{"src":"dk-indopak-text","bismillah":"بِسْمِ اللّٰهِ الرَّحْمٰنِ الرَّحِيْمِ","ayahs":[["قُلْ","يٰٓاَيُّهَا","الْكٰفِرُوْنَۙ"],["لَا͏ٓ","اَعْبُدُ","مَا","تَعْبُدُوْنَۙ"],["وَلَا͏ٓ","اَنْتُمْ","عٰبِدُوْنَ","مَا͏ٓ","اَعْبُدُۚ"],["وَلَا͏ٓ","اَنَا","عَابِدٌ","مَّا","عَبَدْتُّمْۙ"],["وَلَا͏ٓ","اَنْتُمْ","عٰبِدُوْنَ","مَا͏ٓ","اَعْبُدُؕ"],["لَكُمْ","دِيْنُكُمْ","وَلِيَ","دِيْنِࣖ"]]}