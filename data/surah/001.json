{"n":1,"src":{"text":"qc-text","wbw":"qc-wbw"},"ayahs":[{"k":"1:1","n":1,"id":1,"u":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ","juz":1,"page":1,"sajdah":false,"w":[{"u":"بِسْمِ","en":"In (the) name","ur":"ساتھ نام"},{"u":"ٱللَّهِ","en":"(of) Allah","ur":"اللہ کے"},{"u":"ٱلرَّحْمَـٰنِ","en":"the Most Gracious","ur":"جو بے حد مہربان ہے"},{"u":"ٱلرَّحِيمِ","en":"the Most Merciful","ur":"بار بار رحم فرمانے والا ہے"}]},{"k":"1:2","n":2,"id":2,"u":"ٱلْحَمْدُ لِلَّهِ رَبِّ ٱلْعَـٰلَمِينَ","juz":1,"page":1,"sajdah":false,"w":[{"u":"ٱلْحَمْدُ","en":"All praises and thanks","ur":"سب تعریف"},{"u":"لِلَّهِ","en":"(be) to Allah","ur":"اللہ کے لیے ہے"},{"u":"رَبِّ","en":"the Lord","ur":"جو رب ہے"},{"u":"ٱلْعَـٰلَمِينَ","en":"of the universe","ur":"تمام جہانوں کا"}]},{"k":"1:3","n":3,"id":3,"u":"ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ","juz":1,"page":1,"sajdah":false,"w":[{"u":"ٱلرَّحْمَـٰنِ","en":"The Most Gracious","ur":"جو بہت مہربان"},{"u":"ٱلرَّحِيمِ","en":"the Most Merciful","ur":"بار بار رحم فرمانے والا ہے"}]},{"k":"1:4","n":4,"id":4,"u":"مَـٰلِكِ يَوْمِ ٱلدِّينِ","juz":1,"page":1,"sajdah":false,"w":[{"u":"مَـٰلِكِ","en":"(The) Master","ur":"مالک ہے"},{"u":"يَوْمِ","en":"(of the) Day","ur":"دن کا"},{"u":"ٱلدِّينِ","en":"(of the) Judgment","ur":"بدلے کے"}]},{"k":"1:5","n":5,"id":5,"u":"إِيَّاكَ نَعْبُدُ وَإِيَّاكَ نَسْتَعِينُ","juz":1,"page":1,"sajdah":false,"w":[{"u":"إِيَّاكَ","en":"You Alone","ur":"صرف تیری"},{"u":"نَعْبُدُ","en":"we worship","ur":"ہم عبادت کرتے ہیں"},{"u":"وَإِيَّاكَ","en":"and You Alone","ur":"اور صرف تجھ سے"},{"u":"نَسْتَعِينُ","en":"we ask for help","ur":"ہم مدد چاہتے ہیں"}]},{"k":"1:6","n":6,"id":6,"u":"ٱهْدِنَا ٱلصِّرَٰطَ ٱلْمُسْتَقِيمَ","juz":1,"page":1,"sajdah":false,"w":[{"u":"ٱهْدِنَا","en":"Guide us","ur":"دکھا ہم کو"},{"u":"ٱلصِّرَٰطَ","en":"(to) the path","ur":"راستہ"},{"u":"ٱلْمُسْتَقِيمَ","en":"the straight","ur":"سیدھا"}]},{"k":"1:7","n":7,"id":7,"u":"صِرَٰطَ ٱلَّذِينَ أَنْعَمْتَ عَلَيْهِمْ غَيْرِ ٱلْمَغْضُوبِ عَلَيْهِمْ وَلَا ٱلضَّآلِّينَ","juz":1,"page":1,"sajdah":false,"w":[{"u":"صِرَٰطَ","en":"(The) path","ur":"راستہ"},{"u":"ٱلَّذِينَ","en":"(of) those","ur":"ان لوگوں کا"},{"u":"أَنْعَمْتَ","en":"You have bestowed (Your) Favors","ur":"انعام کیا تو نے"},{"u":"عَلَيْهِمْ","en":"on them","ur":"اوپر ان کے"},{"u":"غَيْرِ","en":"not (of)","ur":"نہ ان (لوگوں) کا"},{"u":"ٱلْمَغْضُوبِ","en":"those who earned (Your) wrath","ur":"غضب کیا گیا"},{"u":"عَلَيْهِمْ","en":"on themselves","ur":"اوپر ان کے"},{"u":"وَلَا","en":"and not","ur":"اور نہ"},{"u":"ٱلضَّآلِّينَ","en":"(of) those who go astray","ur":"ان (لوگوں) کا جو گمراہ ہیں / گم کردہ راہ ہیں"}]}]}