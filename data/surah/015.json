":"وَقَضَيْنَآ إِلَيْهِ ذَٰلِكَ ٱلْأَمْرَ أَنَّ دَابِرَ هَـٰٓؤُلَآءِ مَقْطُوعٌ مُّصْبِحِينَ","juz":14,"page":265,"sajdah":false,"w":[{"u":"وَقَضَيْنَآ","en":"And We conveyed","ur":"اور فیصلہ کردیا ہم نے۔ فیصلہ پہنچا دیا ہم نے"},{"u":"إِلَيْهِ","en":"to him","ur":"اس کی طرف۔ اس کو"},{"u":"ذَٰلِكَ","en":"[that]","ur":"اس"},{"u":"ٱلْأَمْرَ","en":"the matter","ur":"معاملے کا"},{"u":"أَنَّ","en":"that","ur":"بیشک"},{"u":"دَابِرَ","en":"(the) root","ur":"جڑ"},{"u":"هَـٰٓؤُلَآءِ","en":"(of) these","ur":"ان لوگوں کی"},{"u":"مَقْطُوعٌۭ","en":"would be cut off","ur":"کاٹ دی جائے گی"},{"u":"مُّصْبِحِينَ","en":"(by) early morning","ur":"صبح ہوتے ہی"}]},{"k":"15:67","n":67,"id":1869,"u":"وَجَآءَ أَهْلُ ٱلْمَدِينَةِ يَسْتَبْشِرُونَ","juz":14,"page":265,"sajdah":false,"w":[{"u":"وَجَآءَ","en":"And came","ur":"اور آئے"},{"u":"أَهْلُ","en":"(the) people","ur":"والے"},{"u":"ٱلْمَدِينَةِ","en":"(of) the city","ur":"شہر والے"},{"u":"يَسْتَبْشِرُونَ","en":"rejoicing","ur":"خوشخبریاں دیتے ہوئے"}]},{"k":"15:68","n":68,"id":1870,"u":"قَالَ إِنَّ هَـٰٓؤُلَآءِ ضَيْفِى فَلَا تَفْضَحُونِ","juz":14,"page":265,"sajdah":false,"w":[{"u":"قَالَ","en":"He said","ur":"لوط نے کہا"},{"u":"إِنَّ","en":"Indeed","ur":"بیشک"},{"u":"هَـٰٓؤُلَآءِ","en":"these","ur":"یہ لوگ"},{"u":"ضَيْفِى","en":"(are) my guests","ur":"میرے مہمان ہیں"},{"u":"فَلَا","en":"so (do) not","ur":"پس نہ"},{"u":"تَفْضَحُونِ","en":"shame me","ur":"تم رسوا کرو مجھ کو"}]},{"k":"15:69","n":69,"id":1871,"u":"وَٱتَّقُوا۟ ٱللَّهَ وَلَا تُخْزُونِ","juz":14,"page":265,"sajdah":false,"w":[{"u":"وَٱتَّقُوا۟","en":"And fear","ur":"اور ڈرو"},{"u":"ٱللَّهَ","en":"Allah","ur":"اللہ سے"},{"u":"وَلَا","en":"and (do) not","ur":"اور نہ"},{"u":"تُخْزُونِ","en":"disgrace me","ur":"تم بےعزت کرو مجھ کو۔ رسوا کرو مجھ کو"}]},{"k":"15:70","n":70,"id":1872,"u":"قَالُوٓا۟ أَوَلَمْ نَنْهَكَ عَنِ ٱلْعَـٰلَمِينَ","juz":14,"page":265,"sajdah":false,"w":[{"u":"قَالُوٓا۟","en":"They said","ur":"انہوں نے کہا"},{"u":"أَوَلَمْ","en":"Did not","ur":"کیا بھلا نہیں"