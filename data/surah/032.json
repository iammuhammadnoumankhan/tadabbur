{"n":32,"src":{"text":"qc-text","wbw":"qc-wbw"},"ayahs":[{"k":"32:1","n":1,"id":3504,"u":" الٓمٓ","juz":21,"page":415,"sajdah":false,"w":[{"u":"الٓمٓ","en":"Alif Lam Meem","ur":"ا، ل، م"}]},{"k":"32:2","n":2,"id":3505,"u":"تَنزِيلُ ٱلْكِتَـٰبِ لَا رَيْبَ فِيهِ مِن رَّبِّ ٱلْعَـٰلَمِينَ","juz":21,"page":415,"sajdah":false,"w":[{"u":"تَنزِيلُ","en":"(The) revelation","ur":"نازل کرنا ہے"},{"u":"ٱلْكِتَـٰبِ","en":"(of) the Book","ur":"کتاب کا"},{"u":"لَا","en":"(there is) no","ur":"نہیں"},{"u":"رَيْبَ","en":"doubt","ur":"کوئی شک"},{"u":"فِيهِ","en":"about it","ur":"اس میں"},{"u":"مِن","en":"from","ur":"طرف سے"},{"u":"رَّبِّ","en":"(the) Lord","ur":"رب کی"},{"u":"ٱلْعَـٰلَمِينَ","en":"(of) the worlds","ur":"العالمین (رب العالمین کی طرف سے)"}]},{"k":"32:3","n":3,"id":3506,"u":"أَمْ يَقُولُونَ ٱفْتَرَىٰهُ ۚ بَلْ هُوَ ٱلْحَقُّ مِن رَّبِّكَ لِتُنذِرَ قَوْمًا مَّآ أَتَىٰهُم مِّن نَّذِيرٍ مِّن قَبْلِكَ لَعَلَّهُمْ يَهْتَدُونَ","juz":21,"page":415,"sajdah":false,"w":[{"u":"أَمْ","en":"Or","ur":"کیا"},{"u":"يَقُولُونَ","en":"(do) they say","ur":"وہ کہتے ہیں"},{"u":"ٱفْتَرَىٰهُ ۚ","en":"He invented it","ur":"اس نے گھڑ لیا اس کو"},{"u":"بَلْ","en":"Nay","ur":"بلکہ"},{"u":"هُوَ","en":"it","ur":"وہ"},{"u":"ٱلْحَقُّ","en":"(is) the truth","ur":"حق ہے"},{"u":"مِن","en":"from","ur":"سے"},{"u":"رَّبِّكَ","en":"your Lord","ur":"تیرے رب کی طرف"},{"u":"لِتُنذِرَ","en":"that you may warn","ur":"تاکہ تو خبردار کرے۔ متنبہ کرے"},{"u":"قَوْمًۭا","en":"a people","ur":"ایسی قوم کو"},{"u":"مَّآ","en":"not","ur":"نہیں"},{"u":"أَتَىٰهُم","en":"has come to them","ur":"آیا ان کے پاس"},{"u":"مِّن","en":"any","ur":"کوئی"},{"u":"نَّذِيرٍۢ","en":"warner","ur":"ڈرانے والا"},{"u":"مِّن","en":"before you","ur":""},{"u":"قَبْلِكَ","en":"before you","ur":"تجھ سے پہلے"},{"u":"لَعَلَّهُمْ","en":"so that they may","ur":"شاید کہ وہ"},{"u":"يَهْتَدُونَ","en":"be guided","ur":"ہدایت پاجائیں"}]},{"k":"32:4","n":4,"id":3507,"u":"ٱللَّهُ ٱلَّذِى خَلَقَ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضَ وَمَا بَيْنَهُمَا فِى سِتَّةِ أَيَّامٍ ثُمَّ ٱسْتَوَىٰ عَلَى ٱلْعَرْشِ ۖ مَا لَكُم مِّن دُونِهِۦ مِن وَلِىٍّ وَلَا شَفِيعٍ ۚ أَفَلَا تَتَذَكَّرُونَ","juz":21,"page":415,"sajdah":false,"w":[{"u":"ٱللَّهُ","en":"Allah","ur":"اللہ"},{"u":"ٱلَّذِى","en":"(is) the One Who","ur":"وہ ذات ہے"},{"u":"خَلَقَ","en":"created","ur":"اس نے پیدا کیا"},{"u":"ٱلسَّمَـٰوَٰتِ","en":"the heavens","ur":"آسمانوں کو"},{"u":"وَٱلْأَرْضَ","en":"and the earth","ur":"اور زمین کو"},{"u":"وَمَا","en":"and whatever","ur":"اور جو"},{"u":"بَيْنَهُمَا","en":"(is) between them","ur":"ان دونوں کے درمیان ہے"},{"u":"فِى","en":"in","ur":"میں"},{"u":"سِتَّةِ","en":"six","ur":"چھ"},{"u":"أَيَّامٍۢ","en":"periods","ur":"دنوں"},{"u":"ثُمَّ","en":"Then","ur":"پھر"},{"u":"ٱسْتَوَىٰ","en":"established Himself","ur":"وہ مستوی ہوا"},{"u":"عَلَى","en":"on","ur":"پر"},{"u":"ٱلْعَرْشِ ۖ","en":"the Throne","ur":"عرش"},{"u":"مَا","en":"Not","ur":"نہیں"},{"u":"لَكُم","en":"for you","ur":"تمہارے لیے"},{"u":"مِّن","en":"besides Him","ur":"اس کے"},{"u":"دُونِهِۦ","en":"besides Him","ur":"سوا"},{"u":"مِن","en":"any","ur":"کوئی"},{"u":"وَلِىٍّۢ","en":"protector","ur":"دوست۔ مددگار"},{"u":"وَلَا","en":"and not","ur":"اور نہ"},{"u":"شَفِيعٍ ۚ","en":"any intercessor","ur":"کوئی سفارشی"},{"u":"أَفَلَا","en":"Then will not","ur":"کیا پھر نہیں"},{"u":"تَتَذَكَّرُونَ","en":"you take heed","ur":"تم نصیحت پکڑتے"}]},{"k":"32:5","n":5,"id":3508,"u":"يُدَبِّرُ ٱلْأَمْرَ مِنَ ٱلسَّمَآءِ إِلَى ٱلْأَرْضِ ثُمَّ يَعْرُجُ إِلَيْهِ فِى يَوْمٍ كَانَ مِقْدَارُهُۥٓ أَلْفَ سَنَةٍ مِّمَّا تَعُدُّونَ","juz":21,"page":415,"sajdah":false,"w":[{"u":"يُدَبِّرُ","en":"He regulates","ur":"وہ تدبیر کرتا ہے"},{"u":"ٱلْأَمْرَ","en":"the affair","ur":"معاملات کی"},{"u":"مِنَ","en":"of","ur":"سے"},{"u":"ٱلسَّمَآءِ","en":"the heaven","ur":"آسمان"},{"u":"إِلَى","en":"to","ur":"تک"},{"u":"ٱلْأَرْضِ","en":"the earth","ur":"زمین"},{"u":"ثُمَّ","en":"then","ur":"پھر"},{"u":"يَعْرُجُ","en":"it will ascend","ur":"وہ چڑھتا ہے (امر)"},{"u":"إِلَيْهِ","en":"to Him","ur":"اس کی طرف"},{"u":"فِى","en":"in","ur":"میں"},{"u":"يَوْمٍۢ","en":"a Day","ur":"ایسے دن"},{"u":"كَانَ","en":"(the) measure of which is","ur":"ہے"},{"u":"مِقْدَارُهُۥٓ","en":"(the) measure of which is","ur":"اس کی مقدار"},{"u":"أَلْفَ","en":"a thousand","ur":"ہزار"},{"u":"سَنَةٍۢ","en":"years","ur":"سال (کے برابر)"},{"u":"مِّمَّا","en":"of what","ur":"اس میں سے"},{"u":"تَعُدُّونَ","en":"you count","ur":"جو تم شمار کرتے ہو"}]},{"k":"32:6","n":6,"id":3509,"u":"ذَٰلِكَ عَـٰلِمُ ٱلْغَيْبِ وَٱلشَّهَـٰدَةِ ٱلْعَزِيزُ ٱلرَّحِيمُ","juz":21,"page":415,"sajdah":false,"w":[{"u":"ذَٰلِكَ","en":"That","ur":"یہ ہے"},{"u":"عَـٰلِمُ","en":"(is the) Knower","ur":"جاننے والا"},{"u":"ٱلْغَيْبِ","en":"(of) the hidden","ur":"غیب کا"},{"u":"وَٱلشَّهَـٰدَةِ","en":"and the witnessed","ur":"اور حاضر کا"},{"u":"ٱلْعَزِيزُ","en":"the All-Mighty","ur":"غالب،"},{"u":"ٱلرَّحِيمُ","en":"the Most Merciful","ur":"رحم فرمانے والا"}]},{"k":"32:7","n":7,"id":3510,"u":"ٱلَّذِىٓ أَحْسَنَ كُلَّ شَىْءٍ خَلَقَهُۥ ۖ وَبَدَأَ خَلْقَ ٱلْإِنسَـٰنِ مِن طِينٍ","juz":21,"page":415,"sajdah":false,"w":[{"u":"ٱلَّذِىٓ","en":"The One Who","ur":"جس نے"},{"u":"أَحْسَنَ","en":"made good","ur":"اچھا بنایا"},{"u":"كُلَّ","en":"every","ur":"ہر"},{"u":"شَىْءٍ","en":"thing","ur":"چیز کو"},{"u":"خَلَقَهُۥ ۖ","en":"He created","ur":"پیدا کیا اس کو"},{"u":"وَبَدَأَ","en":"and He began","ur":"اور ابتدا کی"},{"u":"خَلْقَ","en":"(the) creation","ur":"تخلیق کی"},{"u":"ٱلْإِنسَـٰنِ","en":"(of) man","ur":"انسان کی"},{"u":"مِن","en":"from","ur":"سے"},{"u":"طِينٍۢ","en":"clay","ur":"مٹی"}]},{"k":"32:8","n":8,"id":3511,"u":"ثُمَّ جَعَلَ نَسْلَهُۥ مِن سُلَـٰلَةٍ مِّن مَّآءٍ مَّهِينٍ","juz":21,"page":415,"sajdah":false,"w":[{"u":"ثُمَّ","en":"Then","ur":"پھر"},{"u":"جَعَلَ","en":"He made","ur":"اس نے بنائی"},{"u":"نَسْلَهُۥ","en":"his progeny","ur":"اس کی نسل"},{"u":"مِن","en":"from","ur":"سے"},{"u":"سُلَـٰلَةٍۢ","en":"an extract","ur":"خلاصے"},{"u":"مِّن","en":"of","ur":""},{"u":"مَّآءٍۢ","en":"water","ur":"پانی کے"},{"u":"مَّهِينٍۢ","en":"despised","ur":"ذلیل۔ حقیر"}]},{"k":"32:9","n":9,"id":3512,"u":"ثُمَّ سَوَّىٰهُ وَنَفَخَ فِيهِ مِن رُّوحِهِۦ ۖ وَجَعَلَ لَكُمُ ٱلسَّمْعَ وَٱلْأَبْصَـٰرَ وَٱلْأَفْـِٔدَةَ ۚ قَلِيلًا مَّا تَشْكُرُونَ","juz":21,"page":415,"sajdah":false,"w":[{"u":"ثُمَّ","en":"Then","ur":"پھر"},{"u":"سَوَّىٰهُ","en":"He fashioned him","ur":"درست کیا اس کو"},{"u":"وَنَفَخَ","en":"and breathed","ur":"اور پھونک دی"},{"u":"فِيهِ","en":"into him","ur":"اس میں"},{"u":"مِن","en":"from","ur":""},{"u":"رُّوحِهِۦ ۖ","en":"His spirit","ur":"اپنی  روح"},{"u":"وَجَعَلَ","en":"and made","ur":"اور بنائے"},{"u":"لَكُمُ","en":"for you","ur":"تمہارے لیے"},{"u":"ٱلسَّمْعَ","en":"the hearing","ur":"کان"},{"u":"وَٱلْأَبْصَـٰرَ","en":"and the sight","ur":"اور آنکھیں"},{"u":"وَٱلْأَفْـِٔدَةَ ۚ","en":"and feelings","ur":"اور دل"},{"u":"قَلِيلًۭا","en":"little","ur":"کتنا کم ہے"},{"u":"مَّا","en":"[what]","ur":"جو"},{"u":"تَشْكُرُونَ","en":"thanks you give","ur":"تم شکر ادا کرتے ہو"}]},{"k":"32:10","n":10,"id":3513,"u":"وَقَالُوٓا۟ أَءِذَا ضَلَلْنَا فِى ٱلْأَرْضِ أَءِنَّا لَفِى خَلْقٍ جَدِيدٍۭ ۚ بَلْ هُم بِلِقَآءِ رَبِّهِمْ كَـٰفِرُونَ","juz":21,"page":415,"sajdah":false,"w":[{"u":"وَقَالُوٓا۟","en":"And they say","ur":"اور انہوں نے کہا"},{"u":"أَءِذَا","en":"Is (it) when","ur":"کیا جب"},{"u":"ضَلَلْنَا","en":"we are lost","ur":"ہم گم ہوجائیں گے"},{"u":"فِى","en":"in","ur":"میں"},{"u":"ٱلْأَرْضِ","en":"the earth","ur":"زمین"},{"u":"أَءِنَّا","en":"will we","ur":"کیا بیشک ہم"},{"u":"لَفِى","en":"certainly be in","ur":"البتہ  میں ہوں گے"},{"u":"خَلْقٍۢ","en":"a creation","ur":"پیدائش"},{"u":"جَدِيدٍۭ ۚ","en":"new","ur":"نئی"},{"u":"بَلْ","en":"Nay","ur":"بلکہ"},{"u":"هُم","en":"they","ur":"وہ"},{"u":"بِلِقَآءِ","en":"in (the) meeting","ur":"ملاقات کے"},{"u":"رَبِّهِمْ","en":"(of) their Lord","ur":"اپنے رب کی"},{"u":"كَـٰفِرُونَ","en":"(are) disbelievers","ur":"انکاری ہیں"}]},{"k":"32:11","n":11,"id":3514,"u":"۞ قُلْ يَتَوَفَّىٰكُم مَّلَكُ ٱلْمَوْتِ ٱلَّذِى وُكِّلَ بِكُمْ ثُمَّ إِلَىٰ رَبِّكُمْ تُرْجَعُونَ","juz":21,"page":415,"sajdah":fals