{"n":32,"src":{"text":"qc-text","wbw":"qc-wbw"},"ayahs":[{"k":"32:1","n":1,"id":3504,"u":" الٓمٓ","i":"الٓمّٓ‏","juz":21,"page":415,"sajdah":false,"w":[{"u":"الٓمٓ","i":"الٓمّٓ‏","tl":"alif-lam-meem","en":"Alif Lam Meem","ur":"ا، ل، م","a":"wbw/032_001_001.mp3"}]},{"k":"32:2","n":2,"id":3505,"u":"تَنزِيلُ ٱلْكِتَـٰبِ لَا رَيْبَ فِيهِ مِن رَّبِّ ٱلْعَـٰلَمِينَ","i":"تَنۡزِيۡلُ الۡكِتٰبِ لَا رَيۡبَ فِيۡهِ مِنۡ رَّبِّ الۡعٰلَمِيۡنَؕ‏","juz":21,"page":415,"sajdah":false,"w":[{"u":"تَنزِيلُ","i":"تَنۡزِيۡلُ","tl":"tanzīlu","en":"(The) revelation","ur":"نازل کرنا ہے","a":"wbw/032_002_001.mp3"},{"u":"ٱلْكِتَـٰبِ","i":"الۡكِتٰبِ","tl":"l-kitābi","en":"(of) the Book","ur":"کتاب کا","a":"wbw/032_002_002.mp3"},{"u":"لَا","i":"لَا","tl":"lā","en":"(there is) no","ur":"نہیں","a":"wbw/032_002_003.mp3"},{"u":"رَيْبَ","i":"رَيۡبَ","tl":"rayba","en":"doubt","ur":"کوئی شک","a":"wbw/032_002_004.mp3"},{"u":"فِيهِ","i":"فِيۡهِ","tl":"fīhi","en":"about it","ur":"اس میں","a":"wbw/032_002_005.mp3"},{"u":"مِن","i":"مِنۡ","tl":"min","en":"from","ur":"طرف سے","a":"wbw/032_002_006.mp3"},{"u":"رَّبِّ","i":"رَّبِّ","tl":"rabbi","en":"(the) Lord","ur":"رب کی","a":"wbw/032_002_007.mp3"},{"u":"ٱلْعَـٰلَمِينَ","i":"الۡعٰلَمِيۡنَؕ‏","tl":"l-ʿālamīna","en":"(of) the worlds","ur":"العالمین (رب العالمین کی طرف سے)","a":"wbw/032_002_008.mp3"}]},{"k":"32:3","n":3,"id":3506,"u":"أَمْ يَقُولُونَ ٱفْتَرَىٰهُ ۚ بَلْ هُوَ ٱلْحَقُّ مِن رَّبِّكَ لِتُنذِرَ قَوْمًا مَّآ أَتَىٰهُم مِّن نَّذِيرٍ مِّن قَبْلِكَ لَعَلَّهُمْ يَهْتَدُونَ","i":"اَمۡ يَقُوۡلُوۡنَ افۡتَرٰٮهُ​ۚ بَلۡ هُوَ الۡحَقُّ مِنۡ رَّبِّكَ لِتُنۡذِرَ قَوۡمًا مَّاۤ اَتٰٮهُمۡ مِّنۡ نَّذِيۡرٍ مِّنۡ قَبۡلِكَ لَعَلَّهُمۡ يَهۡتَدُوۡنَ‏ ﻿﻿","juz":21,"page":415,"sajdah":false,"w":[{"u":"أَمْ","i":"اَمۡ","tl":"am","en":"Or","ur":"کیا","a":"wbw/032_003_001.mp3"},{"u":"يَقُولُونَ","i":"يَقُوۡلُوۡنَ","tl":"yaqūlūna","en":"(do) they say","ur":"وہ کہتے ہیں","a":"wbw/032_003_002.mp3"},{"u":"ٱفْتَرَىٰهُ ۚ","i":"افۡتَرٰٮهُ​ۚ","tl":"if'tarāhu","en":"He invented it","ur":