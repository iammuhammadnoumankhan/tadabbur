":"پس انتظار کرو"},{"u":"يَوْمَ","en":"(for the) Day","ur":"جس دن"},{"u":"تَأْتِى","en":"(when) will bring","ur":"آئے گا"},{"u":"ٱلسَّمَآءُ","en":"the sky","ur":"آسمان"},{"u":"بِدُخَانٍۢ","en":"smoke","ur":"ساتھ دھوئیں کے"},{"u":"مُّبِينٍۢ","en":"visible","ur":"کھلے"}]},{"k":"44:11","n":11,"id":4425,"u":"يَغْشَى ٱلنَّاسَ ۖ هَـٰذَا عَذَابٌ أَلِيمٌ","juz":25,"page":496,"sajdah":false,"w":[{"u":"يَغْشَى","en":"Enveloping","ur":"ڈھانپ لے گا"},{"u":"ٱلنَّاسَ ۖ","en":"the people","ur":"لوگوں کو"},{"u":"هَـٰذَا","en":"This","ur":"یہ ہے"},{"u":"عَذَابٌ","en":"(will be) a punishment","ur":"عذاب"},{"u":"أَلِيمٌۭ","en":"painful","ur":"دردناک"}]},{"k":"44:12","n":12,"id":4426,"u":"رَّبَّنَا ٱكْشِفْ عَنَّا ٱلْعَذَابَ إِنَّا مُؤْمِنُونَ","juz":25,"page":496,"sajdah":false,"w":[{"u":"رَّبَّنَا","en":"Our Lord","ur":"(کہیں گے) اے ہمارے رب"},{"u":"ٱكْشِفْ","en":"Remove","ur":"مٹا دے"},{"u":"عَنَّا","en":"from us","ur":"ہم سے"},{"u":"ٱلْعَذَابَ","en":"the punishment","ur":"عذاب کو"},{"u":"إِنَّا","en":"indeed, we","ur":"بیشک ہم"},{"u":"مُؤْمِنُونَ","en":"(are) believers","ur":"ماننے والے ہیں"}]},{"k":"44:13","n":13,"id":4427,"u":"أَنَّىٰ لَهُمُ ٱلذِّكْرَىٰ وَقَدْ جَآءَهُمْ رَسُولٌ مُّبِينٌ","juz":25,"page":496,"sajdah":false,"w":[{"u":"أَنَّىٰ","en":"How can","ur":"کہاں سے ہے"},{"u":"لَهُمُ","en":"(there be) for them","ur":"ان کے لیے"},{"u":"ٱلذِّكْرَىٰ","en":"the reminder","ur":"نصیحت"},{"u":"وَقَدْ","en":"when verily","ur":"اور تحقیق"},{"u":"جَآءَهُمْ","en":"had come to them","ur":"آچکا ان کے پاس"},{"u":"رَسُولٌۭ","en":"a Messenger","ur":"رسول"},{"u":"مُّبِينٌۭ","en":"clear","ur":"مبین۔ بیان کرنے والا"}]},{"k":"44:14","n":14,"id":4428,"u":"ثُمَّ تَوَلَّوْا۟ عَنْهُ وَقَالُوا۟ مُعَلَّمٌ مَّجْنُونٌ","juz":25,"page":496,"sajdah":false,"w":[{"u":"ثُمَّ","en":"Then","ur":"پھر"},{"u":"تَوَلَّوْا۟","en":"they turned away","ur":"وہ منہ موڑ گئے"},{"u":"عَنْهُ","en":"from him","ur":"اس سے"},{"u":"وَقَالُوا۟","en":"and said","ur":"اور انہوں نے کہا"},{"u":"مُعَلَّمٌۭ","en":"One taught","ur":