499,"sajdah":false,"w":[{"u":"وَٱخْتِلَـٰفِ","en":"And (in the) alternation","ur":"اور اختلاف میں"},{"u":"ٱلَّيْلِ","en":"(of) the night","ur":"رات"},{"u":"وَٱلنَّهَارِ","en":"and the day","ur":"اور دن کے"},{"u":"وَمَآ","en":"and what","ur":"اور جو"},{"u":"أَنزَلَ","en":"Allah sends down","ur":"نازل کیا"},{"u":"ٱللَّهُ","en":"Allah sends down","ur":"اللہ نے"},{"u":"مِنَ","en":"from","ur":"سے"},{"u":"ٱلسَّمَآءِ","en":"the sky","ur":"آسمان"},{"u":"مِن","en":"of","ur":"میں سے"},{"u":"رِّزْقٍۢ","en":"(the) provision","ur":"رزق"},{"u":"فَأَحْيَا","en":"and gives life","ur":"پھر اس نے زندہ کیا"},{"u":"بِهِ","en":"thereby","ur":"ساتھ اس کے"},{"u":"ٱلْأَرْضَ","en":"(to) the earth","ur":"زمین کو"},{"u":"بَعْدَ","en":"after","ur":"بعد"},{"u":"مَوْتِهَا","en":"its death","ur":"اس کی موت کے"},{"u":"وَتَصْرِيفِ","en":"and (in) directing","ur":"اور  گردش میں"},{"u":"ٱلرِّيَـٰحِ","en":"(the) winds","ur":"ہواؤں کی"},{"u":"ءَايَـٰتٌۭ","en":"(are) Signs","ur":"نشانیاں ہیں"},{"u":"لِّقَوْمٍۢ","en":"for a people","ur":"اس قوم کے لیے"},{"u":"يَعْقِلُونَ","en":"who reason","ur":"جو عقل رکھتی ہو"}]},{"k":"45:6","n":6,"id":4479,"u":"تِلْكَ ءَايَـٰتُ ٱللَّهِ نَتْلُوهَا عَلَيْكَ بِٱلْحَقِّ ۖ فَبِأَىِّ حَدِيثٍۭ بَعْدَ ٱللَّهِ وَءَايَـٰتِهِۦ يُؤْمِنُونَ","juz":25,"page":499,"sajdah":false,"w":[{"u":"تِلْكَ","en":"These","ur":"یہ"},{"u":"ءَايَـٰتُ","en":"(are the) Verses","ur":"آیات ہیں"},{"u":"ٱللَّهِ","en":"(of) Allah","ur":"اللہ کی"},{"u":"نَتْلُوهَا","en":"We recite them","ur":"ہم پڑھتے ہیں ان کو"},{"u":"عَلَيْكَ","en":"to you","ur":"آپ پر"},{"u":"بِٱلْحَقِّ ۖ","en":"in truth","ur":"حق کے ساتھ"},{"u":"فَبِأَىِّ","en":"Then in what","ur":"تو ساتھ کون سی"},{"u":"حَدِيثٍۭ","en":"statement","ur":"بات"},{"u":"بَعْدَ","en":"after","ur":"کے بعد"},{"u":"ٱللَّهِ","en":"Allah","ur":"اللہ کے"},{"u":"وَءَايَـٰتِهِۦ","en":"and His Verses","ur":"اور اس کی آیات کے"},{"u":"يُؤْمِنُونَ","en":"will they believe","ur":"وہ ایمان لائیں گے"}]},{"k":"45:7","n":7,"id":4480,"u":"وَيْلٌ لِّكُلِّ أَفَّاكٍ أَثِيمٍ",