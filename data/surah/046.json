{"n":46,"src":{"text":"qc-text","wbw":"qc-wbw"},"ayahs":[{"k":"46:1","n":1,"id":4511,"u":" حمٓ","juz":26,"page":502,"sajdah":false,"w":[{"u":"حمٓ","en":"Ha Meem","ur":"ها ميم"}]},{"k":"46:2","n":2,"id":4512,"u":"تَنزِيلُ ٱلْكِتَـٰبِ مِنَ ٱللَّهِ ٱلْعَزِيزِ ٱلْحَكِيمِ","juz":26,"page":502,"sajdah":false,"w":[{"u":"تَنزِيلُ","en":"(The) revelation","ur":"نازل کرنا ہے"},{"u":"ٱلْكِتَـٰبِ","en":"(of) the Book","ur":"کتاب کا"},{"u":"مِنَ","en":"(is) from","ur":"سے"},{"u":"ٱللَّهِ","en":"Allah","ur":"اللہ کی طرف (سے )"},{"u":"ٱلْعَزِيزِ","en":"the All-Mighty","ur":"جو زبردست ہے"},{"u":"ٱلْحَكِيمِ","en":"the All-Wise","ur":"حکمت والا ہے"}]},{"k":"46:3","n":3,"id":4513,"u":"مَا خَلَقْنَا ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضَ وَمَا بَيْنَهُمَآ إِلَّا بِٱلْحَقِّ وَأَجَلٍ مُّسَمًّى ۚ وَٱلَّذِينَ كَفَرُوا۟ عَمَّآ أُنذِرُوا۟ مُعْرِضُونَ","juz":26,"page":502,"sajdah":false,"w":[{"u":"مَا","en":"Not","ur":"نہیں"},{"u":"خَلَقْنَا","en":"We created","ur":"پیدا کیا ہم نے"},{"u":"ٱلسَّمَـٰوَٰتِ","en":"the heavens","ur":"آسمانوں کو"},{"u":"وَٱلْأَرْضَ","en":"and the earth","ur":"اور زمین کو"},{"u":"وَمَا","en":"and what","ur":"اور جو"},{"u":"بَيْنَهُمَآ","en":"(is) between both of them","ur":"ان دونوں کے درمیان ہے"},{"u":"إِلَّا","en":"except","ur":"مگر"},{"u":"بِٱلْحَقِّ","en":"in truth","ur":"حق کے ساتھ"},{"u":"وَأَجَلٍۢ","en":"and (for) a term","ur":"اور  مدت تک"},{"u":"مُّسَمًّۭى ۚ","en":"appointed","ur":"مقرر  تک کے لیے"},{"u":"وَٱلَّذِينَ","en":"But those who","ur":"اور وہ لوگ"},{"u":"كَفَرُوا۟","en":"disbelieve","ur":"جنہوں نے کفر کیا"},{"u":"عَمَّآ","en":"from what","ur":"اس چیز سے"},{"u":"أُنذِرُوا۟","en":"they are warned","ur":"جو وہ خبر دار کیے گئے"},{"u":"مُعْرِضُونَ","en":"(are) turning away","ur":"اعراض برتنے والے ہیں"}]},{"k":"46:4","n":4,"id":4514,"u":"قُلْ أَرَءَيْتُم مَّا تَدْعُونَ مِن دُونِ ٱللَّهِ أَرُونِى مَاذَا خَلَقُوا۟ مِنَ ٱلْأَرْضِ أَمْ لَهُمْ شِرْكٌ فِى ٱلسَّمَـٰوَٰتِ ۖ ٱئْتُونِى بِكِتَـٰبٍ مِّن قَبْلِ هَـٰذَآ أَوْ أَثَـٰرَةٍ مِّنْ عِلْمٍ إِن كُنتُمْ صَـٰدِقِينَ","