":"سیدھے"}]},{"k":"46:31","n":31,"id":4541,"u":"يَـٰقَوْمَنَآ أَجِيبُوا۟ دَاعِىَ ٱللَّهِ وَءَامِنُوا۟ بِهِۦ يَغْفِرْ لَكُم مِّن ذُنُوبِكُمْ وَيُجِرْكُم مِّنْ عَذَابٍ أَلِيمٍ","juz":26,"page":506,"sajdah":false,"w":[{"u":"يَـٰقَوْمَنَآ","en":"O our people","ur":"اے ہماری قوم"},{"u":"أَجِيبُوا۟","en":"Respond","ur":"جواب دو ۔ دعوت قبول کرو"},{"u":"دَاعِىَ","en":"(to the) caller","ur":"داعی کی۔ طرف بلانے والے کی"},{"u":"ٱللَّهِ","en":"(of) Allah","ur":"اللہ کی"},{"u":"وَءَامِنُوا۟","en":"and believe","ur":"اور ایمان لے آؤ"},{"u":"بِهِۦ","en":"in him","ur":"اس کے ساتھ"},{"u":"يَغْفِرْ","en":"He will forgive","ur":"بخش دے گا"},{"u":"لَكُم","en":"for you","ur":"تمہارے لیے"},{"u":"مِّن","en":"of","ur":"سے"},{"u":"ذُنُوبِكُمْ","en":"your sins","ur":"تمہارے گناہوں میں سے"},{"u":"وَيُجِرْكُم","en":"and will protect you","ur":"اور پناہ دے گا تم کو۔ بچالے گا تم کو"},{"u":"مِّنْ","en":"from","ur":"سے"},{"u":"عَذَابٍ","en":"a punishment","ur":"عذاب (سے)"},{"u":"أَلِيمٍۢ","en":"painful","ur":"دردناک"}]},{"k":"46:32","n":32,"id":4542,"u":"وَمَن لَّا يُجِبْ دَاعِىَ ٱللَّهِ فَلَيْسَ بِمُعْجِزٍ فِى ٱلْأَرْضِ وَلَيْسَ لَهُۥ مِن دُونِهِۦٓ أَوْلِيَآءُ ۚ أُو۟لَـٰٓئِكَ فِى ضَلَـٰلٍ مُّبِينٍ","juz":26,"page":506,"sajdah":false,"w":[{"u":"وَمَن","en":"And whoever","ur":"اور جو"},{"u":"لَّا","en":"(does) not","ur":"نہ"},{"u":"يُجِبْ","en":"respond","ur":"جواب دے"},{"u":"دَاعِىَ","en":"(to the) caller","ur":"داعی کو"},{"u":"ٱللَّهِ","en":"(of) Allah","ur":"اللہ کے"},{"u":"فَلَيْسَ","en":"then not","ur":"تو نہیں ہے"},{"u":"بِمُعْجِزٍۢ","en":"he can escape","ur":"عاجز کرنے والا"},{"u":"فِى","en":"in","ur":"میں"},{"u":"ٱلْأَرْضِ","en":"the earth","ur":"زمین (میں)"},{"u":"وَلَيْسَ","en":"and not","ur":"اور نہیں"},{"u":"لَهُۥ","en":"for him","ur":"اس کے لیے"},{"u":"مِن","en":"besides Him","ur":""},{"u":"دُونِهِۦٓ","en":"besides Him","ur":"اس کے سوا"},{"u":"أَوْلِيَآءُ ۚ","en":"protectors","ur":"کوئی حامی و مددگار"},{"u":"أُو۟لَـٰٓئِكَ","en":"Those","ur":"یہی لوگ"},{"u":"فِى","en":"(are) in","ur":"میں"},{"u":"ضَلَـٰلٍۢ","en":"error","ur":"گمراہی (میں) ہیں"},{"u":"مُّبِينٍ","en":"clear","ur":"کھلی"}]},{"k":"46:33","n":33,"id":4543,"u":"أَوَلَمْ يَرَوْا۟ أَنَّ ٱللَّهَ ٱلَّذِى خَلَقَ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضَ وَلَمْ يَعْىَ بِخَلْقِهِنَّ بِقَـٰدِرٍ عَلَىٰٓ أَن يُحْـِۧىَ ٱلْمَوْتَىٰ ۚ بَلَىٰٓ إِنَّهُۥ عَلَىٰ كُلِّ شَىْءٍ قَدِيرٌ","juz":26,"page":506,"sajdah":false,"w":[{"u":"أَوَلَمْ","en":"Do not","ur":"کیا نہیں"},{"u":"يَرَوْا۟","en":"they see","ur":"انہوں نے دیکھا"},{"u":"أَنَّ","en":"that","ur":"بیشک"},{"u":"ٱللَّهَ","en":"Allah","ur":"اللہ"},{"u":"ٱلَّذِى","en":"(is) the One Who","ur":"وہ ذات ہے"},{"u":"خَلَقَ","en":"created","ur":"جس نے پیدا کیا"},{"u":"ٱلسَّمَـٰوَٰتِ","en":"the heavens","ur":"آسمانوں کو"},{"u":"وَٱلْأَرْضَ","en":"and the earth","ur":"اور زمین کو"},{"u":"وَلَمْ","en":"and (was) not","ur":"اور نہیں"},{"u":"يَعْىَ","en":"tired","ur":"تھکا"},{"u":"بِخَلْقِهِنَّ","en":"by their creation","ur":"ساتھ ان کی تخلیق کے"},{"u":"بِقَـٰدِرٍ","en":"(is) able","ur":"قادر ہے"},{"u":"عَلَىٰٓ","en":"to give life","ur":"اس بات پر"},{"u":"أَن","en":"to give life","ur":"کہ"},{"u":"يُحْـِۧىَ","en":"to give life","ur":"وہ زندہ کرے"},{"u":"ٱلْمَوْتَىٰ ۚ","en":"(to) the dead","ur":"مردوں کو"},{"u":"بَلَىٰٓ","en":"Yes","ur":"کیوں نہیں"},{"u":"إِنَّهُۥ","en":"indeed He","ur":"بیشک وہ"},{"u":"عَلَىٰ","en":"(is) on","ur":"پر"},{"u":"كُلِّ","en":"every","ur":"ہر"},{"u":"شَىْءٍۢ","en":"thing","ur":"چیز (پر)"},{"u":"قَدِيرٌۭ","en":"All-Powerful","ur":"قدرت رکھنے والا ہے"}]},{"k":"46:34","n":34,"id":4544,"u":"وَيَوْمَ يُعْرَضُ ٱلَّذِينَ كَفَرُوا۟ عَلَى ٱلنَّارِ أَلَيْسَ هَـٰذَا بِٱلْحَقِّ ۖ قَالُوا۟ بَلَىٰ وَرَبِّنَا ۚ قَالَ فَذُوقُوا۟ ٱلْعَذَابَ بِمَا كُنتُمْ تَكْفُرُونَ","juz":26,"page":506,"sajdah":false,"w":[{"u":"وَيَوْمَ","en":"And (the) Day","ur":"اور جس دن"},{"u":"يُعْرَضُ","en":"are exposed","ur":"پیش کیے جائیں گے"},{"u":"ٱلَّذِينَ","en":"those who","ur":"وہ لوگ"},{"u":"كَفَرُوا۟","en":"disbelieved","ur":"جنہوں نے کفر کیا"},{"u":"عَلَى","en":"to","ur":"پر"},{"u":"ٱلنَّارِ","en":"the Fire","ur":"آگ (پر)"},{"u":"أَلَيْسَ","en":"Is not","ur":"(اس وقت پوچھا جائے گا)کیا نہیں ہے"},{"u":"هَـٰذَا","en":"this","ur":"یہ"},{"u":"بِٱلْحَقِّ ۖ","en":"the truth","ur":"حق"},{"u":"قَالُوا۟","en":"They will say","ur":"وہ کہیں گے"},{"u":"بَلَىٰ","en":"Yes","ur":"کیوں نہیں"},{"u":"وَرَبِّنَا ۚ","en":"by our Lord","ur":"قسم ہے ہمارے رب کی"},{"u":"قَالَ","en":"He will say","ur":"فرمائے گا"},{"u":"فَذُوقُوا۟","en":"Then taste","ur":"پس چکھو"},{"u":"ٱلْعَذَابَ","en":"the punishment","ur":"عذاب"},{"u":"بِمَا","en":"because","ur":"بوجہ اس کے جو"},{"u":"كُنتُمْ","en":"you used to","ur":"تھے تم"},{"u":"تَكْفُرُونَ","en":"disbelieve","ur":"تم کفر کرتے"}]},{"k":"46:35","n":35,"id":4545,"u":"فَٱصْبِرْ كَمَا صَبَرَ أُو۟لُوا۟ ٱلْعَزْمِ مِنَ ٱلرُّسُلِ وَلَا تَسْتَعْجِل لَّهُمْ ۚ كَأَنَّهُمْ يَوْمَ يَرَوْنَ مَا يُوعَدُونَ لَمْ يَلْبَثُوٓا۟ إِلَّا سَاعَةً مِّن نَّهَارٍۭ ۚ بَلَـٰغٌ ۚ فَهَلْ يُهْلَكُ إِلَّا ٱلْقَوْمُ ٱلْفَـٰسِقُونَ","juz":26,"page":506,"sajdah":false,"w":[{"u":"فَٱصْبِرْ","en":"So be patient","ur":"پس صبر کرو"},{"u":"كَمَا","en":"as","ur":"جیسا کہ"},{"u":"صَبَرَ","en":"had patience","ur":"صبر کیا"},{"u":"أُو۟لُوا۟","en":"those of determination","ur":"والوں نے"},{"u":"ٱلْعَزْمِ","en":"those of determination","ur":"ہمت (والوں نے)"},{"u":"مِنَ","en":"of","ur":"سے"},{"u":"ٱلرُّسُلِ","en":"the Messengers","ur":"رسولوں میں (سے)"},{"u":"وَلَا","en":"and (do) not","ur":"اور نہ"},{"u":"تَسْتَعْجِل","en":"seek to hasten","ur":"تم جلدی کرو"},{"u":"لَّهُمْ ۚ","en":"for them","ur":"ان کے لیے"},{"u":"كَأَنَّهُمْ","en":"As if they had","ur":"گویا کہ وہ"},{"u":"يَوْمَ","en":"(the) Day","ur":"جس دن"},{"u":"يَرَوْنَ","en":"they see","ur":"وہ دیکھیں گے"},{"u":"مَا","en":"what","ur":"اسے جو"},{"u":"يُوعَدُونَ","en":"they were promised","ur":"وہ وعدہ دیئے جاتے ہیں"},{"u":"لَمْ","en":"not","ur":"نہیں"},{"u":"يَلْبَثُوٓا۟","en":"remained","ur":"وہ ٹھہریں گے"},{"u":"إِلَّا","en":"except","ur":"مگر"},{"u":"سَاعَةًۭ","en":"an hour","ur":"ایک گھڑی"},{"u":"مِّن","en":"of","ur":"سے"},{"u":"نَّهَارٍۭ ۚ","en":"a day","ur":"دن میں (سے)"},{"u":"بَلَـٰغٌۭ ۚ","en":"A notification","ur":"پیغام پہنچانا ہے"},{"u":"فَهَلْ","en":"But will","ur":"تو نہیں"},{"u":"يُهْلَكُ","en":"(any) be destroyed","ur":"ہلاک کی جائے گی"},{"u":"إِلَّا","en":"except","ur":"مگر"},{"u":"ٱلْقَوْمُ","en":"the people ","ur":"قوم"},{"u":"ٱلْفَـٰسِقُونَ","en":"the defiantly disobedient","ur":"فاسق"}]}]}