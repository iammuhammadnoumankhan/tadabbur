":"And before it","ur":"اور سے"},{"u":"قَبْلِهِۦ","en":"And before it","ur":"اس سے پہلے"},{"u":"كِتَـٰبُ","en":"(was the) Scripture","ur":"کتاب"},{"u":"مُوسَىٰٓ","en":"(of) Musa","ur":"موسیٰ کی"},{"u":"إِمَامًۭا","en":"(as) a guide","ur":"رہنما"},{"u":"وَرَحْمَةًۭ ۚ","en":"and a mercy","ur":"اور رحمت کے طور پر (آچکی ہے)"},{"u":"وَهَـٰذَا","en":"And this","ur":"اور یہ"},{"u":"كِتَـٰبٌۭ","en":"(is) a Book","ur":"کتاب"},{"u":"مُّصَدِّقٌۭ","en":"confirming","ur":"تصدیق کرنے والی ہے"},{"u":"لِّسَانًا","en":"(in) language","ur":"زبان ہے"},{"u":"عَرَبِيًّۭا","en":"Arabic","ur":"عربی"},{"u":"لِّيُنذِرَ","en":"to warn","ur":"تاکہ متنبہ کرے"},{"u":"ٱلَّذِينَ","en":"those who","ur":"ان لوگوں کو"},{"u":"ظَلَمُوا۟","en":"do wrong","ur":"جنہوں نے ظلم کیا"},{"u":"وَبُشْرَىٰ","en":"and (as) glad tidings","ur":"اور خوشخبری ہو"},{"u":"لِلْمُحْسِنِينَ","en":"for the good-doers","ur":"نیکو کاروں کے لیے"}]},{"k":"46:13","n":13,"id":4523,"u":"إِنَّ ٱلَّذِينَ قَالُوا۟ رَبُّنَا ٱللَّهُ ثُمَّ ٱسْتَقَـٰمُوا۟ فَلَا خَوْفٌ عَلَيْهِمْ وَلَا هُمْ يَحْزَنُونَ","juz":26,"page":503,"sajdah":false,"w":[{"u":"إِنَّ","en":"Indeed","ur":"بیشک"},{"u":"ٱلَّذِينَ","en":"those who","ur":"وہ لوگ"},{"u":"قَالُوا۟","en":"say","ur":"جنہوں نے کہا"},{"u":"رَبُّنَا","en":"Our Lord","ur":"ہمارا رب"},{"u":"ٱللَّهُ","en":"(is) Allah","ur":"اللہ ہے"},{"u":"ثُمَّ","en":"then","ur":"پھر"},{"u":"ٱسْتَقَـٰمُوا۟","en":"remain firm","ur":"انہوں نے استقامت اختیار کی۔ جم گئے"},{"u":"فَلَا","en":"then no","ur":"تو نہیں"},{"u":"خَوْفٌ","en":"fear","ur":"کوئی خوف"},{"u":"عَلَيْهِمْ","en":"on them","ur":"ان پر"},{"u":"وَلَا","en":"and not","ur":"اور نہ"},{"u":"هُمْ","en":"they","ur":"وہ"},{"u":"يَحْزَنُونَ","en":"will grieve","ur":"غمگین ہوتے ہیں"}]},{"k":"46:14","n":14,"id":4524,"u":"أُو۟لَـٰٓئِكَ أَصْحَـٰبُ ٱلْجَنَّةِ خَـٰلِدِينَ فِيهَا جَزَآءًۢ بِمَا كَانُوا۟ يَعْمَلُونَ","juz":26,"page":503,"sajdah":false,"w":[{"u":"أُو۟لَـٰٓئِكَ","en":"Those","ur":"یہی لوگ"},{"u":"أَصْحَـٰبُ","en":"(are the) companions","ur":"ساتھی ہیں۔ وا