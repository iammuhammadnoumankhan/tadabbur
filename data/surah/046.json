":"کھلا"}]},{"k":"46:8","n":8,"id":4518,"u":"أَمْ يَقُولُونَ ٱفْتَرَىٰهُ ۖ قُلْ إِنِ ٱفْتَرَيْتُهُۥ فَلَا تَمْلِكُونَ لِى مِنَ ٱللَّهِ شَيْـًٔا ۖ هُوَ أَعْلَمُ بِمَا تُفِيضُونَ فِيهِ ۖ كَفَىٰ بِهِۦ شَهِيدًۢا بَيْنِى وَبَيْنَكُمْ ۖ وَهُوَ ٱلْغَفُورُ ٱلرَّحِيمُ","juz":26,"page":503,"sajdah":false,"w":[{"u":"أَمْ","en":"Or","ur":"یا"},{"u":"يَقُولُونَ","en":"they say","ur":"وہ کہتے ہیں"},{"u":"ٱفْتَرَىٰهُ ۖ","en":"He has invented it","ur":"کہ اس نے گھڑ لیا ہے اس کو"},{"u":"قُلْ","en":"Say","ur":"کہہ دیجیے"},{"u":"إِنِ","en":"If","ur":"اگر"},{"u":"ٱفْتَرَيْتُهُۥ","en":"I have invented it","ur":"میں نے گھڑ لیا ہے اس کو"},{"u":"فَلَا","en":"then not","ur":"تو نہیں"},{"u":"تَمْلِكُونَ","en":"you have power","ur":"تم مالک ہوسکتے"},{"u":"لِى","en":"for me","ur":"میرے لیے"},{"u":"مِنَ","en":"against","ur":"سے"},{"u":"ٱللَّهِ","en":"Allah","ur":"اللہ کے مقابلے میں"},{"u":"شَيْـًٔا ۖ","en":"anything","ur":"کسی چیز کے"},{"u":"هُوَ","en":"He","ur":"وہ"},{"u":"أَعْلَمُ","en":"knows best","ur":"خوب جانتا ہے"},{"u":"بِمَا","en":"of what","ur":"ساتھ اس کے جو"},{"u":"تُفِيضُونَ","en":"you utter","ur":"تم پڑحتے ہو۔ تم شروع کرتے ہو۔ تم گھستے ہو۔ تم پلٹتے ہو"},{"u":"فِيهِ ۖ","en":"concerning it","ur":"اس میں"},{"u":"كَفَىٰ","en":"Sufficient is He","ur":"کافی"},{"u":"بِهِۦ","en":"Sufficient is He","ur":"ساتھ اس کے"},{"u":"شَهِيدًۢا","en":"(as) a Witness","ur":"گواہ ہونا"},{"u":"بَيْنِى","en":"between me","ur":"میرے درمیان"},{"u":"وَبَيْنَكُمْ ۖ","en":"and between you","ur":"اور تمہارے درمیان"},{"u":"وَهُوَ","en":"and He","ur":"اور وہ"},{"u":"ٱلْغَفُورُ","en":"(is) the Oft-Forgiving","ur":"غفور"},{"u":"ٱلرَّحِيمُ","en":"the Most Merciful","ur":"رحیم ہے"}]},{"k":"46:9","n":9,"id":4519,"u":"قُلْ مَا كُنتُ بِدْعًا مِّنَ ٱلرُّسُلِ وَمَآ أَدْرِى مَا يُفْعَلُ بِى وَلَا بِكُمْ ۖ إِنْ أَتَّبِعُ إِلَّا مَا يُوحَىٰٓ إِلَىَّ وَمَآ أَنَا۠ إِلَّا نَذِيرٌ مُّبِينٌ","juz":26,"page":503,"sajdah":false,"w":[{"u":"قُلْ","en":"Say","ur":"کہہ دیجیے"},{"u":"مَا","en":"Not","ur":"نہیں"},{"u":"كُنتُ","en":"I a