"en":"for","ur":"طرف"},{"u":"ٱلسَّلْمِ","en":"peace","ur":"صلح کے"},{"u":"وَأَنتُمُ","en":"while you","ur":"اور تم ہی"},{"u":"ٱلْأَعْلَوْنَ","en":"(are) superior","ur":"غالب رہنے والے ہو"},{"u":"وَٱللَّهُ","en":"and Allah","ur":"اور اللہ"},{"u":"مَعَكُمْ","en":"(is) with you","ur":"تمہارے ساتھ ہے"},{"u":"وَلَن","en":"and never","ur":"اور ہرگز نہ"},{"u":"يَتِرَكُمْ","en":"will deprive you","ur":"کمی  کرے گا"},{"u":"أَعْمَـٰلَكُمْ","en":"(of) your deeds","ur":"تمہارے اعمال میں"}]},{"k":"47:36","n":36,"id":4581,"u":"إِنَّمَا ٱلْحَيَوٰةُ ٱلدُّنْيَا لَعِبٌ وَلَهْوٌ ۚ وَإِن تُؤْمِنُوا۟ وَتَتَّقُوا۟ يُؤْتِكُمْ أُجُورَكُمْ وَلَا يَسْـَٔلْكُمْ أَمْوَٰلَكُمْ","juz":26,"page":510,"sajdah":false,"w":[{"u":"إِنَّمَا","en":"Only","ur":"بیشک"},{"u":"ٱلْحَيَوٰةُ","en":"the life","ur":"زندگی"},{"u":"ٱلدُّنْيَا","en":"(of) the world","ur":"دنیا کی"},{"u":"لَعِبٌۭ","en":"(is) play","ur":"کھیل ہے"},{"u":"وَلَهْوٌۭ ۚ","en":"and amusement","ur":"اور تماشا ہے"},{"u":"وَإِن","en":"And if","ur":"اور اگر"},{"u":"تُؤْمِنُوا۟","en":"you believe","ur":"تم ایمان لے آؤ"},{"u":"وَتَتَّقُوا۟","en":"and fear (Allah)","ur":"اور تقوی اختیار کرو"},{"u":"يُؤْتِكُمْ","en":"He will give you","ur":"وہ دے گا تم کو"},{"u":"أُجُورَكُمْ","en":"your rewards","ur":"اجر تمہارے"},{"u":"وَلَا","en":"and not","ur":"اور نہ"},{"u":"يَسْـَٔلْكُمْ","en":"will ask you","ur":"طلب کرے گا تم سے"},{"u":"أَمْوَٰلَكُمْ","en":"(for) your wealth","ur":"مال تمہارے"}]},{"k":"47:37","n":37,"id":4582,"u":"إِن يَسْـَٔلْكُمُوهَا فَيُحْفِكُمْ تَبْخَلُوا۟ وَيُخْرِجْ أَضْغَـٰنَكُمْ","juz":26,"page":510,"sajdah":false,"w":[{"u":"إِن","en":"If","ur":"اگر"},{"u":"يَسْـَٔلْكُمُوهَا","en":"He were to ask you for it","ur":"وہ تم سے مانگ لے ان کو"},{"u":"فَيُحْفِكُمْ","en":"and press you","ur":"پھر تم سے چمٹ جائے۔ تو وہ چمٹ جائے گا تم سے"},{"u":"تَبْخَلُوا۟","en":"you will withhold","ur":"تم عقل کرو گے"},{"u":"وَيُخْرِجْ","en":"and He will bring forth","ur":"اور نکالے گا"},{"u":"أَضْغَـٰنَكُمْ","en":"your hatred","ur":"تمہارے بغض۔ عداوتیں"}]},{"k":"47:38","n":38,"id":4583,"u":"هَـٰٓأَنتُمْ هَـٰٓؤُلَآءِ تُدْعَوْنَ لِتُنفِقُوا۟ فِى سَبِيلِ ٱللَّهِ فَمِنكُم مَّن يَبْخَلُ ۖ وَمَن يَبْخَلْ فَإِنَّمَا يَبْخَلُ عَن نَّفْسِهِۦ ۚ وَٱللَّهُ ٱلْغَنِىُّ وَأَنتُمُ ٱلْفُقَرَآءُ ۚ وَإِن تَتَوَلَّوْا۟ يَسْتَبْدِلْ قَوْمًا غَيْرَكُمْ ثُمَّ لَا يَكُونُوٓا۟ أَمْثَـٰلَكُم","juz":26,"page":510,"sajdah":false,"w":[{"u":"هَـٰٓأَنتُمْ","en":"Here you are ","ur":"یہ تم ہو"},{"u":"هَـٰٓؤُلَآءِ","en":"these","ur":"وہ لوگ"},{"u":"تُدْعَوْنَ","en":"called","ur":"تمہیں پکارا جاتا ہے۔ بلایا جاتا ہے"},{"u":"لِتُنفِقُوا۟","en":"to spend","ur":"کہ تم خرچ کرو"},{"u":"فِى","en":"in","ur":"میں"},{"u":"سَبِيلِ","en":"(the) way","ur":"راستے (میں)"},{"u":"ٱللَّهِ","en":"(of) Allah ","ur":"اللہ کے"},{"u":"فَمِنكُم","en":"but among you","ur":"تو تم میں سے"},{"u":"مَّن","en":"(are some) who","ur":"کوئی ایسا ہے"},{"u":"يَبْخَلُ ۖ","en":"withhold","ur":"جو بخل کرتا ہے"},{"u":"وَمَن","en":"and whoever","ur":"اور جو"},{"u":"يَبْخَلْ","en":"withholds","ur":"بخل کرتا ہے"},{"u":"فَإِنَّمَا","en":"then only","ur":"تو بیشک"},{"u":"يَبْخَلُ","en":"he withholds","ur":"وہ بخل کرتا ہے"},{"u":"عَن","en":"from","ur":"سے"},{"u":"نَّفْسِهِۦ ۚ","en":"himself","ur":"اپنے آپ (سے)"},{"u":"وَٱللَّهُ","en":"But Allah","ur":"اور اللہ"},{"u":"ٱلْغَنِىُّ","en":"(is) Free of need","ur":"بہت غنی ہے"},{"u":"وَأَنتُمُ","en":"while you","ur":"اور تم"},{"u":"ٱلْفُقَرَآءُ ۚ","en":"(are) the needy","ur":"محتاج ہو"},{"u":"وَإِن","en":"And if","ur":"اور اگر"},{"u":"تَتَوَلَّوْا۟","en":"you turn away","ur":"تم منہ موڑو گے"},{"u":"يَسْتَبْدِلْ","en":"He will replace you","ur":"وہ بدل دے گا"},{"u":"قَوْمًا","en":"(with) a people","ur":"ایک قوم کو"},{"u":"غَيْرَكُمْ","en":"other than you","ur":"تمہارے سوا"},{"u":"ثُمَّ","en":"then","ur":"پھر"},{"u":"لَا","en":"not","ur":"نہ"},{"u":"يَكُونُوٓا۟","en":"they will be","ur":"ہوں گے وہ"},{"u":"أَمْثَـٰلَكُم","en":"(the) likes of you","ur":"تم جیسے"}]}]}