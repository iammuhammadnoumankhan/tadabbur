{"n":47,"src":{"text":"qc-text","wbw":"qc-wbw"},"ayahs":[{"k":"47:1","n":1,"id":4546,"u":" ٱلَّذِينَ كَفَرُوا۟ وَصَدُّوا۟ عَن سَبِيلِ ٱللَّهِ أَضَلَّ أَعْمَـٰلَهُمْ","juz":26,"page":507,"sajdah":false,"w":[{"u":"ٱلَّذِينَ","en":"Those who","ur":"وہ لوگ"},{"u":"كَفَرُوا۟","en":"disbelieve","ur":"جنہوں نے کفر کیا"},{"u":"وَصَدُّوا۟","en":"and turn away","ur":"اور روکا"},{"u":"عَن","en":"from","ur":"سے"},{"u":"سَبِيلِ","en":"(the) way of Allah","ur":"راستے (سے)"},{"u":"ٱللَّهِ","en":"(the) way of Allah","ur":"اللہ کے"},{"u":"أَضَلَّ","en":"He will cause to be lost","ur":"ضائع کردیئے (اللہ نے)"},{"u":"أَعْمَـٰلَهُمْ","en":"their deeds","ur":"ان کے اعمال"}]},{"k":"47:2","n":2,"id":4547,"u":"وَٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ وَءَامَنُوا۟ بِمَا نُزِّلَ عَلَىٰ مُحَمَّدٍ وَهُوَ ٱلْحَقُّ مِن رَّبِّهِمْ ۙ كَفَّرَ عَنْهُمْ سَيِّـَٔاتِهِمْ وَأَصْلَحَ بَالَهُمْ","juz":26,"page":507,"sajdah":false,"w":[{"u":"وَٱلَّذِينَ","en":"And those who","ur":"اور وہ لوگ"},{"u":"ءَامَنُوا۟","en":"believe","ur":"جو ایمان لائے"},{"u":"وَعَمِلُوا۟","en":"and do","ur":"اور انہوں نے  عمل کیے"},{"u":"ٱلصَّـٰلِحَـٰتِ","en":"righteous deeds","ur":"اچھے"},{"u":"وَءَامَنُوا۟","en":"and believe","ur":"اور وہ ایمان لائے"},{"u":"بِمَا","en":"in what","ur":"ساتھ اس کے جو"},{"u":"نُزِّلَ","en":"is revealed","ur":"نازل کیا گیا"},{"u":"عَلَىٰ","en":"to","ur":"پر"},{"u":"مُحَمَّدٍۢ","en":"Muhammad","ur":"محمد (صلی اللہ علیہ وآلہ وسلم)"},{"u":"وَهُوَ","en":"and it","ur":"اور وہ"},{"u":"ٱلْحَقُّ","en":"(is) the truth","ur":"حق ہے"},{"u":"مِن","en":"from","ur":"سے"},{"u":"رَّبِّهِمْ ۙ","en":"their Lord","ur":"ان کے رب کی طرف (سے)"},{"u":"كَفَّرَ","en":"He will remove","ur":"اس نے دور کردیں"},{"u":"عَنْهُمْ","en":"from them","ur":"ان سے"},{"u":"سَيِّـَٔاتِهِمْ","en":"their misdeeds","ur":"ان کی برائیاں"},{"u":"وَأَصْلَحَ","en":"and improve","ur":"اور درست کردیا"},{"u":"بَالَهُمْ","en":"their condition","ur":"ان کا حال"}]},{"k":"47:3","n":3,"id":4548,"u":"ذَٰلِكَ بِأَنَّ ٱلَّذِينَ كَفَرُوا۟ ٱتَّبَعُوا۟ ٱلْبَـٰطِلَ وَأَنَّ ٱلَّذِينَ ءَامَنُوا۟ ٱتَّبَعُوا۟ ٱلْحَقَّ مِن رَّبِّهِمْ ۚ كَذَٰلِكَ يَضْرِبُ ٱللَّهُ لِلنَّاسِ أَمْثَـٰلَهُمْ","juz":26,"page":507,"sajdah":false,"w":[{"u":"ذَٰلِكَ","en":"That","ur":"یہ"},{"u":"بِأَنَّ","en":"(is) because","ur":"بوجہ اس کے کہ بیشک"},{"u":"ٱلَّذِينَ","en":"those who","ur":"وہ لوگ"},{"u":"كَفَرُوا۟","en":"disbelieve","ur":"جنہوں نے کفر کیا"},{"u":"ٱتَّبَعُوا۟","en":"follow","ur":"انہوں نے پیروی کی"},{"u":"ٱلْبَـٰطِلَ","en":"falsehood","ur":"باطل کی"},{"u":"وَأَنَّ","en":"and that","ur":"اور بیشک"},{"u":"ٱلَّذِينَ","en":"those who","ur":"وہ لوگ"},{"u":"ءَامَنُوا۟","en":"believe","ur":"جو ایمان لائے"},{"u":"ٱتَّبَعُوا۟","en":"follow","ur":"انہوں نے پیروی کی"},{"u":"ٱلْحَقَّ","en":"(the) truth","ur":"حق کی"},{"u":"مِن","en":"from","ur":"سے"},{"u":"رَّبِّهِمْ ۚ","en":"their Lord","ur":"اپنے رب کی طرف (سے)"},{"u":"كَذَٰلِكَ","en":"Thus","ur":"اسی طرح"},{"u":"يَضْرِبُ","en":"Allah presents","ur":"بیان کرتا ہے"},{"u":"ٱللَّهُ","en":"Allah presents","ur":"اللہ"},{"u":"لِلنَّاسِ","en":"to the people","ur":"لوگوں کے لیے"},{"u":"أَمْثَـٰلَهُمْ","en":"their similitudes","ur":"ان کی مثالیں۔ ان کے حالات"}]},{"k":"47:4","n":4,"id":4549,"u":"فَإِذَا لَقِيتُمُ ٱلَّذِينَ كَفَرُوا۟ فَضَرْبَ ٱلرِّقَابِ حَتَّىٰٓ إِذَآ أَثْخَنتُمُوهُمْ فَشُدُّوا۟ ٱلْوَثَاقَ فَإِمَّا مَنًّۢا بَعْدُ وَإِمَّا فِدَآءً حَتَّىٰ تَضَعَ ٱلْحَرْبُ أَوْزَارَهَا ۚ ذَٰلِكَ وَلَوْ يَشَآءُ ٱللَّهُ لَٱنتَصَرَ مِنْهُمْ وَلَـٰكِن لِّيَبْلُوَا۟ بَعْضَكُم بِبَعْضٍ ۗ وَٱلَّذِينَ قُتِلُوا۟ فِى سَبِيلِ ٱللَّهِ فَلَن يُضِلَّ أَعْمَـٰلَهُمْ","juz":26,"page":507,"sajdah":false,"w":[{"u":"فَإِذَا","en":"So when","ur":"پھر جب"},{"u":"لَقِيتُمُ","en":"you meet","ur":"ملاقات کرو تم"},{"u":"ٱلَّذِينَ","en":"those who","ur":"ان لوگوں سے"},{"u":"كَفَرُوا۟","en":"disbelieve","ur":"جنہوں نے کفر کیا"},{"u":"فَضَرْبَ","en":"then strike","ur":"تو مارنا ہے"},{"u":"ٱلرِّقَابِ","en":"the necks","ur":"گردنوں کا"},{"u":"حَتَّىٰٓ","en":"until","ur":"یہاں تک کہ"},{"u":"إِذَآ","en":"when","ur":"جب"},{"u":"أَثْخَنتُمُوهُمْ","en":"you have subdued them","ur":"خوب سختی کرو تم ان سے۔ خوب خون بہا چکو تم ان کا"},{"u":"فَشُدُّوا۟","en":"then bind firmly","ur":"پھر پکا کرو"},{"u":"ٱلْوَثَاقَ","en":"the bond","ur":"بندھن کو"},{"u":"فَإِمَّا","en":"then either","ur":"پھر خواہ"},{"u":"مَنًّۢا","en":"a favor","ur":"احسان کرو"},{"u":"بَعْدُ","en":"afterwards","ur":"اس کے بعد"},{"u":"وَإِمَّا","en":"or","ur":"اور خواہ"},{"u":"فِدَآءً","en":"ransom","ur":"فدیہ لو"},{"u":"حَتَّىٰ","en":"until","ur":"یہاں تک کہ"},{"u":"تَضَعَ","en":"lays down","ur":"ڈال دے۔ رکھ دے"},{"u":"ٱلْحَرْبُ","en":"the war","ur":"جنگ"},{"u":"أَوْزَارَهَا ۚ","en":"its burdens","ur":"اپنے اوزار۔ ہتھیار"},{"u":"ذَٰلِكَ","en":"That","ur":"یہ بات"},{"u":"وَلَوْ","en":"And if","ur":"اور اگر"},{"u":"يَشَآءُ","en":"Allah had willed","ur":"چاہتا"},{"u":"ٱللَّهُ","en":"Allah had willed","ur":"اللہ"},{"u":"لَٱنتَصَرَ","en":"surely, He could have taken retribution","ur":"البتہ بدلے لے لیتا"},{"u":"مِنْهُمْ","en":"from them","ur":"ان سے"},{"u":"وَلَـٰكِن","en":"but","ur":"لیکن"},{"u":"لِّيَبْلُوَا۟","en":"to test","ur":"تاکہ آزمائے"},{"u":"بَعْضَكُم","en":"some of you","ur":"تم میں سے بعض کو"},{"u":"بِبَعْضٍۢ ۗ","en":"with others","ur":"ساتھ بعض کے"},{"u":"وَٱلَّذِينَ","en":"And those who","ur":"اور وہ لوگ"},{"u":"قُتِلُوا۟","en":"are killed","ur":"جو مارے گئے"},{"u":"فِى","en":"in","ur":"میں"},{"u":"سَبِيلِ","en":"(the) way of Allah","ur":"راستے (میں)"},{"u":"ٱللَّهِ","en":"(the) way of Allah","ur":"اللہ کے"},{"u":"فَلَن","en":"then never","ur":"تو ہرگز نہ"},{"u":"يُضِلَّ","en":"He will cause to be lost","ur":"ضائع کرے گا"},{"u":"أَعْمَـٰلَهُمْ","en":"their deeds","ur":"ان کے اعمال کو"}]},{"k":"47:5","n":5,"id":4550,"u":"سَيَهْدِيهِمْ وَيُصْلِحُ بَالَهُمْ","juz":26,"page":507,"sajdah":false,"w":[{"u":"سَيَهْدِيهِمْ","en":"He will guide them","ur":"عنقریب وہ رہنمائی کرے گا ان کی"},{"u":"وَيُصْلِحُ","en":"and improve","ur":"اور اصلاح کردے گا"},{"u":"بَالَهُمْ","en":"their condition","ur":"ان کے حال کی"}]},{"k":"47:6","n":6,"id":4551,"u":"وَيُدْخِلُهُمُ ٱلْجَنَّةَ عَرَّفَهَا لَهُمْ","juz":26,"page":507,"sajdah":false,"w":[{"u":"وَيُدْخِلُهُمُ","en":"And admit them","ur":"اور داخل کرے گا ان کو"},{"u":"ٱلْجَنَّةَ","en":"(to) Paradise","ur":"جنت میں"},{"u":"عَرَّفَهَا","en":"He has made it known","ur":"پہچان کرا دی اس کی۔ تعریف کردی اس کی"},{"u":"لَهُمْ","en":"to them","ur":"ان کے لیے"}]},{"k":"47:7","n":7,"id":4552,"u":"يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓا۟ إِن تَنصُرُوا۟ ٱللَّهَ يَنصُرْكُمْ وَيُثَبِّتْ أَقْدَامَكُمْ","juz":26,"page":507,"sajdah":false,"w":[{"u":"يَـٰٓأَيُّهَا","en":"O you who believe","ur":"اے"},{"u":"ٱلَّذِينَ","en":"O you who believe","ur":"لوگو"},{"u":"ءَامَنُوٓا۟","en":"O you who believe","ur":"جو ایمان لائے ہو"},{"u":"إِن","en":"If","ur":"اگر"},{"u":"تَنصُرُوا۟","en":"you help","ur":"تم مدد کرو گے"},{"u":"ٱللَّهَ","en":"Allah","ur":"اللہ کی"},{"u":"يَنصُرْكُمْ","en":"He will help you","ur":"وہ مدد کرے گا تمہاری"},{"u":"وَيُثَبِّتْ","en":"and make firm","ur":"اور جمادے گا"},{"u":"أَقْدَامَكُمْ","en":"your feet","ur":"تمہارے قدموں کو"}]},{"k":"47:8","n":8,"id":4553,"u":"وَٱلَّذِينَ كَفَرُوا۟ فَتَعْسًا لَّهُمْ وَأَضَلَّ أَعْمَـٰلَهُمْ","juz":26,"page":507,"sajdah":false,"w":[{"u":"وَٱلَّذِينَ","en":"But those who","ur":"اور وہ لوگ"},{"u":"كَفَرُوا۟","en":"disbelieve","ur":"جنہوں نے کفر کیا"},{"u":"فَتَعْسًۭا","en":"destruction (is)","ur":"پس تباہی ہے"},{"u":"لَّهُمْ","en":"for them","ur":"ان کے لیے"},{"u":"وَأَضَلَّ","en":"and He will cause to be lost","ur":"اور اس نے بھٹکا دیا"},{"u":"أَعْمَـٰلَهُمْ","en":"their deeds","ur":"ان کے اعمال کو"}]},{"k":"47:9","n":9,"id":4554,"u":"ذَٰلِكَ بِأَنَّهُمْ كَرِهُوا۟ مَآ أَنزَلَ ٱللَّهُ فَأَحْبَطَ أَعْمَـٰلَهُمْ","juz":26,"page":507,"sajdah":false,"w":[{"u":"ذَٰلِكَ","en":"That","ur":"یہ"},{"u":"بِأَنَّهُمْ","en":"(is) because they","ur":"بات بوجہ اس کے کہ بیشک"},{"u":"كَرِهُوا۟","en":"hate","ur":"انہوں نے ناپسند کیا"},{"u":"مَآ","en":"what","ur":"جو"},{"u":"أَنزَلَ","en":"Allah has revealed","ur":"نازل فرمایا"},{"u":"ٱللَّهُ","en":"Allah has revealed","ur":"اللہ نے"},{"u":"فَأَحْبَطَ","en":"so He has made worthless","ur":"تو اس نے ضائع کردیئے"},{"u":"أَعْمَـٰلَهُمْ","en":"their deeds","ur":"ان کے اعمال"}]},{"k":"47:10","n":10,"id":4555,"u":"۞ أَفَلَمْ يَسِيرُوا۟ فِى ٱلْأَرْضِ فَيَنظُرُوا۟ كَيْفَ كَانَ عَـٰقِبَةُ ٱلَّذِينَ مِن قَبْلِهِمْ ۚ دَمَّرَ ٱللَّهُ عَلَيْهِمْ ۖ وَلِلْكَـٰفِرِينَ أَمْثَـٰلُهَا","juz":26,"page":507,"sajdah":false,"w":[{"u":"۞ أَفَلَمْ","en":"Do not","ur":"کیا پھر نہیں"},{"u":"يَسِيرُوا۟","en":"they travel","ur":"وہ چلے پھرے"},{"u":"فِى","en":"in","ur":"میں"},{"u":"ٱلْأَرْضِ","en":"the earth","ur":"زمین (میں)"},{"u":"فَيَنظُرُوا۟","en":"and see","ur":"تو وہ دیکھتے"},{"u":"كَيْفَ","en":"how","ur":"کس طرح"},{"u":"كَانَ","en":"was","ur":"ہوا"},{"u":"عَـٰقِبَةُ","en":"(the) end","ur":"انجام"},{"u":"ٱلَّذِينَ","en":"(of) those","ur":"ان لوگوں کا"},{"u":"مِن","en":"before them","ur":"سے"},{"u":"قَبْلِهِمْ ۚ","en":"before them","ur":"جو ان سے پہلے تھے"},{"u":"دَمَّرَ","en":"Allah destroyed","ur":"ہلاکت ڈالی"},{"u":"ٱللَّهُ","en":"Allah destroyed","ur":"اللہ نے"},{"u":"عَلَيْهِمْ ۖ","en":"[over] them","ur":"ان پر"},{"u":"وَلِلْكَـٰفِرِينَ","en":"and for the disbelievers","ur":"اور کافروں کے لیے"},{"u":"أَمْثَـٰلُهَا","en":"its likeness","ur":"اس کی مثالیں ہیں"}]},{"k":"47:11","n":11,"id":4556,"u":"ذَٰلِكَ بِأَنَّ ٱللَّهَ مَوْلَى ٱلَّذِينَ ءَامَنُوا۟ وَأَنَّ ٱلْكَـٰفِرِينَ لَا مَوْلَىٰ لَهُمْ","juz":26,"page":507,"sajdah":false,"w":[{"u":"ذَٰلِكَ","en":"That","ur":"یہ"},{"u":"بِأَنَّ","en":"(is) because","ur":"بوجہ اس کے کہ بیشک"},{"u":"ٱللَّهَ","en":"Allah","ur":"اللہ تعالیٰ"},{"u":"مَوْلَى","en":"(is the) Protector","ur":"سرپرست ہے"},{"u":"ٱلَّذِينَ","en":"(of) those who","ur":"ان لوگوں کا"},{"u":"ءَامَنُوا۟","en":"believe","ur":"جو ایمان لائے"},{"u":"وَأَنَّ","en":"and that","ur":"اور بیشک"},{"u":"ٱلْكَـٰفِرِينَ","en":"the disbelievers ","ur":"کافر لوگ"},{"u":"لَا","en":"(there is) no","ur":"نہیں"},{"u":"مَوْلَىٰ","en":"protector","ur":"کوئی مددگار"},{"u":"لَهُمْ","en":"