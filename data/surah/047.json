,"w":[{"u":"وَلَنَبْلُوَنَّكُمْ","en":"And surely We will test you","ur":"اور البتہ ہم ضرور آزمائیں گے تم کو"},{"u":"حَتَّىٰ","en":"until","ur":"یہاں تک کہ"},{"u":"نَعْلَمَ","en":"We make evident","ur":"ہم جان لیں"},{"u":"ٱلْمُجَـٰهِدِينَ","en":"those who strive","ur":"مجاہدوں کو"},{"u":"مِنكُمْ","en":"among you","ur":"تم میں سے"},{"u":"وَٱلصَّـٰبِرِينَ","en":"and the patient ones","ur":"اور صبر کرنے والوں کو"},{"u":"وَنَبْلُوَا۟","en":"and We will test","ur":"اور ہم آزمائیں"},{"u":"أَخْبَارَكُمْ","en":"your affairs","ur":"تمہاری خبروں کو۔ حالات کو"}]},{"k":"47:32","n":32,"id":4577,"u":"إِنَّ ٱلَّذِينَ كَفَرُوا۟ وَصَدُّوا۟ عَن سَبِيلِ ٱللَّهِ وَشَآقُّوا۟ ٱلرَّسُولَ مِنۢ بَعْدِ مَا تَبَيَّنَ لَهُمُ ٱلْهُدَىٰ لَن يَضُرُّوا۟ ٱللَّهَ شَيْـًٔا وَسَيُحْبِطُ أَعْمَـٰلَهُمْ","juz":26,"page":510,"sajdah":false,"w":[{"u":"إِنَّ","en":"Indeed","ur":"بیشک"},{"u":"ٱلَّذِينَ","en":"those who","ur":"وہ لوگ"},{"u":"كَفَرُوا۟","en":"disbelieve","ur":"جنہوں نے کفر کیا"},{"u":"وَصَدُّوا۟","en":"and turn away","ur":"اور انہوں نے روکا"},{"u":"عَن","en":"from","ur":"سے"},{"u":"سَبِيلِ","en":"(the) way of Allah","ur":"راستے (سے)"},{"u":"ٱللَّهِ","en":"(the) way of Allah","ur":"اللہ کے"},{"u":"وَشَآقُّوا۟","en":"and oppose","ur":"اور انہوں نے مخالفت کی"},{"u":"ٱلرَّسُولَ","en":"the Messenger","ur":"رسول کی"},{"u":"مِنۢ","en":"after","ur":"کے"},{"u":"بَعْدِ","en":"after","ur":"اس کے بعد"},{"u":"مَا","en":"[what]","ur":"کہ"},{"u":"تَبَيَّنَ","en":"(has been) made clear","ur":"واضح ہوچکی"},{"u":"لَهُمُ","en":"to them","ur":"ان کے لیے"},{"u":"ٱلْهُدَىٰ","en":"the guidance","ur":"ہدایت"},{"u":"لَن","en":"never","ur":"ہرگز نہیں"},{"u":"يَضُرُّوا۟","en":"will they harm","ur":"نقصان پہنچا سکتے"},{"u":"ٱللَّهَ","en":"Allah","ur":"اللہ کو"},{"u":"شَيْـًۭٔا","en":"(in) anything","ur":"کچھ بھی"},{"u":"وَسَيُحْبِطُ","en":"and He will make worthless","ur":"اور عنقریب وہ ضائع کرے گا"},{"u":"أَعْمَـٰلَهُمْ","en":"their deeds","ur":"ان کے اعمال"}]},{"k":"47:33","n":33,"id":4578,"u":"۞ يَـٰٓأَيُّهَا ٱلَّذ