َهَ فَسَيُؤْتِيهِ أَجْرًا عَظِيمًا","juz":26,"page":512,"sajdah":false,"w":[{"u":"إِنَّ","en":"Indeed","ur":"بیشک"},{"u":"ٱلَّذِينَ","en":"those who","ur":"وہ لوگ"},{"u":"يُبَايِعُونَكَ","en":"pledge allegiance to you","ur":"جنہوں نے بیعت کی آپ کی۔ جو بیعت کر رہے ہیں آپ کی"},{"u":"إِنَّمَا","en":"only","ur":"بیشک"},{"u":"يُبَايِعُونَ","en":"they pledge allegiance","ur":"وہ بیعت کر رہے ہیں۔ انہوں نے بیعت کی"},{"u":"ٱللَّهَ","en":"(to) Allah","ur":"اللہ سے"},{"u":"يَدُ","en":"(The) Hand","ur":"ہاتھ تھا"},{"u":"ٱللَّهِ","en":"(of) Allah","ur":"اللہ کا"},{"u":"فَوْقَ","en":"(is) over","ur":"اوپر ہے"},{"u":"أَيْدِيهِمْ ۚ","en":"their hands","ur":"ان کے ہاتھ پر"},{"u":"فَمَن","en":"Then whoever","ur":"تو جو کوئی"},{"u":"نَّكَثَ","en":"breaks (his oath)","ur":"توڑ دے"},{"u":"فَإِنَّمَا","en":"then only","ur":"تو بیشک"},{"u":"يَنكُثُ","en":"he breaks","ur":"وہ توڑتا ہے"},{"u":"عَلَىٰ","en":"against","ur":"پر"},{"u":"نَفْسِهِۦ ۖ","en":"himself","ur":"اپنے نفس"},{"u":"وَمَنْ","en":"and whoever","ur":"اور جو کوئی"},{"u":"أَوْفَىٰ","en":"fulfils","ur":"پورا کرے"},{"u":"بِمَا","en":"what","ur":"اس کو جو"},{"u":"عَـٰهَدَ","en":"he has covenanted","ur":"اس نے عہد کیا"},{"u":"عَلَيْهُ","en":"(with)","ur":"اس پر"},{"u":"ٱللَّهَ","en":"Allah","ur":"اللہ سے"},{"u":"فَسَيُؤْتِيهِ","en":"soon He will give him","ur":"تو عنقریب وہ دے گا اس کو"},{"u":"أَجْرًا","en":"a reward","ur":"اجر"},{"u":"عَظِيمًۭا","en":"great","ur":"عظیم"}]},{"k":"48:11","n":11,"id":4594,"u":"سَيَقُولُ لَكَ ٱلْمُخَلَّفُونَ مِنَ ٱلْأَعْرَابِ شَغَلَتْنَآ أَمْوَٰلُنَا وَأَهْلُونَا فَٱسْتَغْفِرْ لَنَا ۚ يَقُولُونَ بِأَلْسِنَتِهِم مَّا لَيْسَ فِى قُلُوبِهِمْ ۚ قُلْ فَمَن يَمْلِكُ لَكُم مِّنَ ٱللَّهِ شَيْـًٔا إِنْ أَرَادَ بِكُمْ ضَرًّا أَوْ أَرَادَ بِكُمْ نَفْعًۢا ۚ بَلْ كَانَ ٱللَّهُ بِمَا تَعْمَلُونَ خَبِيرًۢا","juz":26,"page":512,"sajdah":false,"w":[{"u":"سَيَقُولُ","en":"Will say","ur":"عنقریب کہیں گے"},{"u":"لَكَ","en":"to you","ur":"آپ کو"},{"u":"ٱلْمُخَلَّفُونَ","en":"those who remained behind","ur":"پیچھے چھوڑے ج