","ur":"سے"},{"u":"ٱللَّهِ","en":"from Allah","ur":"اللہ کی طرف (سے)"},{"u":"وَرِضْوَٰنًۭا ۖ","en":"and pleasure","ur":"اور رضامندی کو"},{"u":"سِيمَاهُمْ","en":"Their mark","ur":"ان کی علامتیں"},{"u":"فِى","en":"(is) on","ur":"میں"},{"u":"وُجُوهِهِم","en":"their faces","ur":"ان کے چہروں میں ہیں"},{"u":"مِّنْ","en":"from","ur":"سے"},{"u":"أَثَرِ","en":"(the) trace","ur":"نشان (سے)"},{"u":"ٱلسُّجُودِ ۚ","en":"(of) the prostration","ur":"سجدوں کے"},{"u":"ذَٰلِكَ","en":"That","ur":"یہ"},{"u":"مَثَلُهُمْ","en":"(is) their similitude","ur":"ان کی مثال ہے"},{"u":"فِى","en":"in","ur":"میں"},{"u":"ٱلتَّوْرَىٰةِ ۚ","en":"the Taurah","ur":"تورات (میں)"},{"u":"وَمَثَلُهُمْ","en":"And their similitude","ur":"اور ان کی مثال"},{"u":"فِى","en":"in","ur":"میں"},{"u":"ٱلْإِنجِيلِ","en":"the Injeel","ur":"انجیل (میں)"},{"u":"كَزَرْعٍ","en":"(is) like a seed","ur":"مانند ایک کھیتی کے"},{"u":"أَخْرَجَ","en":"(which) sends forth","ur":"جس نے نکالی"},{"u":"شَطْـَٔهُۥ","en":"its shoot","ur":"اپنی کونپل"},{"u":"فَـَٔازَرَهُۥ","en":"then strengthens it","ur":"پھر تقویت دی اس کو"},{"u":"فَٱسْتَغْلَظَ","en":"then it becomes thick","ur":"پھر وہ سخت ہوئی"},{"u":"فَٱسْتَوَىٰ","en":"and it stands","ur":"پھر کھڑی ہوگئی"},{"u":"عَلَىٰ","en":"upon","ur":"پر"},{"u":"سُوقِهِۦ","en":"its stem","ur":"اپنے تنے  (پر)"},{"u":"يُعْجِبُ","en":"delighting","ur":"خوش کرتی ہے"},{"u":"ٱلزُّرَّاعَ","en":"the sowers","ur":"کاشت کاروں کو"},{"u":"لِيَغِيظَ","en":"that He (may) enrage","ur":"تاکہ غضب ناک کرے"},{"u":"بِهِمُ","en":"by them","ur":"ساتھ ان کے"},{"u":"ٱلْكُفَّارَ ۗ","en":"the disbelievers","ur":"کافروں کو"},{"u":"وَعَدَ","en":"Allah has promised","ur":"وعدہ کیا"},{"u":"ٱللَّهُ","en":"Allah has promised","ur":"اللہ نے"},{"u":"ٱلَّذِينَ","en":"those who","ur":"ان لوگوں سے"},{"u":"ءَامَنُوا۟","en":"believe","ur":"جو ایمان لائے"},{"u":"وَعَمِلُوا۟","en":"and do","ur":"اور انہوں نے  کام کیے"},{"u":"ٱلصَّـٰلِحَـٰتِ","en":"righteous deeds","ur":"اچھے"},{"u":"مِنْهُم","en":"among them","ur":"ان میں سے"},{"u":"مَّغ