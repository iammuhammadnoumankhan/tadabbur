:[{"u":"وَلِلَّهِ","en":"And for Allah","ur":"اور اللہ ہی کے لیے ہے"},{"u":"مُلْكُ","en":"(is the) kingdom","ur":"بادشاہت"},{"u":"ٱلسَّمَـٰوَٰتِ","en":"(of) the heavens","ur":"آسمانوں کی"},{"u":"وَٱلْأَرْضِ ۚ","en":"and the earth","ur":"اور زمین کی"},{"u":"يَغْفِرُ","en":"He forgives","ur":"بخش دے گا"},{"u":"لِمَن","en":"whom","ur":"جس کو"},{"u":"يَشَآءُ","en":"He wills","ur":"وہ چاہے گا"},{"u":"وَيُعَذِّبُ","en":"and punishes","ur":"اور عذاب دے گا"},{"u":"مَن","en":"whom","ur":"جس کو"},{"u":"يَشَآءُ ۚ","en":"He wills","ur":"وہ چاہے گا"},{"u":"وَكَانَ","en":"And is","ur":"اور ہے"},{"u":"ٱللَّهُ","en":"Allah","ur":"اللہ تعالیٰ"},{"u":"غَفُورًۭا","en":"Oft-Forgiving","ur":"غفور"},{"u":"رَّحِيمًۭا","en":"Most Merciful","ur":"رحیم"}]},{"k":"48:15","n":15,"id":4598,"u":"سَيَقُولُ ٱلْمُخَلَّفُونَ إِذَا ٱنطَلَقْتُمْ إِلَىٰ مَغَانِمَ لِتَأْخُذُوهَا ذَرُونَا نَتَّبِعْكُمْ ۖ يُرِيدُونَ أَن يُبَدِّلُوا۟ كَلَـٰمَ ٱللَّهِ ۚ قُل لَّن تَتَّبِعُونَا كَذَٰلِكُمْ قَالَ ٱللَّهُ مِن قَبْلُ ۖ فَسَيَقُولُونَ بَلْ تَحْسُدُونَنَا ۚ بَلْ كَانُوا۟ لَا يَفْقَهُونَ إِلَّا قَلِيلًا","juz":26,"page":512,"sajdah":false,"w":[{"u":"سَيَقُولُ","en":"Will say","ur":"عنقریب وہ کہیں گے"},{"u":"ٱلْمُخَلَّفُونَ","en":"those who remained behind","ur":"پیچھے چھوڑے جانے والے۔ رہ جانے والے"},{"u":"إِذَا","en":"when","ur":"جب"},{"u":"ٱنطَلَقْتُمْ","en":"you set forth","ur":"چلو گے تم"},{"u":"إِلَىٰ","en":"towards","ur":"طرف"},{"u":"مَغَانِمَ","en":"(the) spoils of war","ur":"غنیمتوں کے"},{"u":"لِتَأْخُذُوهَا","en":"to take it","ur":"تاکہ تم لے سکو ان کو"},{"u":"ذَرُونَا","en":"Allow us","ur":"چھوڑ دو ہم کو"},{"u":"نَتَّبِعْكُمْ ۖ","en":"(to) follow you","ur":"ہم پیروی کریں تمہاری"},{"u":"يُرِيدُونَ","en":"They wish","ur":"وہ چاہتے ہیں"},{"u":"أَن","en":"to","ur":"کہ"},{"u":"يُبَدِّلُوا۟","en":"change","ur":"وہ بدل ڈالیں"},{"u":"كَلَـٰمَ","en":"(the) Words","ur":"کلام"},{"u":"ٱللَّهِ ۚ","en":"(of) Allah","ur":"اللہ کا"},{"u":"قُل","en":"Say","ur":"کہہ دیجیے"},{"u":"لَّن","en":"Never","ur":"ہرگز نہیں"},{"u":"