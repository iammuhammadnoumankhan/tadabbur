{"n":48,"src":{"text":"qc-text","wbw":"qc-wbw"},"ayahs":[{"k":"48:1","n":1,"id":4584,"u":" إِنَّا فَتَحْنَا لَكَ فَتْحًا مُّبِينًا","juz":26,"page":511,"sajdah":false,"w":[{"u":"إِنَّا","en":"Indeed","ur":"بیشک ہم نے"},{"u":"فَتَحْنَا","en":"We have given victory","ur":"فتح عطا کی ہم نے"},{"u":"لَكَ","en":"to you","ur":"آپ کو"},{"u":"فَتْحًۭا","en":"a victory","ur":"فتح"},{"u":"مُّبِينًۭا","en":"clear","ur":"کھلی"}]},{"k":"48:2","n":2,"id":4585,"u":"لِّيَغْفِرَ لَكَ ٱللَّهُ مَا تَقَدَّمَ مِن ذَنۢبِكَ وَمَا تَأَخَّرَ وَيُتِمَّ نِعْمَتَهُۥ عَلَيْكَ وَيَهْدِيَكَ صِرَٰطًا مُّسْتَقِيمًا","juz":26,"page":511,"sajdah":false,"w":[{"u":"لِّيَغْفِرَ","en":"That may forgive","ur":"تاکہ درگزر فرمائے"},{"u":"لَكَ","en":"for you","ur":"آپ کے لیے"},{"u":"ٱللَّهُ","en":"Allah","ur":"اللہ"},{"u":"مَا","en":"what","ur":"جو"},{"u":"تَقَدَّمَ","en":"preceded","ur":"پہلے ہوچکا"},{"u":"مِن","en":"of","ur":"سے"},{"u":"ذَنۢبِكَ","en":"your sins","ur":"آپ کے قصور میں (سے)"},{"u":"وَمَا","en":"and what","ur":"اور جو"},{"u":"تَأَخَّرَ","en":"will follow","ur":"بعد میں ہوا"},{"u":"وَيُتِمَّ","en":"and complete","ur":"اور پورا کردے"},{"u":"نِعْمَتَهُۥ","en":"His favor","ur":"اپنی نعمت کو"},{"u":"عَلَيْكَ","en":"upon you","ur":"آپ پر"},{"u":"وَيَهْدِيَكَ","en":"and guide you","ur":"اور رہنمائی کرے آپ کی"},{"u":"صِرَٰطًۭا","en":"(to) a Path","ur":"راستے کی طرف"},{"u":"مُّسْتَقِيمًۭا","en":"Straight","ur":"سیدھے"}]},{"k":"48:3","n":3,"id":4586,"u":"وَيَنصُرَكَ ٱللَّهُ نَصْرًا عَزِيزًا","juz":26,"page":511,"sajdah":false,"w":[{"u":"وَيَنصُرَكَ","en":"And Allah may help you","ur":"اور مدد فرمائے آپ کی"},{"u":"ٱللَّهُ","en":"And Allah may help you","ur":"اللہ تعالیٰ"},{"u":"نَصْرًا","en":"(with) a help","ur":"مدد"},{"u":"عَزِيزًا","en":"mighty","ur":"زبردست"}]},{"k":"48:4","n":4,"id":4587,"u":"هُوَ ٱلَّذِىٓ أَنزَلَ ٱلسَّكِينَةَ فِى قُلُوبِ ٱلْمُؤْمِنِينَ لِيَزْدَادُوٓا۟ إِيمَـٰنًا مَّعَ إِيمَـٰنِهِمْ ۗ وَلِلَّهِ جُنُودُ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۚ وَكَانَ ٱللَّهُ عَلِيمًا حَكِيمًا","juz":26,"page":511,"sajdah":false,"w":[{"u":"هُوَ","en":"He","ur":"وہ اللہ"},{"u":"ٱلَّذِىٓ","en":"(is) the One Who","ur":"وہ ذات ہے"},{"u":"أَنزَلَ","en":"sent down","ur":"جس نے نازل کی"},{"u":"ٱلسَّكِينَةَ","en":"[the] tranquility","ur":"سکینت"},{"u":"فِى","en":"in(to)","ur":"میں"},{"u":"قُلُوبِ","en":"(the) hearts","ur":"دلوں"},{"u":"ٱلْمُؤْمِنِينَ","en":"(of) the believers","ur":"مومنوں کے"},{"u":"لِيَزْدَادُوٓا۟","en":"that they may increase","ur":"تاکہ وہ بڑھ جائیں"},{"u":"إِيمَـٰنًۭا","en":"(in) faith","ur":"ایمان میں"},{"u":"مَّعَ","en":"with","ur":"ساتھ"},{"u":"إِيمَـٰنِهِمْ ۗ","en":"their faith","ur":"اپنے ایمان کے"},{"u":"وَلِلَّهِ","en":"And for Allah","ur":"اور اللہ ہی کے لیے ہیں"},{"u":"جُنُودُ","en":"(are the) hosts","ur":"لشکر"},{"u":"ٱلسَّمَـٰوَٰتِ","en":"(of) the heavens","ur":"آسمانوں کے"},{"u":"وَٱلْأَرْضِ ۚ","en":"and the earth","ur":"اور زمین کے"},{"u":"وَكَانَ","en":"and Allah","ur":"اور ہے"},{"u":"ٱللَّهُ","en":"and Allah","ur":"اللہ تعالیٰ"},{"u":"عَلِيمًا","en":"(is) All-Knower","ur":"علم والا"},{"u":"حَكِيمًۭا","en":"All-Wise","ur":"حکمت والا"}]},{"k":"48:5","n":5,"id":4588,"u":"لِّيُدْخِلَ ٱلْمُؤْمِنِينَ وَٱلْمُؤْمِنَـٰتِ جَنَّـٰتٍ تَجْرِى مِن تَحْتِهَا ٱلْأَنْهَـٰرُ خَـٰلِدِينَ فِيهَا وَيُكَفِّرَ عَنْهُمْ سَيِّـَٔاتِهِمْ ۚ وَكَانَ ذَٰلِكَ عِندَ ٱللَّهِ فَوْزًا عَظِيمًا","juz":26,"page":511,"sajdah":false,"w":[{"u":"لِّيُدْخِلَ","en":"That He may admit","ur":"تاکہ داخل کرے"},{"u":"ٱلْمُؤْمِنِينَ","en":"the believing men","ur":"مومن مردوں کو"},{"u":"وَٱلْمُؤْمِنَـٰتِ","en":"and the believing women","ur":"اور مومن عورتوں کو"},{"u":"جَنَّـٰتٍۢ","en":"(to) Gardens","ur":"باغوں میں"},{"u":"تَجْرِى","en":"flow","ur":"بہتی ہیں"},{"u":"مِن","en":"from","ur":"سے"},{"u":"تَحْتِهَا","en":"underneath them","ur":"ان کے نیچے (سے)"},{"u":"ٱلْأَنْهَـٰرُ","en":"the rivers","ur":"نہریں"},{"u":"خَـٰلِدِينَ","en":"(to) abide forever","ur":"ہمیشہ رہنے والے ہیں"},{"u":"فِيهَا","en":"therein","ur":"اس میں"},{"u":"وَيُكَفِّرَ","en":"and (to) remove","ur":"اور دور کردے"},{"u":"عَنْهُمْ","en":"from them","ur":"ان سے"},{"u":"سَيِّـَٔاتِهِمْ ۚ","en":"their misdeeds","ur":"ان کی برائیاں"},{"u":"وَكَانَ","en":"and is","ur":"اور ہے"},{"u":"ذَٰلِكَ","en":"that","ur":"یہ"},{"u":"عِندَ","en":"with","ur":"نزدیک"},{"u":"ٱللَّهِ","en":"Allah","ur":"اللہ کے"},{"u":"فَوْزًا","en":"a success","ur":"کامیابی"},{"u":"عَظِيمًۭا","en":"great","ur":"بڑی"}]},{"k":"48:6","n":6,"id":4589,"u":"وَيُعَذِّبَ ٱلْمُنَـٰفِقِينَ وَٱلْمُنَـٰفِقَـٰتِ وَٱلْمُشْرِكِينَ وَٱلْمُشْرِكَـٰتِ ٱلظَّآنِّينَ بِٱللَّهِ ظَنَّ ٱلسَّوْءِ ۚ عَلَيْهِمْ دَآئِرَةُ ٱلسَّوْءِ ۖ وَغَضِبَ ٱللَّهُ عَلَيْهِمْ وَلَعَنَهُمْ وَأَعَدَّ لَهُمْ جَهَنَّمَ ۖ وَسَآءَتْ مَصِيرًا","juz":26,"page":511,"sajdah":false,"w":[{"u":"وَيُعَذِّبَ","en":"And He (may) punish","ur":"اور عذاب دے"},{"u":"ٱلْمُنَـٰفِقِينَ","en":"the hypocrite men","ur":"منافقوں کو"},{"u":"وَٱلْمُنَـٰفِقَـٰتِ","en":"and the hypocrite women","ur":"اور منافق عورتوں کو"},{"u":"وَٱلْمُشْرِكِينَ","en":"and the polytheist men","ur":"اور مشرک مردوں کو"},{"u":"وَٱلْمُشْرِكَـٰتِ","en":"and the polytheist women","ur":"اور مشرک عورتوں کو"},{"u":"ٱلظَّآنِّينَ","en":"who assume","ur":"جو گمان کرنے والے ہیں"},{"u":"بِٱللَّهِ","en":"about Allah","ur":"اللہ کے بارے میں"},{"u":"ظَنَّ","en":"an assumption","ur":"گمان"},{"u":"ٱلسَّوْءِ ۚ","en":"evil","ur":"برا"},{"u":"عَلَيْهِمْ","en":"Upon them","ur":"انہی پر"},{"u":"دَآئِرَةُ","en":"(is) a turn","ur":"گردش ہے"},{"u":"ٱلسَّوْءِ ۖ","en":"(of) evil","ur":"بری"},{"u":"وَغَضِبَ","en":"and Allah's wrath (is)","ur":"اور ناراض ہوا"},{"u":"ٱللَّهُ","en":"and Allah's wrath (is)","ur":"اللہ"},{"u":"عَلَيْهِمْ","en":"upon them","ur":"ان پر"},{"u":"وَلَعَنَهُمْ","en":"and He has cursed them","ur":"اور اس نے لعنت کی ان پر"},{"u":"وَأَعَدَّ","en":"and prepared","ur":"اور اس نے تیار کیا"},{"u":"لَهُمْ","en":"for them","ur":"ان کے لیے"},{"u":"جَهَنَّمَ ۖ","en":"Hell","ur":"جہنم"},{"u":"وَسَآءَتْ","en":"and evil","ur":"اور بہت ہی برا ہے"},{"u":"مَصِيرًۭا","en":"(is the) destination","ur":"ٹھکانہ"}]},{"k":"48:7","n":7,"