:"Allah","ur":"اللہ"},{"u":"عَزِيزًا","en":"All-Mighty","ur":"غالب"},{"u":"حَكِيمًۭا","en":"All-Wise","ur":"حکمت والا"}]},{"k":"48:20","n":20,"id":4603,"u":"وَعَدَكُمُ ٱللَّهُ مَغَانِمَ كَثِيرَةً تَأْخُذُونَهَا فَعَجَّلَ لَكُمْ هَـٰذِهِۦ وَكَفَّ أَيْدِىَ ٱلنَّاسِ عَنكُمْ وَلِتَكُونَ ءَايَةً لِّلْمُؤْمِنِينَ وَيَهْدِيَكُمْ صِرَٰطًا مُّسْتَقِيمًا","juz":26,"page":513,"sajdah":false,"w":[{"u":"وَعَدَكُمُ","en":"Allah has promised you","ur":"وعدہ کیا تم سے"},{"u":"ٱللَّهُ","en":"Allah has promised you","ur":"اللہ نے"},{"u":"مَغَانِمَ","en":"spoils of war","ur":"غنیمتوں کا"},{"u":"كَثِيرَةًۭ","en":"much","ur":"بہت سی"},{"u":"تَأْخُذُونَهَا","en":"that you will take it","ur":"تم لو گے ان کو"},{"u":"فَعَجَّلَ","en":"and He has hastened","ur":"تو اس نے جلدی دی"},{"u":"لَكُمْ","en":"for you","ur":"تم کو"},{"u":"هَـٰذِهِۦ","en":"this","ur":"یہ"},{"u":"وَكَفَّ","en":"and has withheld","ur":"اور روک دیا"},{"u":"أَيْدِىَ","en":"(the) hands","ur":"ہاتھوں کو"},{"u":"ٱلنَّاسِ","en":"(of) the people","ur":"لوگوں کے"},{"u":"عَنكُمْ","en":"from you ","ur":"تم سے"},{"u":"وَلِتَكُونَ","en":"that it may be","ur":"اور تاکہ ہوجائے"},{"u":"ءَايَةًۭ","en":"a sign","ur":"ایک نشانی"},{"u":"لِّلْمُؤْمِنِينَ","en":"for the believers","ur":"مومنوں کے لیے"},{"u":"وَيَهْدِيَكُمْ","en":"and He may guide you","ur":"اور ہدایت بخشے تم کو"},{"u":"صِرَٰطًۭا","en":"(to the) Path","ur":"راستے کی"},{"u":"مُّسْتَقِيمًۭا","en":"Straight","ur":"سیدھے"}]},{"k":"48:21","n":21,"id":4604,"u":"وَأُخْرَىٰ لَمْ تَقْدِرُوا۟ عَلَيْهَا قَدْ أَحَاطَ ٱللَّهُ بِهَا ۚ وَكَانَ ٱللَّهُ عَلَىٰ كُلِّ شَىْءٍ قَدِيرًا","juz":26,"page":513,"sajdah":false,"w":[{"u":"وَأُخْرَىٰ","en":"And others","ur":"اور دوسری چیز"},{"u":"لَمْ","en":"not","ur":"نہیں"},{"u":"تَقْدِرُوا۟","en":"you had power","ur":"تم قادر ہوئے"},{"u":"عَلَيْهَا","en":"over them","ur":"اس پر"},{"u":"قَدْ","en":"surely","ur":"تحقیق"},{"u":"أَحَاطَ","en":"Allah encompassed","ur":"گھیر رکھا ہے"},{"u":"ٱللَّهُ","en":"Allah encompassed","ur":"اللہ نے"},{"u":"بِهَا ۚ","en":"them","ur":"اس کو"},{"u":"وَكَانَ","en":"and is","ur":"اور ہے"},{"u":"ٱللَّهُ","en":"Allah","ur":"اللہ"},{"u":"عَلَىٰ","en":"over","ur":"پر"},{"u":"كُلِّ","en":"all","ur":"ہر"},{"u":"شَىْءٍۢ","en":"things","ur":"چیز (پر)"},{"u":"قَدِيرًۭا","en":"All-Powerful","ur":"قدرت رکھنے والا"}]},{"k":"48:22","n":22,"id":4605,"u":"وَلَوْ قَـٰتَلَكُمُ ٱلَّذِينَ كَفَرُوا۟ لَوَلَّوُا۟ ٱلْأَدْبَـٰرَ ثُمَّ لَا يَجِدُونَ وَلِيًّا وَلَا نَصِيرًا","juz":26,"page":513,"sajdah":false,"w":[{"u":"وَلَوْ","en":"And if","ur":"اور اگر"},{"u":"قَـٰتَلَكُمُ","en":"fight you","ur":"جنگ کرتے تم سے"},{"u":"ٱلَّذِينَ","en":"those who","ur":"وہ لوگ"},{"u":"كَفَرُوا۟","en":"disbelieve","ur":"جنہوں نے کفر کیا"},{"u":"لَوَلَّوُا۟","en":"surely they would turn","ur":"البتہ پھیر لیتے"},{"u":"ٱلْأَدْبَـٰرَ","en":"the backs","ur":"پیٹھیں"},{"u":"ثُمَّ","en":"Then","ur":"پھر"},{"u":"لَا","en":"not","ur":"نہ"},{"u":"يَجِدُونَ","en":"they would find","ur":"وہ پاتے"},{"u":"وَلِيًّۭا","en":"any protector","ur":"کوئی دوست"},{"u":"وَلَا","en":"and not","ur":"اور نہ"},{"u":"نَصِيرًۭا","en":"any helper","ur":"کوئی مددگار"}]},{"k":"48:23","n":23,"id":4606,"u":"سُنَّةَ ٱللَّهِ ٱلَّتِى قَدْ خَلَتْ مِن قَبْلُ ۖ وَلَن تَجِدَ لِسُنَّةِ ٱللَّهِ تَبْدِيلًا","juz":26,"page":513,"sajdah":false,"w":[{"u":"سُنَّةَ","en":"(The established) way","ur":"طریقہ"},{"u":"ٱللَّهِ","en":"(of) Allah","ur":"اللہ کا"},{"u":"ٱلَّتِى","en":"which","ur":"وہ جو"},{"u":"قَدْ","en":"passed away","ur":"تحقیق"},{"u":"خَلَتْ","en":"passed away","ur":"گزر چکا"},{"u":"مِن","en":"before","ur":"سے"},{"u":"قَبْلُ ۖ","en":"before","ur":"اس سے پہلے"},{"u":"وَلَن","en":"and never","ur":"اور ہرگز نہ"},{"u":"تَجِدَ","en":"you will find","ur":"تم پاؤ گے"},{"u":"لِسُنَّةِ","en":"in (the) way of Allah","ur":"سنت کو۔ طریقے کو"},{"u":"ٱللَّهِ","en":"in (the) way of Allah","ur":"اللہ کی"},{"u":"تَبْدِيلًۭا","en":"any change","ur":"بدلنے والا"}]},{"k":"48:24","n":24,"id":4607,"u":"وَهُوَ ٱلَّذِى كَفَّ أَيْدِيَهُمْ عَنكُمْ وَأَيْدِيَكُمْ عَنْهُم بِبَطْنِ مَكَّةَ 