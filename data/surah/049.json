{"n":49,"src":{"text":"qc-text","wbw":"qc-wbw"},"ayahs":[{"k":"49:1","n":1,"id":4613,"u":" يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ لَا تُقَدِّمُوا۟ بَيْنَ يَدَىِ ٱللَّهِ وَرَسُولِهِۦ ۖ وَٱتَّقُوا۟ ٱللَّهَ ۚ إِنَّ ٱللَّهَ سَمِيعٌ عَلِيمٌ","juz":26,"page":515,"sajdah":false,"w":[{"u":"يَـٰٓأَيُّهَا","en":"O you who believe","ur":"اے"},{"u":"ٱلَّذِينَ","en":"O you who believe","ur":"لوگو !"},{"u":"ءَامَنُوا۟","en":"O you who believe","ur":"جو ایمان لائے ہو"},{"u":"لَا","en":"(Do) not","ur":"نہ"},{"u":"تُقَدِّمُوا۟","en":"put (yourselves) forward ","ur":"تم پیش قدمی کرو۔  آگے بڑھو"},{"u":"بَيْنَ","en":"before Allah","ur":""},{"u":"يَدَىِ","en":"before Allah","ur":"آگے"},{"u":"ٱللَّهِ","en":"before Allah","ur":"اللہ کے"},{"u":"وَرَسُولِهِۦ ۖ","en":"and His Messenger","ur":"اور اس کے رسول کے"},{"u":"وَٱتَّقُوا۟","en":"and fear Allah","ur":"اور ڈرو"},{"u":"ٱللَّهَ ۚ","en":"and fear Allah","ur":"اللہ سے"},{"u":"إِنَّ","en":"Indeed","ur":"بیشک"},{"u":"ٱللَّهَ","en":"Allah","ur":"اللہ تعالیٰ"},{"u":"سَمِيعٌ","en":"(is) All-Hearer","ur":"سننے والا ہے"},{"u":"عَلِيمٌۭ","en":"All-Knower","ur":"جاننے والا"}]},{"k":"49:2","n":2,"id":4614,"u":"يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ لَا تَرْفَعُوٓا۟ أَصْوَٰتَكُمْ فَوْقَ صَوْتِ ٱلنَّبِىِّ وَلَا تَجْهَرُوا۟ لَهُۥ بِٱلْقَوْلِ كَجَهْرِ بَعْضِكُمْ لِبَعْضٍ أَن تَحْبَطَ أَعْمَـٰلُكُمْ وَأَنتُمْ لَا تَشْعُرُونَ","juz":26,"page":515,"sajdah":false,"w":[{"u":"يَـٰٓأَيُّهَا","en":"O you who believe","ur":"اے"},{"u":"ٱلَّذِينَ","en":"O you who believe","ur":"لوگو"},{"u":"ءَامَنُوا۟","en":"O you who believe","ur":"جو ایمان لائے ہو"},{"u":"لَا","en":"(Do) not","ur":"نہ"},{"u":"تَرْفَعُوٓا۟","en":"raise","ur":"بلند کرو"},{"u":"أَصْوَٰتَكُمْ","en":"your voices","ur":"اپنی آوازوں کو"},{"u":"فَوْقَ","en":"above","ur":"پر"},{"u":"صَوْتِ","en":"(the) voice","ur":"آواز پر"},{"u":"ٱلنَّبِىِّ","en":"(of) the Prophet","ur":"نبی (صلی اللہ علیہ وآلہ وسلم) کی"},{"u":"وَلَا","en":"and (do) not","ur":"اور نہ"},{"u":"تَجْهَرُوا۟","en":"be loud","ur":"بلند کرو"},{"u":"لَ