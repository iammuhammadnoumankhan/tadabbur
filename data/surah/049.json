":"those who","ur":"وہ لوگ"},{"u":"يُنَادُونَكَ","en":"call you","ur":"جو آواز دیتے ہیں آپ کو۔ پکارتے ہیں آپ کو"},{"u":"مِن","en":"from","ur":"سے"},{"u":"وَرَآءِ","en":"behind","ur":"پیچھے۔ آگے سے"},{"u":"ٱلْحُجُرَٰتِ","en":"the private chambers","ur":"حجروں کے"},{"u":"أَكْثَرُهُمْ","en":"most of them","ur":"اکثر ان میں سے"},{"u":"لَا","en":"(do) not","ur":"نہیں"},{"u":"يَعْقِلُونَ","en":"understand","ur":"عقل رکھتے"}]},{"k":"49:5","n":5,"id":4617,"u":"وَلَوْ أَنَّهُمْ صَبَرُوا۟ حَتَّىٰ تَخْرُجَ إِلَيْهِمْ لَكَانَ خَيْرًا لَّهُمْ ۚ وَٱللَّهُ غَفُورٌ رَّحِيمٌ","juz":26,"page":516,"sajdah":false,"w":[{"u":"وَلَوْ","en":"And if","ur":"اور اگر"},{"u":"أَنَّهُمْ","en":"they","ur":"بیشک وہ"},{"u":"صَبَرُوا۟","en":"had been patient","ur":"وہ صبر کریں"},{"u":"حَتَّىٰ","en":"until","ur":"یہاں تک کہ"},{"u":"تَخْرُجَ","en":"you came out","ur":"تم نکلو"},{"u":"إِلَيْهِمْ","en":"to them","ur":"ان کی طرف"},{"u":"لَكَانَ","en":"certainly it would be","ur":"البتہ ہو"},{"u":"خَيْرًۭا","en":"better","ur":"بہتر"},{"u":"لَّهُمْ ۚ","en":"for them","ur":"ان کے لیے"},{"u":"وَٱللَّهُ","en":"And Allah","ur":"اور اللہ"},{"u":"غَفُورٌۭ","en":"(is) Oft-Forgiving","ur":"غفور"},{"u":"رَّحِيمٌۭ","en":"Most Merciful","ur":"رحیم ہے"}]},{"k":"49:6","n":6,"id":4618,"u":"يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓا۟ إِن جَآءَكُمْ فَاسِقٌۢ بِنَبَإٍ فَتَبَيَّنُوٓا۟ أَن تُصِيبُوا۟ قَوْمًۢا بِجَهَـٰلَةٍ فَتُصْبِحُوا۟ عَلَىٰ مَا فَعَلْتُمْ نَـٰدِمِينَ","juz":26,"page":516,"sajdah":false,"w":[{"u":"يَـٰٓأَيُّهَا","en":"O you who believe","ur":"اے"},{"u":"ٱلَّذِينَ","en":"O you who believe","ur":"لوگو !"},{"u":"ءَامَنُوٓا۟","en":"O you who believe","ur":"جو ایمان لائے ہو"},{"u":"إِن","en":"If","ur":"اگر"},{"u":"جَآءَكُمْ","en":"comes to you","ur":"آئے تمہارے پاس"},{"u":"فَاسِقٌۢ","en":"a wicked person","ur":"کوئی فاسق"},{"u":"بِنَبَإٍۢ","en":"with information","ur":"ساتھ ایک خبر کے۔ کسی خبر کے"},{"u":"فَتَبَيَّنُوٓا۟","en":"investigate","ur":"تو تحقیق کرلیا کرو"},{"u":"أَن","en":"lest","ur":"کہ"},{"u":"تُصِيبُوا۟",