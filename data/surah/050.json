{"n":50,"src":{"text":"qc-text","wbw":"qc-wbw"},"ayahs":[{"k":"50:1","n":1,"id":4631,"u":" قٓ ۚ وَٱلْقُرْءَانِ ٱلْمَجِيدِ","juz":26,"page":518,"sajdah":false,"w":[{"u":"قٓ ۚ","en":"Qaf","ur":"ق"},{"u":"وَٱلْقُرْءَانِ","en":"By the Quran","ur":"قسم ہے قرآن کی"},{"u":"ٱلْمَجِيدِ","en":"the Glorious","ur":"مجید-بزرگی والے"}]},{"k":"50:2","n":2,"id":4632,"u":"بَلْ عَجِبُوٓا۟ أَن جَآءَهُم مُّنذِرٌ مِّنْهُمْ فَقَالَ ٱلْكَـٰفِرُونَ هَـٰذَا شَىْءٌ عَجِيبٌ","juz":26,"page":518,"sajdah":false,"w":[{"u":"بَلْ","en":"Nay","ur":"بلکہ"},{"u":"عَجِبُوٓا۟","en":"they wonder","ur":"انہیں تعجب ہوا"},{"u":"أَن","en":"that","ur":"کہ"},{"u":"جَآءَهُم","en":"has come to them","ur":"آگیا ان کے پاس"},{"u":"مُّنذِرٌۭ","en":"a warner","ur":"ایک ڈرانے والا"},{"u":"مِّنْهُمْ","en":"from them","ur":"ان میں سے"},{"u":"فَقَالَ","en":"So say","ur":"تو کہا"},{"u":"ٱلْكَـٰفِرُونَ","en":"the disbelievers","ur":"کافروں نے"},{"u":"هَـٰذَا","en":"This","ur":"یہ"},{"u":"شَىْءٌ","en":"(is) a thing","ur":"ایک چیز ہے"},{"u":"عَجِيبٌ","en":"amazing","ur":"بہت ہی عجیب"}]},{"k":"50:3","n":3,"id":4633,"u":"أَءِذَا مِتْنَا وَكُنَّا تُرَابًا ۖ ذَٰلِكَ رَجْعٌۢ بَعِيدٌ","juz":26,"page":518,"sajdah":false,"w":[{"u":"أَءِذَا","en":"What! When","ur":"کیا جب"},{"u":"مِتْنَا","en":"we die","ur":"ہم مرجائیں گے"},{"u":"وَكُنَّا","en":"and have become","ur":"اور ہم ہوجائیں گے"},{"u":"تُرَابًۭا ۖ","en":"dust","ur":"مٹی"},{"u":"ذَٰلِكَ","en":"That","ur":"یہ"},{"u":"رَجْعٌۢ","en":"(is) a return","ur":"پلٹنا۔ پھر آنا"},{"u":"بَعِيدٌۭ","en":"far","ur":"دور کا ہے۔ ناممکن ہے"}]},{"k":"50:4","n":4,"id":4634,"u":"قَدْ عَلِمْنَا مَا تَنقُصُ ٱلْأَرْضُ مِنْهُمْ ۖ وَعِندَنَا كِتَـٰبٌ حَفِيظٌۢ","juz":26,"page":518,"sajdah":false,"w":[{"u":"قَدْ","en":"Certainly","ur":"تحقیق"},{"u":"عَلِمْنَا","en":"We know","ur":"ہم نے جان لیا"},{"u":"مَا","en":"what","ur":"اس کا بھی جو"},{"u":"تَنقُصُ","en":"diminishes","ur":"کمی کرتی ہے"},{"u":"ٱلْأَرْضُ","en":"the earth","ur":"زمین"},{"u":"مِنْهُمْ ۖ","en":"of them","ur":"ان میں سے"},{"u":"وَعِندَن