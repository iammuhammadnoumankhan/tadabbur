َّكُمْ","en":"Indeed, you","ur":"بیشک تم"},{"u":"لَفِى","en":"(are) surely in","ur":"البتہ میں ہو"},{"u":"قَوْلٍۢ","en":"a speech","ur":"ایک بات"},{"u":"مُّخْتَلِفٍۢ","en":"differing","ur":"جو مختلف ہے"}]},{"k":"51:9","n":9,"id":4684,"u":"يُؤْفَكُ عَنْهُ مَنْ أُفِكَ","juz":26,"page":521,"sajdah":false,"w":[{"u":"يُؤْفَكُ","en":"Deluded away","ur":"پھیرا جاتا ہے"},{"u":"عَنْهُ","en":"from it","ur":"اس سے"},{"u":"مَنْ","en":"(is he) who","ur":"جو"},{"u":"أُفِكَ","en":"is deluded","ur":"پھرایا جائے"}]},{"k":"51:10","n":10,"id":4685,"u":"قُتِلَ ٱلْخَرَّٰصُونَ","juz":26,"page":521,"sajdah":false,"w":[{"u":"قُتِلَ","en":"Cursed be","ur":"مارے گئے"},{"u":"ٱلْخَرَّٰصُونَ","en":"the liars","ur":"اندازے لگانے والے"}]},{"k":"51:11","n":11,"id":4686,"u":"ٱلَّذِينَ هُمْ فِى غَمْرَةٍ سَاهُونَ","juz":26,"page":521,"sajdah":false,"w":[{"u":"ٱلَّذِينَ","en":"Those who","ur":"یہ لوگ"},{"u":"هُمْ","en":"[they]","ur":"وہ ہیں"},{"u":"فِى","en":"(are) in","ur":"میں"},{"u":"غَمْرَةٍۢ","en":"flood","ur":"جو غفلت (میں)"},{"u":"سَاهُونَ","en":"(of) heedlessness","ur":"بھولے ہوئے ہیں"}]},{"k":"51:12","n":12,"id":4687,"u":"يَسْـَٔلُونَ أَيَّانَ يَوْمُ ٱلدِّينِ","juz":26,"page":521,"sajdah":false,"w":[{"u":"يَسْـَٔلُونَ","en":"They ask","ur":"وہ سوال کرتے ہیں"},{"u":"أَيَّانَ","en":"When","ur":"کب ہوگا"},{"u":"يَوْمُ","en":"(is the) Day","ur":"دن"},{"u":"ٱلدِّينِ","en":"(of) Judgment","ur":"جزا سزا کا"}]},{"k":"51:13","n":13,"id":4688,"u":"يَوْمَ هُمْ عَلَى ٱلنَّارِ يُفْتَنُونَ","juz":26,"page":521,"sajdah":false,"w":[{"u":"يَوْمَ","en":"A Day","ur":"اس روز"},{"u":"هُمْ","en":"they","ur":"وہ"},{"u":"عَلَى","en":"over","ur":"پر"},{"u":"ٱلنَّارِ","en":"the Fire","ur":"آگ"},{"u":"يُفْتَنُونَ","en":"will be tried","ur":"تپائے جائیں گے"}]},{"k":"51:14","n":14,"id":4689,"u":"ذُوقُوا۟ فِتْنَتَكُمْ هَـٰذَا ٱلَّذِى كُنتُم بِهِۦ تَسْتَعْجِلُونَ","juz":26,"page":521,"sajdah":false,"w":[{"u":"ذُوقُوا۟","en":"Taste","ur":"چکھو"},{"u":"فِتْنَتَكُمْ","en":"your trial","ur":"اپنی گمراہی کو۔ اپنے عذاب کو"},{"u":"هَـٰذَا","en":"This","ur":"یہ"},{"u":"ٱلَّذِى","en":"(is) what","ur":"وہ چیز ہے"},{"u":"كُنتُم","en":"you were","ur":"تھے تم"},{"u":"بِهِۦ","en":"for it","ur":"ساتھ اس کے"},{"u":"تَسْتَعْجِلُونَ","en":"seeking to hasten","ur":"تم جلدی مچاتے"}]},{"k":"51:15","n":15,"id":4690,"u":"إِنَّ ٱلْمُتَّقِينَ فِى جَنَّـٰتٍ وَعُيُونٍ","juz":26,"page":521,"sajdah":false,"w":[{"u":"إِنَّ","en":"Indeed","ur":"بیشک"},{"u":"ٱلْمُتَّقِينَ","en":"the righteous","ur":"متقی لوگ"},{"u":"فِى","en":"(will be) in","ur":"میں"},{"u":"جَنَّـٰتٍۢ","en":"Gardens","ur":"باغات (میں)"},{"u":"وَعُيُونٍ","en":"and springs","ur":"اور چشموں میں ہوں گے"}]},{"k":"51:16","n":16,"id":4691,"u":"ءَاخِذِينَ مَآ ءَاتَىٰهُمْ رَبُّهُمْ ۚ إِنَّهُمْ كَانُوا۟ قَبْلَ ذَٰلِكَ مُحْسِنِينَ","juz":26,"page":521,"sajdah":false,"w":[{"u":"ءَاخِذِينَ","en":"Taking","ur":"لینے والے ہوں گے"},{"u":"مَآ","en":"what","ur":"جو"},{"u":"ءَاتَىٰهُمْ","en":"their Lord has given them","ur":"دے گا ان کو"},{"u":"رَبُّهُمْ ۚ","en":"their Lord has given them","ur":"ان کا رب"},{"u":"إِنَّهُمْ","en":"Indeed, they","ur":"بیشک وہ"},{"u":"كَانُوا۟","en":"were","ur":"تھے وہ"},{"u":"قَبْلَ","en":"before","ur":"قبل"},{"u":"ذَٰلِكَ","en":"that","ur":"اس سے"},{"u":"مُحْسِنِينَ","en":"good-doers","ur":"نیکو کار"}]},{"k":"51:17","n":17,"id":4692,"u":"كَانُوا۟ قَلِيلًا مِّنَ ٱلَّيْلِ مَا يَهْجَعُونَ","juz":26,"page":521,"sajdah":false,"w":[{"u":"كَانُوا۟","en":"They used to","ur":"تھے وہ"},{"u":"قَلِيلًۭا","en":"little","ur":"کم ہی"},{"u":"مِّنَ","en":"of","ur":"سے"},{"u":"ٱلَّيْلِ","en":"the night","ur":"رات میں (سے)"},{"u":"مَا","en":"[what]","ur":"جو"},{"u":"يَهْجَعُونَ","en":"sleep","ur":"وہ سوتے تھے"}]},{"k":"51:18","n":18,"id":4693,"u":"وَبِٱلْأَسْحَارِ هُمْ يَسْتَغْفِرُونَ","juz":26,"page":521,"sajdah":false,"w":[{"u":"وَبِٱلْأَسْحَارِ","en":"And in the hours before dawn","ur":"اور سحری کے وقت"},{"u":"هُمْ","en":"they","ur":"وہ"},{"u":"يَسْتَغْفِرُونَ","en":"would ask forgiveness","ur":"استغفار کرتے تھے"}]},{"k":"51:19","n":19,"id":4694,"u":"وَفِىٓ أَمْوَٰلِهِمْ حَقٌّ لِّلسَّآئِلِ وَٱلْمَحْرُومِ","juz":26,"page":521,"sajdah":false,"w":[{"u":"وَفِىٓ","en":"And in","ur":"اور  میں"},{"u":"أَمْوَٰلِهِمْ","en":"their wealth","ur":"ان کے مالوں (میں)"},{"u":"حَقٌّۭ","en":"(was the) right","ur":"حق تھا"},{"u":"لِّلسَّآئِلِ","en":"(of) those who asked","ur":"سوالی کے لیے"},{"u":"وَٱلْمَحْرُومِ","en":"and the deprived","ur":"اور محروم کے لیے"}]},{"k":"51:20","n":20,"id":4695,"u":"وَفِى ٱلْأَرْضِ ءَايَـٰتٌ لِّلْمُوقِنِينَ","juz":26,"page":521,"sajdah":false,"w":[{"u":"وَفِى","en":"And in","ur":"اور  میں"},{"u":"ٱلْأَرْضِ","en":"the earth","ur":"زمین (میں)"},{"u":"ءَايَـٰتٌۭ","en":"(are) signs","ur":"کئی نشانیاں ہیں"},{"u":"لِّلْمُوقِنِينَ","en":"for those who are certain","ur":"یقین کرنے والوں کے لیے"}]},{"k":"51:21","n":21,"id":4696,"u":"وَفِىٓ أَنفُسِكُمْ ۚ أَفَلَا تُبْصِرُونَ","juz":26,"page":521,"sajdah":false,"w":[{"u":"وَفِىٓ","en":"And in","ur":"اور میں"},{"u":"أَنفُسِكُمْ ۚ","en":"yourselves","ur":"تمہارے نفسوں (میں) بھی"},{"u":"أَفَلَا","en":"Then will not","ur":"کیا بھلا نہیں"},{"u":"تُبْصِرُونَ","en":"you see","ur":"تم دیکھتے"}]},{"k":"51:22","n":22,"id":4697,"u":"وَفِى ٱلسَّمَآءِ رِزْقُكُمْ وَمَا تُوعَدُونَ","juz":26,"page":521,"sajdah":false,"w":[{"u":"وَفِى","en":"And in","ur":"اور  میں"},{"u":"ٱلسَّمَآءِ","en":"the heaven","ur":"آسمان"},{"u":"رِزْقُكُمْ","en":"(is) your provision","ur":"رزق ہے تمہارا"},{"u":"وَمَا","en":"and what","ur":"اور جو"},{"u":"تُوعَدُونَ","en":"you are promised","ur":"تم وعدہ کیے جاتے ہو"}]},{"k":"51:23","n":23,"id":4698,"u":"فَوَرَبِّ ٱلسَّمَآءِ وَٱلْأَرْضِ إِنَّهُۥ لَحَقٌّ مِّثْلَ مَآ أَنَّكُمْ تَنطِقُونَ","juz":26,"page":521,"sajdah":false,"w":[{"u":"فَوَرَبِّ","en":"Then by (the) Lord","ur":"پس قسم ہے رب کی"},{"u":"ٱلسَّمَآءِ","en":"(of) the heaven","ur":"آسمانوں کے"},{"u":"وَٱلْأَرْضِ","en":"and the earth","ur":"اور زمین کے"},{"u":"إِنَّهُۥ","en":"indeed, it","ur":"بیشک وہ"},{"u":"لَحَقٌّۭ","en":"(is) surely (the) truth","ur":"البتہ حق ہے"},{"u":"مِّثْلَ","en"