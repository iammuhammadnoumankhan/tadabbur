01.mp3"},{"u":"كُنَّا","i":"كُـنَّا","tl":"kunnā","en":"[we] used to","ur":"تھے ہم","a":"wbw/052_028_002.mp3"},{"u":"مِن","i":"مِنۡ","tl":"min","en":"before","ur":"اس سے","a":"wbw/052_028_003.mp3"},{"u":"قَبْلُ","i":"قَبۡلُ","tl":"qablu","en":"before","ur":"پہلے","a":"wbw/052_028_004.mp3"},{"u":"نَدْعُوهُ ۖ","i":"نَدۡعُوۡهُ​ ؕ","tl":"nadʿūhu","en":"call Him","ur":"اس سے دعا کرتے۔ اسی کو پکارا کرتے","a":"wbw/052_028_005.mp3"},{"u":"إِنَّهُۥ","i":"اِنَّهٗ","tl":"innahu","en":"Indeed, He","ur":"بیشک وہ","a":"wbw/052_028_007.mp3"},{"u":"هُوَ","i":"هُوَ","tl":"huwa","en":"[He]","ur":"وہی","a":"wbw/052_028_008.mp3"},{"u":"ٱلْبَرُّ","i":"الۡبَـرُّ","tl":"l-baru","en":"(is) the Most Kind","ur":"محسن ہے","a":"wbw/052_028_009.mp3"},{"u":"ٱلرَّحِيمُ","i":"الرَّحِيۡمُ‏ ﻿﻿","tl":"l-raḥīmu","en":"the Most Merciful","ur":"رحم فرمانے والا ہے","a":"wbw/052_028_010.mp3"}]},{"k":"52:29","n":29,"id":4764,"u":"فَذَكِّرْ فَمَآ أَنتَ بِنِعْمَتِ رَبِّكَ بِكَاهِنٍ وَلَا مَجْنُونٍ","i":"فَذَكِّرۡ فَمَاۤ اَنۡتَ بِنِعۡمَتِ رَبِّكَ بِكَاهِنٍ وَّلَا مَجۡنُوۡنٍؕ‏","juz":27,"page":524,"sajdah":false,"w":[{"u":"فَذَكِّرْ","i":"فَذَكِّرۡ","tl":"fadhakkir","en":"Therefore remind","ur":"پس نصیحت کیجیے","a":"wbw/052_029_001.mp3"},{"u":"فَمَآ","i":"فَمَاۤ","tl":"famā","en":"for not","ur":"پس نہیں","a":"wbw/052_029_002.mp3"},{"u":"أَنتَ","i":"اَنۡتَ","tl":"anta","en":"you","ur":"آپ","a":"wbw/052_029_003.mp3"},{"u":"بِنِعْمَتِ","i":"بِنِعۡمَتِ","tl":"biniʿ'mati","en":"(are) by (the) grace","ur":"نعمت سے","a":"wbw/052_029_004.mp3"},{"u":"رَبِّكَ","i":"رَبِّكَ","tl":"rabbika","en":"(of) your Lord","ur":"اپنے رب کی","a":"wbw/052_029_005.mp3"},{"u":"بِكَاهِنٍۢ","i":"بِكَاهِنٍ","tl":"bikāhinin","en":"a soothsayer","ur":"کا ھن","a":"wbw/052_029_006.mp3"},{"u":"وَلَا","i":"وَّلَا","tl":"walā","en":"and not","ur":"اور نہ","a":"wbw/052_029_007.mp3"},{"u":"مَجْنُونٍ","i":"مَجۡنُوۡنٍؕ‏","tl":"majnūnin","en":"a madman","ur":"مجنون","a":"wbw/052_029_008.mp3"}]},{"k":"52:30","n":30,"id":4765,"u":"أَمْ يَقُولُونَ شَا