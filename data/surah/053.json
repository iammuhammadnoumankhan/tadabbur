{"n":53,"src":{"text":"qc-text","wbw":"qc-wbw"},"ayahs":[{"k":"53:1","n":1,"id":4785,"u":" وَٱلنَّجْمِ إِذَا هَوَىٰ","juz":27,"page":526,"sajdah":false,"w":[{"u":"وَٱلنَّجْمِ","en":"By the star","ur":"قسم ہے تارے کی"},{"u":"إِذَا","en":"when","ur":"جب"},{"u":"هَوَىٰ","en":"it goes down","ur":"وہ گرا"}]},{"k":"53:2","n":2,"id":4786,"u":"مَا ضَلَّ صَاحِبُكُمْ وَمَا غَوَىٰ","juz":27,"page":526,"sajdah":false,"w":[{"u":"مَا","en":"Not","ur":"نہیں"},{"u":"ضَلَّ","en":"has strayed","ur":"بھٹکا"},{"u":"صَاحِبُكُمْ","en":"your companion","ur":"ساتھی تمہارا"},{"u":"وَمَا","en":"and not","ur":"ا ور نہ"},{"u":"غَوَىٰ","en":"has he erred","ur":"وہ بہکا"}]},{"k":"53:3","n":3,"id":4787,"u":"وَمَا يَنطِقُ عَنِ ٱلْهَوَىٰٓ","juz":27,"page":526,"sajdah":false,"w":[{"u":"وَمَا","en":"And not","ur":"اور نہیں"},{"u":"يَنطِقُ","en":"he speaks","ur":"وہ بولتا۔ بات کرتا"},{"u":"عَنِ","en":"from","ur":"سے"},{"u":"ٱلْهَوَىٰٓ","en":"the desire","ur":"خواہش نفس"}]},{"k":"53:4","n":4,"id":4788,"u":"إِنْ هُوَ إِلَّا وَحْىٌ يُوحَىٰ","juz":27,"page":526,"sajdah":false,"w":[{"u":"إِنْ","en":"Not","ur":"نہیں"},{"u":"هُوَ","en":"it","ur":"وہ"},{"u":"إِلَّا","en":"(is) except","ur":"مگر"},{"u":"وَحْىٌۭ","en":"a revelation","ur":"ایک وحی ہے"},{"u":"يُوحَىٰ","en":"revealed","ur":"جو وحی کی جاتی ہے"}]},{"k":"53:5","n":5,"id":4789,"u":"عَلَّمَهُۥ شَدِيدُ ٱلْقُوَىٰ","juz":27,"page":526,"sajdah":false,"w":[{"u":"عَلَّمَهُۥ","en":"Has taught him","ur":"سکھایا اس کو"},{"u":"شَدِيدُ","en":"the (one) mighty","ur":"زبردست"},{"u":"ٱلْقُوَىٰ","en":"(in) power","ur":"قوت والے نے"}]},{"k":"53:6","n":6,"id":4790,"u":"ذُو مِرَّةٍ فَٱسْتَوَىٰ","juz":27,"page":526,"sajdah":false,"w":[{"u":"ذُو","en":"Possessor of soundness","ur":"صاحب"},{"u":"مِرَّةٍۢ","en":"Possessor of soundness","ur":"قوت ہے"},{"u":"فَٱسْتَوَىٰ","en":"And he rose","ur":"پھر پورا نظر آیا۔ سیدھا کھڑا ہوگیا۔ درست ہوگیا"}]},{"k":"53:7","n":7,"id":4791,"u":"وَهُوَ بِٱلْأُفُقِ ٱلْأَعْلَىٰ","juz":27,"page":526,"sajdah":false,"w":[{"u":"وَهُوَ","en":"While he","ur":"اور وہ"},{"u":"بِٱلْأُفُقِ","en":"(was) in the horizon ","ur":"افق پر تھا"},{"u":"ٱلْأَعْلَىٰ","en":"the highest","ur":"بالائی۔ اعلیٰ"}]},{"k":"53:8","n":8,"id":4792,"u":"ثُمَّ دَنَا فَتَدَلَّىٰ","juz":27,"page":526,"sajdah":false,"w":[{"u":"ثُمَّ","en":"Then","ur":"پھر"},{"u":"دَنَا","en":"he approached","ur":"قریب آیا"},{"u":"فَتَدَلَّىٰ","en":"and came down","ur":"پھر اتر آیا"}]},{"k":"53:9","n":9,"id":4793,"u":"فَكَانَ قَابَ قَوْسَيْنِ أَوْ أَدْنَىٰ","juz":27,"page":526,"sajdah":false,"w":[{"u":"فَكَانَ","en":"And was","ur":"تو تھا اندازے سے"},{"u":"قَابَ","en":"(at) a distance","ur":"برابر"},{"u":"قَوْسَيْنِ","en":"(of) two bow-(lengths)","ur":"دو کمان کے"},{"u":"أَوْ","en":"or","ur":"یا"},{"u":"أَدْنَىٰ","en":"nearer","ur":"اس سے کم تر۔ قریب"}]},{"k":"53:10","n":10,"id":4794,"u":"فَأَوْحَىٰٓ إِلَىٰ عَبْدِهِۦ مَآ أَوْحَىٰ","juz":27,"page":526,"sajdah":false,"w":[{"u":"فَأَوْحَىٰٓ","en":"So he revealed","ur":"تو اس نے وحی کی"},{"u":"إِلَىٰ","en":"to","ur":"طرف"},{"u":"عَبْدِهِۦ","en":"His slave","ur":"اس کے بندے کی"},{"u":"مَآ","en":"what","ur":"جو"},{"u":"أَوْحَىٰ","en":"he revealed","ur":"اس نے وحی کی۔ وحی پہنچائی"}]},{"k":"53:11","n":11,"id":4795,"u":"مَا كَذَبَ ٱلْفُؤَادُ مَا رَأَىٰٓ","juz":27,"page":526,"sajdah":false,"w":[{"u":"مَا","en":"Not","ur":"نہیں"},{"u":"كَذَبَ","en":"lied","ur":"جھوٹ بولا"},{"u":"ٱلْفُؤَادُ","en":"the heart","ur":"دل نے"},{"u":"مَا","en":"what","ur":"جو"},{"u":"رَأَىٰٓ","en":"it saw","ur":"اس نے دیکھا"}]},{"k":"53:12","n":12,"id":4796,"u":"أَفَتُمَـٰرُونَهُۥ عَلَىٰ مَا يَرَىٰ","juz":27,"page":526,"sajdah":false,"w":[{"u":"أَفَتُمَـٰرُونَهُۥ","en":"Then will you dispute with him","ur":"کیا پھر تم جھگڑتے ہو اس سے"},{"u":"عَلَىٰ","en":"about","ur":"اوپر"},{"u":"مَا","en":"what","ur":"اس کے جو"},{"u":"يَرَىٰ","en":"he saw","ur":"وہ دیکھتا ہے"}]},{"k":"53:13","n":13,"id":4797,"u":"وَلَقَدْ رَءَاهُ نَزْلَةً أُخْرَىٰ","juz":27,"page":526,"sajdah":false,"w":[{"u":"وَلَقَدْ","en":"And certainly","ur":"اور البتہ تحقیق"},{"u":"رَء