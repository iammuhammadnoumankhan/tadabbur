ِ ٱلْعَـٰلَمِينَ","juz":27,"page":537,"sajdah":false,"w":[{"u":"تَنزِيلٌۭ","en":"A Revelation","ur":"نازل کردہ ہے"},{"u":"مِّن","en":"from","ur":"طرف    سے"},{"u":"رَّبِّ","en":"(the) Lord","ur":"رب"},{"u":"ٱلْعَـٰلَمِينَ","en":"(of) the worlds","ur":"العالمین کی"}]},{"k":"56:81","n":81,"id":5060,"u":"أَفَبِهَـٰذَا ٱلْحَدِيثِ أَنتُم مُّدْهِنُونَ","juz":27,"page":537,"sajdah":false,"w":[{"u":"أَفَبِهَـٰذَا","en":"Then is it to this","ur":"کیا بھلا"},{"u":"ٱلْحَدِيثِ","en":"statement","ur":"اس بات کے بارے میں"},{"u":"أَنتُم","en":"that you","ur":"تم"},{"u":"مُّدْهِنُونَ","en":"(are) indifferent","ur":"معمولی سمجھنے والے ہو۔ انکار کرنے والے ہو"}]},{"k":"56:82","n":82,"id":5061,"u":"وَتَجْعَلُونَ رِزْقَكُمْ أَنَّكُمْ تُكَذِّبُونَ","juz":27,"page":537,"sajdah":false,"w":[{"u":"وَتَجْعَلُونَ","en":"And you make","ur":"اور تم بناتے ہو"},{"u":"رِزْقَكُمْ","en":"your provision","ur":"اپنا حصہ"},{"u":"أَنَّكُمْ","en":"that you","ur":"بیشک تم"},{"u":"تُكَذِّبُونَ","en":"deny","ur":"تم جھٹلاتے ہو"}]},{"k":"56:83","n":83,"id":5062,"u":"فَلَوْلَآ إِذَا بَلَغَتِ ٱلْحُلْقُومَ","juz":27,"page":537,"sajdah":false,"w":[{"u":"فَلَوْلَآ","en":"Then why not","ur":"پس کیوں نہیں"},{"u":"إِذَا","en":"when","ur":"جب"},{"u":"بَلَغَتِ","en":"it reaches","ur":"پہنچ جاتی ہے"},{"u":"ٱلْحُلْقُومَ","en":"the throat","ur":"حلق کو۔ نرخرے کو"}]},{"k":"56:84","n":84,"id":5063,"u":"وَأَنتُمْ حِينَئِذٍ تَنظُرُونَ","juz":27,"page":537,"sajdah":false,"w":[{"u":"وَأَنتُمْ","en":"And you","ur":"اور تم"},{"u":"حِينَئِذٍۢ","en":"(at) that time","ur":"اس وقت"},{"u":"تَنظُرُونَ","en":"look on","ur":"تم دیکھ رہے ہوتے ہو۔ تم آنکھوں دیکھتے ہو"}]},{"k":"56:85","n":85,"id":5064,"u":"وَنَحْنُ أَقْرَبُ إِلَيْهِ مِنكُمْ وَلَـٰكِن لَّا تُبْصِرُونَ","juz":27,"page":537,"sajdah":false,"w":[{"u":"وَنَحْنُ","en":"And We","ur":"اور ہم"},{"u":"أَقْرَبُ","en":"(are) nearer","ur":"زیادہ قریب ہوتے ہیں"},{"u":"إِلَيْهِ","en":"to him","ur":"اس کی طرف"},{"u":"مِنكُمْ","en":"than you","ur":"تمہاری نسبت"},{"u":"وَلَـٰكِن","en":"but"