{"n":57,"src":{"text":"qc-text","wbw":"qc-wbw"},"ayahs":[{"k":"57:1","n":1,"id":5076,"u":" سَبَّحَ لِلَّهِ مَا فِى ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۖ وَهُوَ ٱلْعَزِيزُ ٱلْحَكِيمُ","juz":27,"page":537,"sajdah":false,"w":[{"u":"سَبَّحَ","en":"Glorifies","ur":"تسبیح کی ہے۔ کرتی ہے"},{"u":"لِلَّهِ","en":"[to] Allah","ur":"اللہ ہی کے لیے"},{"u":"مَا","en":"whatever","ur":"ہر اس چیز نے جو"},{"u":"فِى","en":"(is) in","ur":"میں ہے"},{"u":"ٱلسَّمَـٰوَٰتِ","en":"the heavens","ur":"آسمانوں"},{"u":"وَٱلْأَرْضِ ۖ","en":"and the earth","ur":"اور زمین میں"},{"u":"وَهُوَ","en":"and He","ur":"اور وہ"},{"u":"ٱلْعَزِيزُ","en":"(is) the All-Mighty","ur":"زبردست ہے"},{"u":"ٱلْحَكِيمُ","en":"the All-Wise","ur":"حکمت والا ہے"}]},{"k":"57:2","n":2,"id":5077,"u":"لَهُۥ مُلْكُ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۖ يُحْىِۦ وَيُمِيتُ ۖ وَهُوَ عَلَىٰ كُلِّ شَىْءٍ قَدِيرٌ","juz":27,"page":537,"sajdah":false,"w":[{"u":"لَهُۥ","en":"For Him","ur":"اسی کے لیے ہے"},{"u":"مُلْكُ","en":"(is the) dominion","ur":"بادشاہت"},{"u":"ٱلسَّمَـٰوَٰتِ","en":"(of) the heavens","ur":"آسمانوں کی"},{"u":"وَٱلْأَرْضِ ۖ","en":"and the earth","ur":"اور زمین کی"},{"u":"يُحْىِۦ","en":"He gives life","ur":"وہ زندہ کرتا ہے"},{"u":"وَيُمِيتُ ۖ","en":"and causes death","ur":"اور موت دیتا ہے"},{"u":"وَهُوَ","en":"and He","ur":"اور وہ"},{"u":"عَلَىٰ","en":"(is) over","ur":"پر"},{"u":"كُلِّ","en":"all","ur":"ہر"},{"u":"شَىْءٍۢ","en":"things","ur":"چیز"},{"u":"قَدِيرٌ","en":"All-Powerful","ur":"قدرت رکھتا ہے"}]},{"k":"57:3","n":3,"id":5078,"u":"هُوَ ٱلْأَوَّلُ وَٱلْـَٔاخِرُ وَٱلظَّـٰهِرُ وَٱلْبَاطِنُ ۖ وَهُوَ بِكُلِّ شَىْءٍ عَلِيمٌ","juz":27,"page":537,"sajdah":false,"w":[{"u":"هُوَ","en":"He","ur":"وہی"},{"u":"ٱلْأَوَّلُ","en":"(is) the First","ur":"اول ہے"},{"u":"وَٱلْـَٔاخِرُ","en":"and the Last","ur":"اور وہی آخر ہے"},{"u":"وَٱلظَّـٰهِرُ","en":"and the Apparent","ur":"اور ظاہر ہے"},{"u":"وَٱلْبَاطِنُ ۖ","en":"and the Unapparent","ur":"اور باطن ہے"},{"u":"وَهُوَ","en":"and He","ur":"اور وہ"},{"u":"بِكُلِّ","en":"(is) of every","ur":"ہر"},{