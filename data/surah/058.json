19","n":19,"id":5123,"u":"ٱسْتَحْوَذَ عَلَيْهِمُ ٱلشَّيْطَـٰنُ فَأَنسَىٰهُمْ ذِكْرَ ٱللَّهِ ۚ أُو۟لَـٰٓئِكَ حِزْبُ ٱلشَّيْطَـٰنِ ۚ أَلَآ إِنَّ حِزْبَ ٱلشَّيْطَـٰنِ هُمُ ٱلْخَـٰسِرُونَ","juz":28,"page":544,"sajdah":false,"w":[{"u":"ٱسْتَحْوَذَ","en":"Has overcome","ur":"غالب آگیا۔ گھیر لیا۔ احاطہ کرلیا"},{"u":"عَلَيْهِمُ","en":"them","ur":"ان پر"},{"u":"ٱلشَّيْطَـٰنُ","en":"the Shaitaan","ur":"شیطان نے"},{"u":"فَأَنسَىٰهُمْ","en":"so he made them forget","ur":"تو اس نے بھلا دیا ان کو"},{"u":"ذِكْرَ","en":"(the) remembrance","ur":"ذکر"},{"u":"ٱللَّهِ ۚ","en":"(of) Allah","ur":"اللہ کا"},{"u":"أُو۟لَـٰٓئِكَ","en":"Those","ur":"یہی لوگ"},{"u":"حِزْبُ","en":"(are the) party","ur":"گروہ ہیں"},{"u":"ٱلشَّيْطَـٰنِ ۚ","en":"(of) the Shaitaan","ur":"شیطان کا"},{"u":"أَلَآ","en":"No doubt","ur":"خبردار"},{"u":"إِنَّ","en":"Indeed","ur":"بیشک"},{"u":"حِزْبَ","en":"(the) party","ur":"گروہ"},{"u":"ٱلشَّيْطَـٰنِ","en":"(of) the Shaitaan","ur":"شیطان کا"},{"u":"هُمُ","en":"they","ur":"وہ"},{"u":"ٱلْخَـٰسِرُونَ","en":"(will be) the losers","ur":"خسارہ پانے والے ہیں"}]},{"k":"58:20","n":20,"id":5124,"u":"إِنَّ ٱلَّذِينَ يُحَآدُّونَ ٱللَّهَ وَرَسُولَهُۥٓ أُو۟لَـٰٓئِكَ فِى ٱلْأَذَلِّينَ","juz":28,"page":544,"sajdah":false,"w":[{"u":"إِنَّ","en":"Indeed","ur":"بیشک"},{"u":"ٱلَّذِينَ","en":"those who","ur":"وہ لوگ"},{"u":"يُحَآدُّونَ","en":"oppose","ur":"جو مقابلہ کرتے ہیں"},{"u":"ٱللَّهَ","en":"Allah","ur":"اللہ کا"},{"u":"وَرَسُولَهُۥٓ","en":"and His Messenger","ur":"اور اس کے رسول کا"},{"u":"أُو۟لَـٰٓئِكَ","en":"those","ur":"یہی لوگ"},{"u":"فِى","en":"(will be) among","ur":"میں"},{"u":"ٱلْأَذَلِّينَ","en":"the most humiliated","ur":"سب سے ذلیل ترین (مخلوق) میں سے ہیں"}]},{"k":"58:21","n":21,"id":5125,"u":"كَتَبَ ٱللَّهُ لَأَغْلِبَنَّ أَنَا۠ وَرُسُلِىٓ ۚ إِنَّ ٱللَّهَ قَوِىٌّ عَزِيزٌ","juz":28,"page":544,"sajdah":false,"w":[{"u":"كَتَبَ","en":"Allah has decreed","ur":"لکھ دیا"},{"u":"ٱللَّهُ","en":"Allah has decreed","ur":"اللہ نے"},{"u":"لَأَغْلِبَنَّ","en":"Surely, I will overcom