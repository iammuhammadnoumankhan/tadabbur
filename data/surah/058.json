{"n":58,"src":{"text":"qc-text","wbw":"qc-wbw"},"ayahs":[{"k":"58:1","n":1,"id":5105,"u":" قَدْ سَمِعَ ٱللَّهُ قَوْلَ ٱلَّتِى تُجَـٰدِلُكَ فِى زَوْجِهَا وَتَشْتَكِىٓ إِلَى ٱللَّهِ وَٱللَّهُ يَسْمَعُ تَحَاوُرَكُمَآ ۚ إِنَّ ٱللَّهَ سَمِيعٌۢ بَصِيرٌ","juz":28,"page":542,"sajdah":false,"w":[{"u":"قَدْ","en":"Indeed","ur":"تحقیق"},{"u":"سَمِعَ","en":"Allah has heard","ur":"سن لی"},{"u":"ٱللَّهُ","en":"Allah has heard","ur":"اللہ نے"},{"u":"قَوْلَ","en":"(the) speech","ur":"بات"},{"u":"ٱلَّتِى","en":"(of one) who","ur":"اس عورت کی"},{"u":"تُجَـٰدِلُكَ","en":"disputes with you","ur":"جو جھگڑ رہی تھی تجھ سے"},{"u":"فِى","en":"concerning","ur":"بارے میں"},{"u":"زَوْجِهَا","en":"her husband","ur":"اپنے شوہر کے"},{"u":"وَتَشْتَكِىٓ","en":"and she directs her complaint","ur":"اور شکایت کررہی تھی"},{"u":"إِلَى","en":"to","ur":"سے"},{"u":"ٱللَّهِ","en":"Allah","ur":"اللہ (سے)"},{"u":"وَٱللَّهُ","en":"And Allah","ur":"اور اللہ"},{"u":"يَسْمَعُ","en":"hears","ur":"سن رہا تھا"},{"u":"تَحَاوُرَكُمَآ ۚ","en":"(the) dialogue of both of you","ur":"تم دونوں کی گفتگو کو"},{"u":"إِنَّ","en":"Indeed","ur":"بیشک"},{"u":"ٱللَّهَ","en":"Allah","ur":"اللہ تعالیٰ"},{"u":"سَمِيعٌۢ","en":"(is) All-Hearer","ur":"سننے والا ہے"},{"u":"بَصِيرٌ","en":"All-Seer","ur":"دیکھنے والا ہے"}]},{"k":"58:2","n":2,"id":5106,"u":"ٱلَّذِينَ يُظَـٰهِرُونَ مِنكُم مِّن نِّسَآئِهِم مَّا هُنَّ أُمَّهَـٰتِهِمْ ۖ إِنْ أُمَّهَـٰتُهُمْ إِلَّا ٱلَّـٰٓـِٔى وَلَدْنَهُمْ ۚ وَإِنَّهُمْ لَيَقُولُونَ مُنكَرًا مِّنَ ٱلْقَوْلِ وَزُورًا ۚ وَإِنَّ ٱللَّهَ لَعَفُوٌّ غَفُورٌ","juz":28,"page":542,"sajdah":false,"w":[{"u":"ٱلَّذِينَ","en":"Those who","ur":"وہ لوگ"},{"u":"يُظَـٰهِرُونَ","en":"pronounce zihar","ur":"جو ظہار کرتے ہیں"},{"u":"مِنكُم","en":"among you","ur":"تم میں سے"},{"u":"مِّن","en":"[from]","ur":"سے"},{"u":"نِّسَآئِهِم","en":"(to) their wives","ur":"اپنی بیویوں (سے)"},{"u":"مَّا","en":"not","ur":"نہیں"},{"u":"هُنَّ","en":"they","ur":"وہ"},{"u":"أُمَّهَـٰتِهِمْ ۖ","en":"(are) their mothers","ur":"ان کی مائیں"},{"u":"إِنْ","en":"Not","ur":"نہیں"},{"u":"أُمَّهَـٰتُهُمْ","en":"(are) their mothers","ur":"ان کی مائیں"},{"u":"إِلَّا","en":"except","ur":"مگر"},{"u":"ٱلَّـٰٓـِٔى","en":"those who","ur":"وہ (عورتیں) جنہوں نے"},{"u":"وَلَدْنَهُمْ ۚ","en":"gave them birth","ur":"جنم دیا ان کو"},{"u":"وَإِنَّهُمْ","en":"And indeed, they","ur":"اور بیشک وہ"},{"u":"لَيَقُولُونَ","en":"surely say","ur":"البتہ وہ کہتے ہیں"},{"u":"مُنكَرًۭا","en":"an evil","ur":"منکر۔ ناپسندیدہ"},{"u":"مِّنَ","en":"[of]","ur":"سے"},{"u":"ٱلْقَوْلِ","en":"[the] word","ur":"بات میں (سے)"},{"u":"وَزُورًۭا ۚ","en":"and a lie","ur":"اور جھوٹ"},{"u":"وَإِنَّ","en":"But indeed","ur":"اور بیشک"},{"u":"ٱللَّهَ","en":"Allah","ur":"اللہ تعالیٰ"},{"u":"لَعَفُوٌّ","en":"(is) surely, Oft-Pardoning","ur":"البتہ معاف کرنے والا ہے"},{"u":"غَفُورٌۭ","en":"Oft-Forgiving","ur":"بخشش فرمانے والا ہے"}]},{"k":"58:3","n":3,"id":5107,"u":"وَٱلَّذِينَ يُظَـٰهِرُونَ مِن نِّسَآئِهِمْ ثُمَّ يَعُودُونَ لِمَا قَالُوا۟ فَتَحْرِيرُ رَقَبَةٍ مِّن قَبْلِ أَن يَتَمَآسَّا ۚ ذَٰلِكُمْ تُوعَظُونَ بِهِۦ ۚ وَٱللَّهُ بِمَا تَعْمَلُونَ خَبِيرٌ","juz":28,"page":542,"sajdah":false,"w":[{"u":"وَٱلَّذِينَ","en":"And those who","ur":"اور وہ لوگ"},{"u":"يُظَـٰهِرُونَ","en":"pronounce zihar","ur":"جو ظہار کرتے ہیں"},{"u":"مِن","en":"[from]","ur":"سے"},{"u":"نِّسَآئِهِمْ","en":"(to) their wives","ur":"اپنی بیویوں (سے)"},{"u":"ثُمَّ","en":"then","ur":"پھر"},{"u":"يَعُودُونَ","en":"go back","ur":"وہ لوٹنا چاہتے ہوں"},{"u":"لِمَا","en":"on what","ur":"واسطے اس کے جو"},{"u":"قَالُوا۟","en":"they said","ur":"انہوں نے کہا"},{"u":"فَتَحْرِيرُ","en":"then freeing","ur":"پس آزاد کرنا ہے"},{"u":"رَقَبَةٍۢ","en":"(of) a slave","ur":"ایک گردن کا"},{"u":"مِّن","en":"before","ur":"سے"},{"u":"قَبْلِ","en":"before","ur":"اس سے قبل"},{"u":"أَن","en":"[that]","ur":"وہ"},{"u":"يَتَمَآسَّا ۚ","en":"they touch each other","ur":"ایک دوسرے کو چھوئیں"},{"u":"ذَٰلِكُمْ","en":"That","ur":"یہ بات"},{"u":"تُوعَظُونَ","en":"you are admonished","ur":"تم نصیحت کیے جاتے ہو"},{"u":"بِهِۦ ۚ","en":"to it","ur":"ساتھ اس کے"},{"u":"وَٱللَّهُ","en":"And Allah","ur":"اور اللہ تعالیٰ"},{"u":"بِمَا","en":"of what","ur":"ساتھ اس کے جو"},{"u":"تَعْمَلُونَ","en":"you do","ur":"تم عمل کرتے ہو"},{"u":"خَبِيرٌۭ","en":"(is) All-Aware","ur":"باخبر ہے"}]},{"k":"58:4","n":4,"id":5108,"u":"فَمَن لَّمْ يَجِدْ فَصِيَامُ شَهْرَيْنِ مُتَتَابِعَيْنِ مِن قَبْلِ أَن يَتَمَآسَّا ۖ فَمَن لَّمْ يَسْتَطِعْ فَإِطْعَامُ سِتِّينَ مِسْكِينًا ۚ ذَٰلِكَ لِتُؤْمِنُوا۟ بِٱللَّهِ وَرَسُولِهِۦ ۚ وَتِلْكَ حُدُودُ ٱللَّهِ ۗ وَلِلْكَـٰفِرِينَ عَذَابٌ أَلِيمٌ","juz":28,"page":542,"sajdah":false,"w":[{"u":"فَمَن","en":"Then whoever","ur":"تو جو کوئی"},{"u":"لَّمْ","en":"(does) not","ur":"نہ"},{"u":"يَجِدْ","en":"find","ur":"پائے"},{"u":"فَصِيَامُ","en":"then fasting","ur":"تو روزے رکھے"},{"u":"شَهْرَيْنِ","en":"(for) two months","ur":"دو مہینوں کے"},{"u":"مُتَتَابِعَيْنِ","en":"consecutively","ur":"مسلسل۔ پے درپے"},{"u":"مِن","en":"before","ur":"سے"},{"u":"قَبْلِ","en":"before","ur":"اس سے پہلے"},{"u":"أَن","en":"[that]","ur":"کہ"},{"u":"يَتَمَآسَّا ۖ","en":"they both touch each other","ur":"وہ ایک دوسرے کو چھوئیں"},{"u":"فَمَن","en":"But (he) who","ur":"تو جو کوئی"},{"u":"لَّمْ","en":"not","ur":"نہ"},{"u":"يَسْتَطِعْ","en":"is able","ur":"استطاعت رکھتا ہو"},{"u":"فَإِطْعَامُ","en":"then (the) feeding","ur":"تو کھانا کھلانا ہے"},{"u":"سِتِّينَ","en":"(of) sixty","ur":"ساٹھ"},{"u":"مِسْكِينًۭا ۚ","en":"needy one(s)","ur":"مسکینوں کا"},{"u":"ذَٰلِكَ","en":"That ","ur":"یہ"},{"u":"لِتُؤْمِنُوا۟","en":"so that you may believe","ur":"تاکہ تم ایمان لاؤ"},{"u":"بِٱللَّهِ","en":"in Allah","ur":"اللہ پر"},{"u":"وَرَسُولِهِۦ ۚ","en":"and His Messenger","ur":"اور اس کے رسول پر"},{"u":"وَتِلْكَ","en":"and these","ur":"اور یہ"},{"u":"حُدُودُ","en":"(are the) limits","ur":"حدود ہیں"},{"u":"ٱللَّهِ ۗ","en":"(of) Allah","ur":"اللہ کی"},{"u":"وَلِلْكَـٰفِرِينَ","en":"and for the disbelievers","ur":"اور کافروں کے لیے"},{"u":"عَذَابٌ","en":"(is) a punishment","ur":"عذاب ہے"},{"u":"أَلِيمٌ","en":"painful","ur":"دردناک"}]},{"k":"58:5","n":5,"id":5109,"u":"إِنَّ ٱلَّذِينَ يُحَآدُّونَ ٱللَّهَ وَرَسُولَهُۥ كُبِتُوا۟ كَمَا كُبِتَ ٱلَّذِينَ مِن قَبْلِهِمْ ۚ وَقَدْ أَنزَلْنَآ ءَايَـٰتٍۭ بَيِّنَـٰتٍ ۚ وَلِلْكَـٰفِرِينَ عَذَابٌ مُّهِينٌ","juz":28,"page":542,"sajdah":false,"w":[{"u":"إِنَّ","en":"Indeed","ur":"بیشک"},{"u":"ٱلَّذِينَ","en":"those who","ur":"وہ لوگ"},{"u":"يُحَآدُّونَ","en":"oppose","ur":"جو مخالفت کرتے ہیں"},{"u":"ٱللَّهَ","en":"Allah","ur":"اللہ تعالیٰ کی"},{"u":"وَرَسُولَهُۥ","en":"and His Messenger","ur":"اور اس کے رسول کی"},{"u":"كُبِتُوا۟","en":"(will) be disgraced","ur":"ذلیل کیے گئے"},{"u":"كَمَا","en":"as","ur":"جیسا کہ"},{"u":"كُبِتَ","en":"were disgraced","ur":"ذلیل کیے گئے تھے"},{"u":"ٱلَّذِينَ","en":"those","ur":"وہ لوگ"},{"u":"مِن","en":"before them","ur":"سے"},{"u":"قَبْلِهِمْ ۚ","en":"before them","ur":"جو ان سے پہلے تھے"},{"u":"وَقَدْ","en":"And certainly","ur":"اور تحقیق"},{"u":"أَنزَلْنَآ","en":"We have sent down","ur":"نازل کیا ہم نے"},{"u":"ءَايَـٰتٍۭ","en":"Verses","ur":"آیات"},{"u":"بَيِّنَـٰتٍۢ ۚ","en":"clear","ur":"روشن ۔ واضح"},{"u":"وَلِلْكَـٰفِرِينَ","en":"And for the disbelievers","ur":"اور کافروں کے لیے"},{"u":"عَذَابٌۭ","en":"(is) a punishment","ur":"عذاب ہے"},{"u":"مُّهِينٌۭ","en":"humiliating","ur":"رسوا کرنے والا"}]},{"k":"58:6","n":6,"id":5110,"u":"يَوْمَ يَبْعَثُهُمُ ٱللَّهُ جَمِيعًا فَيُنَبِّئُهُم بِمَا عَمِلُوٓا۟ ۚ أَحْصَىٰهُ ٱللَّهُ وَنَسُوهُ ۚ وَٱللَّهُ عَلَىٰ كُلِّ شَىْءٍ شَهِيدٌ","juz":28,"page":542,"sajdah":false,"w":[{"u":"يَوْمَ","en":"(On the) Day","ur":"جس دن"},{"u":"يَبْعَثُهُمُ","en":"(when) Allah will raise them","ur":"اٹھائے گا ان کو"},{"u":"ٱللَّهُ","en":"(when) Allah will raise them","ur":"اللہ"},{"u":"جَمِيعًۭا","en":"all","ur":"سب کو"},{"u":"فَيُنَبِّئُهُم","en":"and inform them","ur":"پھر وہ آگاہ کرے گا ان کو"},{"u":"بِمَا","en":"of what","ur":"ساتھ اس کے جو"},{"u":"عَمِلُوٓا۟ ۚ","en":"they did","ur":"انہوں نے عمل کیے"},{"u":"أَحْصَىٰهُ","en":"Allah has recorded it","ur":"گن رکھا ہے اس کو"},{"u":"ٱللَّهُ","en":"Allah has recorded it","ur":"اللہ نے"},{"u":"وَنَسُوهُ ۚ","en":"while they forgot it","ur":"اور وہ بھول چکے ہیں اس کو"},{"u":"وَٱللَّهُ","en":"And Allah","ur":"اور اللہ تعالیٰ"},{"u":"عَلَىٰ","en":"(is) over","ur":"پر"},{"u":"كُلِّ","en":"all","ur":"ہر"},{"u":"شَىْءٍۢ","en":"things","ur":"چیز (پر)"},{"u":"شَهِيدٌ","en":"a Witness","ur":"گواہ"}]},{"k":"58:7","n":7,"id":5111,"u":"أَلَمْ تَرَ أَنَّ ٱللَّهَ يَعْلَمُ مَا فِى ٱلسَّمَـٰوَٰتِ وَمَا فِى ٱلْأَرْضِ ۖ مَا يَكُونُ مِن نَّجْوَىٰ ثَلَـٰثَةٍ إِلَّا هُوَ رَابِعُهُمْ وَلَا خَمْسَةٍ إِلَّا هُوَ سَادِسُهُمْ وَلَآ أَدْنَىٰ مِن ذَٰلِكَ وَلَآ أَكْثَرَ إِلَّا هُوَ مَعَهُمْ أَيْنَ مَا كَانُوا۟ ۖ ثُمَّ يُنَبِّئُهُم بِمَا عَمِلُوا۟ يَوْمَ ٱلْقِيَـٰمَةِ ۚ إِنَّ ٱللَّهَ بِكُلِّ شَىْءٍ عَلِيمٌ","juz":28,"page":543,"sajdah":false,"w":[{"u":"أَلَمْ","en":"Do not","ur":"کیا  نہیں"},{"u":"تَرَ","en":"you see","ur":"تم نے دیکھا"},{"u":"أَنَّ","en":"that","ur":"بیشک"},{"u":"ٱللَّهَ","en":"Allah","ur":"اللہ تعالیٰ"},{"u":"يَعْلَمُ","en":"knows","ur":"جانتا ہے"},{"u":"مَا","en":"whatever","ur":"جو کچھ"},{"u":"فِى","en":"(is) in","ur":"میں"},{"u":"ٱلسَّمَـٰوَٰتِ","en":"the heavens","ur":"آسمانوں میں ہے"},{"u":"وَمَا","en":"and whatever","ur":"اور جو کچھ"},{"u":"فِى","en":"(is) in","ur":"میں"},{"u":"ٱلْأَرْضِ ۖ","en":"the earth","ur":"زمین میں ہے"},{"u":"مَا","en":"Not","ur":"نہیں"},{"u":"يَكُونُ","en":"there is","ur":"ہوتا"},{"u":"مِن","en":"any","ur":"سے"},{"u":"نَّجْوَىٰ","en":"secret counsel","ur":"سرگوشی میں (سے)"},{"u":"ثَلَـٰثَةٍ","en":"(of) three","ur":"تین کی"},{"u":"إِلَّا","en":"but","ur":"مگر"},{"u":"هُوَ","en":"He (is)","ur":"وہ"},{"u":"رَابِعُهُمْ","en":"(the) fourth of them","ur":"چوتھا ہے ان کا"},{"u":"وَلَا","en":"and not","ur":"اور نہ"},{"u":"خَمْسَةٍ","en":"five","ur":"پانچ کی"},{"u":"إِلَّا","en":"but","ur":"مگر"},{"u":"هُوَ","en":"He (is)","ur":"وہ"},{"u":"سَادِسُهُمْ","en":"(the) sixth of them","ur":"چھٹا ہے ان کا"},{"u":"وَلَآ","en":"and not","ur":"اور نہ"},{"u":"أَدْنَىٰ","en":"less","ur":"کم تر"},{"u":"مِن","en":"than","ur":"سے"},{"u":"ذَٰلِكَ","en":"that","ur":"اس سے"},{"u":"وَلَآ","en":"and not","ur":"اور نہ"},{"u":"أَكْثَرَ","en":"more","ur":"زیادہ"},{"u":"إِلَّا","en":"but","ur":"مگر"},{"u":"هُوَ","en":"He","ur":"وہ"},{"u":"مَعَهُمْ","en":"(is) with them","ur":"ان کے ساتھ ہے"},{"u":"أَيْنَ","en":"wherever","ur":"جہاں"},{"u":"مَا","en":"wherever","ur":"کہیں"},{"u":"كَانُوا۟ ۖ","en":"they are","ur":"وہ ہوں"},{"u":"ثُمَّ","en":"Then","ur":"پھر"},{"u":"يُنَبِّئُهُم","en":"He will inform them","ur":"وہ آگاہ کرے گا ان کو"},{"u":"بِمَا","en":"of what","ur":"ساتھ اس کے جو"},{"u":"عَمِلُوا۟","en":"they did","ur":"انہوں نے عمل کیے"},{"u":"يَوْمَ","en":"(on the) Day","ur":"دن"},{"u":"ٱلْقِيَـٰمَةِ ۚ","en":"(of) the Resurrection","ur":"قیامت کے"},{"u":"إِنَّ","en":"Indeed","ur":"بیشک"},{"u":"ٱللَّهَ","en":"Allah","ur":"اللہ تعالیٰ"},{"u":"بِكُلِّ","en":"of every","ur":"ساتھ ہر"},{"u":"شَىْءٍ","en":"thing","ur":"چیز کے"},{"u":"عَلِيمٌ","en":"(is) All-Knower","ur":"جاننے والا"}]},{"k":"58:8","n":8,"id":5112,"u":"أَلَمْ تَرَ إِلَى ٱلَّذِينَ نُهُوا۟ عَنِ ٱلنَّجْوَىٰ ثُمَّ يَعُودُونَ لِمَا نُهُوا۟ عَنْهُ وَيَتَنَـٰجَوْنَ بِٱلْإِثْمِ وَٱلْعُدْوَٰنِ وَمَعْصِيَتِ ٱلرَّسُولِ وَإِذَا جَآءُوكَ حَيَّوْكَ بِمَا لَمْ يُحَيِّكَ بِهِ ٱللَّهُ وَيَقُولُونَ فِىٓ أَنفُسِهِمْ لَوْلَا يُعَذِّبُنَا ٱللَّهُ بِمَا نَقُولُ ۚ حَسْبُهُمْ جَهَنَّمُ يَصْلَوْنَهَا ۖ فَبِئْسَ ٱلْمَصِيرُ","juz":28,"page":543,"sajdah":false,"w":[{"u":"أَلَمْ","en":"Do not","ur":"کیا نہیں"},{"u":"تَرَ","en":"you see","ur":"تم نے دیکھا"},{"u":"إِلَى","en":"[to]","ur":"طرف"},{"u":"ٱلَّذِينَ","en":"those who","ur":"ان لوگوں کی (طرف)"},{"u":"نُهُوا۟","en":"were forbidden","ur":"جو روکے گئے"},{"u":"عَنِ","en":"from","ur":"سے"},{"u":"ٱلنَّجْوَىٰ","en":"secret counsels","ur":"سرگوشی (سے)"},{"u":"ثُمَّ","en":"then","ur":"پھر"},{"u":"يَعُودُونَ","en":"they return","ur":"وہ لوٹتے ہیں"},{"u":"لِمَا","en":"to what","ur":"واسطے اس کے جو"},{"u":"نُهُوا۟","en":"they were forbidden","ur":"وہ روکے گئے تھے"},{"u":"عَنْهُ","en":"from [it]","ur":"جس سے"},{"u":"وَيَتَنَـٰجَوْنَ","en":"and they hold secret counsels","ur":"اور وہ ایک دوسرے سے سرگوشیاں کرتے ہیں"},{"u":"بِٱلْإِثْمِ","en":"for sin","ur":"ساتھ گناہ کے"},{"u":"وَٱلْعُدْوَٰنِ","en":"and aggression","ur":"اور زیادتی کے"},{"u":"وَمَعْصِيَتِ","en":"and disobedience","ur":"نافرمانی کے"},{"u":"ٱلرَّسُولِ","en":"(to) the Messenger","ur":"رسول (صلی اللہ علیہ وآلہ وسلم) کی"},{"u":"وَإِذَا","en":"And when","ur":"اور جب"},{"u":"جَآءُوكَ","en":"they come to you","ur":"وہ آتے ہیں تیرے پاس"},{"u":"حَيَّوْكَ","en":"they greet you","ur":"وہ سلام کرتے ہیں تجھ کو"},{"u":"بِمَا","en":"with what","ur":"ساتھ اس کے جو"},{"u":"لَمْ","en":"not","ur":"نہیں"},{"u":"يُحَيِّكَ","en":"greets you","ur":"سلام کیا تجھ کو"},{"u":"بِهِ","en":"therewith","ur":"ساتھ اس کے"},{"u":"ٱللَّهُ","en":"Allah","ur":"اللہ نے"},{"u":"وَيَقُولُونَ","en":"and they say","ur":"اور وہ کہتے ہیں"},{"u":"فِىٓ","en":"among","ur":"میں"},{"u":"أَنفُسِهِمْ","en":"themselves","ur":"اپنے نفسوں میں"},{"u":"لَوْلَا","en":"Why (does) not","ur":"کیوں نہیں"},{"u":"يُعَذِّبُنَا","en":"Allah punish us","ur":"عذاب دیتا ہم کو"},{"u":"ٱللَّهُ","en":"Allah punish us","ur":"اللہ"},{"u":"بِمَا","en":"for what","ur":"بوجہ اس کے جو"},{"u":"نَقُولُ ۚ","en":"we say","ur":"ہم کہتے ہیں"},{"u":"حَسْبُهُمْ","en":"Sufficient (for) them","ur":"کافی ہے ان کو"},{"u":"جَهَنَّمُ","en":"(is) Hell","ur":"جہنم"},{"u":"يَصْلَوْنَهَا ۖ","en":"they will burn in it","ur":"وہ جلیں گے اس میں"},{"u":"فَبِئْسَ","en":"and worst is","ur":"پس بدترین"},{"u":"ٱلْمَصِيرُ","en":"the destination","ur":"ٹھکانہ ہے"}]},{"k":"58:9","n":9,"id":5113,"u":"يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓا۟ إِذَا تَنَـٰجَيْتُمْ فَلَا تَتَنَـٰجَوْا۟ بِٱلْإِثْمِ وَٱلْعُدْوَٰنِ وَمَعْصِيَتِ ٱلرَّسُولِ وَتَنَـٰجَوْا۟ بِٱلْبِرِّ وَٱلتَّقْوَىٰ ۖ وَٱتَّقُوا۟ ٱللَّهَ ٱلَّذِىٓ إِلَيْهِ تُحْشَرُونَ","juz":28,"page":543,"sajdah":false,"w":[{"u":"يَـٰٓأَيُّهَا","en":"O you who believe","ur":"اے"},{"u":"ٱلَّذِينَ","en":"O you who believe","ur":"لوگو"},{"u":"ءَامَنُوٓا۟","en":"O you who belie