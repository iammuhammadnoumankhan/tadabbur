{"n":59,"src":{"text":"qc-text","wbw":"qc-wbw"},"ayahs":[{"k":"59:1","n":1,"id":5127,"u":" سَبَّحَ لِلَّهِ مَا فِى ٱلسَّمَـٰوَٰتِ وَمَا فِى ٱلْأَرْضِ ۖ وَهُوَ ٱلْعَزِيزُ ٱلْحَكِيمُ","juz":28,"page":545,"sajdah":false,"w":[{"u":"سَبَّحَ","en":"Glorifies","ur":"تسبیح کی ہے"},{"u":"لِلَّهِ","en":"[to] Allah","ur":"اللہ کے لیے"},{"u":"مَا","en":"whatever","ur":"ہر اس چیز نے"},{"u":"فِى","en":"(is) in","ur":"میں"},{"u":"ٱلسَّمَـٰوَٰتِ","en":"the heavens","ur":"جو آسمانوں میں ہے"},{"u":"وَمَا","en":"and whatever","ur":"اور جو"},{"u":"فِى","en":"(is) in","ur":"میں"},{"u":"ٱلْأَرْضِ ۖ","en":"the earth","ur":"زمین میں ہے"},{"u":"وَهُوَ","en":"And He","ur":"اور وہ"},{"u":"ٱلْعَزِيزُ","en":"(is) the All-Mighty","ur":"زبردست ہے"},{"u":"ٱلْحَكِيمُ","en":"the All-Wise","ur":"حکمت والا ہے"}]},{"k":"59:2","n":2,"id":5128,"u":"هُوَ ٱلَّذِىٓ أَخْرَجَ ٱلَّذِينَ كَفَرُوا۟ مِنْ أَهْلِ ٱلْكِتَـٰبِ مِن دِيَـٰرِهِمْ لِأَوَّلِ ٱلْحَشْرِ ۚ مَا ظَنَنتُمْ أَن يَخْرُجُوا۟ ۖ وَظَنُّوٓا۟ أَنَّهُم مَّانِعَتُهُمْ حُصُونُهُم مِّنَ ٱللَّهِ فَأَتَىٰهُمُ ٱللَّهُ مِنْ حَيْثُ لَمْ يَحْتَسِبُوا۟ ۖ وَقَذَفَ فِى قُلُوبِهِمُ ٱلرُّعْبَ ۚ يُخْرِبُونَ بُيُوتَهُم بِأَيْدِيهِمْ وَأَيْدِى ٱلْمُؤْمِنِينَ فَٱعْتَبِرُوا۟ يَـٰٓأُو۟لِى ٱلْأَبْصَـٰرِ","juz":28,"page":545,"sajdah":false,"w":[{"u":"هُوَ","en":"He","ur":"وہ اللہ"},{"u":"ٱلَّذِىٓ","en":"(is) the One Who","ur":"وہ ذات ہے"},{"u":"أَخْرَجَ","en":"expelled","ur":"جس نے نکال دیا"},{"u":"ٱلَّذِينَ","en":"those who","ur":"ان لوگوں کو"},{"u":"كَفَرُوا۟","en":"disbelieved","ur":"جنہوں نے کفر کیا"},{"u":"مِنْ","en":"from","ur":"سے"},{"u":"أَهْلِ","en":"(the) People","ur":"اہل"},{"u":"ٱلْكِتَـٰبِ","en":"(of) the Scripture","ur":"کتاب میں (سے)"},{"u":"مِن","en":"from","ur":"سے"},{"u":"دِيَـٰرِهِمْ","en":"their homes","ur":"ان کے گھروں (سے)"},{"u":"لِأَوَّلِ","en":"at (the) first","ur":"پہلے ہی"},{"u":"ٱلْحَشْرِ ۚ","en":"gathering","ur":"حشر میں۔ پہلی بھیڑ میں"},{"u":"مَا","en":"Not","ur":"نہیں"},{"u":"ظَنَنتُمْ","en":"you think","ur":"تم نے گمان کیا"},{"u":"أَن","en":"