ed","ur":"دبا ہوا"},{"u":"مُّتَصَدِّعًۭا","en":"breaking asunder","ur":"پھٹتا ہوا۔ پھٹنے والا"},{"u":"مِّنْ","en":"from","ur":"سے"},{"u":"خَشْيَةِ","en":"(the) fear","ur":"ڈر (سے)"},{"u":"ٱللَّهِ ۚ","en":"(of) Allah","ur":"اللہ کے"},{"u":"وَتِلْكَ","en":"And these","ur":"اور یہ"},{"u":"ٱلْأَمْثَـٰلُ","en":"examples","ur":"مثالیں"},{"u":"نَضْرِبُهَا","en":"We present them","ur":"ہم بیان کرتے ہیں ان کو"},{"u":"لِلنَّاسِ","en":"to the people","ur":"لوگوں کے لیے"},{"u":"لَعَلَّهُمْ","en":"so that they may","ur":"تاکہ وہ"},{"u":"يَتَفَكَّرُونَ","en":"give thought","ur":"وہ غور و فکر کریں"}]},{"k":"59:22","n":22,"id":5148,"u":"هُوَ ٱللَّهُ ٱلَّذِى لَآ إِلَـٰهَ إِلَّا هُوَ ۖ عَـٰلِمُ ٱلْغَيْبِ وَٱلشَّهَـٰدَةِ ۖ هُوَ ٱلرَّحْمَـٰنُ ٱلرَّحِيمُ","juz":28,"page":548,"sajdah":false,"w":[{"u":"هُوَ","en":"He","ur":"وہ"},{"u":"ٱللَّهُ","en":"(is) Allah","ur":"اللہ"},{"u":"ٱلَّذِى","en":"the One Who","ur":"وہ ذات ہے"},{"u":"لَآ","en":"(there is) no","ur":"نہیں"},{"u":"إِلَـٰهَ","en":"god","ur":"کوئی الہ"},{"u":"إِلَّا","en":"but","ur":"مگر"},{"u":"هُوَ ۖ","en":"He","ur":"وہی"},{"u":"عَـٰلِمُ","en":"(the) All-Knower","ur":"جاننے والا ہے"},{"u":"ٱلْغَيْبِ","en":"(of) the unseen","ur":"غیب کا"},{"u":"وَٱلشَّهَـٰدَةِ ۖ","en":"and the witnessed","ur":"اور حاضر کا"},{"u":"هُوَ","en":"He","ur":"وہ"},{"u":"ٱلرَّحْمَـٰنُ","en":"(is) the Most Gracious","ur":"رحمن ہے"},{"u":"ٱلرَّحِيمُ","en":"the Most Merciful","ur":"اور رحیم ہے"}]},{"k":"59:23","n":23,"id":5149,"u":"هُوَ ٱللَّهُ ٱلَّذِى لَآ إِلَـٰهَ إِلَّا هُوَ ٱلْمَلِكُ ٱلْقُدُّوسُ ٱلسَّلَـٰمُ ٱلْمُؤْمِنُ ٱلْمُهَيْمِنُ ٱلْعَزِيزُ ٱلْجَبَّارُ ٱلْمُتَكَبِّرُ ۚ سُبْحَـٰنَ ٱللَّهِ عَمَّا يُشْرِكُونَ","juz":28,"page":548,"sajdah":false,"w":[{"u":"هُوَ","en":"He","ur":"وہ"},{"u":"ٱللَّهُ","en":"(is) Allah","ur":"اللہ"},{"u":"ٱلَّذِى","en":"the One Who","ur":"وہ ذات ہے"},{"u":"لَآ","en":"(there is) no","ur":"نہیں"},{"u":"إِلَـٰهَ","en":"god","ur":"کوئی الہ برحق"},{"u":"إِلَّا","en":"but","ur":"مگر"},{"u":"هُوَ","en":"He","ur":"وہی"},{"u":"ٱلْم