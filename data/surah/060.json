{"n":60,"src":{"text":"qc-text","wbw":"qc-wbw"},"ayahs":[{"k":"60:1","n":1,"id":5151,"u":" يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ لَا تَتَّخِذُوا۟ عَدُوِّى وَعَدُوَّكُمْ أَوْلِيَآءَ تُلْقُونَ إِلَيْهِم بِٱلْمَوَدَّةِ وَقَدْ كَفَرُوا۟ بِمَا جَآءَكُم مِّنَ ٱلْحَقِّ يُخْرِجُونَ ٱلرَّسُولَ وَإِيَّاكُمْ ۙ أَن تُؤْمِنُوا۟ بِٱللَّهِ رَبِّكُمْ إِن كُنتُمْ خَرَجْتُمْ جِهَـٰدًا فِى سَبِيلِى وَٱبْتِغَآءَ مَرْضَاتِى ۚ تُسِرُّونَ إِلَيْهِم بِٱلْمَوَدَّةِ وَأَنَا۠ أَعْلَمُ بِمَآ أَخْفَيْتُمْ وَمَآ أَعْلَنتُمْ ۚ وَمَن يَفْعَلْهُ مِنكُمْ فَقَدْ ضَلَّ سَوَآءَ ٱلسَّبِيلِ","juz":28,"page":549,"sajdah":false,"w":[{"u":"يَـٰٓأَيُّهَا","en":"O you","ur":"اے"},{"u":"ٱلَّذِينَ","en":"who","ur":"لوگو"},{"u":"ءَامَنُوا۟","en":"believe","ur":"جو ایمان لائے ہو"},{"u":"لَا","en":"(Do) not","ur":"نہ"},{"u":"تَتَّخِذُوا۟","en":"take","ur":"تم بناؤ"},{"u":"عَدُوِّى","en":"My enemies","ur":"میرے دشمنوں کو"},{"u":"وَعَدُوَّكُمْ","en":"and your enemies","ur":"اور اپنے دشمنوں کو"},{"u":"أَوْلِيَآءَ","en":"(as) allies","ur":"دوست"},{"u":"تُلْقُونَ","en":"offering","ur":"تم ڈالتے ہو"},{"u":"إِلَيْهِم","en":"them","ur":"ان کی طرف"},{"u":"بِٱلْمَوَدَّةِ","en":"love","ur":"محبت کو"},{"u":"وَقَدْ","en":"while","ur":"حالانکہ تحقیق"},{"u":"كَفَرُوا۟","en":"they have disbelieved","ur":"انہوں نے کفر کیا"},{"u":"بِمَا","en":"in what","ur":"ساتھ اس کے جو"},{"u":"جَآءَكُم","en":"came to you","ur":"آیا تمہارے پاس"},{"u":"مِّنَ","en":"of","ur":"سے"},{"u":"ٱلْحَقِّ","en":"the truth","ur":"حق میں (سے)"},{"u":"يُخْرِجُونَ","en":"driving out","ur":"وہ نکالتے ہیں"},{"u":"ٱلرَّسُولَ","en":"the Messenger","ur":"رسول کو"},{"u":"وَإِيَّاكُمْ ۙ","en":"and yourselves","ur":"اور تم کو"},{"u":"أَن","en":"because","ur":"کہ"},{"u":"تُؤْمِنُوا۟","en":"you believe","ur":"تم ایمان لاتے ہو"},{"u":"بِٱللَّهِ","en":"in Allah","ur":"اللہ پر"},{"u":"رَبِّكُمْ","en":"your Lord","ur":"جو رب ہے تمہارا"},{"u":"إِن","en":"If","ur":"اگر"},{"u":"كُنتُمْ","en":"you","ur":"ہو تم"},{"u":"خَرَجْتُمْ","en":"come forth","ur":"نکلے تم"},{"u":"جِهَـ