","ur":"کاش"},{"u":"تَكْفُرُونَ","en":"you would disbelieve","ur":"تم کفر کرو"}]},{"k":"60:3","n":3,"id":5153,"u":"لَن تَنفَعَكُمْ أَرْحَامُكُمْ وَلَآ أَوْلَـٰدُكُمْ ۚ يَوْمَ ٱلْقِيَـٰمَةِ يَفْصِلُ بَيْنَكُمْ ۚ وَٱللَّهُ بِمَا تَعْمَلُونَ بَصِيرٌ","juz":28,"page":549,"sajdah":false,"w":[{"u":"لَن","en":"Never","ur":"ہرگز نہیں"},{"u":"تَنفَعَكُمْ","en":"will benefit you","ur":"کام آئیں گے تم کو۔ فائدہ دیں گے تم کو"},{"u":"أَرْحَامُكُمْ","en":"your relatives","ur":"تمہارے رحم۔ رشتے داریاں"},{"u":"وَلَآ","en":"and not","ur":"اور نہ"},{"u":"أَوْلَـٰدُكُمْ ۚ","en":"your children","ur":"تمہاری اولادیں"},{"u":"يَوْمَ","en":"(on the) Day","ur":"دن"},{"u":"ٱلْقِيَـٰمَةِ","en":"(of) the Resurrection","ur":"قیامت کے"},{"u":"يَفْصِلُ","en":"He will judge","ur":"وہ فیصلہ کرے گا"},{"u":"بَيْنَكُمْ ۚ","en":"between you","ur":"تمہارے درمیان"},{"u":"وَٱللَّهُ","en":"And Allah","ur":"اور اللہ تعالیٰ"},{"u":"بِمَا","en":"of what","ur":"ساتھ اس کے جو"},{"u":"تَعْمَلُونَ","en":"you do","ur":"تم عمل کرتے ہو"},{"u":"بَصِيرٌۭ","en":"(is) All-Seer","ur":"دیکھنے والا"}]},{"k":"60:4","n":4,"id":5154,"u":"قَدْ كَانَتْ لَكُمْ أُسْوَةٌ حَسَنَةٌ فِىٓ إِبْرَٰهِيمَ وَٱلَّذِينَ مَعَهُۥٓ إِذْ قَالُوا۟ لِقَوْمِهِمْ إِنَّا بُرَءَٰٓؤُا۟ مِنكُمْ وَمِمَّا تَعْبُدُونَ مِن دُونِ ٱللَّهِ كَفَرْنَا بِكُمْ وَبَدَا بَيْنَنَا وَبَيْنَكُمُ ٱلْعَدَٰوَةُ وَٱلْبَغْضَآءُ أَبَدًا حَتَّىٰ تُؤْمِنُوا۟ بِٱللَّهِ وَحْدَهُۥٓ إِلَّا قَوْلَ إِبْرَٰهِيمَ لِأَبِيهِ لَأَسْتَغْفِرَنَّ لَكَ وَمَآ أَمْلِكُ لَكَ مِنَ ٱللَّهِ مِن شَىْءٍ ۖ رَّبَّنَا عَلَيْكَ تَوَكَّلْنَا وَإِلَيْكَ أَنَبْنَا وَإِلَيْكَ ٱلْمَصِيرُ","juz":28,"page":549,"sajdah":false,"w":[{"u":"قَدْ","en":"Indeed","ur":"تحقیق"},{"u":"كَانَتْ","en":"(there) is","ur":"ہے"},{"u":"لَكُمْ","en":"for you","ur":"تمہارے لیے"},{"u":"أُسْوَةٌ","en":"an example","ur":"نمونہ"},{"u":"حَسَنَةٌۭ","en":"good","ur":"اچھا"},{"u":"فِىٓ","en":"in","ur":"میں"},{"u":"إِبْرَٰهِيمَ","en":"Ibrahim","ur":"ابراہیم (میں)"},{"u":"وَٱلَّذِينَ","en":"and those","ur":"اور وہ لوگ"},{"u":"مَعَهُۥٓ","en":"with him","ur":"جو آپ کے ساتھ ہیں"},{"u":"إِذْ","en":"when","ur":"جب"},{"u":"قَالُوا۟","en":"they said","ur":"انہوں نے کہا"},{"u":"لِقَوْمِهِمْ","en":"to their people","ur":"اپنی قوم سے"},{"u":"إِنَّا","en":"Indeed, we","ur":"بیشک ہم"},{"u":"بُرَءَٰٓؤُا۟","en":"(are) disassociated","ur":"بری الذمہ ہیں"},{"u":"مِنكُمْ","en":"from you","ur":"تم سے"},{"u":"وَمِمَّا","en":"and from what","ur":"اور ان سے جن کو"},{"u":"تَعْبُدُونَ","en":"you worship","ur":"تم پوجتے ہو"},{"u":"مِن","en":"from","ur":"سے"},{"u":"دُونِ","en":"besides","ur":"سوا"},{"u":"ٱللَّهِ","en":"Allah","ur":"اللہ کے"},{"u":"كَفَرْنَا","en":"We have denied","ur":"کفر کیا ہم نے"},{"u":"بِكُمْ","en":"you","ur":"ساتھ تمہارے"},{"u":"وَبَدَا","en":"and has appeared","ur":"اور ظاہر ہوگئی"},{"u":"بَيْنَنَا","en":"between us","ur":"ہمارے درمیان"},{"u":"وَبَيْنَكُمُ","en":"and between you","ur":"اور تمہارے درمیان"},{"u":"ٱلْعَدَٰوَةُ","en":"enmity","ur":"عداوت"},{"u":"وَٱلْبَغْضَآءُ","en":"and hatred","ur":"اور بغض"},{"u":"أَبَدًا","en":"forever","ur":"ہمیشہ کے لیے"},{"u":"حَتَّىٰ","en":"until","ur":"یہاں تک کہ"},{"u":"تُؤْمِنُوا۟","en":"you believe","ur":"تم ایمان لاؤ"},{"u":"بِٱللَّهِ","en":"in Allah","ur":"اللہ پر"},{"u":"وَحْدَهُۥٓ","en":"Alone","ur":"اکیلے اس پر"},{"u":"إِلَّا","en":"Except","ur":"مگر"},{"u":"قَوْلَ","en":"(the) saying","ur":"بات"},{"u":"إِبْرَٰهِيمَ","en":"(of) Ibrahim","ur":"ابراہیم کی"},{"u":"لِأَبِيهِ","en":"to his father","ur":"اپنے والد کے لیے"},{"u":"لَأَسْتَغْفِرَنَّ","en":"Surely I ask forgiveness","ur":"البتہ میں ضرور بخشش مانگوں گا"},{"u":"لَكَ","en":"for you","ur":"آپ کے لیے"},{"u":"وَمَآ","en":"but not","ur":"اور نہیں"},{"u":"أَمْلِكُ","en":"I have power","ur":"میں مالک"},{"u":"لَكَ","en":"for you","ur":"آپ کے لیے"},{"u":"مِنَ","en":"from","ur":"سے"},{"u":"ٱللَّهِ","en":"Allah","ur":"اللہ (سے)"},{"u":"مِن","en":"of","ur":""},{"u":"شَىْءٍۢ ۖ","en":"anything","ur":"کسی چیز کا"},{"u":"رَّبَّنَا","en":"Our Lord","ur":"اے ہمارے رب"},{"u":"عَلَيْكَ","en":"upon You","ur":"آپ پر