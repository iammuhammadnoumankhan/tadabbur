me forth","ur":"نکلے تم","a":"wbw/060_001_028.mp3"},{"u":"جِهَـٰدًۭا","i":"جِهَادًا","tl":"jihādan","en":"(to) strive","ur":"جہاد کو","a":"wbw/060_001_029.mp3"},{"u":"فِى","i":"فِىۡ","tl":"fī","en":"in","ur":"میں","a":"wbw/060_001_030.mp3"},{"u":"سَبِيلِى","i":"سَبِيۡلِىۡ","tl":"sabīlī","en":"My way","ur":"میرے راستے (میں)","a":"wbw/060_001_031.mp3"},{"u":"وَٱبْتِغَآءَ","i":"وَ ابۡتِغَآءَ","tl":"wa-ib'tighāa","en":"and (to) seek","ur":"اور تلاش کرنے کو","a":"wbw/060_001_032.mp3"},{"u":"مَرْضَاتِى ۚ","i":"مَرۡضَاتِىۡ ​ۖ ","tl":"marḍātī","en":"My Pleasure","ur":"میری رضا","a":"wbw/060_001_033.mp3"},{"u":"تُسِرُّونَ","i":"تُسِرُّوۡنَ","tl":"tusirrūna","en":"You confide","ur":"تم چھپا کر بھیجتے ہو","a":"wbw/060_001_035.mp3"},{"u":"إِلَيْهِم","i":"اِلَيۡهِمۡ","tl":"ilayhim","en":"to them","ur":"ان کی طرف","a":"wbw/060_001_036.mp3"},{"u":"بِٱلْمَوَدَّةِ","i":"بِالۡمَوَدَّةِ ​ۖ ","tl":"bil-mawadati","en":"love","ur":"محبت کو","a":"wbw/060_001_037.mp3"},{"u":"وَأَنَا۠","i":"وَاَنَا","tl":"wa-anā","en":"but I Am","ur":"اور میں","a":"wbw/060_001_038.mp3"},{"u":"أَعْلَمُ","i":"اَعۡلَمُ","tl":"aʿlamu","en":"most knowing","ur":"خوب جانتا ہوں","a":"wbw/060_001_039.mp3"},{"u":"بِمَآ","i":"بِمَاۤ","tl":"bimā","en":"of what","ur":"ساتھ اس کے جو","a":"wbw/060_001_040.mp3"},{"u":"أَخْفَيْتُمْ","i":"اَخۡفَيۡتُمۡ","tl":"akhfaytum","en":"you conceal","ur":"تم چھپاتے ہو","a":"wbw/060_001_041.mp3"},{"u":"وَمَآ","i":"وَمَاۤ","tl":"wamā","en":"and what","ur":"اور جو","a":"wbw/060_001_042.mp3"},{"u":"أَعْلَنتُمْ ۚ","i":"اَعۡلَنۡتُمۡ​ؕ","tl":"aʿlantum","en":"you declare","ur":"تم ظاہر کرتے ہو","a":"wbw/060_001_043.mp3"},{"u":"وَمَن","i":"وَمَنۡ","tl":"waman","en":"And whoever","ur":"اور جو کوئی","a":"wbw/060_001_045.mp3"},{"u":"يَفْعَلْهُ","i":"يَّفۡعَلۡهُ","tl":"yafʿalhu","en":"does it","ur":"کرے گا اس کو","a":"wbw/060_001_046.mp3"},{"u":"مِنكُمْ","i":"مِنۡكُمۡ","tl":"minkum","en":"among you","ur":"تم میں سے","a":"wbw/060_001_047.mp3"},{"u":"فَقَدْ","i":"فَقَدۡ","tl":"faqad","en":"then 