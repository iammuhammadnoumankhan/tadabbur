{"n":61,"src":{"text":"qc-text","wbw":"qc-wbw"},"ayahs":[{"k":"61:1","n":1,"id":5164,"u":" سَبَّحَ لِلَّهِ مَا فِى ٱلسَّمَـٰوَٰتِ وَمَا فِى ٱلْأَرْضِ ۖ وَهُوَ ٱلْعَزِيزُ ٱلْحَكِيمُ","i":"سَبَّحَ لِلّٰهِ مَا فِى السَّمٰوٰتِ وَمَا فِى الۡاَرۡضِ​ۚ وَهُوَ الۡعَزِيۡزُ الۡحَكِيۡمُ‏","juz":28,"page":551,"sajdah":false,"w":[{"u":"سَبَّحَ","i":"سَبَّحَ","tl":"sabbaḥa","en":"Glorifies","ur":"تسبیح کی ہے","a":"wbw/061_001_001.mp3"},{"u":"لِلَّهِ","i":"لِلّٰهِ","tl":"lillahi","en":"Allah","ur":"اللہ کے","a":"wbw/061_001_002.mp3"},{"u":"مَا","i":"مَا","tl":"mā","en":"whatever","ur":"ہر چیز نے جو","a":"wbw/061_001_003.mp3"},{"u":"فِى","i":"فِى","tl":"fī","en":"(is) in","ur":"میں","a":"wbw/061_001_004.mp3"},{"u":"ٱلسَّمَـٰوَٰتِ","i":"السَّمٰوٰتِ","tl":"l-samāwāti","en":"the heavens","ur":"آسمانوں میں ہے","a":"wbw/061_001_005.mp3"},{"u":"وَمَا","i":"وَمَا","tl":"wamā","en":"and whatever","ur":"اور جو","a":"wbw/061_001_006.mp3"},{"u":"فِى","i":"فِى","tl":"fī","en":"(is) in","ur":"میں","a":"wbw/061_001_007.mp3"},{"u":"ٱلْأَرْضِ ۖ","i":"الۡاَرۡضِ​ۚ","tl":"l-arḍi","en":"the earth","ur":"زمین میں ہے","a":"wbw/061_001_008.mp3"},{"u":"وَهُوَ","i":"وَهُوَ","tl":"wahuwa","en":"And He","ur":"اور وہ","a":"wbw/061_001_010.mp3"},{"u":"ٱلْعَزِيزُ","i":"الۡعَزِيۡزُ","tl":"l-ʿazīzu","en":"(is) the All-Mighty","ur":"زبردست ہے","a":"wbw/061_001_011.mp3"},{"u":"ٱلْحَكِيمُ","i":"الۡحَكِيۡمُ‏","tl":"l-ḥakīmu","en":"the All-Wise","ur":"حکمت والا ہے","a":"wbw/061_001_012.mp3"}]},{"k":"61:2","n":2,"id":5165,"u":"يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ لِمَ تَقُولُونَ مَا لَا تَفْعَلُونَ","i":"يٰۤاَيُّهَا الَّذِيۡنَ اٰمَنُوۡا لِمَ تَقُوۡلُوۡنَ مَا لَا تَفۡعَلُوۡنَ‏","juz":28,"page":551,"sajdah":false,"w":[{"u":"يَـٰٓأَيُّهَا","i":"يٰۤاَيُّهَا","tl":"yāayyuhā","en":"O","ur":"اے","a":"wbw/061_002_001.mp3"},{"u":"ٱلَّذِينَ","i":"الَّذِيۡنَ","tl":"alladhīna","en":"(you) who","ur":"لوگو","a":"wbw/061_002_002.mp3"},{"u":"ءَامَنُوا۟","i":"اٰمَنُوۡا","tl":"āmanū","en":"believe","ur":"جو ایمان لائے ہو","a":"wbw/061_002_003.mp3"},{"u":"لِمَ","i":"لِمَ","tl":"lima","en":"Why","ur":"کیوں","a":"wbw/061_002_004.mp3"},{"u":"تَقُولُونَ","i":"تَقُوۡلُوۡنَ","tl":"taqūlūna","en":"(do) you say","ur":"تم کہتے ہو","a":"wbw/061_002_005.mp3"},{"u":"مَا","i":"مَا","tl":"mā","en":"what","ur":"وہ جو","a":"wbw/061_002_006.mp3"},{"u":"لَا","i":"لَا","tl":"lā","en":"not","ur":"نہیں","a":"wbw/061_002_007.mp3"},{"u":"تَفْعَلُونَ","i":"تَفۡعَلُوۡنَ‏","tl":"tafʿalūna","en":"you do","ur":"تم کرتے","a":"wbw/061_002_008.mp3"}]},{"k":"61:3","n":3,"id":5166,"u":"كَبُرَ مَقْتًا عِندَ ٱللَّهِ أَن تَقُولُوا۟ مَا لَا تَفْعَلُونَ","i":"كَبُرَ مَقۡتًا عِنۡدَ اللّٰهِ اَنۡ تَقُوۡلُوۡا مَا لَا تَفۡعَلُوۡنَ‏","juz":28,"page":551,"sajdah":false,"w":[{"u":"كَبُرَ","i":"كَبُرَ","tl":"kabura","en":"Great is","ur":"بڑا ہے","a":"wbw/061_003_001.mp3"},{"u":"مَقْتًا","i":"مَقۡتًا","tl":"maqtan","en":"hatred","ur":"بغض میں۔ ناراضگی میں","a":"wbw/061_003_002.mp3"},{"u":"عِندَ","i":"عِنۡدَ","tl":"ʿinda","en":"with","ur":"ہاں","a":"wbw/061_003_003.mp3"},{"u":"ٱللَّهِ","i":"اللّٰهِ","tl":"l-lahi","en":"Allah","ur":"اللہ کے","a":"wbw/061_003_004.mp3"},{"u":"أَن","i":"اَنۡ","tl":"an","en":"that","ur":"کہ","a":"wbw/061_003_005.mp3"},{"u":"تَقُولُوا۟","i":"تَقُوۡلُوۡا","tl":"taqūlū","en":"you say","ur":"تم کہو","a":"wbw/061_003_006.mp3"},{"u":"مَا","i":"مَا","tl":"mā","en":"what","ur":"وہ جو","a":"wbw/061_003_007.mp3"},{"u":"لَا","i":"لَا","tl":"lā","en":"not","ur":"نہیں","a":"wbw/061_003_008.mp3"},{"u":"تَفْعَلُونَ","i":"تَفۡعَلُوۡنَ‏","tl":"tafʿalūna","en":"you do","ur":"تم کرتے","a":"wbw/061_003_009.mp3"}]},{"k":"61:4","n":4,"id":5167,"u":"إِنَّ ٱللَّهَ يُحِبُّ ٱلَّذِينَ يُقَـٰتِلُونَ فِى سَبِيلِهِۦ صَفًّا كَأَنَّهُم بُنْيَـٰنٌ مَّرْصُوصٌ","i":"اِنَّ اللّٰهَ يُحِبُّ الَّذِيۡنَ يُقَاتِلُوۡنَ فِىۡ سَبِيۡلِهٖ صَفًّا كَاَنَّهُمۡ بُنۡيَانٌ مَّرۡصُوۡصٌ‏","juz":28,"page":551,"sajdah":false,"w":[{"u":"إِنَّ","i":"اِنَّ","tl":"inna","en":"Indeed","ur":"بیشک","a":"wbw/061_004_001.mp3"},{"u":"ٱللَّهَ","i":"اللّٰهَ","tl":"l-laha","en":"Allah","u