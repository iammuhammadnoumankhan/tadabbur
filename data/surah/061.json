-fāsiqīna","en":"the defiantly disobedient","ur":"فاسق","a":"wbw/061_005_025.mp3"}]},{"k":"61:6","n":6,"id":5169,"u":"وَإِذْ قَالَ عِيسَى ٱبْنُ مَرْيَمَ يَـٰبَنِىٓ إِسْرَٰٓءِيلَ إِنِّى رَسُولُ ٱللَّهِ إِلَيْكُم مُّصَدِّقًا لِّمَا بَيْنَ يَدَىَّ مِنَ ٱلتَّوْرَىٰةِ وَمُبَشِّرًۢا بِرَسُولٍ يَأْتِى مِنۢ بَعْدِى ٱسْمُهُۥٓ أَحْمَدُ ۖ فَلَمَّا جَآءَهُم بِٱلْبَيِّنَـٰتِ قَالُوا۟ هَـٰذَا سِحْرٌ مُّبِينٌ","i":"وَاِذۡ قَالَ عِيۡسَى ابۡنُ مَرۡيَمَ يٰبَنِىۡۤ اِسۡرَآءِيۡلَ اِنِّىۡ رَسُوۡلُ اللّٰهِ اِلَيۡكُمۡ مُّصَدِّقًا لِّمَا بَيۡنَ يَدَىَّ مِنَ التَّوۡرٰٮةِ وَمُبَشِّرًۢا بِرَسُوۡلٍ يَّاۡتِىۡ مِنۡۢ بَعۡدِى اسۡمُهٗۤ اَحۡمَدُ​ؕ فَلَمَّا جَآءَهُمۡ بِالۡبَيِّنٰتِ قَالُوۡا هٰذَا سِحۡرٌ مُّبِيۡنٌ‏","juz":28,"page":552,"sajdah":false,"w":[{"u":"وَإِذْ","i":"وَاِذۡ","tl":"wa-idh","en":"And when","ur":"اور جب","a":"wbw/061_006_001.mp3"},{"u":"قَالَ","i":"قَالَ","tl":"qāla","en":"said","ur":"کہا","a":"wbw/061_006_002.mp3"},{"u":"عِيسَى","i":"عِيۡسَى","tl":"ʿīsā","en":"Isa","ur":"عیسیٰ","a":"wbw/061_006_003.mp3"},{"u":"ٱبْنُ","i":"ابۡنُ","tl":"ub'nu","en":"son","ur":"ابن","a":"wbw/061_006_004.mp3"},{"u":"مَرْيَمَ","i":"مَرۡيَمَ","tl":"maryama","en":"(of) Maryam","ur":"مریم نے","a":"wbw/061_006_005.mp3"},{"u":"يَـٰبَنِىٓ","i":"يٰبَنِىۡۤ","tl":"yābanī","en":"O Children","ur":"اے بنی","a":"wbw/061_006_006.mp3"},{"u":"إِسْرَٰٓءِيلَ","i":"اِسۡرَآءِيۡلَ","tl":"is'rāīla","en":"(of) Israel","ur":"اسرائیل","a":"wbw/061_006_007.mp3"},{"u":"إِنِّى","i":"اِنِّىۡ","tl":"innī","en":"Indeed, I am","ur":"بیشک میں","a":"wbw/061_006_008.mp3"},{"u":"رَسُولُ","i":"رَسُوۡلُ","tl":"rasūlu","en":"(the) Messenger","ur":"رسول ہوں","a":"wbw/061_006_009.mp3"},{"u":"ٱللَّهِ","i":"اللّٰهِ","tl":"l-lahi","en":"(of) Allah","ur":"اللہ کا","a":"wbw/061_006_010.mp3"},{"u":"إِلَيْكُم","i":"اِلَيۡكُمۡ","tl":"ilaykum","en":"to you","ur":"تمہاری طرف","a":"wbw/061_006_011.mp3"},{"u":"مُّصَدِّقًۭا","i":"مُّصَدِّقًا","tl":"muṣaddiqan","en":"confirming","ur":"تصدیق کرنے والا ہوں","a":"wbw/061_006_012.mp3"},{"u":"لِّمَا","i":"ل