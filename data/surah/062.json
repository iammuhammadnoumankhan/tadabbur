{"n":62,"src":{"text":"qc-text","wbw":"qc-wbw"},"ayahs":[{"k":"62:1","n":1,"id":5178,"u":" يُسَبِّحُ لِلَّهِ مَا فِى ٱلسَّمَـٰوَٰتِ وَمَا فِى ٱلْأَرْضِ ٱلْمَلِكِ ٱلْقُدُّوسِ ٱلْعَزِيزِ ٱلْحَكِيمِ","i":"يُسَبِّحُ لِلّٰهِ مَا فِى السَّمٰوٰتِ وَمَا فِى الۡاَرۡضِ الۡمَلِكِ الۡقُدُّوۡسِ الۡعَزِيۡزِ الۡحَكِيۡمِ‏","juz":28,"page":553,"sajdah":false,"w":[{"u":"يُسَبِّحُ","i":"يُسَبِّحُ","tl":"yusabbiḥu","en":"Glorifies","ur":"تسبیح کررہی ہے","a":"wbw/062_001_001.mp3"},{"u":"لِلَّهِ","i":"لِلّٰهِ","tl":"lillahi","en":"Allah","ur":"اللہ ہی کے لیے","a":"wbw/062_001_002.mp3"},{"u":"مَا","i":"مَا","tl":"mā","en":"whatever","ur":"ہر وہ چیز جو","a":"wbw/062_001_003.mp3"},{"u":"فِى","i":"فِى","tl":"fī","en":"(is) in","ur":"میں","a":"wbw/062_001_004.mp3"},{"u":"ٱلسَّمَـٰوَٰتِ","i":"السَّمٰوٰتِ","tl":"l-samāwāti","en":"the heavens","ur":"آسمان میں ہے","a":"wbw/062_001_005.mp3"},{"u":"وَمَا","i":"وَمَا","tl":"wamā","en":"and whatever","ur":"اور جو","a":"wbw/062_001_006.mp3"},{"u":"فِى","i":"فِى","tl":"fī","en":"(is) in","ur":"میں","a":"wbw/062_001_007.mp3"},{"u":"ٱلْأَرْضِ","i":"الۡاَرۡضِ","tl":"l-arḍi","en":"the earth","ur":"زمین میں ہے","a":"wbw/062_001_008.mp3"},{"u":"ٱلْمَلِكِ","i":"الۡمَلِكِ","tl":"l-maliki","en":"the Sovereign","ur":"جو بادشاہ ہے","a":"wbw/062_001_009.mp3"},{"u":"ٱلْقُدُّوسِ","i":"الۡقُدُّوۡسِ","tl":"l-qudūsi","en":"the Holy","ur":"نہایت پاکیزہ","a":"wbw/062_001_010.mp3"},{"u":"ٱلْعَزِيزِ","i":"الۡعَزِيۡزِ","tl":"l-ʿazīzi","en":"the All-Mighty","ur":"زبردست","a":"wbw/062_001_011.mp3"},{"u":"ٱلْحَكِيمِ","i":"الۡحَكِيۡمِ‏","tl":"l-ḥakīmi","en":"the All-Wise","ur":"حکمت والا","a":"wbw/062_001_012.mp3"}]},{"k":"62:2","n":2,"id":5179,"u":"هُوَ ٱلَّذِى بَعَثَ فِى ٱلْأُمِّيِّـۧنَ رَسُولًا مِّنْهُمْ يَتْلُوا۟ عَلَيْهِمْ ءَايَـٰتِهِۦ وَيُزَكِّيهِمْ وَيُعَلِّمُهُمُ ٱلْكِتَـٰبَ وَٱلْحِكْمَةَ وَإِن كَانُوا۟ مِن قَبْلُ لَفِى ضَلَـٰلٍ مُّبِينٍ","i":"هُوَ الَّذِىۡ بَعَثَ فِى الۡاُمِّيّٖنَ رَسُوۡلًا مِّنۡهُمۡ يَتۡلُوۡا عَلَيۡهِمۡ اٰيٰتِهٖ وَيُزَكِّيۡهِمۡ وَيُعَلِّمُهُمُ الۡكِتٰ