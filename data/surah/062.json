":"truthful","ur":"سچے"}]},{"k":"62:7","n":7,"id":5184,"u":"وَلَا يَتَمَنَّوْنَهُۥٓ أَبَدًۢا بِمَا قَدَّمَتْ أَيْدِيهِمْ ۚ وَٱللَّهُ عَلِيمٌۢ بِٱلظَّـٰلِمِينَ","juz":28,"page":553,"sajdah":false,"w":[{"u":"وَلَا","en":"But not","ur":"اور نہ"},{"u":"يَتَمَنَّوْنَهُۥٓ","en":"they will wish for it","ur":"وہ تمنا کریں گے اس کی"},{"u":"أَبَدًۢا","en":"ever","ur":"کبھی بھی"},{"u":"بِمَا","en":"for what","ur":"بوجہ اس کے جو"},{"u":"قَدَّمَتْ","en":"(have) sent forth","ur":"آگے بھیجا"},{"u":"أَيْدِيهِمْ ۚ","en":"their hands","ur":"ان کے ہاتھوں نے"},{"u":"وَٱللَّهُ","en":"And Allah","ur":"اور اللہ"},{"u":"عَلِيمٌۢ","en":"(is) All-Knowing","ur":"جاننے والا ہے"},{"u":"بِٱلظَّـٰلِمِينَ","en":"of the wrongdoers","ur":"ظالموں کو"}]},{"k":"62:8","n":8,"id":5185,"u":"قُلْ إِنَّ ٱلْمَوْتَ ٱلَّذِى تَفِرُّونَ مِنْهُ فَإِنَّهُۥ مُلَـٰقِيكُمْ ۖ ثُمَّ تُرَدُّونَ إِلَىٰ عَـٰلِمِ ٱلْغَيْبِ وَٱلشَّهَـٰدَةِ فَيُنَبِّئُكُم بِمَا كُنتُمْ تَعْمَلُونَ","juz":28,"page":553,"sajdah":false,"w":[{"u":"قُلْ","en":"Say","ur":"کہہ دیجئے"},{"u":"إِنَّ","en":"Indeed","ur":"بیشک"},{"u":"ٱلْمَوْتَ","en":"the death","ur":"موت"},{"u":"ٱلَّذِى","en":"which","ur":"وہ جو"},{"u":"تَفِرُّونَ","en":"you flee","ur":"تم بھاگتے ہو"},{"u":"مِنْهُ","en":"from it","ur":"اس سے"},{"u":"فَإِنَّهُۥ","en":"then surely it","ur":"تو بیشک وہ"},{"u":"مُلَـٰقِيكُمْ ۖ","en":"(will) meet you","ur":"ملنے والی ہے تم سے"},{"u":"ثُمَّ","en":"Then","ur":"پھر"},{"u":"تُرَدُّونَ","en":"you will be sent back","ur":"تم لوٹائے جاؤ گے"},{"u":"إِلَىٰ","en":"to","ur":"طرف"},{"u":"عَـٰلِمِ","en":"(the) All-Knower","ur":"جاننے والے"},{"u":"ٱلْغَيْبِ","en":"(of) the unseen","ur":"غیب کے"},{"u":"وَٱلشَّهَـٰدَةِ","en":"and the witnessed","ur":"اور حاضر کے"},{"u":"فَيُنَبِّئُكُم","en":"and He will inform you","ur":"پھر وہ بتادے گا تم کو"},{"u":"بِمَا","en":"[of] what","ur":"ساتھ اس کے جو"},{"u":"كُنتُمْ","en":"you used to","ur":"تم"},{"u":"تَعْمَلُونَ","en":"do","ur":"تم عمل کرتے"}]},{"k":"62:9","n":9,"id":5186,"u":"يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓا