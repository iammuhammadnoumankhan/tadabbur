{"n":62,"src":{"text":"qc-text","wbw":"qc-wbw"},"ayahs":[{"k":"62:1","n":1,"id":5178,"u":" يُسَبِّحُ لِلَّهِ مَا فِى ٱلسَّمَـٰوَٰتِ وَمَا فِى ٱلْأَرْضِ ٱلْمَلِكِ ٱلْقُدُّوسِ ٱلْعَزِيزِ ٱلْحَكِيمِ","juz":28,"page":553,"sajdah":false,"w":[{"u":"يُسَبِّحُ","en":"Glorifies","ur":"تسبیح کررہی ہے"},{"u":"لِلَّهِ","en":"Allah","ur":"اللہ ہی کے لیے"},{"u":"مَا","en":"whatever","ur":"ہر وہ چیز جو"},{"u":"فِى","en":"(is) in","ur":"میں"},{"u":"ٱلسَّمَـٰوَٰتِ","en":"the heavens","ur":"آسمان میں ہے"},{"u":"وَمَا","en":"and whatever","ur":"اور جو"},{"u":"فِى","en":"(is) in","ur":"میں"},{"u":"ٱلْأَرْضِ","en":"the earth","ur":"زمین میں ہے"},{"u":"ٱلْمَلِكِ","en":"the Sovereign","ur":"جو بادشاہ ہے"},{"u":"ٱلْقُدُّوسِ","en":"the Holy","ur":"نہایت پاکیزہ"},{"u":"ٱلْعَزِيزِ","en":"the All-Mighty","ur":"زبردست"},{"u":"ٱلْحَكِيمِ","en":"the All-Wise","ur":"حکمت والا"}]},{"k":"62:2","n":2,"id":5179,"u":"هُوَ ٱلَّذِى بَعَثَ فِى ٱلْأُمِّيِّـۧنَ رَسُولًا مِّنْهُمْ يَتْلُوا۟ عَلَيْهِمْ ءَايَـٰتِهِۦ وَيُزَكِّيهِمْ وَيُعَلِّمُهُمُ ٱلْكِتَـٰبَ وَٱلْحِكْمَةَ وَإِن كَانُوا۟ مِن قَبْلُ لَفِى ضَلَـٰلٍ مُّبِينٍ","juz":28,"page":553,"sajdah":false,"w":[{"u":"هُوَ","en":"He","ur":"وہ اللہ"},{"u":"ٱلَّذِى","en":"(is) the One Who","ur":"وہ ذات ہے"},{"u":"بَعَثَ","en":"sent","ur":"جس نے بھیجا"},{"u":"فِى","en":"among","ur":"میں"},{"u":"ٱلْأُمِّيِّـۧنَ","en":"the unlettered","ur":"ان پڑھ لوگوں (میں)"},{"u":"رَسُولًۭا","en":"a Messenger","ur":"ایک رسول"},{"u":"مِّنْهُمْ","en":"from themselves","ur":"انہی میں سے"},{"u":"يَتْلُوا۟","en":"reciting","ur":"جو پڑھتا ہے"},{"u":"عَلَيْهِمْ","en":"to them","ur":"ان پر"},{"u":"ءَايَـٰتِهِۦ","en":"His Verses","ur":"اس کی آیات"},{"u":"وَيُزَكِّيهِمْ","en":"and purifying them","ur":"اور ان کا تزکیہ کرتا ہے"},{"u":"وَيُعَلِّمُهُمُ","en":"and teaching them","ur":"اور سکھاتا ہے ان کو"},{"u":"ٱلْكِتَـٰبَ","en":"the Book","ur":"کتاب"},{"u":"وَٱلْحِكْمَةَ","en":"and the wisdom","ur":"اور حکمت"},{"u":"وَإِن","en":"although","ur":"اور بیشک"},{"u":"كَانُوا۟","en":"they were","ur":"تھے وہ"},{"u":"مِن","en":"from","ur":"سے"},{"u":"قَبْلُ","en":"before","ur":"اس سے پہلے"},{"u":"لَفِى","en":"surely in","ur":"البتہ میں"},{"u":"ضَلَـٰلٍۢ","en":"an error","ur":"گمراہی میں"},{"u":"مُّبِينٍۢ","en":"clear","ur":"کھلی"}]},{"k":"62:3","n":3,"id":5180,"u":"وَءَاخَرِينَ مِنْهُمْ لَمَّا يَلْحَقُوا۟ بِهِمْ ۚ وَهُوَ ٱلْعَزِيزُ ٱلْحَكِيمُ","juz":28,"page":553,"sajdah":false,"w":[{"u":"وَءَاخَرِينَ","en":"And others","ur":"اور کچھ دوسرے"},{"u":"مِنْهُمْ","en":"among them","ur":"ان میں سے"},{"u":"لَمَّا","en":"who have not yet","ur":"حالانکہ (نہیں)"},{"u":"يَلْحَقُوا۟","en":"joined","ur":"وہ ملے"},{"u":"بِهِمْ ۚ","en":"them","ur":"ان کے ساتھ"},{"u":"وَهُوَ","en":"and He","ur":"اور وہ"},{"u":"ٱلْعَزِيزُ","en":"(is) the All-Mighty","ur":"زبردست ہے"},{"u":"ٱلْحَكِيمُ","en":"the All-Wise","ur":"حکمت والا ہے"}]},{"k":"62:4","n":4,"id":5181,"u":"ذَٰلِكَ فَضْلُ ٱللَّهِ يُؤْتِيهِ مَن يَشَآءُ ۚ وَٱللَّهُ ذُو ٱلْفَضْلِ ٱلْعَظِيمِ","juz":28,"page":553,"sajdah":false,"w":[{"u":"ذَٰلِكَ","en":"That","ur":"یہ"},{"u":"فَضْلُ","en":"(is the) Bounty","ur":"فضل ہے"},{"u":"ٱللَّهِ","en":"(of) Allah","ur":"اللہ کا"},{"u":"يُؤْتِيهِ","en":"He gives it","ur":"دیتا ہے اسے"},{"u":"مَن","en":"(to) whom","ur":"جس کو"},{"u":"يَشَآءُ ۚ","en":"He wills","ur":"وہ چاہتا ہے"},{"u":"وَٱللَّهُ","en":"And Allah","ur":"اور اللہ"},{"u":"ذُو","en":"(is the) Possessor","ur":"والا ہے"},{"u":"ٱلْفَضْلِ","en":"(of) Bounty","ur":"فضل (والا ہے)"},{"u":"ٱلْعَظِيمِ","en":"the Great","ur":"بڑے"}]},{"k":"62:5","n":5,"id":5182,"u":"مَثَلُ ٱلَّذِينَ حُمِّلُوا۟ ٱلتَّوْرَىٰةَ ثُمَّ لَمْ يَحْمِلُوهَا كَمَثَلِ ٱلْحِمَارِ يَحْمِلُ أَسْفَارًۢا ۚ بِئْسَ مَثَلُ ٱلْقَوْمِ ٱلَّذِينَ كَذَّبُوا۟ بِـَٔايَـٰتِ ٱللَّهِ ۚ وَٱللَّهُ لَا يَهْدِى ٱلْقَوْمَ ٱلظَّـٰلِمِينَ","juz":28,"page":553,"sajdah":false,"w":[{"u":"مَثَلُ","en":"(The) likeness","ur":"مثال"},{"u":"ٱلَّذِينَ","en":"(of) those who","ur":"ان لوگوں کی"},{"u":"حُمِّلُوا۟","en":"were entrusted","ur":"جو اٹھوائے گئے"},{"u":"ٱلتَّوْرَىٰةَ","en":"(with) the Taurat",