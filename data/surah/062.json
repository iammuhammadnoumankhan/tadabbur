llah","ur":"اللہ کا"},{"u":"كَثِيرًۭا","en":"much","ur":"بہت"},{"u":"لَّعَلَّكُمْ","en":"so that you may","ur":"تاکہ تم"},{"u":"تُفْلِحُونَ","en":"succeed","ur":"تم فلاح پاؤ"}]},{"k":"62:11","n":11,"id":5188,"u":"وَإِذَا رَأَوْا۟ تِجَـٰرَةً أَوْ لَهْوًا ٱنفَضُّوٓا۟ إِلَيْهَا وَتَرَكُوكَ قَآئِمًا ۚ قُلْ مَا عِندَ ٱللَّهِ خَيْرٌ مِّنَ ٱللَّهْوِ وَمِنَ ٱلتِّجَـٰرَةِ ۚ وَٱللَّهُ خَيْرُ ٱلرَّٰزِقِينَ","juz":28,"page":554,"sajdah":false,"w":[{"u":"وَإِذَا","en":"And when","ur":"اور جب"},{"u":"رَأَوْا۟","en":"they saw","ur":"انہوں نے دیکھا"},{"u":"تِجَـٰرَةً","en":"a transaction","ur":"تجارت کو"},{"u":"أَوْ","en":"or","ur":"یا"},{"u":"لَهْوًا","en":"a sport","ur":"کھیل"},{"u":"ٱنفَضُّوٓا۟","en":"they rushed","ur":"تماشے کو مائل ہوگئے"},{"u":"إِلَيْهَا","en":"to it","ur":"اس کی طرف"},{"u":"وَتَرَكُوكَ","en":"and left you","ur":"اور انہوں نے چھوڑ دیا آپ کو"},{"u":"قَآئِمًۭا ۚ","en":"standing","ur":"کھڑے۔ کھڑی حالت میں"},{"u":"قُلْ","en":"Say","ur":"کہہ دیجئے"},{"u":"مَا","en":"What","ur":"جو"},{"u":"عِندَ","en":"(is) with","ur":"پاس ہے"},{"u":"ٱللَّهِ","en":"Allah","ur":"اللہ کے (پاس ہے)"},{"u":"خَيْرٌۭ","en":"(is) better","ur":"بہتر ہے"},{"u":"مِّنَ","en":"than","ur":"سے"},{"u":"ٱللَّهْوِ","en":"the sport","ur":"کھیل تماشے"},{"u":"وَمِنَ","en":"and from","ur":"سے اور"},{"u":"ٱلتِّجَـٰرَةِ ۚ","en":"(any) transaction","ur":"تجارت (سے)"},{"u":"وَٱللَّهُ","en":"And Allah","ur":"اور اللہ"},{"u":"خَيْرُ","en":"(is the) Best","ur":"بہترین"},{"u":"ٱلرَّٰزِقِينَ","en":"(of) the Providers","ur":"رزق دینے والا ہے"}]}]}