{"n":63,"src":{"text":"qc-text","wbw":"qc-wbw"},"ayahs":[{"k":"63:1","n":1,"id":5189,"u":" إِذَا جَآءَكَ ٱلْمُنَـٰفِقُونَ قَالُوا۟ نَشْهَدُ إِنَّكَ لَرَسُولُ ٱللَّهِ ۗ وَٱللَّهُ يَعْلَمُ إِنَّكَ لَرَسُولُهُۥ وَٱللَّهُ يَشْهَدُ إِنَّ ٱلْمُنَـٰفِقِينَ لَكَـٰذِبُونَ","i":"اِذَا جَآءَكَ الۡمُنٰفِقُوۡنَ قَالُوۡا نَشۡهَدُ اِنَّكَ لَرَسُوۡلُ اللّٰهِ ​ۘ وَاللّٰهُ يَعۡلَمُ اِنَّكَ لَرَسُوۡلُهٗ ؕ وَاللّٰهُ يَشۡهَدُ اِنَّ الۡمُنٰفِقِيۡنَ لَـكٰذِبُوۡنَ​ ۚ‏","juz":28,"page":554,"sajdah":false,"w":[{"u":"إِذَا","i":"اِذَا","tl":"idhā","en":"When","ur":"جب","a":"wbw/063_001_001.mp3"},{"u":"جَآءَكَ","i":"جَآءَكَ","tl":"jāaka","en":"come to you","ur":"آتے ہیں تیرے پاس","a":"wbw/063_001_002.mp3"},{"u":"ٱلْمُنَـٰفِقُونَ","i":"الۡمُنٰفِقُوۡنَ","tl":"l-munāfiqūna","en":"the hypocrites","ur":"منافق","a":"wbw/063_001_003.mp3"},{"u":"قَالُوا۟","i":"قَالُوۡا","tl":"qālū","en":"they say","ur":"کہتے ہیں","a":"wbw/063_001_004.mp3"},{"u":"نَشْهَدُ","i":"نَشۡهَدُ","tl":"nashhadu","en":"We testify","ur":"ہم گواہی دیتے ہیں","a":"wbw/063_001_005.mp3"},{"u":"إِنَّكَ","i":"اِنَّكَ","tl":"innaka","en":"that you","ur":"بیشک آپ","a":"wbw/063_001_006.mp3"},{"u":"لَرَسُولُ","i":"لَرَسُوۡلُ","tl":"larasūlu","en":"(are) surely (the) Messenger","ur":"البتہ رسول ہیں","a":"wbw/063_001_007.mp3"},{"u":"ٱللَّهِ ۗ","i":"اللّٰهِ ​ۘ","tl":"l-lahi","en":"(of) Allah","ur":"اللہ کے","a":"wbw/063_001_008.mp3"},{"u":"وَٱللَّهُ","i":"وَاللّٰهُ","tl":"wal-lahu","en":"And Allah","ur":"اور اللہ","a":"wbw/063_001_010.mp3"},{"u":"يَعْلَمُ","i":"يَعۡلَمُ","tl":"yaʿlamu","en":"knows","ur":"جانتا ہے","a":"wbw/063_001_011.mp3"},{"u":"إِنَّكَ","i":"اِنَّكَ","tl":"innaka","en":"that you","ur":"بیشک آپ","a":"wbw/063_001_012.mp3"},{"u":"لَرَسُولُهُۥ","i":"لَرَسُوۡلُهٗ ؕ","tl":"larasūluhu","en":"(are) surely His Messenger","ur":"البتہ اس کے رسول ہیں","a":"wbw/063_001_013.mp3"},{"u":"وَٱللَّهُ","i":"وَاللّٰهُ","tl":"wal-lahu","en":"and Allah","ur":"اور اللہ","a":"wbw/063_001_014.mp3"},{"u":"يَشْهَدُ","i":"يَشۡهَدُ","tl":"yashhadu","en":"testifies","ur":"گواہی دیتا ہے","a":"wbw/063_001_015.mp3"},{"u":"إِنَّ","i":"اِنَّ","tl":"inna","en":"that","ur":"بیشک","a":"wbw/063_001_016.mp3"},{"u":"ٱلْمُنَـٰفِقِينَ","i":"الۡمُنٰفِقِيۡنَ","tl":"l-munāfiqīna","en":"the hypocrites","ur":"منافق","a":"wbw/063_001_017.mp3"},{"u":"لَكَـٰذِبُونَ","i":"لَـكٰذِبُوۡنَ​ ۚ‏","tl":"lakādhibūna","en":"(are) surely liars","ur":"البتہ جھوٹے ہیں","a":"wbw/063_001_018.mp3"}]},{"k":"63:2","n":2,"id":5190,"u":"ٱتَّخَذُوٓا۟ أَيْمَـٰنَهُمْ جُنَّةً فَصَدُّوا۟ عَن سَبِيلِ ٱللَّهِ ۚ إِنَّهُمْ سَآءَ مَا كَانُوا۟ يَعْمَلُونَ","i":"اِتَّخَذُوۡۤا اَيۡمَانَهُمۡ جُنَّةً فَصَدُّوۡا عَنۡ سَبِيۡلِ اللّٰهِ​ؕ اِنَّهُمۡ سَآءَ مَا كَانُوۡا يَعۡمَلُوۡنَ‏","juz":28,"page":554,"sajdah":false,"w":[{"u":"ٱتَّخَذُوٓا۟","i":"اِتَّخَذُوۡۤا","tl":"ittakhadhū","en":"They take","ur":"انہوں نے بنا لیا","a":"wbw/063_002_001.mp3"},{"u":"أَيْمَـٰنَهُمْ","i":"اَيۡمَانَهُمۡ","tl":"aymānahum","en":"their oaths","ur":"اپنی قسموں کو","a":"wbw/063_002_002.mp3"},{"u":"جُنَّةًۭ","i":"جُنَّةً","tl":"junnatan","en":"(as) a cover","ur":"ڈھال","a":"wbw/063_002_003.mp3"},{"u":"فَصَدُّوا۟","i":"فَصَدُّوۡا","tl":"faṣaddū","en":"so they turn away","ur":"تو انہوں نے روکا","a":"wbw/063_002_004.mp3"},{"u":"عَن","i":"عَنۡ","tl":"ʿan","en":"from","ur":"سے","a":"wbw/063_002_005.mp3"},{"u":"سَبِيلِ","i":"سَبِيۡلِ","tl":"sabīli","en":"(the) Way","ur":"راستے سے","a":"wbw/063_002_006.mp3"},{"u":"ٱللَّهِ ۚ","i":"اللّٰهِ​ؕ","tl":"l-lahi","en":"(of) Allah","ur":"اللہ کے","a":"wbw/063_002_007.mp3"},{"u":"إِنَّهُمْ","i":"اِنَّهُمۡ","tl":"innahum","en":"Indeed, [they]","ur":"بیشک وہ","a":"wbw/063_002_009.mp3"},{"u":"سَآءَ","i":"سَآءَ","tl":"sāa","en":"evil is","ur":"کتنا برا ہے","a":"wbw/063_002_010.mp3"},{"u":"مَا","i":"مَا","tl":"mā","en":"what","ur":"جو کچھ","a":"wbw/063_002_011.mp3"},{"u":"كَانُوا۟","i":"كَانُوۡا","tl":"kānū","en":"they used to","ur":"وہ ہیں","a":"wbw/063_002_012.mp3"},{"u":"يَعْمَلُونَ","i":"يَعۡمَلُوۡنَ‏","tl":"yaʿmalūna","en":"do","ur":"وہ کررہے","a":"wbw/063_002_013.mp3"}]},{"k":"63:3","n":3,"id":5191,"u":"ذَٰلِكَ بِأَنَّهُمْ ءَامَنُوا۟ ثُمَّ كَفَرُوا۟ فَطُبِعَ عَلَىٰ قُلُوبِهِمْ فَهُمْ لَا يَفْقَهُونَ","i":"ذٰلِكَ بِاَنَّهُمۡ اٰمَنُوۡا ثُمَّ كَفَرُوۡا فَطُبِعَ عَلٰى قُلُوۡبِهِمۡ فَهُمۡ لَا يَفۡقَهُوۡنَ‏","juz":28,"page":554,"sajdah":false,"w":[{"u":"ذَٰلِكَ","i":"ذٰلِكَ","tl":"dhālika","en":"That","ur":"یہ","a":"wbw/063_003_001.mp3"},{"u":"بِأَنَّهُمْ","i":"بِاَنَّهُمۡ","tl":"bi-annahum","en":"(is) because","ur":"بوجہ اس کے کہ بیشک وہ","a":"wbw/063_003_002.mp3"},{"u":"ءَامَنُوا۟","i":"اٰمَنُوۡا","tl":"āmanū","en":"they believed","ur":"ایمان لائے","a":"wbw/063_003_003.mp3"},{"u":"ثُمَّ","i":"ثُمَّ","tl":"thumma","en":"then","ur":"پھر","a":"wbw/063_003_004.mp3"},{"u":"كَفَرُوا۟","i":"كَفَرُوۡا","tl":"kafarū","en":"they disbelieved","ur":"انہوں نے کفر کیا","a":"wbw/063_003_005.mp3"},{"u":"فَطُبِعَ","i":"فَطُبِعَ","tl":"faṭubiʿa","en":"so were sealed","ur":"تو مہر لگا دی گئی","a":"wbw/063_003_006.mp3"},{"u":"عَلَىٰ","i":"عَلٰى","tl":"ʿalā","en":"[upon]","ur":"اوپر","a":"wbw/063_003_007.mp3"},{"u":"قُلُوبِهِمْ","i":"قُلُوۡبِهِمۡ","tl":"qulūbihim","en":"their hearts","ur":"ان کے دلوں کے","a":"wbw/063_003_008.mp3"},{"u":"فَهُمْ","i":"فَهُمۡ","tl":"fahum","en":"so they","ur":"پس وہ","a":"wbw/063_003_009.mp3"},{"u":"لَا","i":"لَا","tl":"lā","en":"(do) not","ur":"نہیں","a":"wbw/063_003_010.mp3"},{"u":"يَفْقَهُونَ","i":"يَفۡقَهُوۡنَ‏","tl":"yafqahūna","en":"understand","ur":"سمجھتے ہیں","a":"wbw/063_003_011.mp3"}]},{"k":"63:4","n":4,"id":5192,"u":"۞ وَإِذَا رَأَيْتَهُمْ تُعْجِبُكَ أَجْسَامُهُمْ ۖ وَإِن يَقُولُوا۟ تَسْمَعْ لِقَوْلِهِمْ ۖ كَأَنَّهُمْ خُشُبٌ مُّسَنَّدَةٌ ۖ يَحْسَبُونَ كُلَّ صَيْحَةٍ عَلَيْهِمْ ۚ هُمُ ٱلْعَدُوُّ فَٱحْذَرْهُمْ ۚ قَـٰتَلَهُمُ ٱللَّهُ ۖ أَنَّىٰ يُؤْفَكُونَ","i":"وَاِذَا رَاَيۡتَهُمۡ تُعۡجِبُكَ اَجۡسَامُهُمۡ​ ؕ وَاِنۡ يَّقُوۡلُوۡا تَسۡمَعۡ لِقَوۡلِهِمۡ​ ؕ كَاَنَّهُمۡ خُشُبٌ مُّسَنَّدَةٌ   ​ؕ يَحۡسَبُوۡنَ كُلَّ صَيۡحَةٍ عَلَيۡهِمۡ​ ؕ هُمُ الۡعَدُوُّ فَاحۡذَرۡهُمۡ​ ؕ قَاتَلَهُمُ اللّٰهُ​ اَنّٰى يُـؤۡفَكُوۡنَ‏ ﻿﻿","juz":28,"page":554,"sajdah":false,"w":[{"u":"۞ وَإِذَا","i":"۞ وَاِذَا","tl":"wa-idhā","en":"And when","ur":"پھر جب","a":"wbw/063_004_002.mp3"},{"u":"رَأَيْتَهُمْ","i":"رَاَيۡتَهُمۡ","tl":"ra-aytahum","en":"you see them","ur":"تم دیکھو ان کو","a":"wbw/063_004_003.mp3"},{"u":"تُعْجِبُكَ","i":"تُعۡجِبُكَ","tl":"tuʿ'jibuka","en":"pleases you","ur":"اچھے لگیں گے تم کو","a":"wbw/063_004_004.mp3"},{"u":"أَجْسَامُهُمْ ۖ","i":"اَجۡسَامُهُمۡ​ ؕ","tl":"ajsāmuhum","en":"their bodies","ur":"ان کے جسم","a":"wbw/063_004_005.mp3"},{"u":"وَإِن","i":"وَاِنۡ","tl":"wa-in","en":"and if","ur":"اور اگر","a":"wbw/063_004_007.mp3"},{"u":"يَقُولُوا۟","i":"يَّقُوۡلُوۡا","tl":"yaqūlū","en":"they speak","ur":"وہ بات کریں","a":"wbw/063_004_008.mp3"},{"u":"تَسْمَعْ","i":"تَسۡمَعۡ","tl":"tasmaʿ","en":"you listen","ur":"تم سنتے جاؤ","a":"wbw/063_004_009.mp3"},{"u":"لِقَوْلِهِمْ ۖ","i":"لِقَوۡلِهِمۡ​ ؕ","tl":"liqawlihim","en":"to their speech","ur":"ان کی بات کو","a":"wbw/063_004_010.mp3"},{"u":"كَأَنَّهُمْ","i":"كَاَنَّهُمۡ","tl":"ka-annahum","en":"as if they (were)","ur":"گویا کہ وہ","a":"wbw/063_004_012.mp3"},{"u":"خُشُبٌۭ","i":"خُشُبٌ","tl":"khushubun","en":"pieces of wood","ur":"لکڑیاں ہیں","a":"wbw/063_004_013.mp3"},{"u":"مُّسَنَّدَةٌۭ ۖ","i":"مُّسَنَّدَةٌ   ​ؕ","tl":"musannadatun","en":"propped up","ur":"تختہ لگائی ہوئیں","a":"wbw/063_004_014.mp3"},{"u":"يَحْسَبُونَ","i":"يَحۡسَبُوۡنَ","tl":"yaḥsabūna","en":"They think","ur":"وہ سمجھتے ہیں","a":"wbw/063_004_016.mp3"},{"u":"كُلَّ","i":"كُلَّ","tl":"kulla","en":"every","ur":"ہر","a":"wbw/063_004_017.mp3"},{"u":"صَيْحَةٍ","i":"صَيۡحَةٍ","tl":"ṣayḥatin","en":"shout","ur":"سخت آواز کو","a":"wbw/063_004_018.mp3"},{"u":"عَلَيْهِمْ ۚ","i":"عَلَيۡهِمۡ​ ؕ","tl":"ʿalayhim","en":"(is) against them","ur":"اپنے اوپر","a":"wbw/063_004_019.mp3"},{"u":"هُمُ","i":"هُمُ","tl":"humu","en":"They","ur":"وہ","a":"wbw/063_004_021.mp3"},{"u":"ٱلْعَدُوُّ","i":"الۡعَدُوُّ","tl":"l-ʿaduwu","en":"(are) the enemy","ur":"دشمن ہیں","a":"wbw/063_004_022.mp3"},{"u":