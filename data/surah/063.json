{"n":63,"src":{"text":"qc-text","wbw":"qc-wbw"},"ayahs":[{"k":"63:1","n":1,"id":5189,"u":" إِذَا جَآءَكَ ٱلْمُنَـٰفِقُونَ قَالُوا۟ نَشْهَدُ إِنَّكَ لَرَسُولُ ٱللَّهِ ۗ وَٱللَّهُ يَعْلَمُ إِنَّكَ لَرَسُولُهُۥ وَٱللَّهُ يَشْهَدُ إِنَّ ٱلْمُنَـٰفِقِينَ لَكَـٰذِبُونَ","juz":28,"page":554,"sajdah":false,"w":[{"u":"إِذَا","en":"When","ur":"جب"},{"u":"جَآءَكَ","en":"come to you","ur":"آتے ہیں تیرے پاس"},{"u":"ٱلْمُنَـٰفِقُونَ","en":"the hypocrites","ur":"منافق"},{"u":"قَالُوا۟","en":"they say","ur":"کہتے ہیں"},{"u":"نَشْهَدُ","en":"We testify","ur":"ہم گواہی دیتے ہیں"},{"u":"إِنَّكَ","en":"that you","ur":"بیشک آپ"},{"u":"لَرَسُولُ","en":"(are) surely (the) Messenger","ur":"البتہ رسول ہیں"},{"u":"ٱللَّهِ ۗ","en":"(of) Allah","ur":"اللہ کے"},{"u":"وَٱللَّهُ","en":"And Allah","ur":"اور اللہ"},{"u":"يَعْلَمُ","en":"knows","ur":"جانتا ہے"},{"u":"إِنَّكَ","en":"that you","ur":"بیشک آپ"},{"u":"لَرَسُولُهُۥ","en":"(are) surely His Messenger","ur":"البتہ اس کے رسول ہیں"},{"u":"وَٱللَّهُ","en":"and Allah","ur":"اور اللہ"},{"u":"يَشْهَدُ","en":"testifies","ur":"گواہی دیتا ہے"},{"u":"إِنَّ","en":"that","ur":"بیشک"},{"u":"ٱلْمُنَـٰفِقِينَ","en":"the hypocrites","ur":"منافق"},{"u":"لَكَـٰذِبُونَ","en":"(are) surely liars","ur":"البتہ جھوٹے ہیں"}]},{"k":"63:2","n":2,"id":5190,"u":"ٱتَّخَذُوٓا۟ أَيْمَـٰنَهُمْ جُنَّةً فَصَدُّوا۟ عَن سَبِيلِ ٱللَّهِ ۚ إِنَّهُمْ سَآءَ مَا كَانُوا۟ يَعْمَلُونَ","juz":28,"page":554,"sajdah":false,"w":[{"u":"ٱتَّخَذُوٓا۟","en":"They take","ur":"انہوں نے بنا لیا"},{"u":"أَيْمَـٰنَهُمْ","en":"their oaths","ur":"اپنی قسموں کو"},{"u":"جُنَّةًۭ","en":"(as) a cover","ur":"ڈھال"},{"u":"فَصَدُّوا۟","en":"so they turn away","ur":"تو انہوں نے روکا"},{"u":"عَن","en":"from","ur":"سے"},{"u":"سَبِيلِ","en":"(the) Way","ur":"راستے سے"},{"u":"ٱللَّهِ ۚ","en":"(of) Allah","ur":"اللہ کے"},{"u":"إِنَّهُمْ","en":"Indeed, [they]","ur":"بیشک وہ"},{"u":"سَآءَ","en":"evil is","ur":"کتنا برا ہے"},{"u":"مَا","en":"what","ur":"جو کچھ"},{"u":"كَانُوا۟","en":"they used to","ur":"وہ ہیں"},{"u":"يَعْمَلُونَ","en":"do","ur":"وہ کررہے"}]},{"k":"63:3","n":3,"id":5191,"u":"ذَٰلِكَ بِأَنَّهُمْ ءَامَنُوا۟ ثُمَّ كَفَرُوا۟ فَطُبِعَ عَلَىٰ قُلُوبِهِمْ فَهُمْ لَا يَفْقَهُونَ","juz":28,"page":554,"sajdah":false,"w":[{"u":"ذَٰلِكَ","en":"That","ur":"یہ"},{"u":"بِأَنَّهُمْ","en":"(is) because","ur":"بوجہ اس کے کہ بیشک وہ"},{"u":"ءَامَنُوا۟","en":"they believed","ur":"ایمان لائے"},{"u":"ثُمَّ","en":"then","ur":"پھر"},{"u":"كَفَرُوا۟","en":"they disbelieved","ur":"انہوں نے کفر کیا"},{"u":"فَطُبِعَ","en":"so were sealed","ur":"تو مہر لگا دی گئی"},{"u":"عَلَىٰ","en":"[upon]","ur":"اوپر"},{"u":"قُلُوبِهِمْ","en":"their hearts","ur":"ان کے دلوں کے"},{"u":"فَهُمْ","en":"so they","ur":"پس وہ"},{"u":"لَا","en":"(do) not","ur":"نہیں"},{"u":"يَفْقَهُونَ","en":"understand","ur":"سمجھتے ہیں"}]},{"k":"63:4","n":4,"id":5192,"u":"۞ وَإِذَا رَأَيْتَهُمْ تُعْجِبُكَ أَجْسَامُهُمْ ۖ وَإِن يَقُولُوا۟ تَسْمَعْ لِقَوْلِهِمْ ۖ كَأَنَّهُمْ خُشُبٌ مُّسَنَّدَةٌ ۖ يَحْسَبُونَ كُلَّ صَيْحَةٍ عَلَيْهِمْ ۚ هُمُ ٱلْعَدُوُّ فَٱحْذَرْهُمْ ۚ قَـٰتَلَهُمُ ٱللَّهُ ۖ أَنَّىٰ يُؤْفَكُونَ","juz":28,"page":554,"sajdah":false,"w":[{"u":"۞ وَإِذَا","en":"And when","ur":"پھر جب"},{"u":"رَأَيْتَهُمْ","en":"you see them","ur":"تم دیکھو ان کو"},{"u":"تُعْجِبُكَ","en":"pleases you","ur":"اچھے لگیں گے تم کو"},{"u":"أَجْسَامُهُمْ ۖ","en":"their bodies","ur":"ان کے جسم"},{"u":"وَإِن","en":"and if","ur":"اور اگر"},{"u":"يَقُولُوا۟","en":"they speak","ur":"وہ بات کریں"},{"u":"تَسْمَعْ","en":"you listen","ur":"تم سنتے جاؤ"},{"u":"لِقَوْلِهِمْ ۖ","en":"to their speech","ur":"ان کی بات کو"},{"u":"كَأَنَّهُمْ","en":"as if they (were)","ur":"گویا کہ وہ"},{"u":"خُشُبٌۭ","en":"pieces of wood","ur":"لکڑیاں ہیں"},{"u":"مُّسَنَّدَةٌۭ ۖ","en":"propped up","ur":"تختہ لگائی ہوئیں"},{"u":"يَحْسَبُونَ","en":"They think","ur":"وہ سمجھتے ہیں"},{"u":"كُلَّ","en":"every","ur":"ہر"},{"u":"صَيْحَةٍ","en":"shout","ur":"سخت آواز کو"},{"u":"عَلَيْهِمْ ۚ","en":"(is) against them","ur":"اپنے اوپر"},{"u":"هُمُ","en":"They","ur":"وہ"},{"u":"ٱلْعَدُوُّ","en":"(are) the enemy","ur":"دشمن ہیں"},{"u":"فَٱحْذَرْهُمْ ۚ","en":"so beware of them","ur":"پس ڈرو ان سے۔ بچو ان سے"},{"u":"قَـٰتَلَهُمُ","en":"May destroy them","ur":"غارت کرے ان کو"},{"u":"ٱللَّهُ ۖ","en":"Allah","ur":"اللہ"},{"u":"أَنَّىٰ","en":"How","ur":"کہاں سے"},{"u":"يُؤْفَكُونَ","en":"are they deluded","ur":"وہ پھرے جاتے ہیں"}]},{"k":"63:5","n":5,"id":5193,"u":"وَإِذَا قِيلَ لَهُمْ تَعَالَوْا۟ يَسْتَغْفِرْ لَكُمْ رَسُولُ ٱللَّهِ لَوَّوْا۟ رُءُوسَهُمْ وَرَأَيْتَهُمْ يَصُدُّونَ وَهُم مُّسْتَكْبِرُونَ","juz":28,"page":555,"sajdah":false,"w":[{"u":"وَإِذَا","en":"And when","ur":"اور جب"},{"u":"قِيلَ","en":"it is said","ur":"کہا جاتا ہے"},{"u":"لَهُمْ","en":"to them","ur":"ان سے"},{"u":"تَعَالَوْا۟","en":"Come","ur":"آؤ"},{"u":"يَسْتَغْفِرْ","en":"will ask forgiveness","ur":"بخشش مانگتے ہیں"},{"u":"لَكُمْ","en":"for you","ur":"تمہارے لیے"},{"u":"رَسُولُ","en":"(the) Messenger","ur":"رسول"},{"u":"ٱللَّهِ","en":"(of) Allah","ur":"اللہ کے"},{"u":"لَوَّوْا۟","en":"They turn aside","ur":"موڑتے ہیں"},{"u":"رُءُوسَهُمْ","en":"their heads","ur":"اپنے سروں کو"},{"u":"وَرَأَيْتَهُمْ","en":"and you see them","ur":"اور تم دیکھتے ہو ان کو"},{"u":"يَصُدُّونَ","en":"turning away","ur":"وہ باز رہتے ہیں"},{"u":"وَهُم","en":"while they","ur":"اور وہ"},{"u":"مُّسْتَكْبِرُونَ","en":"(are) arrogant","ur":"تکبر کرنے والے ہیں"}]},{"k":"63:6","n":6,"id":5194,"u":"سَوَآءٌ عَلَيْهِمْ أَسْتَغْفَرْتَ لَهُمْ أَمْ لَمْ تَسْتَغْفِرْ لَهُمْ لَن يَغْفِرَ ٱللَّهُ لَهُمْ ۚ إِنَّ ٱللَّهَ لَا يَهْدِى ٱلْقَوْمَ ٱلْفَـٰسِقِينَ","juz":28,"page":555,"sajdah":false,"w":[{"u":"سَوَآءٌ","en":"(It) is same","ur":"برابر ہے"},{"u":"عَلَيْهِمْ","en":"for them","ur":"ان پر"},{"u":"أَسْتَغْفَرْتَ","en":"whether you ask forgiveness","ur":"خواہ تم بخشش مانگو"},{"u":"لَهُمْ","en":"for them","ur":"ان کے لیے"},{"u":"أَمْ","en":"or","ur":"یا"},{"u":"لَمْ","en":"(do) not","ur":"نہ"},{"u":"تَسْتَغْفِرْ","en":"ask forgiveness","ur":"تم بخشش مانگو"},{"u":"لَهُمْ","en":"for them","ur":"ان کے لیے"},{"u":"لَن","en":"Never","ur":"ہرگز نہ"},{"u":"يَغْفِرَ","en":"will forgive","ur":"معاف کرے گا"},{"u":"ٱللَّهُ","en":"Allah","ur":"اللہ"},{"u":"لَهُمْ ۚ","en":"[to] them","ur":"ان کو"},{"u":"إِنَّ","en":"Indeed","ur":"کیونکہ"},{"u":"ٱللَّهَ","en":"Allah","ur":"اللہ تعالیٰ"},{"u":"لَا","en":"(does) not","ur":"نہیں"},{"u":"يَهْدِى","en":"guide","ur":"ہدایت دیتا"},{"u":"ٱلْقَوْمَ","en":"the people","ur":"قوم کو"},{"u":"ٱلْفَـٰسِقِينَ","en":"the defiantly disobedient","ur":"فاسق"}]},{"k":"63:7","n":7,"id":5195,"u":"هُمُ ٱلَّذِينَ يَقُولُونَ لَا تُنفِقُوا۟ عَلَىٰ مَنْ عِندَ رَسُولِ ٱللَّهِ حَتَّىٰ يَنفَضُّوا۟ ۗ وَلِلَّهِ خَزَآئِنُ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ وَلَـٰكِنَّ ٱلْمُنَـٰفِقِينَ لَا يَفْقَهُونَ","juz":28,"page":555,"sajdah":false,"w":[{"u":"هُمُ","en":"They","ur":"وہ"},{"u":"ٱلَّذِينَ","en":"(are) those who","ur":"لوگ ہیں"},{"u":"يَقُولُونَ","en":"say","ur":"جو کہتے ہیں"},{"u":"لَا","en":"(Do) not","ur":"نہ"},{"u":"تُنفِقُوا۟","en":"spend","ur":"تم خرچ کرو"},{"u":"عَلَىٰ","en":"on","ur":"اوپر"},{"u":"مَنْ","en":"(those) who","ur":"اس کے جو"},{"u":"عِندَ","en":"(are) with","ur":"پاس ہیں"},{"u":"رَسُولِ","en":"(the) Messenger","ur":"رسول کے"},{"u":"ٱللَّهِ","en":"(of) Allah","ur":"اللہ کے"},{"u":"حَتَّىٰ","en":"until","ur":"یہاں تک کہ"},{"u":"يَنفَضُّوا۟ ۗ","en":"they disband","ur":"وہ بھاگ جائیں"},{"u":"وَلِلَّهِ","en":"And for Allah","ur":"اور اللہ کے لیے ہیں"},{"u":"خَزَآئِنُ","en":"(are the) treasures","ur":"خزانے"},{"u":"ٱلسَّمَـٰوَٰتِ","en":"(of) the heavens","ur":"آسمانوں کے"},{"u":"وَٱلْأَرْضِ","en":"and the earth","ur":"اور زمین کے"},{"u":"وَلَـٰكِنَّ","en":"but","ur":"لیکن"},{"u":"ٱلْمُنَـٰفِقِينَ","en":"the hypocrites","ur":"منافق لوگ"},{"u":"لَا","en":"(do) not","ur":"نہیں"},{"u":"يَفْقَهُونَ","en":"understand","ur":"سمجھتے"}]},{"k":"63:8","n":8,"id":5196,"u":"يَقُولُونَ لَئِن رَّجَعْنَآ إِلَى ٱلْمَدِينَةِ لَيُخْرِجَنَّ ٱلْأَعَزُّ مِنْهَا ٱلْأَذَلَّ ۚ وَلِلَّهِ ٱلْعِزَّةُ وَلِرَسُولِهِۦ وَلِلْمُؤْمِنِينَ وَلَـٰكِنَّ ٱلْمُنَـٰفِقِينَ لَا يَعْلَمُونَ","juz":28,