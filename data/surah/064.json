{"n":64,"src":{"text":"qc-text","wbw":"qc-wbw"},"ayahs":[{"k":"64:1","n":1,"id":5200,"u":" يُسَبِّحُ لِلَّهِ مَا فِى ٱلسَّمَـٰوَٰتِ وَمَا فِى ٱلْأَرْضِ ۖ لَهُ ٱلْمُلْكُ وَلَهُ ٱلْحَمْدُ ۖ وَهُوَ عَلَىٰ كُلِّ شَىْءٍ قَدِيرٌ","juz":28,"page":556,"sajdah":false,"w":[{"u":"يُسَبِّحُ","en":"Glorifies","ur":"تسبیح کررہی ہے"},{"u":"لِلَّهِ","en":"[to] Allah","ur":"اللہ کے لیے"},{"u":"مَا","en":"whatever","ur":"جو کچھ"},{"u":"فِى","en":"(is) in","ur":"میں"},{"u":"ٱلسَّمَـٰوَٰتِ","en":"the heavens","ur":"آسمانوں (میں) ہے"},{"u":"وَمَا","en":"and whatever","ur":"اور جو کچھ"},{"u":"فِى","en":"(is) in","ur":"میں"},{"u":"ٱلْأَرْضِ ۖ","en":"the earth","ur":"زمین (میں) ہے"},{"u":"لَهُ","en":"For Him","ur":"اسی کے لیے"},{"u":"ٱلْمُلْكُ","en":"(is the) dominion","ur":"بادشاہت"},{"u":"وَلَهُ","en":"and for Him","ur":"اور اسی کے لیے ہے"},{"u":"ٱلْحَمْدُ ۖ","en":"(is) the praise","ur":"تعریف"},{"u":"وَهُوَ","en":"And He","ur":"اور وہ"},{"u":"عَلَىٰ","en":"(is) on","ur":"پر"},{"u":"كُلِّ","en":"every","ur":"ہر"},{"u":"شَىْءٍۢ","en":"thing","ur":"چیز (پر)"},{"u":"قَدِيرٌ","en":"All-Powerful","ur":"قدرت رکھنے والا ہے"}]},{"k":"64:2","n":2,"id":5201,"u":"هُوَ ٱلَّذِى خَلَقَكُمْ فَمِنكُمْ كَافِرٌ وَمِنكُم مُّؤْمِنٌ ۚ وَٱللَّهُ بِمَا تَعْمَلُونَ بَصِيرٌ","juz":28,"page":556,"sajdah":false,"w":[{"u":"هُوَ","en":"He","ur":"وہ اللہ"},{"u":"ٱلَّذِى","en":"(is) the One Who","ur":"وہ ذات ہے"},{"u":"خَلَقَكُمْ","en":"created you","ur":"جس نے پیدا کیا تم کو"},{"u":"فَمِنكُمْ","en":"and among you","ur":"تو تم میں سے"},{"u":"كَافِرٌۭ","en":"(is) a disbeliever","ur":"کوئی کافر"},{"u":"وَمِنكُم","en":"and among you","ur":"اور تم میں سے"},{"u":"مُّؤْمِنٌۭ ۚ","en":"(is) a believer","ur":"کوئی مومن ہے"},{"u":"وَٱللَّهُ","en":"And Allah","ur":"اور اللہ"},{"u":"بِمَا","en":"of what","ur":"ساتھ اس کے جو"},{"u":"تَعْمَلُونَ","en":"you do","ur":"تم عمل کرتے ہو"},{"u":"بَصِيرٌ","en":"(is) All-Seer","ur":"دیکھنے والا ہے"}]},{"k":"64:3","n":3,"id":5202,"u":"خَلَقَ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضَ بِٱلْحَقِّ وَصَوَّرَكُمْ فَأَحْسَنَ صُوَرَكُمْ ۖ وَإِلَيْهِ ٱلْمَصِيرُ","juz":28,"page":556,"sajdah":false,"w":[{"u":"خَلَقَ","en":"He created","ur":"اس نے پیدا کیا"},{"u":"ٱلسَّمَـٰوَٰتِ","en":"the heavens","ur":"آسمانوں کو"},{"u":"وَٱلْأَرْضَ","en":"and the earth","ur":"اور زمین کو"},{"u":"بِٱلْحَقِّ","en":"with truth","ur":"حق کے ساتھ"},{"u":"وَصَوَّرَكُمْ","en":"and He formed you","ur":"اور صورت بنائی تمہاری"},{"u":"فَأَحْسَنَ","en":"and made good","ur":"تو اچھی بنائیں"},{"u":"صُوَرَكُمْ ۖ","en":"your forms","ur":"صورتیں تمہاری"},{"u":"وَإِلَيْهِ","en":"and to Him","ur":"اور اسی کی طرف"},{"u":"ٱلْمَصِيرُ","en":"(is) the final return","ur":"لوٹنا ہے"}]},{"k":"64:4","n":4,"id":5203,"u":"يَعْلَمُ مَا فِى ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ وَيَعْلَمُ مَا تُسِرُّونَ وَمَا تُعْلِنُونَ ۚ وَٱللَّهُ عَلِيمٌۢ بِذَاتِ ٱلصُّدُورِ","juz":28,"page":556,"sajdah":false,"w":[{"u":"يَعْلَمُ","en":"He knows","ur":"وہ جانتا ہے"},{"u":"مَا","en":"what","ur":"جو کچھ"},{"u":"فِى","en":"(is) in","ur":"میں"},{"u":"ٱلسَّمَـٰوَٰتِ","en":"the heavens","ur":"آسمانوں (میں) ہے"},{"u":"وَٱلْأَرْضِ","en":"and the earth","ur":"اور زمین میں"},{"u":"وَيَعْلَمُ","en":"and He knows","ur":"اور وہ جانتا ہے"},{"u":"مَا","en":"what","ur":"جو"},{"u":"تُسِرُّونَ","en":"you conceal","ur":"تم چھپاتے ہو"},{"u":"وَمَا","en":"and what","ur":"اور جو"},{"u":"تُعْلِنُونَ ۚ","en":"you declare","ur":"تم ظاہر کرتے ہو"},{"u":"وَٱللَّهُ","en":"And Allah","ur":"اور اللہ تعالیٰ"},{"u":"عَلِيمٌۢ","en":"(is) All-Knowing","ur":"جاننے والا ہے"},{"u":"بِذَاتِ","en":"of what","ur":"والے"},{"u":"ٱلصُّدُورِ","en":"(is in) the breasts","ur":"سینوں کے بھید"}]},{"k":"64:5","n":5,"id":5204,"u":"أَلَمْ يَأْتِكُمْ نَبَؤُا۟ ٱلَّذِينَ كَفَرُوا۟ مِن قَبْلُ فَذَاقُوا۟ وَبَالَ أَمْرِهِمْ وَلَهُمْ عَذَابٌ أَلِيمٌ","juz":28,"page":556,"sajdah":false,"w":[{"u":"أَلَمْ","en":"Has not","ur":"کیا نہیں"},{"u":"يَأْتِكُمْ","en":"come to you","ur":"آئی تمہارے پاس"},{"u":"نَبَؤُا۟","en":"(the) news","ur":"خبر"},{"u":"ٱلَّذِينَ","en":"(of) those who","ur":"ان لوگوں کی"},{"u":"كَفَرُوا۟","en":"disbelieved","ur":"جنہوں نے کفر کیا"},{"u":"مِن","en":"from","ur":"سے"},{"u":"قَبْلُ","en":"before","ur":"اس سے پہلے"},{"u":"فَذَاقُوا۟","en":"So they tasted","ur":"تو انہوں نے چکھا"},{"u":"وَبَالَ","en":"(the bad) consequence","ur":"وبال"},{"u":"أَمْرِهِمْ","en":"(of) their affair","ur":"اپنے کام کا"},{"u":"وَلَهُمْ","en":"and for them","ur":"اور ان کے لیے"},{"u":"عَذَابٌ","en":"(is) a punishment","ur":"عذاب"},{"u":"أَلِيمٌۭ","en":"painful","ur":"دردناک"}]},{"k":"64:6","n":6,"id":5205,"u":"ذَٰلِكَ بِأَنَّهُۥ كَانَت تَّأْتِيهِمْ رُسُلُهُم بِٱلْبَيِّنَـٰتِ فَقَالُوٓا۟ أَبَشَرٌ يَهْدُونَنَا فَكَفَرُوا۟ وَتَوَلَّوا۟ ۚ وَّٱسْتَغْنَى ٱللَّهُ ۚ وَٱللَّهُ غَنِىٌّ حَمِيدٌ","juz":28,"page":556,"sajdah":false,"w":[{"u":"ذَٰلِكَ","en":"That","ur":"یہ"},{"u":"بِأَنَّهُۥ","en":"(is) because","ur":"بوجہ اس کے کہ بیشک وہ"},{"u":"كَانَت","en":"had","ur":"تھے"},{"u":"تَّأْتِيهِمْ","en":"come to them","ur":"آتے ان کے پاس"},{"u":"رُسُلُهُم","en":"their Messengers","ur":"ان کے رسول"},{"u":"بِٱلْبَيِّنَـٰتِ","en":"with clear proofs","ur":"ساتھ واضح آیات کے"},{"u":"فَقَالُوٓا۟","en":"but they said","ur":"تو وہ کہتے"},{"u":"أَبَشَرٌۭ","en":"Shall human beings","ur":"کیا انسان"},{"u":"يَهْدُونَنَا","en":"guide us","ur":"ہدایت دیں گے ہم کو"},{"u":"فَكَفَرُوا۟","en":"So they disbelieved","ur":"تو انہوں نے کفر کیا"},{"u":"وَتَوَلَّوا۟ ۚ","en":"and turned away","ur":"اورمنہ موڑ گئے"},{"u":"وَّٱسْتَغْنَى","en":"And can do without them","ur":"اور بےپرواہ ہوگیا"},{"u":"ٱللَّهُ ۚ","en":"Allah","ur":"اللہ"},{"u":"وَٱللَّهُ","en":"And Allah","ur":"اور اللہ"},{"u":"غَنِىٌّ","en":"(is) Self-sufficient","ur":"بےنیاز ہے"},{"u":"حَمِيدٌۭ","en":"Praiseworthy","ur":"تعریف والا ہے"}]},{"k":"64:7","n":7,"id":5206,"u":"زَعَمَ ٱلَّذِينَ كَفَرُوٓا۟ أَن لَّن يُبْعَثُوا۟ ۚ قُلْ بَلَىٰ وَرَبِّى لَتُبْعَثُنَّ ثُمَّ لَتُنَبَّؤُنَّ بِمَا عَمِلْتُمْ ۚ وَذَٰلِكَ عَلَى ٱللَّهِ يَسِيرٌ","juz":28,"page":556,"sajdah":false,"w":[{"u":"زَعَمَ","en":"Claim","ur":"دعوی کیا"},{"u":"ٱلَّذِينَ","en":"those who","ur":"ان لوگوں نے"},{"u":"كَفَرُوٓا۟","en":"disbelieve","ur":"جنہوں نے کفر کیا"},{"u":"أَن","en":"that","ur":"کہ"},{"u":"لَّن","en":"never","ur":"ہرگز نہ"},{"u":"يُبْعَثُوا۟ ۚ","en":"will they be raised","ur":"اٹھائے جائیں گے"},{"u":"قُلْ","en":"Say","ur":"کہہ دیجئے"},{"u":"بَلَىٰ","en":"Yes","ur":"کیوں نہیں"},{"u":"وَرَبِّى","en":"by my Lord","ur":"میرے رب کی قسم"},{"u":"لَتُبْعَثُنَّ","en":"surely you will be raised","ur":"البتہ تم ضرور اٹھائے جاؤ گے"},{"u":"ثُمَّ","en":"then","ur":"پھر"},{"u":"لَتُنَبَّؤُنَّ","en":"surely you will be informed","ur":"البتہ تم ضرور بتائے جاؤ گے"},{"u":"بِمَا","en":"of what","ur":"ساتھ اس کے جو"},{"u":"عَمِلْتُمْ ۚ","en":"you did","ur":"تم نے عمل کیے"},{"u":"وَذَٰلِكَ","en":"And that","ur":"اور یہ بات"},{"u":"عَلَى","en":"for","ur":"پر"},{"u":"ٱللَّهِ","en":"Allah","ur":"اللہ (پر)"},{"u":"يَسِيرٌۭ","en":"(is) easy","ur":"بہت آسان ہے"}]},{"k":"64:8","n":8,"id":5207,"u":"فَـَٔامِنُوا۟ بِٱللَّهِ وَرَسُولِهِۦ وَٱلنُّورِ ٱلَّذِىٓ أَنزَلْنَا ۚ وَٱللَّهُ بِمَا تَعْمَلُونَ خَبِيرٌ","juz":28,"page":556,"sajdah":false,"w":[{"u":"فَـَٔامِنُوا۟","en":"So believe","ur":"پس ایمان لاؤ"},{"u":"بِٱللَّهِ","en":"in Allah","ur":"اللہ پر"},{"u":"وَرَسُولِهِۦ","en":"and His Messenger","ur":"اور اس کے رسول پر"},{"u":"وَٱلنُّورِ","en":"and the Light","ur":"اور اس نور پر"},{"u":"ٱلَّذِىٓ","en":"which","ur":"وہ جو"},{"u":"أَنزَلْنَا ۚ","en":"We have sent down","ur":"اتارا ہم نے"},{"u":"وَٱللَّهُ","en":"And Allah","ur":"اور اللہ"},{"u":"بِمَا","en":"of what","ur":"ساتھ اس کے جو"},{"u":"تَعْمَلُونَ","en":"you do","ur":"تم عمل کرتے ہو"},{"u":"خَبِيرٌۭ","en":"(is) All-Aware","ur":"خبر رکھنے والا"}]},{"k":"64:9","n":9,"id":5208,"u":"يَوْمَ يَجْمَعُكُمْ لِيَوْمِ ٱلْجَمْعِ ۖ ذَٰلِكَ يَوْمُ ٱلتَّغَابُنِ ۗ وَمَن يُؤْمِنۢ بِٱللَّهِ وَيَعْمَلْ صَـٰلِحًا يُكَفِّرْ عَنْهُ سَيِّـَٔاتِهِۦ وَيُدْخِلْهُ جَنَّـٰتٍ تَجْرِى مِن تَحْتِهَا ٱلْأَنْهَـٰرُ خَـٰلِدِينَ فِيهَآ أَبَدًا ۚ ذَٰلِكَ ٱلْفَوْزُ ٱلْعَظِيمُ","juz":28,"page":556,"sajdah":false,"w":[{"u":"يَوْمَ","en":"(The) Day",