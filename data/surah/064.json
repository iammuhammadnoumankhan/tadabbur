{"n":64,"src":{"text":"qc-text","wbw":"qc-wbw"},"ayahs":[{"k":"64:1","n":1,"id":5200,"u":" يُسَبِّحُ لِلَّهِ مَا فِى ٱلسَّمَـٰوَٰتِ وَمَا فِى ٱلْأَرْضِ ۖ لَهُ ٱلْمُلْكُ وَلَهُ ٱلْحَمْدُ ۖ وَهُوَ عَلَىٰ كُلِّ شَىْءٍ قَدِيرٌ","i":"يُسَبِّحُ لِلّٰهِ مَا فِى السَّمٰوٰتِ وَمَا فِى الۡاَرۡضِ​ۚ لَهُ الۡمُلۡكُ وَلَهُ الۡحَمۡدُ​ وَهُوَ عَلٰى كُلِّ شَىۡءٍ قَدِيۡرٌ‏","juz":28,"page":556,"sajdah":false,"w":[{"u":"يُسَبِّحُ","i":"يُسَبِّحُ","tl":"yusabbiḥu","en":"Glorifies","ur":"تسبیح کررہی ہے","a":"wbw/064_001_001.mp3"},{"u":"لِلَّهِ","i":"لِلّٰهِ","tl":"lillahi","en":"[to] Allah","ur":"اللہ کے لیے","a":"wbw/064_001_002.mp3"},{"u":"مَا","i":"مَا","tl":"mā","en":"whatever","ur":"جو کچھ","a":"wbw/064_001_003.mp3"},{"u":"فِى","i":"فِى","tl":"fī","en":"(is) in","ur":"میں","a":"wbw/064_001_004.mp3"},{"u":"ٱلسَّمَـٰوَٰتِ","i":"السَّمٰوٰتِ","tl":"l-samāwāti","en":"the heavens","ur":"آسمانوں (میں) ہے","a":"wbw/064_001_005.mp3"},{"u":"وَمَا","i":"وَمَا","tl":"wamā","en":"and whatever","ur":"اور جو کچھ","a":"wbw/064_001_006.mp3"},{"u":"فِى","i":"فِى","tl":"fī","en":"(is) in","ur":"میں","a":"wbw/064_001_007.mp3"},{"u":"ٱلْأَرْضِ ۖ","i":"الۡاَرۡضِ​ۚ","tl":"l-arḍi","en":"the earth","ur":"زمین (میں) ہے","a":"wbw/064_001_008.mp3"},{"u":"لَهُ","i":"لَهُ","tl":"lahu","en":"For Him","ur":"اسی کے لیے","a":"wbw/064_001_010.mp3"},{"u":"ٱلْمُلْكُ","i":"الۡمُلۡكُ","tl":"l-mul'ku","en":"(is the) dominion","ur":"بادشاہت","a":"wbw/064_001_011.mp3"},{"u":"وَلَهُ","i":"وَلَهُ","tl":"walahu","en":"and for Him","ur":"اور اسی کے لیے ہے","a":"wbw/064_001_012.mp3"},{"u":"ٱلْحَمْدُ ۖ","i":"الۡحَمۡدُ​","tl":"l-ḥamdu","en":"(is) the praise","ur":"تعریف","a":"wbw/064_001_013.mp3"},{"u":"وَهُوَ","i":"وَهُوَ","tl":"wahuwa","en":"And He","ur":"اور وہ","a":"wbw/064_001_015.mp3"},{"u":"عَلَىٰ","i":"عَلٰى","tl":"ʿalā","en":"(is) on","ur":"پر","a":"wbw/064_001_016.mp3"},{"u":"كُلِّ","i":"كُلِّ","tl":"kulli","en":"every","ur":"ہر","a":"wbw/064_001_017.mp3"},{"u":"شَىْءٍۢ","i":"شَىۡءٍ","tl":"shayin","en":"thing","ur":"چیز (پر)","a":"wbw/064_001_018.mp3"},{"u":"قَدِيرٌ","i":"قَدِيۡرٌ‏","tl":"qadīrun","en":"All-Powerful","ur":"قدرت رکھنے والا ہے","a":"wbw/064_001_019.mp3"}]},{"k":"64:2","n":2,"id":5201,"u":"هُوَ ٱلَّذِى خَلَقَكُمْ فَمِنكُمْ كَافِرٌ وَمِنكُم مُّؤْمِنٌ ۚ وَٱللَّهُ بِمَا تَعْمَلُونَ بَصِيرٌ","i":"هُوَ الَّذِىۡ خَلَقَكُمۡ فَمِنۡكُمۡ كَافِرٌ وَّمِنۡكُمۡ مُّؤۡمِنٌ​ؕ وَاللّٰهُ بِمَا تَعۡمَلُوۡنَ بَصِيۡرٌ‏","juz":28,"page":556,"sajdah":false,"w":[{"u":"هُوَ","i":"هُوَ","tl":"huwa","en":"He","ur":"وہ اللہ","a":"wbw/064_002_001.mp3"},{"u":"ٱلَّذِى","i":"الَّذِىۡ","tl":"alladhī","en":"(is) the One Who","ur":"وہ ذات ہے","a":"wbw/064_002_002.mp3"},{"u":"خَلَقَكُمْ","i":"خَلَقَكُمۡ","tl":"khalaqakum","en":"created you","ur":"جس نے پیدا کیا تم کو","a":"wbw/064_002_003.mp3"},{"u":"فَمِنكُمْ","i":"فَمِنۡكُمۡ","tl":"faminkum","en":"and among you","ur":"تو تم میں سے","a":"wbw/064_002_004.mp3"},{"u":"كَافِرٌۭ","i":"كَافِرٌ","tl":"kāfirun","en":"(is) a disbeliever","ur":"کوئی کافر","a":"wbw/064_002_005.mp3"},{"u":"وَمِنكُم","i":"وَّمِنۡكُمۡ","tl":"waminkum","en":"and among you","ur":"اور تم میں سے","a":"wbw/064_002_006.mp3"},{"u":"مُّؤْمِنٌۭ ۚ","i":"مُّؤۡمِنٌ​ؕ","tl":"mu'minun","en":"(is) a believer","ur":"کوئی مومن ہے","a":"wbw/064_002_007.mp3"},{"u":"وَٱللَّهُ","i":"وَاللّٰهُ","tl":"wal-lahu","en":"And Allah","ur":"اور اللہ","a":"wbw/064_002_009.mp3"},{"u":"بِمَا","i":"بِمَا","tl":"bimā","en":"of what","ur":"ساتھ اس کے جو","a":"wbw/064_002_010.mp3"},{"u":"تَعْمَلُونَ","i":"تَعۡمَلُوۡنَ","tl":"taʿmalūna","en":"you do","ur":"تم عمل کرتے ہو","a":"wbw/064_002_011.mp3"},{"u":"بَصِيرٌ","i":"بَصِيۡرٌ‏","tl":"baṣīrun","en":"(is) All-Seer","ur":"دیکھنے والا ہے","a":"wbw/064_002_012.mp3"}]},{"k":"64:3","n":3,"id":5202,"u":"خَلَقَ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضَ بِٱلْحَقِّ وَصَوَّرَكُمْ فَأَحْسَنَ صُوَرَكُمْ ۖ وَإِلَيْهِ ٱلْمَصِيرُ","i":"خَلَقَ السَّمٰوٰتِ وَالۡاَرۡضَ بِالۡحَـقِّ وَصَوَّرَكُمۡ​ فَاَحۡسَنَ صُوَرَكُمۡۚ​ وَاِلَيۡهِ الۡمَصِيۡرُ‏","juz":28,"page":556,"sajdah":false,"w":[{"u":"خَلَقَ","i":