{"n":65,"src":{"text":"qc-text","wbw":"qc-wbw"},"ayahs":[{"k":"65:1","n":1,"id":5218,"u":" يَـٰٓأَيُّهَا ٱلنَّبِىُّ إِذَا طَلَّقْتُمُ ٱلنِّسَآءَ فَطَلِّقُوهُنَّ لِعِدَّتِهِنَّ وَأَحْصُوا۟ ٱلْعِدَّةَ ۖ وَٱتَّقُوا۟ ٱللَّهَ رَبَّكُمْ ۖ لَا تُخْرِجُوهُنَّ مِنۢ بُيُوتِهِنَّ وَلَا يَخْرُجْنَ إِلَّآ أَن يَأْتِينَ بِفَـٰحِشَةٍ مُّبَيِّنَةٍ ۚ وَتِلْكَ حُدُودُ ٱللَّهِ ۚ وَمَن يَتَعَدَّ حُدُودَ ٱللَّهِ فَقَدْ ظَلَمَ نَفْسَهُۥ ۚ لَا تَدْرِى لَعَلَّ ٱللَّهَ يُحْدِثُ بَعْدَ ذَٰلِكَ أَمْرًا","i":"يٰۤاَيُّهَا النَّبِىُّ اِذَا طَلَّقۡتُمُ النِّسَآءَ فَطَلِّقُوۡهُنَّ لِعِدَّتِهِنَّ وَاَحۡصُوا الۡعِدَّةَ ​ ۚ وَاتَّقُوا اللّٰهَ رَبَّكُمۡ​ ۚ لَا تُخۡرِجُوۡهُنَّ مِنۡۢ بُيُوۡتِهِنَّ وَلَا يَخۡرُجۡنَ اِلَّاۤ اَنۡ يَّاۡتِيۡنَ بِفَاحِشَةٍ مُّبَيِّنَةٍ​ ؕ وَتِلۡكَ حُدُوۡدُ اللّٰهِ​ ؕ وَمَنۡ يَّتَعَدَّ حُدُوۡدَ اللّٰهِ فَقَدۡ ظَلَمَ نَفۡسَهٗ​ ؕ لَا تَدۡرِىۡ لَعَلَّ اللّٰهَ يُحۡدِثُ بَعۡدَ ذٰ لِكَ اَمۡرًا‏","juz":28,"page":558,"sajdah":false,"w":[{"u":"يَـٰٓأَيُّهَا","i":"يٰۤاَيُّهَا","tl":"yāayyuhā","en":"O","ur":"اے","a":"wbw/065_001_001.mp3"},{"u":"ٱلنَّبِىُّ","i":"النَّبِىُّ","tl":"l-nabiyu","en":"Prophet","ur":"نبی (صلی اللہ علیہ وآلہ وسلم)","a":"wbw/065_001_002.mp3"},{"u":"إِذَا","i":"اِذَا","tl":"idhā","en":"When","ur":"جب","a":"wbw/065_001_003.mp3"},{"u":"طَلَّقْتُمُ","i":"طَلَّقۡتُمُ","tl":"ṭallaqtumu","en":"you divorce","ur":"طلاق دو تم","a":"wbw/065_001_004.mp3"},{"u":"ٱلنِّسَآءَ","i":"النِّسَآءَ","tl":"l-nisāa","en":"[the] women","ur":"عورتوں کو","a":"wbw/065_001_005.mp3"},{"u":"فَطَلِّقُوهُنَّ","i":"فَطَلِّقُوۡهُنَّ","tl":"faṭalliqūhunna","en":"then divorce them","ur":"تو طلاق دو ان کو","a":"wbw/065_001_006.mp3"},{"u":"لِعِدَّتِهِنَّ","i":"لِعِدَّتِهِنَّ","tl":"liʿiddatihinna","en":"for their waiting period","ur":"ان کی عدت کے لیے","a":"wbw/065_001_007.mp3"},{"u":"وَأَحْصُوا۟","i":"وَاَحۡصُوا","tl":"wa-aḥṣū","en":"and keep count","ur":"اور شمار کرو۔ گن لو","a":"wbw/065_001_008.mp3"},{"u":"ٱلْعِدَّةَ ۖ","i":"الۡعِدَّةَ ​ ۚ","tl":"l-ʿidata","en":"(of) the waiting period","ur":"عدت کو","a":"wbw/065_001_009.mp3"},{"u":"وَٱتَّقُوا۟","i":"وَاتَّقُوا","tl":"wa-ittaqū","en":"and fear","ur":"اور ڈرو","a":"wbw/065_001_011.mp3"},{"u":"ٱللَّهَ","i":"اللّٰهَ","tl":"l-laha","en":"Allah","ur":"اللہ سے","a":"wbw/065_001_012.mp3"},{"u":"رَبَّكُمْ ۖ","i":"رَبَّكُمۡ​ ۚ","tl":"rabbakum","en":"your Lord","ur":"جو رب ہے تمہارا","a":"wbw/065_001_013.mp3"},{"u":"لَا","i":"لَا","tl":"lā","en":"(Do) not","ur":"نہ","a":"wbw/065_001_015.mp3"},{"u":"تُخْرِجُوهُنَّ","i":"تُخۡرِجُوۡهُنَّ","tl":"tukh'rijūhunna","en":"expel them","ur":"تم نکالو ان کو","a":"wbw/065_001_016.mp3"},{"u":"مِنۢ","i":"مِنۡۢ","tl":"min","en":"from","ur":"سے","a":"wbw/065_001_017.mp3"},{"u":"بُيُوتِهِنَّ","i":"بُيُوۡتِهِنَّ","tl":"buyūtihinna","en":"their houses","ur":"ان کے گھروں (سے )","a":"wbw/065_001_018.mp3"},{"u":"وَلَا","i":"وَلَا","tl":"walā","en":"and not","ur":"اور نہ","a":"wbw/065_001_019.mp3"},{"u":"يَخْرُجْنَ","i":"يَخۡرُجۡنَ","tl":"yakhruj'na","en":"they should leave","ur":"وہ نکلیں","a":"wbw/065_001_020.mp3"},{"u":"إِلَّآ","i":"اِلَّاۤ","tl":"illā","en":"except","ur":"مگر","a":"wbw/065_001_021.mp3"},{"u":"أَن","i":"اَنۡ","tl":"an","en":"that","ur":"یہ کہ","a":"wbw/065_001_022.mp3"},{"u":"يَأْتِينَ","i":"يَّاۡتِيۡنَ","tl":"yatīna","en":"they commit","ur":"وہ آئیں","a":"wbw/065_001_023.mp3"},{"u":"بِفَـٰحِشَةٍۢ","i":"بِفَاحِشَةٍ","tl":"bifāḥishatin","en":"an immorality","ur":"بےحیائی کو","a":"wbw/065_001_024.mp3"},{"u":"مُّبَيِّنَةٍۢ ۚ","i":"مُّبَيِّنَةٍ​ ؕ","tl":"mubayyinatin","en":"clear","ur":"کھلی","a":"wbw/065_001_025.mp3"},{"u":"وَتِلْكَ","i":"وَتِلۡكَ","tl":"watil'ka","en":"And these","ur":"اور یہ","a":"wbw/065_001_027.mp3"},{"u":"حُدُودُ","i":"حُدُوۡدُ","tl":"ḥudūdu","en":"(are the) limits","ur":"حدود ہیں","a":"wbw/065_001_028.mp3"},{"u":"ٱللَّهِ ۚ","i":"اللّٰهِ​ ؕ","tl":"l-lahi","en":"(of) Allah","ur":"اللہ کی","a":"wbw/065_001_029.mp3"},{"u":"وَمَن","i":"وَمَنۡ","tl":"waman","en":"And whoever","ur":"اور جو","a":"wbw/065_001_031.mp3"},{"u":"يَتَعَدَّ","i":"يَّتَعَدَّ","tl":"yataʿadda","en":"transgresses","ur":"تجاوز کرے گا","a":"wbw/065_001_032.mp3"},{"u":"حُدُودَ","i":"حُدُوۡدَ","tl":"ḥudūda","en":"(the) limits","ur":"حدود سے","a":"wbw/065_001_033.mp3"},{"u":"ٱللَّهِ","i":"اللّٰهِ","tl":"l-lahi","en":"(of) Allah","ur":"اللہ کی","a":"wbw/065_001_034.mp3"},{"u":"فَقَدْ","i":"فَقَدۡ","tl":"faqad","en":"then certainly","ur":"تو تحقیق","a":"wbw/065_001_035.mp3"},{"u":"ظَلَمَ","i":"ظَلَمَ","tl":"ẓalama","en":"he has wronged","ur":"اس نے ظلم کیا","a":"wbw/065_001_036.mp3"},{"u":"نَفْسَهُۥ ۚ","i":"نَفۡسَهٗ​ ؕ","tl":"nafsahu","en":"himself","ur":"اپنی جان پر","a":"wbw/065_001_037.mp3"},{"u":"لَا","i":"لَا","tl":"lā","en":"Not","ur":"نہیں","a":"wbw/065_001_039.mp3"},{"u":"تَدْرِى","i":"تَدۡرِىۡ","tl":"tadrī","en":"you know","ur":"تم جانتے","a":"wbw/065_001_040.mp3"},{"u":"لَعَلَّ","i":"لَعَلَّ","tl":"laʿalla","en":"Perhaps","ur":"شاید کہ","a":"wbw/065_001_041.mp3"},{"u":"ٱللَّهَ","i":"اللّٰهَ","tl":"l-laha","en":"Allah","ur":"اللہ تعالیٰ","a":"wbw/065_001_042.mp3"},{"u":"يُحْدِثُ","i":"يُحۡدِثُ","tl":"yuḥ'dithu","en":"will bring about","ur":"پیدا کردے","a":"wbw/065_001_043.mp3"},{"u":"بَعْدَ","i":"بَعۡدَ","tl":"baʿda","en":"after","ur":"بعد","a":"wbw/065_001_044.mp3"},{"u":"ذَٰلِكَ","i":"ذٰ لِكَ","tl":"dhālika","en":"that","ur":"اس کے","a":"wbw/065_001_045.mp3"},{"u":"أَمْرًۭا","i":"اَمۡرًا‏","tl":"amran","en":"a matter","ur":"کوئی صورت","a":"wbw/065_001_046.mp3"}]},{"k":"65:2","n":2,"id":5219,"u":"فَإِذَا بَلَغْنَ أَجَلَهُنَّ فَأَمْسِكُوهُنَّ بِمَعْرُوفٍ أَوْ فَارِقُوهُنَّ بِمَعْرُوفٍ وَأَشْهِدُوا۟ ذَوَىْ عَدْلٍ مِّنكُمْ وَأَقِيمُوا۟ ٱلشَّهَـٰدَةَ لِلَّهِ ۚ ذَٰلِكُمْ يُوعَظُ بِهِۦ مَن كَانَ يُؤْمِنُ بِٱللَّهِ وَٱلْيَوْمِ ٱلْـَٔاخِرِ ۚ وَمَن يَتَّقِ ٱللَّهَ يَجْعَل لَّهُۥ مَخْرَجًا","i":"فَاِذَا بَلَغۡنَ اَجَلَهُنَّ فَاَمۡسِكُوۡهُنَّ بِمَعۡرُوۡفٍ اَوۡ فَارِقُوۡهُنَّ بِمَعۡرُوۡفٍ وَّاَشۡهِدُوۡا ذَوَىۡ عَدۡلٍ مِّنۡكُمۡ وَاَقِيۡمُوا الشَّهَادَةَ لِلّٰهِ​ ؕ ذٰ لِكُمۡ يُوۡعَظُ بِهٖ مَنۡ كَانَ يُؤۡمِنُ بِاللّٰهِ وَالۡيَوۡمِ الۡاٰخِرِ​ ۙ وَمَنۡ يَّـتَّـقِ اللّٰهَ يَجۡعَلْ لَّهٗ مَخۡرَجًا ۙ‏","juz":28,"page":558,"sajdah":false,"w":[{"u":"فَإِذَا","i":"فَاِذَا","tl":"fa-idhā","en":"Then when","ur":"پھر جب","a":"wbw/065_002_001.mp3"},{"u":"بَلَغْنَ","i":"بَلَغۡنَ","tl":"balaghna","en":"they have reached","ur":"وہ پہنچیں","a":"wbw/065_002_002.mp3"},{"u":"أَجَلَهُنَّ","i":"اَجَلَهُنَّ","tl":"ajalahunna","en":"their term","ur":"اپنی مدت کو","a":"wbw/065_002_003.mp3"},{"u":"فَأَمْسِكُوهُنَّ","i":"فَاَمۡسِكُوۡهُنَّ","tl":"fa-amsikūhunna","en":"then retain them","ur":"تو روک لو ان کو","a":"wbw/065_002_004.mp3"},{"u":"بِمَعْرُوفٍ","i":"بِمَعۡرُوۡفٍ","tl":"bimaʿrūfin","en":"with kindness","ur":"بھلے طریقے سے","a":"wbw/065_002_005.mp3"},{"u":"أَوْ","i":"اَوۡ","tl":"aw","en":"or","ur":"یا","a":"wbw/065_002_006.mp3"},{"u":"فَارِقُوهُنَّ","i":"فَارِقُوۡهُنَّ","tl":"fāriqūhunna","en":"part with them","ur":"جدا کردو ان کو","a":"wbw/065_002_007.mp3"},{"u":"بِمَعْرُوفٍۢ","i":"بِمَعۡرُوۡفٍ","tl":"bimaʿrūfin","en":"with kindness","ur":"ساتھ بھلے طریقے کے","a":"wbw/065_002_008.mp3"},{"u":"وَأَشْهِدُوا۟","i":"وَّاَشۡهِدُوۡا","tl":"wa-ashhidū","en":"And take witness","ur":"اور گواہ بنا لو","a":"wbw/065_002_009.mp3"},{"u":"ذَوَىْ","i":"ذَوَىۡ","tl":"dhaway","en":"two men","ur":"دو والوں کو","a":"wbw/065_002_010.mp3"},{"u":"عَدْلٍۢ","i":"عَدۡلٍ","tl":"ʿadlin","en":"just","ur":"عدل","a":"wbw/065_002_011.mp3"},{"u":"مِّنكُمْ","i":"مِّنۡكُمۡ","tl":"minkum","en":"among you","ur":"تم میں سے","a":"wbw/065_002_012.mp3"},{"u":"وَأَقِيمُوا۟","i":"وَاَقِيۡمُوا","tl":"wa-aqīmū","en":"and establish","ur":"اور قائم کرو","a":"wbw/065_002_013.mp3"},{"u":"ٱلشَّهَـٰدَةَ","i":"الشَّهَادَةَ","tl":"l-shahādata","en":"the testimony","ur":"گواہی کو","a":"wbw/065_002_014.mp3"},{"u":"لِلَّهِ ۚ","i":"لِلّٰهِ​ ؕ","tl":"lillahi","en":"for Allah","ur":"اللہ ہی کے لیے","a":"wbw/065_002_015.mp3"},{"u":"ذَٰلِكُمْ","i":"ذٰ لِكُمۡ","tl":"dhālikum","en":"That","ur":"یہ بات","a":"wbw/065_002_017.mp3"},{"u":"يُوعَظُ","i":"يُوۡعَظُ","tl":"yūʿaẓu","en":"is instructed","ur":"نصیحت کی جاتی ہے","a":"wbw/065_002_018.mp3"},{"u":"بِهِۦ","i":"بِهٖ","tl":"bihi","en":"with it","ur":"ساتھ اس کے","a":"wbw/065_002_019.mp3"},{"u":"مَن","i":"مَنۡ","tl":"man","en":"whoever","ur":"اسے جو کوئی","a":"wbw/065_002_020.mp3"},{"u":"كَانَ","i":"كَانَ","tl":"kāna","en":"[is]","ur":"ہو","a":"wbw/065_002_021.mp3"},{"u":"يُؤْمِنُ","i":"يُؤۡمِنُ","tl":"yu'minu","en":"believes","ur":"ایمان رکھتا ہے","a":"wbw/065_002_022.mp3"},{"u":"بِٱللَّهِ","i":"بِاللّٰهِ","tl":"bil-lahi","en":"in Allah","ur":"اللہ پر","a":"wbw/065_002_023.mp3"},{"u":"وَٱلْيَوْمِ","i":"وَالۡيَوۡمِ","tl":"wal-yawmi","en":"and the Day","ur":"اور یوم","a":"wbw/065_002_024.mp3"},{"u":"ٱلْـَٔاخِرِ ۚ","i":"الۡاٰخِرِ​ ۙ","tl":"l-ākhiri","en":"the Last","ur":"آخرت پر","a":"wbw/065_002_025.mp3"},{"u":"وَمَن","i":"وَمَنۡ","tl":"waman","en":"And whoever","ur":"اور جو","a":"wbw/065_002_027.mp3"},{"u":"يَتَّقِ","i":"يَّـتَّـقِ","tl":"yattaqi","en":"fears","ur":"ڈرے گا","a":"wbw/065_002_028.mp3"},{"u":"ٱللَّهَ","i":"اللّٰهَ","tl":"l-laha","en":"Allah","ur":"اللہ سے","a":"wbw/065_002_029.mp3"},{"u":"يَجْعَل","i":"يَجۡعَلْ","tl":"yajʿal","en":"He will make","ur":"وہ پیدا کردے گا","a":"wbw/065_002_030.mp3"},{"u":"لَّهُۥ","i":"لَّهٗ","tl":"lahu","en":"for him","ur":"اس کے لیے","a":"wbw/065_002_031.mp3"},{"u":"مَخْرَجًۭا","i":"مَخۡرَجًا ۙ‏","tl":"makhrajan","en":"a way out","ur":"نکلنے کا راستہ","a":"wbw/065_002_032.mp3"}]},{"k":"65:3","n":3,"id":5220,"u":"وَيَرْزُقْهُ مِنْ حَيْثُ لَا يَحْتَسِبُ ۚ وَمَن يَتَوَكَّلْ عَلَى ٱللَّهِ فَهُوَ حَسْبُهُۥٓ ۚ إِنَّ ٱللَّهَ بَـٰلِغُ أَمْرِهِۦ ۚ قَدْ جَعَلَ ٱللَّهُ لِكُلِّ شَىْءٍ قَدْرًا","i":"وَّيَرۡزُقۡهُ مِنۡ حَيۡثُ لَا يَحۡتَسِبُ​ ؕ وَمَنۡ يَّتَوَكَّلۡ عَلَى اللّٰهِ فَهُوَ حَسۡبُهٗ ؕ اِنَّ اللّٰهَ بَالِغُ اَمۡرِهٖ​ ؕ قَدۡ جَعَلَ اللّٰهُ لِكُلِّ شَىۡءٍ قَدۡرًا‏","juz":28,"page":558,"sajdah":false,"w":[{"u":"وَيَرْزُقْهُ","i":"وَّيَرۡزُقۡهُ","tl":"wayarzuq'hu","en":"And He will provide for him","ur":"اور رزق دے گا اس کو","a":"wbw/065_003_001.mp3"},{"u":"مِنْ","i":"مِنۡ",