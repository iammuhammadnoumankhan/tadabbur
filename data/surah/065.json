 deliver","ur":"وہ رکھ دیں"},{"u":"حَمْلَهُنَّ ۚ","en":"their burden","ur":"حمل اپنا"},{"u":"فَإِنْ","en":"Then if","ur":"پھر اگر"},{"u":"أَرْضَعْنَ","en":"they suckle","ur":"وہ دودھ پلائیں"},{"u":"لَكُمْ","en":"for you","ur":"تمہارے لیے"},{"u":"فَـَٔاتُوهُنَّ","en":"then give them","ur":"تو دے دو ان کو"},{"u":"أُجُورَهُنَّ ۖ","en":"their payment","ur":"ان کے اجر"},{"u":"وَأْتَمِرُوا۟","en":"and consult","ur":"اور معاملہ کرو"},{"u":"بَيْنَكُم","en":"among yourselves","ur":"آپس میں"},{"u":"بِمَعْرُوفٍۢ ۖ","en":"with kindness","ur":"بھلے طریقے سے"},{"u":"وَإِن","en":"but if","ur":"اور اگر"},{"u":"تَعَاسَرْتُمْ","en":"you disagree","ur":"آپس میں کشمش کرو تم"},{"u":"فَسَتُرْضِعُ","en":"then may suckle","ur":"تو دودھ پلا دے"},{"u":"لَهُۥٓ","en":"for him","ur":"اس کے لیے"},{"u":"أُخْرَىٰ","en":"another (women)","ur":"کوئی دوسری"}]},{"k":"65:7","n":7,"id":5224,"u":"لِيُنفِقْ ذُو سَعَةٍ مِّن سَعَتِهِۦ ۖ وَمَن قُدِرَ عَلَيْهِ رِزْقُهُۥ فَلْيُنفِقْ مِمَّآ ءَاتَىٰهُ ٱللَّهُ ۚ لَا يُكَلِّفُ ٱللَّهُ نَفْسًا إِلَّا مَآ ءَاتَىٰهَا ۚ سَيَجْعَلُ ٱللَّهُ بَعْدَ عُسْرٍ يُسْرًا","juz":28,"page":559,"sajdah":false,"w":[{"u":"لِيُنفِقْ","en":"Let spend","ur":"تاکہ خرچ کرے"},{"u":"ذُو","en":"owner","ur":"والا"},{"u":"سَعَةٍۢ","en":"(of) ample means","ur":"وسعت (والا)"},{"u":"مِّن","en":"from","ur":"سے"},{"u":"سَعَتِهِۦ ۖ","en":"his ample means","ur":"اپنی وسعت میں (سے)"},{"u":"وَمَن","en":"and (he) who","ur":"اور جو کوئی"},{"u":"قُدِرَ","en":"is restricted","ur":"تنگ کیا گیا"},{"u":"عَلَيْهِ","en":"on him","ur":"اس پر"},{"u":"رِزْقُهُۥ","en":"his provision","ur":"اس کا رزق"},{"u":"فَلْيُنفِقْ","en":"let him spend","ur":"پس چاہیے کہ خرچ کرے"},{"u":"مِمَّآ","en":"from what","ur":"اس میں سے جو"},{"u":"ءَاتَىٰهُ","en":"he has been given","ur":"عطا کیا اس کو"},{"u":"ٱللَّهُ ۚ","en":"(by) Allah","ur":"اللہ نے"},{"u":"لَا","en":"Does not","ur":"نہیں"},{"u":"يُكَلِّفُ","en":"burden","ur":"تکلیف دیتا"},{"u":"ٱللَّهُ","en":"Allah","ur":"اللہ"},{"u":"نَفْسًا","en":"any soul","ur":"کسی شخص کو"},{"