{"n":65,"src":{"text":"qc-text","wbw":"qc-wbw"},"ayahs":[{"k":"65:1","n":1,"id":5218,"u":" يَـٰٓأَيُّهَا ٱلنَّبِىُّ إِذَا طَلَّقْتُمُ ٱلنِّسَآءَ فَطَلِّقُوهُنَّ لِعِدَّتِهِنَّ وَأَحْصُوا۟ ٱلْعِدَّةَ ۖ وَٱتَّقُوا۟ ٱللَّهَ رَبَّكُمْ ۖ لَا تُخْرِجُوهُنَّ مِنۢ بُيُوتِهِنَّ وَلَا يَخْرُجْنَ إِلَّآ أَن يَأْتِينَ بِفَـٰحِشَةٍ مُّبَيِّنَةٍ ۚ وَتِلْكَ حُدُودُ ٱللَّهِ ۚ وَمَن يَتَعَدَّ حُدُودَ ٱللَّهِ فَقَدْ ظَلَمَ نَفْسَهُۥ ۚ لَا تَدْرِى لَعَلَّ ٱللَّهَ يُحْدِثُ بَعْدَ ذَٰلِكَ أَمْرًا","juz":28,"page":558,"sajdah":false,"w":[{"u":"يَـٰٓأَيُّهَا","en":"O","ur":"اے"},{"u":"ٱلنَّبِىُّ","en":"Prophet","ur":"نبی (صلی اللہ علیہ وآلہ وسلم)"},{"u":"إِذَا","en":"When","ur":"جب"},{"u":"طَلَّقْتُمُ","en":"you divorce","ur":"طلاق دو تم"},{"u":"ٱلنِّسَآءَ","en":"[the] women","ur":"عورتوں کو"},{"u":"فَطَلِّقُوهُنَّ","en":"then divorce them","ur":"تو طلاق دو ان کو"},{"u":"لِعِدَّتِهِنَّ","en":"for their waiting period","ur":"ان کی عدت کے لیے"},{"u":"وَأَحْصُوا۟","en":"and keep count","ur":"اور شمار کرو۔ گن لو"},{"u":"ٱلْعِدَّةَ ۖ","en":"(of) the waiting period","ur":"عدت کو"},{"u":"وَٱتَّقُوا۟","en":"and fear","ur":"اور ڈرو"},{"u":"ٱللَّهَ","en":"Allah","ur":"اللہ سے"},{"u":"رَبَّكُمْ ۖ","en":"your Lord","ur":"جو رب ہے تمہارا"},{"u":"لَا","en":"(Do) not","ur":"نہ"},{"u":"تُخْرِجُوهُنَّ","en":"expel them","ur":"تم نکالو ان کو"},{"u":"مِنۢ","en":"from","ur":"سے"},{"u":"بُيُوتِهِنَّ","en":"their houses","ur":"ان کے گھروں (سے )"},{"u":"وَلَا","en":"and not","ur":"اور نہ"},{"u":"يَخْرُجْنَ","en":"they should leave","ur":"وہ نکلیں"},{"u":"إِلَّآ","en":"except","ur":"مگر"},{"u":"أَن","en":"that","ur":"یہ کہ"},{"u":"يَأْتِينَ","en":"they commit","ur":"وہ آئیں"},{"u":"بِفَـٰحِشَةٍۢ","en":"an immorality","ur":"بےحیائی کو"},{"u":"مُّبَيِّنَةٍۢ ۚ","en":"clear","ur":"کھلی"},{"u":"وَتِلْكَ","en":"And these","ur":"اور یہ"},{"u":"حُدُودُ","en":"(are the) limits","ur":"حدود ہیں"},{"u":"ٱللَّهِ ۚ","en":"(of) Allah","ur":"اللہ کی"},{"u":"وَمَن","en":"And whoever","ur":"اور جو"},{"u":"يَتَعَدَّ","en":"tra