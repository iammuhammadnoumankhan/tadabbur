:"wbw/065_003_024.mp3"}]},{"k":"65:4","n":4,"id":5221,"u":"وَٱلَّـٰٓـِٔى يَئِسْنَ مِنَ ٱلْمَحِيضِ مِن نِّسَآئِكُمْ إِنِ ٱرْتَبْتُمْ فَعِدَّتُهُنَّ ثَلَـٰثَةُ أَشْهُرٍ وَٱلَّـٰٓـِٔى لَمْ يَحِضْنَ ۚ وَأُو۟لَـٰتُ ٱلْأَحْمَالِ أَجَلُهُنَّ أَن يَضَعْنَ حَمْلَهُنَّ ۚ وَمَن يَتَّقِ ٱللَّهَ يَجْعَل لَّهُۥ مِنْ أَمْرِهِۦ يُسْرًا","i":"وَالّٰٓـىٴِۡ يَٮِٕسۡنَ مِنَ الۡمَحِيۡضِ مِنۡ نِّسَآٮِٕكُمۡ اِنِ ارۡتَبۡتُمۡ فَعِدَّتُهُنَّ ثَلٰثَةُ اَشۡهُرٍ وَّالّٰٓـىٴِۡ لَمۡ يَحِضۡنَ​ ؕ وَاُولَاتُ الۡاَحۡمَالِ اَجَلُهُنَّ اَنۡ يَّضَعۡنَ حَمۡلَهُنَّ ​ؕ وَمَنۡ يَّـتَّـقِ اللّٰهَ يَجۡعَلْ لَّهٗ مِنۡ اَمۡرِهٖ یُسْرًا‏","juz":28,"page":558,"sajdah":false,"w":[{"u":"وَٱلَّـٰٓـِٔى","i":"وَالّٰٓـىٴِۡ","tl":"wa-allāī","en":"And those who","ur":"اور وہ عورتیں","a":"wbw/065_004_001.mp3"},{"u":"يَئِسْنَ","i":"يَٮِٕسۡنَ","tl":"ya-is'na","en":"have despaired","ur":"جو مایوس ہوچکی ہوں","a":"wbw/065_004_002.mp3"},{"u":"مِنَ","i":"مِنَ","tl":"mina","en":"of","ur":"سے","a":"wbw/065_004_003.mp3"},{"u":"ٱلْمَحِيضِ","i":"الۡمَحِيۡضِ","tl":"l-maḥīḍi","en":"the menstruation","ur":"حیض (سے)","a":"wbw/065_004_004.mp3"},{"u":"مِن","i":"مِنۡ","tl":"min","en":"among","ur":"سے","a":"wbw/065_004_005.mp3"},{"u":"نِّسَآئِكُمْ","i":"نِّسَآٮِٕكُمۡ","tl":"nisāikum","en":"your women","ur":"تمہاری عورتوں میں (سے)","a":"wbw/065_004_006.mp3"},{"u":"إِنِ","i":"اِنِ","tl":"ini","en":"if","ur":"اگر","a":"wbw/065_004_007.mp3"},{"u":"ٱرْتَبْتُمْ","i":"ارۡتَبۡتُمۡ","tl":"ir'tabtum","en":"you doubt","ur":"شک ہو تم کو","a":"wbw/065_004_008.mp3"},{"u":"فَعِدَّتُهُنَّ","i":"فَعِدَّتُهُنَّ","tl":"faʿiddatuhunna","en":"then their waiting period","ur":"تو ان کی عدت","a":"wbw/065_004_009.mp3"},{"u":"ثَلَـٰثَةُ","i":"ثَلٰثَةُ","tl":"thalāthatu","en":"(is) three","ur":"تین","a":"wbw/065_004_010.mp3"},{"u":"أَشْهُرٍۢ","i":"اَشۡهُرٍ","tl":"ashhurin","en":"months","ur":"مہینے ہے","a":"wbw/065_004_011.mp3"},{"u":"وَٱلَّـٰٓـِٔى","i":"وَّالّٰٓـىٴِۡ","tl":"wa-allāī","en":"and the ones who","ur":"اور وہ عورتیں","a":"wbw/065_004_012.mp3"},{"u":"لَم