 نِّسَآئِكُمْ إِنِ ٱرْتَبْتُمْ فَعِدَّتُهُنَّ ثَلَـٰثَةُ أَشْهُرٍ وَٱلَّـٰٓـِٔى لَمْ يَحِضْنَ ۚ وَأُو۟لَـٰتُ ٱلْأَحْمَالِ أَجَلُهُنَّ أَن يَضَعْنَ حَمْلَهُنَّ ۚ وَمَن يَتَّقِ ٱللَّهَ يَجْعَل لَّهُۥ مِنْ أَمْرِهِۦ يُسْرًا","juz":28,"page":558,"sajdah":false,"w":[{"u":"وَٱلَّـٰٓـِٔى","en":"And those who","ur":"اور وہ عورتیں"},{"u":"يَئِسْنَ","en":"have despaired","ur":"جو مایوس ہوچکی ہوں"},{"u":"مِنَ","en":"of","ur":"سے"},{"u":"ٱلْمَحِيضِ","en":"the menstruation","ur":"حیض (سے)"},{"u":"مِن","en":"among","ur":"سے"},{"u":"نِّسَآئِكُمْ","en":"your women","ur":"تمہاری عورتوں میں (سے)"},{"u":"إِنِ","en":"if","ur":"اگر"},{"u":"ٱرْتَبْتُمْ","en":"you doubt","ur":"شک ہو تم کو"},{"u":"فَعِدَّتُهُنَّ","en":"then their waiting period","ur":"تو ان کی عدت"},{"u":"ثَلَـٰثَةُ","en":"(is) three","ur":"تین"},{"u":"أَشْهُرٍۢ","en":"months","ur":"مہینے ہے"},{"u":"وَٱلَّـٰٓـِٔى","en":"and the ones who","ur":"اور وہ عورتیں"},{"u":"لَمْ","en":"not","ur":"نہیں"},{"u":"يَحِضْنَ ۚ","en":"[they] menstruated","ur":"جنہیں ابھی حیض آیا ہو۔ جو حائضہ ہوئی ہوں"},{"u":"وَأُو۟لَـٰتُ","en":"And those who (are)","ur":"اور والیاں"},{"u":"ٱلْأَحْمَالِ","en":"pregnant","ur":"حمل والیاں"},{"u":"أَجَلُهُنَّ","en":"their term","ur":"ان کی عدت"},{"u":"أَن","en":"until","ur":"کہ"},{"u":"يَضَعْنَ","en":"they deliver","ur":"وہ رکھ دیں"},{"u":"حَمْلَهُنَّ ۚ","en":"their burdens","ur":"اپنا حمل"},{"u":"وَمَن","en":"And whoever","ur":"اور جو"},{"u":"يَتَّقِ","en":"fears","ur":"ڈرے گا"},{"u":"ٱللَّهَ","en":"Allah","ur":"اللہ سے"},{"u":"يَجْعَل","en":"He will make","ur":"وہ کردے گا"},{"u":"لَّهُۥ","en":"for him","ur":"اس کے لیے"},{"u":"مِنْ","en":"of","ur":"سے"},{"u":"أَمْرِهِۦ","en":"his affair","ur":"اس کے کام میں"},{"u":"يُسْرًۭا","en":"ease","ur":"آسانی"}]},{"k":"65:5","n":5,"id":5222,"u":"ذَٰلِكَ أَمْرُ ٱللَّهِ أَنزَلَهُۥٓ إِلَيْكُمْ ۚ وَمَن يَتَّقِ ٱللَّهَ يُكَفِّرْ عَنْهُ سَيِّـَٔاتِهِۦ وَيُعْظِمْ لَهُۥٓ أَجْرًا","juz":28,"page":558,"sajdah":false,"w":[{"u":"ذَٰلِكَ","en":"That","ur":"یہ"},{"u":"أَمْرُ","en":