يۡمُ الۡخَبِیْرُ‏","juz":28,"page":560,"sajdah":false,"w":[{"u":"وَإِذْ","i":"وَاِذۡ","tl":"wa-idh","en":"And when","ur":"اور جب","a":"wbw/066_003_001.mp3"},{"u":"أَسَرَّ","i":"اَسَرَّ","tl":"asarra","en":"confided","ur":"چھپایا","a":"wbw/066_003_002.mp3"},{"u":"ٱلنَّبِىُّ","i":"النَّبِىُّ","tl":"l-nabiyu","en":"the Prophet","ur":"نبی (صلی اللہ علیہ وآلہ وسلم)","a":"wbw/066_003_003.mp3"},{"u":"إِلَىٰ","i":"اِلٰى","tl":"ilā","en":"to","ur":"طرف","a":"wbw/066_003_004.mp3"},{"u":"بَعْضِ","i":"بَعۡضِ","tl":"baʿḍi","en":"one","ur":"اپنی بعض","a":"wbw/066_003_005.mp3"},{"u":"أَزْوَٰجِهِۦ","i":"اَزۡوَاجِهٖ","tl":"azwājihi","en":"(of) his wives","ur":"بیویوں کے","a":"wbw/066_003_006.mp3"},{"u":"حَدِيثًۭا","i":"حَدِيۡثًا​ۚ","tl":"ḥadīthan","en":"a statement","ur":"ایک بات کو","a":"wbw/066_003_007.mp3"},{"u":"فَلَمَّا","i":"فَلَمَّا","tl":"falammā","en":"and when","ur":"تو جب","a":"wbw/066_003_008.mp3"},{"u":"نَبَّأَتْ","i":"نَـبَّاَتۡ","tl":"nabba-at","en":"she informed","ur":"اس نے خبر دی","a":"wbw/066_003_009.mp3"},{"u":"بِهِۦ","i":"بِهٖ","tl":"bihi","en":"about it","ur":"اس کی","a":"wbw/066_003_010.mp3"},{"u":"وَأَظْهَرَهُ","i":"وَاَظۡهَرَهُ","tl":"wa-aẓharahu","en":"and made it apparent","ur":"اور ظاہر کردیا اس کو","a":"wbw/066_003_011.mp3"},{"u":"ٱللَّهُ","i":"اللّٰهُ","tl":"l-lahu","en":"Allah","ur":"اللہ نے","a":"wbw/066_003_012.mp3"},{"u":"عَلَيْهِ","i":"عَلَيۡهِ","tl":"ʿalayhi","en":"to him","ur":"اس پر","a":"wbw/066_003_013.mp3"},{"u":"عَرَّفَ","i":"عَرَّفَ","tl":"ʿarrafa","en":"he made known","ur":"اس نے بتادیا۔ جتلا دیا","a":"wbw/066_003_014.mp3"},{"u":"بَعْضَهُۥ","i":"بَعۡضَهٗ","tl":"baʿḍahu","en":"a part of it","ur":"اس کا بعض حصہ","a":"wbw/066_003_015.mp3"},{"u":"وَأَعْرَضَ","i":"وَاَعۡرَضَ","tl":"wa-aʿraḍa","en":"and avoided","ur":"اور اعراض برتا","a":"wbw/066_003_016.mp3"},{"u":"عَنۢ","i":"عَنۡۢ","tl":"ʿan","en":"[of]","ur":"سے","a":"wbw/066_003_017.mp3"},{"u":"بَعْضٍۢ ۖ","i":"بَعۡضٍ​ۚ","tl":"baʿḍin","en":"a part","ur":"بعض (سے)","a":"wbw/066_003_018.mp3"},{