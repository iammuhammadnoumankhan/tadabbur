{"n":66,"src":{"text":"qc-text","wbw":"qc-wbw"},"ayahs":[{"k":"66:1","n":1,"id":5230,"u":" يَـٰٓأَيُّهَا ٱلنَّبِىُّ لِمَ تُحَرِّمُ مَآ أَحَلَّ ٱللَّهُ لَكَ ۖ تَبْتَغِى مَرْضَاتَ أَزْوَٰجِكَ ۚ وَٱللَّهُ غَفُورٌ رَّحِيمٌ","juz":28,"page":560,"sajdah":false,"w":[{"u":"يَـٰٓأَيُّهَا","en":"O","ur":"اے"},{"u":"ٱلنَّبِىُّ","en":"Prophet","ur":"نبی (صلی اللہ علیہ وآلہ وسلم)"},{"u":"لِمَ","en":"Why (do)","ur":"کیوں"},{"u":"تُحَرِّمُ","en":"you prohibit","ur":"آپ حرام قرار دیتے ہیں"},{"u":"مَآ","en":"what","ur":"جو"},{"u":"أَحَلَّ","en":"has made lawful","ur":"حلال کیا"},{"u":"ٱللَّهُ","en":"Allah","ur":"اللہ نے"},{"u":"لَكَ ۖ","en":"for you","ur":"آپ کے لیے"},{"u":"تَبْتَغِى","en":"seeking","ur":"آپ چاہتے ہیں"},{"u":"مَرْضَاتَ","en":"(to) please","ur":"رضامندی"},{"u":"أَزْوَٰجِكَ ۚ","en":"your wives","ur":"اپنی بیویوں کی"},{"u":"وَٱللَّهُ","en":"And Allah","ur":"اور اللہ"},{"u":"غَفُورٌۭ","en":"(is) Oft-Forgiving","ur":"بخشنے والا"},{"u":"رَّحِيمٌۭ","en":"Most Merciful","ur":"مہربان ہے"}]},{"k":"66:2","n":2,"id":5231,"u":"قَدْ فَرَضَ ٱللَّهُ لَكُمْ تَحِلَّةَ أَيْمَـٰنِكُمْ ۚ وَٱللَّهُ مَوْلَىٰكُمْ ۖ وَهُوَ ٱلْعَلِيمُ ٱلْحَكِيمُ","juz":28,"page":560,"sajdah":false,"w":[{"u":"قَدْ","en":"Indeed","ur":"تحقیق"},{"u":"فَرَضَ","en":"has ordained","ur":"فرض کیا"},{"u":"ٱللَّهُ","en":"Allah","ur":"اللہ نے"},{"u":"لَكُمْ","en":"for you","ur":"تمہارے لیے"},{"u":"تَحِلَّةَ","en":"(the) dissolution","ur":"کھولنا"},{"u":"أَيْمَـٰنِكُمْ ۚ","en":"(of) your oaths","ur":"تمہاری قسموں کا"},{"u":"وَٱللَّهُ","en":"And Allah","ur":"اور اللہ تعالیٰ"},{"u":"مَوْلَىٰكُمْ ۖ","en":"(is) your Protector","ur":"مولا ہے تمہارا"},{"u":"وَهُوَ","en":"and He","ur":"اور وہ"},{"u":"ٱلْعَلِيمُ","en":"(is) the All-Knower","ur":"علم والا ہے"},{"u":"ٱلْحَكِيمُ","en":"the All-Wise","ur":"حکمت والا ہے"}]},{"k":"66:3","n":3,"id":5232,"u":"وَإِذْ أَسَرَّ ٱلنَّبِىُّ إِلَىٰ بَعْضِ أَزْوَٰجِهِۦ حَدِيثًا فَلَمَّا نَبَّأَتْ بِهِۦ وَأَظْهَرَهُ ٱللَّهُ عَلَيْهِ عَرَّفَ بَعْضَهُۥ وَأَعْرَضَ عَنۢ بَعْضٍ ۖ فَلَمَّا نَبَّأَهَا بِهِۦ قَالَتْ مَنْ أَنۢبَأَكَ هَـٰذَا ۖ قَالَ نَبَّأَنِىَ ٱلْعَلِيمُ ٱلْخَبِيرُ","juz":28,"page":560,"sajdah":false,"w":[{"u":"وَإِذْ","en":"And when","ur":"اور جب"},{"u":"أَسَرَّ","en":"confided","ur":"چھپایا"},{"u":"ٱلنَّبِىُّ","en":"the Prophet","ur":"نبی (صلی اللہ علیہ وآلہ وسلم)"},{"u":"إِلَىٰ","en":"to","ur":"طرف"},{"u":"بَعْضِ","en":"one","ur":"اپنی بعض"},{"u":"أَزْوَٰجِهِۦ","en":"(of) his wives","ur":"بیویوں کے"},{"u":"حَدِيثًۭا","en":"a statement","ur":"ایک بات کو"},{"u":"فَلَمَّا","en":"and when","ur":"تو جب"},{"u":"نَبَّأَتْ","en":"she informed","ur":"اس نے خبر دی"},{"u":"بِهِۦ","en":"about it","ur":"اس کی"},{"u":"وَأَظْهَرَهُ","en":"and made it apparent","ur":"اور ظاہر کردیا اس کو"},{"u":"ٱللَّهُ","en":"Allah","ur":"اللہ نے"},{"u":"عَلَيْهِ","en":"to him","ur":"اس پر"},{"u":"عَرَّفَ","en":"he made known","ur":"اس نے بتادیا۔ جتلا دیا"},{"u":"بَعْضَهُۥ","en":"a part of it","ur":"اس کا بعض حصہ"},{"u":"وَأَعْرَضَ","en":"and avoided","ur":"اور اعراض برتا"},{"u":"عَنۢ","en":"[of]","ur":"سے"},{"u":"بَعْضٍۢ ۖ","en":"a part","ur":"بعض (سے)"},{"u":"فَلَمَّا","en":"Then when","ur":"تو جب"},{"u":"نَبَّأَهَا","en":"he informed her","ur":"آپ نے خبر دی اس (بیوی) کو"},{"u":"بِهِۦ","en":"about it","ur":"ساتھ اس بات کے"},{"u":"قَالَتْ","en":"she said","ur":"بولی آپ کو"},{"u":"مَنْ","en":"Who","ur":"کس نے"},{"u":"أَنۢبَأَكَ","en":"informed you","ur":"بتایا ہے۔ آپ کو کس نے خبر دی ہے"},{"u":"هَـٰذَا ۖ","en":"this","ur":"اس کی"},{"u":"قَالَ","en":"He said","ur":"فرمایا"},{"u":"نَبَّأَنِىَ","en":"Has informed me","ur":"خبر دی مجھ کو"},{"u":"ٱلْعَلِيمُ","en":"the All-Knower","ur":"علم والے"},{"u":"ٱلْخَبِيرُ","en":"the All-Aware","ur":"خبر والے نے"}]},{"k":"66:4","n":4,"id":5233,"u":"إِن تَتُوبَآ إِلَى ٱللَّهِ فَقَدْ صَغَتْ قُلُوبُكُمَا ۖ وَإِن تَظَـٰهَرَا عَلَيْهِ فَإِنَّ ٱللَّهَ هُوَ مَوْلَىٰهُ وَجِبْرِيلُ وَصَـٰلِحُ ٱلْمُؤْمِنِينَ ۖ وَٱلْمَلَـٰٓئِكَةُ بَعْدَ ذَٰلِكَ ظَهِيرٌ","juz":28,"page":560,"sajdah":false,"w":[{"u":"إِن","en":"If","ur":"اگر"},{"u":"تَتُوبَآ","en":"y