{"n":66,"src":{"text":"qc-text","wbw":"qc-wbw"},"ayahs":[{"k":"66:1","n":1,"id":5230,"u":" يَـٰٓأَيُّهَا ٱلنَّبِىُّ لِمَ تُحَرِّمُ مَآ أَحَلَّ ٱللَّهُ لَكَ ۖ تَبْتَغِى مَرْضَاتَ أَزْوَٰجِكَ ۚ وَٱللَّهُ غَفُورٌ رَّحِيمٌ","i":"يٰۤاَيُّهَا النَّبِىُّ لِمَ تُحَرِّمُ مَاۤ اَحَلَّ اللّٰهُ لَـكَ​ۚ تَبۡتَغِىۡ مَرۡضَاتَ اَزۡوَاجِكَ​ؕ وَاللّٰهُ غَفُوۡرٌ رَّحِيۡمٌ‏","juz":28,"page":560,"sajdah":false,"w":[{"u":"يَـٰٓأَيُّهَا","i":"يٰۤاَيُّهَا","tl":"yāayyuhā","en":"O","ur":"اے","a":"wbw/066_001_001.mp3"},{"u":"ٱلنَّبِىُّ","i":"النَّبِىُّ","tl":"l-nabiyu","en":"Prophet","ur":"نبی (صلی اللہ علیہ وآلہ وسلم)","a":"wbw/066_001_002.mp3"},{"u":"لِمَ","i":"لِمَ","tl":"lima","en":"Why (do)","ur":"کیوں","a":"wbw/066_001_003.mp3"},{"u":"تُحَرِّمُ","i":"تُحَرِّمُ","tl":"tuḥarrimu","en":"you prohibit","ur":"آپ حرام قرار دیتے ہیں","a":"wbw/066_001_004.mp3"},{"u":"مَآ","i":"مَاۤ","tl":"mā","en":"what","ur":"جو","a":"wbw/066_001_005.mp3"},{"u":"أَحَلَّ","i":"اَحَلَّ","tl":"aḥalla","en":"has made lawful","ur":"حلال کیا","a":"wbw/066_001_006.mp3"},{"u":"ٱللَّهُ","i":"اللّٰهُ","tl":"l-lahu","en":"Allah","ur":"اللہ نے","a":"wbw/066_001_007.mp3"},{"u":"لَكَ ۖ","i":"لَـكَ​ۚ","tl":"laka","en":"for you","ur":"آپ کے لیے","a":"wbw/066_001_008.mp3"},{"u":"تَبْتَغِى","i":"تَبۡتَغِىۡ","tl":"tabtaghī","en":"seeking","ur":"آپ چاہتے ہیں","a":"wbw/066_001_010.mp3"},{"u":"مَرْضَاتَ","i":"مَرۡضَاتَ","tl":"marḍāta","en":"(to) please","ur":"رضامندی","a":"wbw/066_001_011.mp3"},{"u":"أَزْوَٰجِكَ ۚ","i":"اَزۡوَاجِكَ​ؕ","tl":"azwājika","en":"your wives","ur":"اپنی بیویوں کی","a":"wbw/066_001_012.mp3"},{"u":"وَٱللَّهُ","i":"وَاللّٰهُ","tl":"wal-lahu","en":"And Allah","ur":"اور اللہ","a":"wbw/066_001_014.mp3"},{"u":"غَفُورٌۭ","i":"غَفُوۡرٌ","tl":"ghafūrun","en":"(is) Oft-Forgiving","ur":"بخشنے والا","a":"wbw/066_001_015.mp3"},{"u":"رَّحِيمٌۭ","i":"رَّحِيۡمٌ‏","tl":"raḥīmun","en":"Most Merciful","ur":"مہربان ہے","a":"wbw/066_001_016.mp3"}]},{"k":"66:2","n":2,"id":5231,"u":"قَدْ فَرَضَ ٱللَّهُ لَكُمْ تَحِلَّةَ أَيْمَـٰ