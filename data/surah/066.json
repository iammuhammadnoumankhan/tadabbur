ve","ur":"جنہوں نے کفر کیا"},{"u":"لَا","en":"(Do) not","ur":"نہ"},{"u":"تَعْتَذِرُوا۟","en":"make excuses","ur":"تم معذرت کرو"},{"u":"ٱلْيَوْمَ ۖ","en":"today","ur":"آج کے دن"},{"u":"إِنَّمَا","en":"Only","ur":"بیشک تم"},{"u":"تُجْزَوْنَ","en":"you will be recompensed","ur":"جزا دئیے جارہے ہو"},{"u":"مَا","en":"(for) what","ur":"جو"},{"u":"كُنتُمْ","en":"you used to","ur":"تھے تم"},{"u":"تَعْمَلُونَ","en":"do","ur":"تم عمل کرتے"}]},{"k":"66:8","n":8,"id":5237,"u":"يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ تُوبُوٓا۟ إِلَى ٱللَّهِ تَوْبَةً نَّصُوحًا عَسَىٰ رَبُّكُمْ أَن يُكَفِّرَ عَنكُمْ سَيِّـَٔاتِكُمْ وَيُدْخِلَكُمْ جَنَّـٰتٍ تَجْرِى مِن تَحْتِهَا ٱلْأَنْهَـٰرُ يَوْمَ لَا يُخْزِى ٱللَّهُ ٱلنَّبِىَّ وَٱلَّذِينَ ءَامَنُوا۟ مَعَهُۥ ۖ نُورُهُمْ يَسْعَىٰ بَيْنَ أَيْدِيهِمْ وَبِأَيْمَـٰنِهِمْ يَقُولُونَ رَبَّنَآ أَتْمِمْ لَنَا نُورَنَا وَٱغْفِرْ لَنَآ ۖ إِنَّكَ عَلَىٰ كُلِّ شَىْءٍ قَدِيرٌ","juz":28,"page":561,"sajdah":false,"w":[{"u":"يَـٰٓأَيُّهَا","en":"O","ur":"اے"},{"u":"ٱلَّذِينَ","en":"(you) who believe","ur":"لوگو"},{"u":"ءَامَنُوا۟","en":"believe","ur":"جو ایمان لائے ہو"},{"u":"تُوبُوٓا۟","en":"Turn","ur":"توبہ کرو"},{"u":"إِلَى","en":"to","ur":"طرف"},{"u":"ٱللَّهِ","en":"Allah","ur":"اللہ کی"},{"u":"تَوْبَةًۭ","en":"(in) repentance","ur":"توبہ"},{"u":"نَّصُوحًا","en":"sincere","ur":"خالص"},{"u":"عَسَىٰ","en":"Perhaps","ur":"امید ہے"},{"u":"رَبُّكُمْ","en":"your Lord","ur":"تمہارا رب"},{"u":"أَن","en":"will","ur":"کہ"},{"u":"يُكَفِّرَ","en":"remove","ur":"دور کردے گا"},{"u":"عَنكُمْ","en":"from you","ur":"تم سے"},{"u":"سَيِّـَٔاتِكُمْ","en":"your evil deeds","ur":"تمہاری برائیاں"},{"u":"وَيُدْخِلَكُمْ","en":"and admit you","ur":"اور داخل کردے گا"},{"u":"جَنَّـٰتٍۢ","en":"(into) Gardens","ur":"باغوں میں"},{"u":"تَجْرِى","en":"flow","ur":"بہتی ہیں"},{"u":"مِن","en":"from","ur":"سے"},{"u":"تَحْتِهَا","en":"underneath it","ur":"ان کے نیچے"},{"u":"ٱلْأَنْهَـٰرُ","en":"the rivers","ur":"نہریں"},{"u":"يَوْمَ","en":"(on the) Day","ur":"جس دن"},{"u":"لَا","en":"not","ur":"نہ"}