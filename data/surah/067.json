{"n":67,"src":{"text":"qc-text","wbw":"qc-wbw"},"ayahs":[{"k":"67:1","n":1,"id":5242,"u":" تَبَـٰرَكَ ٱلَّذِى بِيَدِهِ ٱلْمُلْكُ وَهُوَ عَلَىٰ كُلِّ شَىْءٍ قَدِيرٌ","i":"تَبٰرَكَ الَّذِىۡ بِيَدِهِ الۡمُلۡكُ وَهُوَ عَلٰى كُلِّ شَىۡءٍ قَدِيۡرُۙ‏ ﻿﻿","juz":29,"page":562,"sajdah":false,"w":[{"u":"تَبَـٰرَكَ","i":"تَبٰرَكَ","tl":"tabāraka","en":"Blessed is","ur":"بہت بابرکت ہے","a":"wbw/067_001_001.mp3"},{"u":"ٱلَّذِى","i":"الَّذِىۡ","tl":"alladhī","en":"He","ur":"وہ ذات","a":"wbw/067_001_002.mp3"},{"u":"بِيَدِهِ","i":"بِيَدِهِ","tl":"biyadihi","en":"in Whose Hand","ur":"جس کے ہاتھ میں ہے","a":"wbw/067_001_003.mp3"},{"u":"ٱلْمُلْكُ","i":"الۡمُلۡكُ","tl":"l-mul'ku","en":"(is) the Dominion","ur":"ساری بادشاہت","a":"wbw/067_001_004.mp3"},{"u":"وَهُوَ","i":"وَهُوَ","tl":"wahuwa","en":"and He","ur":"اور وہ","a":"wbw/067_001_005.mp3"},{"u":"عَلَىٰ","i":"عَلٰى","tl":"ʿalā","en":"(is) over","ur":"پر","a":"wbw/067_001_006.mp3"},{"u":"كُلِّ","i":"كُلِّ","tl":"kulli","en":"every","ur":"ہر","a":"wbw/067_001_007.mp3"},{"u":"شَىْءٍۢ","i":"شَىۡءٍ","tl":"shayin","en":"thing","ur":"چیز","a":"wbw/067_001_008.mp3"},{"u":"قَدِيرٌ","i":"قَدِيۡرُۙ‏ ﻿﻿","tl":"qadīrun","en":"All-Powerful","ur":"قدرت رکھنے والا ہے","a":"wbw/067_001_009.mp3"}]},{"k":"67:2","n":2,"id":5243,"u":"ٱلَّذِى خَلَقَ ٱلْمَوْتَ وَٱلْحَيَوٰةَ لِيَبْلُوَكُمْ أَيُّكُمْ أَحْسَنُ عَمَلًا ۚ وَهُوَ ٱلْعَزِيزُ ٱلْغَفُورُ","i":"اۨلَّذِىۡ خَلَقَ الۡمَوۡتَ وَالۡحَيٰوةَ لِيَبۡلُوَكُمۡ اَيُّكُمۡ اَحۡسَنُ عَمَلًا ؕ وَهُوَ الۡعَزِيۡزُ الۡغَفُوۡرُۙ‏","juz":29,"page":562,"sajdah":false,"w":[{"u":"ٱلَّذِى","i":"اۨلَّذِىۡ","tl":"alladhī","en":"The One Who","ur":"جس نے","a":"wbw/067_002_001.mp3"},{"u":"خَلَقَ","i":"خَلَقَ","tl":"khalaqa","en":"created","ur":"پیدا کیا","a":"wbw/067_002_002.mp3"},{"u":"ٱلْمَوْتَ","i":"الۡمَوۡتَ","tl":"l-mawta","en":"death","ur":"موت کو","a":"wbw/067_002_003.mp3"},{"u":"وَٱلْحَيَوٰةَ","i":"وَالۡحَيٰوةَ","tl":"wal-ḥayata","en":"and life","ur":"اور زندگی کو","a":"wbw/067_002_004.mp3"},{"u":"لِيَبْلُوَكُمْ","i":"لِيَبۡلُوَكُمۡ","tl":"liyabluwakum","en":"that He may test you","ur":"تاکہ آزمائے تم کو","a":"wbw/067_002_005.mp3"},{"u":"أَيُّكُمْ","i":"اَيُّكُمۡ","tl":"ayyukum","en":"which of you","ur":"کون ساتم میں سے","a":"wbw/067_002_006.mp3"},{"u":"أَحْسَنُ","i":"اَحۡسَنُ","tl":"aḥsanu","en":"(is) best","ur":"زیادہ اچھا ہے","a":"wbw/067_002_007.mp3"},{"u":"عَمَلًۭا ۚ","i":"عَمَلًا ؕ","tl":"ʿamalan","en":"(in) deed","ur":"عمل میں","a":"wbw/067_002_008.mp3"},{"u":"وَهُوَ","i":"وَهُوَ","tl":"wahuwa","en":"And He","ur":"اور وہ","a":"wbw/067_002_010.mp3"},{"u":"ٱلْعَزِيزُ","i":"الۡعَزِيۡزُ","tl":"l-ʿazīzu","en":"(is) the All-Mighty","ur":"زبردست ہے","a":"wbw/067_002_011.mp3"},{"u":"ٱلْغَفُورُ","i":"الۡغَفُوۡرُۙ‏","tl":"l-ghafūru","en":"the Oft-Forgiving","ur":"بخشش کرنے والا ہے","a":"wbw/067_002_012.mp3"}]},{"k":"67:3","n":3,"id":5244,"u":"ٱلَّذِى خَلَقَ سَبْعَ سَمَـٰوَٰتٍ طِبَاقًا ۖ مَّا تَرَىٰ فِى خَلْقِ ٱلرَّحْمَـٰنِ مِن تَفَـٰوُتٍ ۖ فَٱرْجِعِ ٱلْبَصَرَ هَلْ تَرَىٰ مِن فُطُورٍ","i":"الَّذِىۡ خَلَقَ سَبۡعَ سَمٰوٰتٍ طِبَاقًا​ ؕ مَا تَرٰى فِىۡ خَلۡقِ الرَّحۡمٰنِ مِنۡ تَفٰوُتٍ​ ؕ فَارۡجِعِ الۡبَصَرَۙ هَلۡ تَرٰى مِنۡ فُطُوۡرٍ‏","juz":29,"page":562,"sajdah":false,"w":[{"u":"ٱلَّذِى","i":"الَّذِىۡ","tl":"alladhī","en":"The One Who","ur":"جس نے","a":"wbw/067_003_001.mp3"},{"u":"خَلَقَ","i":"خَلَقَ","tl":"khalaqa","en":"created","ur":"بنائے","a":"wbw/067_003_002.mp3"},{"u":"سَبْعَ","i":"سَبۡعَ","tl":"sabʿa","en":"seven","ur":"سات","a":"wbw/067_003_003.mp3"},{"u":"سَمَـٰوَٰتٍۢ","i":"سَمٰوٰتٍ","tl":"samāwātin","en":"heavens","ur":"آسمان","a":"wbw/067_003_004.mp3"},{"u":"طِبَاقًۭا ۖ","i":"طِبَاقًا​ ؕ","tl":"ṭibāqan","en":"one above another","ur":"اوپر تلے۔ تہ بہ تہ","a":"wbw/067_003_005.mp3"},{"u":"مَّا","i":"مَا","tl":"mā","en":"Not","ur":"نہ","a":"wbw/067_003_007.mp3"},{"u":"تَرَىٰ","i":"تَرٰى","tl":"tarā","en":"you see","ur":"تم دیکھو گے","a":"wbw/067_003_008.mp3"},{"u":"فِى","i":"فِىۡ","tl":"fī","en":"in","ur":"میں","a":"wbw/067_003_009.mp3"},{"u":"خَلْقِ","i":"خَلۡقِ","tl":"khalqi","en":"(the) creation","ur":"تخلیق","a":"wbw/067_003_010.mp3"},{"u":"ٱلرَّحْمَـٰنِ","i":"الرَّحۡمٰنِ","tl":"l-raḥmāni","en":"(of) the Most Gracious","ur":"رحمن کی","a":"wbw/067_003_011.mp3"},{"u":"مِن","i":"مِنۡ","tl":"min","en":"any","ur":"کوئی","a":"wbw/067_003_012.mp3"},{"u":"تَفَـٰوُتٍۢ ۖ","i":"تَفٰوُتٍ​ ؕ","tl":"tafāwutin","en":"fault","ur":"نقص۔ کجی۔ خلل","a":"wbw/067_003_013.mp3"},{"u":"فَٱرْجِعِ","i":"فَارۡجِعِ","tl":"fa-ir'jiʿi","en":"So return","ur":"پھر لوٹاؤ","a":"wbw/067_003_015.mp3"},{"u":"ٱلْبَصَرَ","i":"الۡبَصَرَۙ","tl":"l-baṣara","en":"the vision","ur":"نگاہ کو","a":"wbw/067_003_016.mp3"},{"u":"هَلْ","i":"هَلۡ","tl":"hal","en":"can","ur":"کیا","a":"wbw/067_003_017.mp3"},{"u":"تَرَىٰ","i":"تَرٰى","tl":"tarā","en":"you see","ur":"تم دیکھتے ہو","a":"wbw/067_003_018.mp3"},{"u":"مِن","i":"مِنۡ","tl":"min","en":"any","ur":"کوئی","a":"wbw/067_003_019.mp3"},{"u":"فُطُورٍۢ","i":"فُطُوۡرٍ‏","tl":"fuṭūrin","en":"flaw","ur":"شگاف۔ کوئی رخنہ","a":"wbw/067_003_020.mp3"}]},{"k":"67:4","n":4,"id":5245,"u":"ثُمَّ ٱرْجِعِ ٱلْبَصَرَ كَرَّتَيْنِ يَنقَلِبْ إِلَيْكَ ٱلْبَصَرُ خَاسِئًا وَهُوَ حَسِيرٌ","i":"ثُمَّ ارۡجِعِ الۡبَصَرَ كَرَّتَيۡنِ يَنۡقَلِبۡ اِلَيۡكَ الۡبَصَرُ خَاسِئًا وَّهُوَ حَسِيۡرٌ‏","juz":29,"page":562,"sajdah":false,"w":[{"u":"ثُمَّ","i":"ثُمَّ","tl":"thumma","en":"Then","ur":"پھر","a":"wbw/067_004_001.mp3"},{"u":"ٱرْجِعِ","i":"ارۡجِعِ","tl":"ir'jiʿi","en":"return","ur":"لوٹاؤ","a":"wbw/067_004_002.mp3"},{"u":"ٱلْبَصَرَ","i":"الۡبَصَرَ","tl":"l-baṣara","en":"the vision","ur":"نگاہ کو","a":"wbw/067_004_003.mp3"},{"u":"كَرَّتَيْنِ","i":"كَرَّتَيۡنِ","tl":"karratayni","en":"twice (again)","ur":"بار بار","a":"wbw/067_004_004.mp3"},{"u":"يَنقَلِبْ","i":"يَنۡقَلِبۡ","tl":"yanqalib","en":"Will return","ur":"لوٹ آئے گی","a":"wbw/067_004_005.mp3"},{"u":"إِلَيْكَ","i":"اِلَيۡكَ","tl":"ilayka","en":"to you","ur":"تیری طرف","a":"wbw/067_004_006.mp3"},{"u":"ٱلْبَصَرُ","i":"الۡبَصَرُ","tl":"l-baṣaru","en":"the vision","ur":"نگاہ","a":"wbw/067_004_007.mp3"},{"u":"خَاسِئًۭ