{"n":68,"src":{"text":"qc-text","wbw":"qc-wbw"},"ayahs":[{"k":"68:1","n":1,"id":5272,"u":" نٓ ۚ وَٱلْقَلَمِ وَمَا يَسْطُرُونَ","i":"نٓ​ وَالۡقَلَمِ وَمَا يَسۡطُرُوۡنَۙ‏","juz":29,"page":564,"sajdah":false,"w":[{"u":"نٓ ۚ","i":"نٓ​","tl":"noon","en":"Nun","ur":"ن","a":"wbw/068_001_001.mp3"},{"u":"وَٱلْقَلَمِ","i":"وَالۡقَلَمِ","tl":"wal-qalami","en":"By the pen","ur":"قسم ہے قلم کی","a":"wbw/068_001_003.mp3"},{"u":"وَمَا","i":"وَمَا","tl":"wamā","en":"and what","ur":"اور قسم ہے اس کی جو کچھ","a":"wbw/068_001_004.mp3"},{"u":"يَسْطُرُونَ","i":"يَسۡطُرُوۡنَۙ‏","tl":"yasṭurūna","en":"they write","ur":"وہ لکھ رہے ہیں","a":"wbw/068_001_005.mp3"}]},{"k":"68:2","n":2,"id":5273,"u":"مَآ أَنتَ بِنِعْمَةِ رَبِّكَ بِمَجْنُونٍ","i":"مَاۤ اَنۡتَ بِـنِعۡمَةِ رَبِّكَ بِمَجۡنُوۡنٍ​ۚ‏","juz":29,"page":564,"sajdah":false,"w":[{"u":"مَآ","i":"مَاۤ","tl":"mā","en":"Not","ur":"نہیں ہیں","a":"wbw/068_002_001.mp3"},{"u":"أَنتَ","i":"اَنۡتَ","tl":"anta","en":"you (are)","ur":"آپ","a":"wbw/068_002_002.mp3"},{"u":"بِنِعْمَةِ","i":"بِـنِعۡمَةِ","tl":"biniʿ'mati","en":"by (the) Grace","ur":"نعمت کے ساتھ","a":"wbw/068_002_003.mp3"},{"u":"رَبِّكَ","i":"رَبِّكَ","tl":"rabbika","en":"(of) your Lord","ur":"اپنے رب کی","a":"wbw/068_002_004.mp3"},{"u":"بِمَجْنُونٍۢ","i":"بِمَجۡنُوۡنٍ​ۚ‏","tl":"bimajnūnin","en":"a madman","ur":"مجنون","a":"wbw/068_002_005.mp3"}]},{"k":"68:3","n":3,"id":5274,"u":"وَإِنَّ لَكَ لَأَجْرًا غَيْرَ مَمْنُونٍ","i":"وَاِنَّ لَڪَ لَاَجۡرًا غَيۡرَ مَمۡنُوۡنٍ​ۚ‏","juz":29,"page":564,"sajdah":false,"w":[{"u":"وَإِنَّ","i":"وَاِنَّ","tl":"wa-inna","en":"And indeed","ur":"اور بیشک","a":"wbw/068_003_001.mp3"},{"u":"لَكَ","i":"لَڪَ","tl":"laka","en":"for you","ur":"آپ کے لیے","a":"wbw/068_003_002.mp3"},{"u":"لَأَجْرًا","i":"لَاَجۡرًا","tl":"la-ajran","en":"surely (is) a reward","ur":"البتہ اجر ہے","a":"wbw/068_003_003.mp3"},{"u":"غَيْرَ","i":"غَيۡرَ","tl":"ghayra","en":"without","ur":"نہ","a":"wbw/068_003_004.mp3"},{"u":"مَمْنُونٍۢ","i":"مَمۡنُوۡنٍ​ۚ‏","tl":"mamnūnin","en":"end","ur":"ختم ہونے والا","a":"wbw/068_003_005.mp3"}]},{"k":"68:4","n":4,"id":5275,"u":"وَإِنَّكَ لَعَلَىٰ خُلُقٍ عَظِيمٍ","i":"وَاِنَّكَ لَعَلٰى خُلُقٍ عَظِيۡمٍ‏","juz":29,"page":564,"sajdah":false,"w":[{"u":"وَإِنَّكَ","i":"وَاِنَّكَ","tl":"wa-innaka","en":"And indeed, you","ur":"اور بیشک آپ","a":"wbw/068_004_001.mp3"},{"u":"لَعَلَىٰ","i":"لَعَلٰى","tl":"laʿalā","en":"surely (are)","ur":"البتہ","a":"wbw/068_004_002.mp3"},{"u":"خُلُقٍ","i":"خُلُقٍ","tl":"khuluqin","en":"(of) a moral character","ur":"اخلاق کے","a":"wbw/068_004_003.mp3"},{"u":"عَظِيمٍۢ","i":"عَظِيۡمٍ‏","tl":"ʿaẓīmin","en":"great","ur":"بلند مرتبے پر ہیں","a":"wbw/068_004_004.mp3"}]},{"k":"68:5","n":5,"id":5276,"u":"فَسَتُبْصِرُ وَيُبْصِرُونَ","i":"فَسَتُبۡصِرُ وَيُبۡصِرُوۡنَۙ‏","juz":29,"page":564,"sajdah":false,"w":[{"u":"فَسَتُبْصِرُ","i":"فَسَتُبۡصِرُ","tl":"fasatub'ṣiru","en":"So you will see","ur":"پس عنقریب تم بھی دیکھو گے","a":"wbw/068_005_001.mp3"},{"u":"وَيُبْصِرُونَ","i":"وَيُبۡصِرُوۡنَۙ‏","tl":"wayub'ṣirūna","en":"and they will see","ur":"اور وہ بھی دیکھیں گے","a":"wbw/068_005_002.mp3"}]},{"k":"68:6","n":6,"id":5277,"u":"بِأَييِّكُمُ ٱلْمَفْتُونُ","i":"بِاَيِّٮكُمُ الۡمَفۡتُوۡنُ‏","juz":29,"page":564,"sajdah":false,"w":[{"u":"بِأَييِّكُمُ","i":"بِاَيِّٮكُمُ","tl":"bi-ayyikumu","en":"Which of you","ur":"کون تم میں سے","a":"wbw/068_006_001.mp3"},{"u":"ٱلْمَفْتُونُ","i":"الۡمَفۡتُوۡنُ‏","tl":"l-maftūnu","en":"(is) the afflicted one","ur":"فتنے میں پڑا ہو ا ہے","a":"wbw/068_006_002.mp3"}]},{"k":"68:7","n":7,"id":5278,"u":"إِنَّ رَبَّكَ هُوَ أَعْلَمُ بِمَن ضَلَّ عَن سَبِيلِهِۦ وَهُوَ أَعْلَمُ بِٱلْمُهْتَدِينَ","i":"اِنَّ رَبَّكَ هُوَ اَعۡلَمُ بِمَنۡ ضَلَّ عَنۡ سَبِيۡلِهٖ وَهُوَ اَعۡلَمُ بِالۡمُهۡتَدِيۡنَ‏","juz":29,"page":564,"sajdah":false,"w":[{"u":"إِنَّ","i":"اِنَّ","tl":"inna","en":"Indeed","ur":"بیشک","a":"wbw/068_007_001.mp3"},{"u":"رَبَّكَ","i":"رَبَّكَ","tl":"rabbaka","en":"your Lord","ur":"رب تیرا","a":"wbw/068_007_002.mp3"},{"u":"هُوَ","i":"هُوَ","tl":"huwa","en":"He","ur":"وہ","a":"wbw/068_007_003.mp3"},{"u":"أَعْلَمُ","i":"اَعۡلَمُ","tl":"aʿlamu","en":"(is) most knowing","ur":"زیادہ جانتا ہے","a":"wbw/068_007_004.mp3"},{"u":"بِمَن","i":"بِمَنۡ","tl":"biman","en":"of (he) who","ur":"اس کو جو","a":"wbw/068_007_005.mp3"},{"u":"ضَلَّ","i":"ضَلَّ","tl":"ḍalla","en":"has strayed","ur":"بھٹک گیا","a":"wbw/068_007_006.mp3"},{"u":"عَن","i":"عَنۡ","tl":"ʿan","en":"from","ur":"سے","a":"wbw/068_007_007.mp3"},{"u":"سَبِيلِهِۦ","i":"سَبِيۡلِهٖ","tl":"sabīlihi","en":"His way","ur":"اس کے راستے","a":"wbw/068_007_008.mp3"},{"u":"وَهُوَ","i":"وَهُوَ","tl":"wahuwa","en":"and He","ur":"اور وہ","a":"wbw/068_007_009.mp3"},{"u":"أَعْلَمُ","i":"اَعۡلَمُ","tl":"aʿlamu","en":"(is) most knowing","ur":"زیادہ جانتا ہے","a":"wbw/068_007_010.mp3"},{"u":"بِٱلْمُهْتَدِينَ","i":"بِالۡمُهۡتَدِيۡنَ‏","tl":"bil-muh'tadīna","en":"of the guided ones","ur":"ہدایت پانے والوں کو","a":"wbw/068_007_011.mp3"}]},{"k":"68:8","n":8,"id":5279,"u":"فَلَا تُطِعِ ٱلْمُكَذِّبِينَ","i":"فَلَا تُطِعِ الۡمُكَذِّبِيۡنَ‏","juz":29,"page":564,"sajdah":false,"w":[{"u":"فَلَا","i":"فَلَا","tl":"falā","en":"So (do) not","ur":"پس نہ","a":"wbw/068_008_001.mp3"},{"u":"تُطِعِ","i":"تُطِعِ","tl":"tuṭiʿi","en":"obey","ur":"تم اطاعت کرو","a":"wbw/068_008_002.mp3"},{"u":"ٱلْمُكَذِّبِينَ","i":"الۡمُكَذِّبِيۡنَ‏","tl":"l-mukadhibīna","en":"the deniers","ur":"جھٹلانے والوں کی","a":"wbw/068_008_003.mp3"}]},{"k":"68:9","n":9,"id":5280,"u":"وَدُّوا۟ لَوْ تُدْهِنُ فَيُدْهِنُونَ","i":"وَدُّوۡا لَوۡ تُدۡهِنُ فَيُدۡهِنُوۡنَ‏","juz":29,"page":564,"sajdah":false,"w":[{"u":"وَدُّوا۟","i":"وَدُّوۡا","tl":"waddū","en":"They wish","ur":"وہ چاہتے ہیں","a":"wbw/068_009_001.mp3"},{"u":"لَوْ","i":"لَوۡ","tl":"law","en":"that","ur":"کاش تم","a":"wbw/068_009_002.mp3"},{"u":"تُدْهِنُ","i":"تُدۡهِنُ","tl":"tud'hinu","en":"you should compromise","ur":"سستی کرو","a":"wbw/068_009_003.mp3"},{"u":"فَيُدْهِنُونَ","i":"فَيُدۡهِنُوۡنَ‏","tl":"fayud'hinūna","en":"so they would compromise","ur":"تو وہ بھی سستی کریں۔ مداہنت کریں","a":"wbw/068_009_004.mp3"}]},{"k":"68:10","n":10,"id":5281,"u":"وَلَا تُطِعْ كُلَّ حَلَّافٍ مَّهِينٍ","i":"وَلَا تُطِعۡ كُلَّ حَلَّافٍ مَّهِيۡنٍۙ‏","juz":29,"page":564,"sajdah":false,"w":[{"u":"وَلَا","i":"وَلَا","tl":"walā","en":"And (do) not","ur":"اور نہ","a":"wbw/068_010_001.mp3"},{"u":"تُطِعْ","i":"تُطِعۡ","tl":"tuṭiʿ","en":"obey","ur":"تم اطاعت کرو","a":"wbw/068_010_002.mp3"},{"u":"كُلَّ","i":"كُلَّ","tl":"kulla","en":"every","ur":"بہت","a":"wbw/068_010_003.mp3"},{"u":"حَلَّافٍۢ","i":"حَلَّافٍ","tl":"ḥallāfin","en":"habitual swearer","ur":"قسمیں کھانے والے کی","a":"wbw/068_010_004.mp3"},{"u":"مَّهِينٍ","i":"مَّهِيۡنٍۙ‏","tl":"mahīnin","en":"worthless","ur":"ذلیل","a":"wbw/068_010_005.mp3"}]},{"k":"68:11","n":11,"id":5282,"u":"هَمَّازٍ مَّشَّآءٍۭ بِنَمِيمٍ","i":"هَمَّازٍ مَّشَّآءٍۢ بِنَمِيۡمٍۙ‏","juz":29,"page":564,"sajdah":false,"w":[{"u":"هَمَّازٍۢ","i":"هَمَّازٍ","tl":"hammāzin","en":"Defamer","ur":"عیب جوئی کرنے والا","a":"wbw/068_011_001.mp3"},{"u":"مَّشَّآءٍۭ","i":"مَّشَّآءٍۢ","tl":"mashāin","en":"going about","ur":"چلنے والا","a":"wbw/068_011_002.mp3"},{"u":"بِنَمِيمٍۢ","i":"بِنَمِيۡمٍۙ‏","tl":"binamīmin","en":"with malicious gossip","ur":"ساتھ چغل خوری کے","a":"wbw/068_011_003.mp3"}]},{"k":"68:12","n":12,"id":5283,"u":"مَّنَّاعٍ لِّلْخَيْرِ مُعْتَدٍ أَثِيمٍ","i":"مَّنَّاعٍ لِّلۡخَيۡرِ مُعۡتَدٍ اَثِيۡمٍۙ‏","juz":29,"page":564,"sajdah":false,"w":[{"u":"مَّنَّاعٍۢ","i":"مَّنَّاعٍ","tl":"mannāʿin","en":"A preventer","ur":"بہت روکنے والا","a":"wbw/068_012_001.mp3"},{"u":"لِّلْخَيْرِ","i":"لِّلۡخَيۡرِ","tl":"lil'khayri","en":"of (the) good","ur":"بھلائی کا","a":"wbw/068_012_002.mp3"},{"u":"مُعْتَدٍ","i":"مُعۡتَدٍ","tl":"muʿ'tadin","en":"transgressor","ur":"حد سے بڑھنے والا","a":"wbw/068_012_003.mp3"},{"u":"أَثِيمٍ","i":"اَثِيۡمٍۙ‏","tl":"athīmin","en":"sinful","ur":"گناہ گار","a":"wbw/068_012_004.mp3"}]},{"k":"68:13","n":13,"id":5284,"u":"عُتُلٍّۭ بَعْدَ ذَٰلِكَ زَنِيمٍ","i":"عُتُلٍّ ۢ بَعۡدَ ذٰلِكَ زَنِيۡمٍۙ‏","juz":29,"page":564,"sajdah":false,"w":[{"u":"عُتُلٍّۭ","i":"عُتُلّ