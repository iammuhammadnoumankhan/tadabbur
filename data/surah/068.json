{"n":68,"src":{"text":"qc-text","wbw":"qc-wbw"},"ayahs":[{"k":"68:1","n":1,"id":5272,"u":" نٓ ۚ وَٱلْقَلَمِ وَمَا يَسْطُرُونَ","juz":29,"page":564,"sajdah":false,"w":[{"u":"نٓ ۚ","en":"Nun","ur":"ن"},{"u":"وَٱلْقَلَمِ","en":"By the pen","ur":"قسم ہے قلم کی"},{"u":"وَمَا","en":"and what","ur":"اور قسم ہے اس کی جو کچھ"},{"u":"يَسْطُرُونَ","en":"they write","ur":"وہ لکھ رہے ہیں"}]},{"k":"68:2","n":2,"id":5273,"u":"مَآ أَنتَ بِنِعْمَةِ رَبِّكَ بِمَجْنُونٍ","juz":29,"page":564,"sajdah":false,"w":[{"u":"مَآ","en":"Not","ur":"نہیں ہیں"},{"u":"أَنتَ","en":"you (are)","ur":"آپ"},{"u":"بِنِعْمَةِ","en":"by (the) Grace","ur":"نعمت کے ساتھ"},{"u":"رَبِّكَ","en":"(of) your Lord","ur":"اپنے رب کی"},{"u":"بِمَجْنُونٍۢ","en":"a madman","ur":"مجنون"}]},{"k":"68:3","n":3,"id":5274,"u":"وَإِنَّ لَكَ لَأَجْرًا غَيْرَ مَمْنُونٍ","juz":29,"page":564,"sajdah":false,"w":[{"u":"وَإِنَّ","en":"And indeed","ur":"اور بیشک"},{"u":"لَكَ","en":"for you","ur":"آپ کے لیے"},{"u":"لَأَجْرًا","en":"surely (is) a reward","ur":"البتہ اجر ہے"},{"u":"غَيْرَ","en":"without","ur":"نہ"},{"u":"مَمْنُونٍۢ","en":"end","ur":"ختم ہونے والا"}]},{"k":"68:4","n":4,"id":5275,"u":"وَإِنَّكَ لَعَلَىٰ خُلُقٍ عَظِيمٍ","juz":29,"page":564,"sajdah":false,"w":[{"u":"وَإِنَّكَ","en":"And indeed, you","ur":"اور بیشک آپ"},{"u":"لَعَلَىٰ","en":"surely (are)","ur":"البتہ"},{"u":"خُلُقٍ","en":"(of) a moral character","ur":"اخلاق کے"},{"u":"عَظِيمٍۢ","en":"great","ur":"بلند مرتبے پر ہیں"}]},{"k":"68:5","n":5,"id":5276,"u":"فَسَتُبْصِرُ وَيُبْصِرُونَ","juz":29,"page":564,"sajdah":false,"w":[{"u":"فَسَتُبْصِرُ","en":"So you will see","ur":"پس عنقریب تم بھی دیکھو گے"},{"u":"وَيُبْصِرُونَ","en":"and they will see","ur":"اور وہ بھی دیکھیں گے"}]},{"k":"68:6","n":6,"id":5277,"u":"بِأَييِّكُمُ ٱلْمَفْتُونُ","juz":29,"page":564,"sajdah":false,"w":[{"u":"بِأَييِّكُمُ","en":"Which of you","ur":"کون تم میں سے"},{"u":"ٱلْمَفْتُونُ","en":"(is) the afflicted one","ur":"فتنے میں پڑا ہو ا ہے"}]},{"k":"68:7","n":7,"id":5278,"u":"إِنَّ رَبَّكَ هُو