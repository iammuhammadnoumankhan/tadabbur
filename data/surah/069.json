30,"u":"سَخَّرَهَا عَلَيْهِمْ سَبْعَ لَيَالٍ وَثَمَـٰنِيَةَ أَيَّامٍ حُسُومًا فَتَرَى ٱلْقَوْمَ فِيهَا صَرْعَىٰ كَأَنَّهُمْ أَعْجَازُ نَخْلٍ خَاوِيَةٍ","juz":29,"page":566,"sajdah":false,"w":[{"u":"سَخَّرَهَا","en":"Which He imposed","ur":"مسلط کردیا اس کو"},{"u":"عَلَيْهِمْ","en":"upon them","ur":"ان پر"},{"u":"سَبْعَ","en":"(for) seven","ur":"ساتھ"},{"u":"لَيَالٍۢ","en":"nights","ur":"راتوں تک"},{"u":"وَثَمَـٰنِيَةَ","en":"and eight","ur":"اور آٹھ"},{"u":"أَيَّامٍ","en":"days","ur":"دن"},{"u":"حُسُومًۭا","en":"(in) succession","ur":"پے درپے۔ مسلسل"},{"u":"فَتَرَى","en":"so you would see","ur":"تو تم دیکھتے"},{"u":"ٱلْقَوْمَ","en":"the people","ur":"لوگوں کو۔ قوم کو"},{"u":"فِيهَا","en":"therein","ur":"اس میں"},{"u":"صَرْعَىٰ","en":"fallen","ur":"گرے ہوئے ہیں"},{"u":"كَأَنَّهُمْ","en":"as if they were","ur":"گویا کہ وہ"},{"u":"أَعْجَازُ","en":"trunks","ur":"تنے ہیں"},{"u":"نَخْلٍ","en":"(of) date-palms","ur":"کھجور کے درخت کے"},{"u":"خَاوِيَةٍۢ","en":"hollow","ur":"خالی۔ کھوکھلے"}]},{"k":"69:8","n":8,"id":5331,"u":"فَهَلْ تَرَىٰ لَهُم مِّنۢ بَاقِيَةٍ","juz":29,"page":566,"sajdah":false,"w":[{"u":"فَهَلْ","en":"Then do","ur":"تو کیا"},{"u":"تَرَىٰ","en":"you see","ur":"تم دیکھتے ہو"},{"u":"لَهُم","en":"of them","ur":"ان کے لیے"},{"u":"مِّنۢ","en":"any","ur":"کوئی"},{"u":"بَاقِيَةٍۢ","en":"remains","ur":"باقی بچا ہوا"}]},{"k":"69:9","n":9,"id":5332,"u":"وَجَآءَ فِرْعَوْنُ وَمَن قَبْلَهُۥ وَٱلْمُؤْتَفِكَـٰتُ بِٱلْخَاطِئَةِ","juz":29,"page":567,"sajdah":false,"w":[{"u":"وَجَآءَ","en":"And came","ur":"اور آیا"},{"u":"فِرْعَوْنُ","en":"Firaun","ur":"فرعون"},{"u":"وَمَن","en":"and (those)","ur":"اور جو"},{"u":"قَبْلَهُۥ","en":"before him","ur":"اس سے پہلے تھے"},{"u":"وَٱلْمُؤْتَفِكَـٰتُ","en":"and the overturned cities","ur":"اور اٹھائی جانے والی بستیاں"},{"u":"بِٱلْخَاطِئَةِ","en":"with sin","ur":"ساتھ خطا کے"}]},{"k":"69:10","n":10,"id":5333,"u":"فَعَصَوْا۟ رَسُولَ رَبِّهِمْ فَأَخَذَهُمْ أَخْذَةً رَّابِيَةً","juz":29,"page":567,"sajdah":false,"w":[{"u":"فَعَصَوْا۟","e