{"n":69,"src":{"text":"qc-text","wbw":"qc-wbw"},"ayahs":[{"k":"69:1","n":1,"id":5324,"u":" ٱلْحَآقَّةُ","i":"اَلۡحَـآقَّةُ ۙ‏","juz":29,"page":566,"sajdah":false,"w":[{"u":"ٱلْحَآقَّةُ","i":"اَلۡحَـآقَّةُ ۙ‏","tl":"al-ḥāqatu","en":"The Inevitable Reality","ur":"حق ہونے والی۔ ثابت ہونے والی","a":"wbw/069_001_001.mp3"}]},{"k":"69:2","n":2,"id":5325,"u":"مَا ٱلْحَآقَّةُ","i":"مَا الۡحَـآقَّةُ​ ۚ‏","juz":29,"page":566,"sajdah":false,"w":[{"u":"مَا","i":"مَا","tl":"mā","en":"What","ur":"کیا ہے","a":"wbw/069_002_001.mp3"},{"u":"ٱلْحَآقَّةُ","i":"الۡحَـآقَّةُ​ ۚ‏","tl":"l-ḥāqatu","en":"(is) the Inevitable Reality","ur":"وہ ثابت ہوکررہنے والی","a":"wbw/069_002_002.mp3"}]},{"k":"69:3","n":3,"id":5326,"u":"وَمَآ أَدْرَىٰكَ مَا ٱلْحَآقَّةُ","i":"وَمَاۤ اَدۡرٰٮكَ مَا الۡحَــآقَّةُ ؕ‏","juz":29,"page":566,"sajdah":false,"w":[{"u":"وَمَآ","i":"وَمَاۤ","tl":"wamā","en":"And what","ur":"اور کیا","a":"wbw/069_003_001.mp3"},{"u":"أَدْرَىٰكَ","i":"اَدۡرٰٮكَ","tl":"adrāka","en":"will make you know","ur":"چیز بتائے تجھ کو","a":"wbw/069_003_002.mp3"},{"u":"مَا","i":"مَا","tl":"mā","en":"what","ur":"کیا ہے","a":"wbw/069_003_003.mp3"},{"u":"ٱلْحَآقَّةُ","i":"الۡحَــآقَّةُ ؕ‏","tl":"l-ḥāqatu","en":"(is) the Inevitable Reality","ur":"وہ ثابت ہوکررہنے والی","a":"wbw/069_003_004.mp3"}]},{"k":"69:4","n":4,"id":5327,"u":"كَذَّبَتْ ثَمُودُ وَعَادٌۢ بِٱلْقَارِعَةِ","i":"كَذَّبَتۡ ثَمُوۡدُ وَعَادٌۢ بِالۡقَارِعَةِ‏","juz":29,"page":566,"sajdah":false,"w":[{"u":"كَذَّبَتْ","i":"كَذَّبَتۡ","tl":"kadhabat","en":"Denied","ur":"جھٹلایا","a":"wbw/069_004_001.mp3"},{"u":"ثَمُودُ","i":"ثَمُوۡدُ","tl":"thamūdu","en":"Thamud","ur":"ثمود نے","a":"wbw/069_004_002.mp3"},{"u":"وَعَادٌۢ","i":"وَعَادٌۢ","tl":"waʿādun","en":"and Aad","ur":"اور عاد نے","a":"wbw/069_004_003.mp3"},{"u":"بِٱلْقَارِعَةِ","i":"بِالۡقَارِعَةِ‏","tl":"bil-qāriʿati","en":"the Striking Calamity","ur":"کھڑکا دینے والی کو","a":"wbw/069_004_004.mp3"}]},{"k":"69:5","n":5,"id":5328,"u":"فَأَمَّا ثَمُودُ فَأُهْلِكُوا۟ بِٱلطَّاغِيَةِ",