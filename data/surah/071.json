{"n":71,"src":{"text":"qc-text","wbw":"qc-wbw"},"ayahs":[{"k":"71:1","n":1,"id":5420,"u":" إِنَّآ أَرْسَلْنَا نُوحًا إِلَىٰ قَوْمِهِۦٓ أَنْ أَنذِرْ قَوْمَكَ مِن قَبْلِ أَن يَأْتِيَهُمْ عَذَابٌ أَلِيمٌ","i":"اِنَّاۤ اَرۡسَلۡنَا نُوۡحًا اِلٰى قَوۡمِهٖۤ اَنۡ اَنۡذِرۡ قَوۡمَكَ مِنۡ قَبۡلِ اَنۡ يَّاۡتِيَهُمۡ عَذَابٌ اَلِيۡمٌ‏","juz":29,"page":570,"sajdah":false,"w":[{"u":"إِنَّآ","i":"اِنَّاۤ","tl":"innā","en":"Indeed, We","ur":"بیشک ہم نے","a":"wbw/071_001_001.mp3"},{"u":"أَرْسَلْنَا","i":"اَرۡسَلۡنَا","tl":"arsalnā","en":"[We] sent","ur":"بھیجا ہم نے","a":"wbw/071_001_002.mp3"},{"u":"نُوحًا","i":"نُوۡحًا","tl":"nūḥan","en":"Nuh","ur":"نوح کو","a":"wbw/071_001_003.mp3"},{"u":"إِلَىٰ","i":"اِلٰى","tl":"ilā","en":"to","ur":"طرف","a":"wbw/071_001_004.mp3"},{"u":"قَوْمِهِۦٓ","i":"قَوۡمِهٖۤ","tl":"qawmihi","en":"his people","ur":"اس کی قوم کی","a":"wbw/071_001_005.mp3"},{"u":"أَنْ","i":"اَنۡ","tl":"an","en":"that","ur":"کہ","a":"wbw/071_001_006.mp3"},{"u":"أَنذِرْ","i":"اَنۡذِرۡ","tl":"andhir","en":"Warn","ur":"ڈراؤ","a":"wbw/071_001_007.mp3"},{"u":"قَوْمَكَ","i":"قَوۡمَكَ","tl":"qawmaka","en":"your people","ur":"اپنی قوم کو","a":"wbw/071_001_008.mp3"},{"u":"مِن","i":"مِنۡ","tl":"min","en":"from","ur":"سے","a":"wbw/071_001_009.mp3"},{"u":"قَبْلِ","i":"قَبۡلِ","tl":"qabli","en":"before","ur":"اس سے پہلے","a":"wbw/071_001_010.mp3"},{"u":"أَن","i":"اَنۡ","tl":"an","en":"[that]","ur":"کہ","a":"wbw/071_001_011.mp3"},{"u":"يَأْتِيَهُمْ","i":"يَّاۡتِيَهُمۡ","tl":"yatiyahum","en":"comes to them","ur":"آئے ان کے پاس","a":"wbw/071_001_012.mp3"},{"u":"عَذَابٌ","i":"عَذَابٌ","tl":"ʿadhābun","en":"a punishment","ur":"عذاب","a":"wbw/071_001_013.mp3"},{"u":"أَلِيمٌۭ","i":"اَلِيۡمٌ‏","tl":"alīmun","en":"painful","ur":"دردناک","a":"wbw/071_001_014.mp3"}]},{"k":"71:2","n":2,"id":5421,"u":"قَالَ يَـٰقَوْمِ إِنِّى لَكُمْ نَذِيرٌ مُّبِينٌ","i":"قَالَ يٰقَوۡمِ اِنِّىۡ لَـكُمۡ نَذِيۡرٌ مُّبِيۡنٌۙ‏","juz":29,"page":570,"sajdah":false,"w":[{"u":"قَالَ","i":"قَالَ","tl":"qāla","en":"He said","ur":"اس نے کہا","a":"wbw/071_002_001.mp3"},{"u":"يَـٰقَوْمِ","i":"يٰقَوۡمِ","tl":"yāqawmi","en":"O my people","ur":"اے میری قوم","a":"wbw/071_002_002.mp3"},{"u":"إِنِّى","i":"اِنِّىۡ","tl":"innī","en":"Indeed, I am","ur":"بیشک میں","a":"wbw/071_002_003.mp3"},{"u":"لَكُمْ","i":"لَـكُمۡ","tl":"lakum","en":"to you","ur":"تم کو","a":"wbw/071_002_004.mp3"},{"u":"نَذِيرٌۭ","i":"نَذِيۡرٌ","tl":"nadhīrun","en":"a warner","ur":"ڈرانے والا ہوں","a":"wbw/071_002_005.mp3"},{"u":"مُّبِينٌ","i":"مُّبِيۡنٌۙ‏","tl":"mubīnun","en":"clear","ur":"کھلم کھلا","a":"wbw/071_002_006.mp3"}]},{"k":"71:3","n":3,"id":5422,"u":"أَنِ ٱعْبُدُوا۟ ٱللَّهَ وَٱتَّقُوهُ وَأَطِيعُونِ","i":"اَنِ اعۡبُدُوا اللّٰهَ وَاتَّقُوۡهُ وَاَطِيۡعُوۡنِۙ‏","juz":29,"page":570,"sajdah":false,"w":[{"u":"أَنِ","i":"اَنِ","tl":"ani","en":"That","ur":"کہ","a":"wbw/071_003_001.mp3"},{"u":"ٱعْبُدُوا۟","i":"اعۡبُدُوا","tl":"uʿ'budū","en":"Worship","ur":"عبادت کرو","a":"wbw/071_003_002.mp3"},{"u":"ٱللَّهَ","i":"اللّٰهَ","tl":"l-laha","en":"Allah","ur":"اللہ کی","a":"wbw/071_003_003.mp3"},{"u":"وَٱتَّقُوهُ","i":"وَاتَّقُوۡهُ","tl":"wa-ittaqūhu","en":"and fear Him","ur":"اور ڈرو اس سے","a":"wbw/071_003_004.mp3"},{"u":"وَأَطِيعُونِ","i":"وَاَطِيۡعُوۡنِۙ‏","tl":"wa-aṭīʿūni","en":"and obey me","ur":"اور اطاعت کرو میری","a":"wbw/071_003_005.mp3"}]},{"k":"71:4","n":4,"id":5423,"u":"يَغْفِرْ لَكُم مِّن ذُنُوبِكُمْ وَيُؤَخِّرْكُمْ إِلَىٰٓ أَجَلٍ مُّسَمًّى ۚ إِنَّ أَجَلَ ٱللَّهِ إِذَا جَآءَ لَا يُؤَخَّرُ ۖ لَوْ كُنتُمْ تَعْلَمُونَ","i":"يَغۡفِرۡ لَـكُمۡ مِّنۡ ذُنُوۡبِكُمۡ وَيُؤَخِّرۡكُمۡ اِلٰٓى اَجَلٍ مُّسَمًّى​ؕ اِنَّ اَجَلَ اللّٰهِ اِذَا جَآءَ لَا يُؤَخَّرُ​​ۘ لَوۡ كُنۡتُمۡ تَعۡلَمُوۡنَ‏","juz":29,"page":570,"sajdah":false,"w":[{"u":"يَغْفِرْ","i":"يَغۡفِرۡ","tl":"yaghfir","en":"He will forgive","ur":"بخش دے گا","a":"wbw/071_004_001.mp3"},{"u":"لَكُم","i":"لَـكُمۡ","tl":"lakum","en":"for you","ur":"تمہارے لیے","a":"wbw/071_004_002.mp3"},{"u":"مِّن","i":"مِّنۡ","tl":"min","en":"[of]","ur":"میں سے","a":"wbw/071_004_003.mp3"},{"u":"ذُنُوبِكُمْ","i":"ذُنُوۡبِكُمۡ","tl":"dhunūbikum","en":"your sins","ur":"تمہارے گناہوں","a":"wbw/071_004_004.mp3"},{"u":"وَيُؤَخِّرْكُمْ","i":"وَيُؤَخِّرۡكُمۡ","tl":"wayu-akhir'kum","en":"and give you respite","ur":"اور مہلت دے گا تم کو","a":"wbw/071_004_005.mp3"},{"u":"إِلَىٰٓ","i":"اِلٰٓى","tl":"ilā","en":"for","ur":"تک","a":"wbw/071_004_006.mp3"},{"u":"أَجَلٍۢ","i":"اَجَلٍ","tl":"ajalin","en":"a term","ur":"وقت","a":"wbw/071_004_007.mp3"},{"u":"مُّسَمًّى ۚ","i":"مُّسَمًّى​ؕ","tl":"musamman","en":"specified","ur":"مقرر","a":"wbw/071_004_008.mp3"},{"u":"إِنَّ","i":"اِنَّ","tl":"inna","en":"Indeed","ur":"بیشک","a":"wbw/071_004_010.mp3"},{"u":"أَجَلَ","i":"اَجَلَ","tl":"ajala","en":"(the) term","ur":"مقرر کیا ہوا وقت","a":"wbw/071_004_011.mp3"},{"u":"ٱللَّهِ","i":"اللّٰهِ","tl":"l-lahi","en":"(of) Allah","ur":"اللہ کا","a":"wbw/071_004_012.mp3"},{"u":"إِذَا","i":"اِذَا","tl":"idhā","en":"when","ur":"جب","a":"wbw/071_004_013.mp3"},{"u":"جَآءَ","i":"جَآءَ","tl":"jāa","en":"it comes","ur":"آجاتا ہے","a":"wbw/071_004_014.mp3"},{"u":"لَا","i":"لَا","tl":"lā","en":"not","ur":"تو  نہیں دی جاتی","a":"wbw/071_004_015.mp3"},{"u":"يُؤَخَّرُ ۖ","i":"يُؤَخَّرُ​​ۘ","tl":"yu-akharu","en":"is delayed","ur":"ڈھیل","a":"wbw/071_004_016.mp3"},{"u":"لَوْ","i":"لَوۡ","tl":"law","en":"if","ur":"اگر","a":"wbw/071_004_018.mp3"},{"u":"كُنتُمْ","i":"كُنۡتُمۡ","tl":"kuntum","en":"you","ur":"ہو تم","a":"wbw/071_004_019.mp3"},{"u":"تَعْلَمُونَ","i":"تَعۡلَمُوۡنَ‏","tl":"taʿlamūna","en":"know","ur":"تم جانتے","a":"wbw/071_004_020.mp3"}]},{"k":"71:5","n":5,"id":5424,"u":"قَالَ رَبِّ إِنِّى دَعَوْتُ قَوْمِى لَيْلًا وَنَهَارًا","i":"قَالَ رَبِّ اِنِّىۡ دَعَوۡتُ قَوۡمِىۡ لَيۡلًا وَّنَهَارًا ۙ‏","juz":29,"page":570,"sajdah":false,"w":[{"u":"قَالَ","i":"قَالَ","tl":"qāla","en":"He said","ur":"اس نے کہا","a":"wbw/071_005_001.mp3"},{"u":"رَبِّ","i":"رَبِّ","tl":"rabbi","en":"My Lord","ur":"اے میرے رب","a":"wbw/071_005_002.mp3"},{"u":"إِنِّى","i":"اِنِّىۡ","tl":"innī","en":"Indeed, I","ur":"بیشک میں نے","a":"