{"n":71,"src":{"text":"qc-text","wbw":"qc-wbw"},"ayahs":[{"k":"71:1","n":1,"id":5420,"u":" إِنَّآ أَرْسَلْنَا نُوحًا إِلَىٰ قَوْمِهِۦٓ أَنْ أَنذِرْ قَوْمَكَ مِن قَبْلِ أَن يَأْتِيَهُمْ عَذَابٌ أَلِيمٌ","juz":29,"page":570,"sajdah":false,"w":[{"u":"إِنَّآ","en":"Indeed, We","ur":"بیشک ہم نے"},{"u":"أَرْسَلْنَا","en":"[We] sent","ur":"بھیجا ہم نے"},{"u":"نُوحًا","en":"Nuh","ur":"نوح کو"},{"u":"إِلَىٰ","en":"to","ur":"طرف"},{"u":"قَوْمِهِۦٓ","en":"his people","ur":"اس کی قوم کی"},{"u":"أَنْ","en":"that","ur":"کہ"},{"u":"أَنذِرْ","en":"Warn","ur":"ڈراؤ"},{"u":"قَوْمَكَ","en":"your people","ur":"اپنی قوم کو"},{"u":"مِن","en":"from","ur":"سے"},{"u":"قَبْلِ","en":"before","ur":"اس سے پہلے"},{"u":"أَن","en":"[that]","ur":"کہ"},{"u":"يَأْتِيَهُمْ","en":"comes to them","ur":"آئے ان کے پاس"},{"u":"عَذَابٌ","en":"a punishment","ur":"عذاب"},{"u":"أَلِيمٌۭ","en":"painful","ur":"دردناک"}]},{"k":"71:2","n":2,"id":5421,"u":"قَالَ يَـٰقَوْمِ إِنِّى لَكُمْ نَذِيرٌ مُّبِينٌ","juz":29,"page":570,"sajdah":false,"w":[{"u":"قَالَ","en":"He said","ur":"اس نے کہا"},{"u":"يَـٰقَوْمِ","en":"O my people","ur":"اے میری قوم"},{"u":"إِنِّى","en":"Indeed, I am","ur":"بیشک میں"},{"u":"لَكُمْ","en":"to you","ur":"تم کو"},{"u":"نَذِيرٌۭ","en":"a warner","ur":"ڈرانے والا ہوں"},{"u":"مُّبِينٌ","en":"clear","ur":"کھلم کھلا"}]},{"k":"71:3","n":3,"id":5422,"u":"أَنِ ٱعْبُدُوا۟ ٱللَّهَ وَٱتَّقُوهُ وَأَطِيعُونِ","juz":29,"page":570,"sajdah":false,"w":[{"u":"أَنِ","en":"That","ur":"کہ"},{"u":"ٱعْبُدُوا۟","en":"Worship","ur":"عبادت کرو"},{"u":"ٱللَّهَ","en":"Allah","ur":"اللہ کی"},{"u":"وَٱتَّقُوهُ","en":"and fear Him","ur":"اور ڈرو اس سے"},{"u":"وَأَطِيعُونِ","en":"and obey me","ur":"اور اطاعت کرو میری"}]},{"k":"71:4","n":4,"id":5423,"u":"يَغْفِرْ لَكُم مِّن ذُنُوبِكُمْ وَيُؤَخِّرْكُمْ إِلَىٰٓ أَجَلٍ مُّسَمًّى ۚ إِنَّ أَجَلَ ٱللَّهِ إِذَا جَآءَ لَا يُؤَخَّرُ ۖ لَوْ كُنتُمْ تَعْلَمُونَ","juz":29,"page":570,"sajdah":false,"w":[{"u":"يَغْفِرْ","en":"He will forgive","ur":"بخش دے گا"},{"u":"لَكُم","en":"for yo