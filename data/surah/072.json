{"n":72,"src":{"text":"qc-text","wbw":"qc-wbw"},"ayahs":[{"k":"72:1","n":1,"id":5448,"u":" قُلْ أُوحِىَ إِلَىَّ أَنَّهُ ٱسْتَمَعَ نَفَرٌ مِّنَ ٱلْجِنِّ فَقَالُوٓا۟ إِنَّا سَمِعْنَا قُرْءَانًا عَجَبًا","i":"قُلۡ اُوۡحِىَ اِلَىَّ اَنَّهُ اسۡتَمَعَ نَفَرٌ مِّنَ الۡجِنِّ فَقَالُوۡۤا اِنَّا سَمِعۡنَا قُرۡاٰنًاعَجَبًا ۙ‏","juz":29,"page":572,"sajdah":false,"w":[{"u":"قُلْ","i":"قُلۡ","tl":"qul","en":"Say","ur":"کہہ دیجیے","a":"wbw/072_001_001.mp3"},{"u":"أُوحِىَ","i":"اُوۡحِىَ","tl":"ūḥiya","en":"It has been revealed","ur":"وحی کی گئی","a":"wbw/072_001_002.mp3"},{"u":"إِلَىَّ","i":"اِلَىَّ","tl":"ilayya","en":"to me","ur":"میری طرف","a":"wbw/072_001_003.mp3"},{"u":"أَنَّهُ","i":"اَنَّهُ","tl":"annahu","en":"that","ur":"بیشک","a":"wbw/072_001_004.mp3"},{"u":"ٱسْتَمَعَ","i":"اسۡتَمَعَ","tl":"is'tamaʿa","en":"listened","ur":"غور سے سنا","a":"wbw/072_001_005.mp3"},{"u":"نَفَرٌۭ","i":"نَفَرٌ","tl":"nafarun","en":"a group","ur":"ایک گروہ نے","a":"wbw/072_001_006.mp3"},{"u":"مِّنَ","i":"مِّنَ","tl":"mina","en":"of","ur":"میں سے","a":"wbw/072_001_007.mp3"},{"u":"ٱلْجِنِّ","i":"الۡجِنِّ","tl":"l-jini","en":"the jinn","ur":"جنوں","a":"wbw/072_001_008.mp3"},{"u":"فَقَالُوٓا۟","i":"فَقَالُوۡۤا","tl":"faqālū","en":"and they said","ur":"تو انہوں نے کہا","a":"wbw/072_001_009.mp3"},{"u":"إِنَّا","i":"اِنَّا","tl":"innā","en":"Indeed, we","ur":"بیشک ہم","a":"wbw/072_001_010.mp3"},{"u":"سَمِعْنَا","i":"سَمِعۡنَا","tl":"samiʿ'nā","en":"heard","ur":"سنا ہم نے","a":"wbw/072_001_011.mp3"},{"u":"قُرْءَانًا","i":"قُرۡاٰنًا","tl":"qur'ānan","en":"a Quran","ur":"ایک قرآن","a":"wbw/072_001_012.mp3"},{"u":"عَجَبًۭا","i":"عَجَبًا ۙ","tl":"ʿajaban","en":"amazing","ur":"عجیب","a":"wbw/072_001_013.mp3"}]},{"k":"72:2","n":2,"id":5449,"u":"يَهْدِىٓ إِلَى ٱلرُّشْدِ فَـَٔامَنَّا بِهِۦ ۖ وَلَن نُّشْرِكَ بِرَبِّنَآ أَحَدًا","i":"يَّهۡدِىۡۤ اِلَى الرُّشۡدِ فَاٰمَنَّا بِهٖ​ ؕ وَلَنۡ نُّشۡرِكَ بِرَبِّنَاۤ اَحَدًا ۙ‏","juz":29,"page":572,"sajdah":false,"w":[{"u":"يَهْدِىٓ","i":"يَّهۡدِىۡۤ","tl":"yahdī","en":"It 