{"n":72,"src":{"text":"qc-text","wbw":"qc-wbw"},"ayahs":[{"k":"72:1","n":1,"id":5448,"u":" قُلْ أُوحِىَ إِلَىَّ أَنَّهُ ٱسْتَمَعَ نَفَرٌ مِّنَ ٱلْجِنِّ فَقَالُوٓا۟ إِنَّا سَمِعْنَا قُرْءَانًا عَجَبًا","juz":29,"page":572,"sajdah":false,"w":[{"u":"قُلْ","en":"Say","ur":"کہہ دیجیے"},{"u":"أُوحِىَ","en":"It has been revealed","ur":"وحی کی گئی"},{"u":"إِلَىَّ","en":"to me","ur":"میری طرف"},{"u":"أَنَّهُ","en":"that","ur":"بیشک"},{"u":"ٱسْتَمَعَ","en":"listened","ur":"غور سے سنا"},{"u":"نَفَرٌۭ","en":"a group","ur":"ایک گروہ نے"},{"u":"مِّنَ","en":"of","ur":"میں سے"},{"u":"ٱلْجِنِّ","en":"the jinn","ur":"جنوں"},{"u":"فَقَالُوٓا۟","en":"and they said","ur":"تو انہوں نے کہا"},{"u":"إِنَّا","en":"Indeed, we","ur":"بیشک ہم"},{"u":"سَمِعْنَا","en":"heard","ur":"سنا ہم نے"},{"u":"قُرْءَانًا","en":"a Quran","ur":"ایک قرآن"},{"u":"عَجَبًۭا","en":"amazing","ur":"عجیب"}]},{"k":"72:2","n":2,"id":5449,"u":"يَهْدِىٓ إِلَى ٱلرُّشْدِ فَـَٔامَنَّا بِهِۦ ۖ وَلَن نُّشْرِكَ بِرَبِّنَآ أَحَدًا","juz":29,"page":572,"sajdah":false,"w":[{"u":"يَهْدِىٓ","en":"It guides","ur":"رہنمائی کرتا ہے"},{"u":"إِلَى","en":"to","ur":"طرف"},{"u":"ٱلرُّشْدِ","en":"the right way","ur":"ہدایت کی"},{"u":"فَـَٔامَنَّا","en":"so we believe","ur":"پس ایمان لائے ہم"},{"u":"بِهِۦ ۖ","en":"in it","ur":"ساتھ اس کے"},{"u":"وَلَن","en":"and never","ur":"اور ہرگز نہیں"},{"u":"نُّشْرِكَ","en":"we will associate","ur":"ہم شریک کریں گے"},{"u":"بِرَبِّنَآ","en":"with our Lord","ur":"اپنے رب کے ساتھ"},{"u":"أَحَدًۭا","en":"anyone","ur":"کسی ایک کو"}]},{"k":"72:3","n":3,"id":5450,"u":"وَأَنَّهُۥ تَعَـٰلَىٰ جَدُّ رَبِّنَا مَا ٱتَّخَذَ صَـٰحِبَةً وَلَا وَلَدًا","juz":29,"page":572,"sajdah":false,"w":[{"u":"وَأَنَّهُۥ","en":"And that He ","ur":"اور بیشک وہ"},{"u":"تَعَـٰلَىٰ","en":"Exalted is","ur":"بلند ہے"},{"u":"جَدُّ","en":"(the) Majesty","ur":"شان"},{"u":"رَبِّنَا","en":"(of) our Lord ","ur":"ہمارے رب کی"},{"u":"مَا","en":"not","ur":"نہیں"},{"u":"ٱتَّخَذَ","en":"He has taken","ur":"بنائی اس نے"},{"u":"صَـٰحِبَةًۭ","en":"a 