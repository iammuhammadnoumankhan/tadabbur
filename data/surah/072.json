:"میں"},{"u":"ٱلْأَرْضِ","en":"the earth","ur":"زمین"},{"u":"وَلَن","en":"and never","ur":"اور ہرگز نہیں"},{"u":"نُّعْجِزَهُۥ","en":"we can escape Him","ur":"ہم عاجز کرسکتے اس کو"},{"u":"هَرَبًۭا","en":"(by) flight","ur":"بھاگ کر"}]},{"k":"72:13","n":13,"id":5460,"u":"وَأَنَّا لَمَّا سَمِعْنَا ٱلْهُدَىٰٓ ءَامَنَّا بِهِۦ ۖ فَمَن يُؤْمِنۢ بِرَبِّهِۦ فَلَا يَخَافُ بَخْسًا وَلَا رَهَقًا","juz":29,"page":572,"sajdah":false,"w":[{"u":"وَأَنَّا","en":"And that [we]","ur":"اور بیشک ہم نے"},{"u":"لَمَّا","en":"when","ur":"جب"},{"u":"سَمِعْنَا","en":"we heard","ur":"سنا ہم نے"},{"u":"ٱلْهُدَىٰٓ","en":"the Guidance","ur":"ہدایت کو"},{"u":"ءَامَنَّا","en":"we believed","ur":"ایمان لے آئے ہم"},{"u":"بِهِۦ ۖ","en":"in it","ur":"ساتھ اس کے"},{"u":"فَمَن","en":"And whoever","ur":"پس جو کوئی"},{"u":"يُؤْمِنۢ","en":"believes","ur":"ایمان لائے گا"},{"u":"بِرَبِّهِۦ","en":"in his Lord","ur":"اپنے رب پر"},{"u":"فَلَا","en":"then not","ur":"تو نہ"},{"u":"يَخَافُ","en":"he will fear","ur":"وہ ڈرے گا"},{"u":"بَخْسًۭا","en":"any loss","ur":"کم کرنے میں"},{"u":"وَلَا","en":"and not","ur":"اور نہ"},{"u":"رَهَقًۭا","en":"any burden","ur":"زیادتی میں"}]},{"k":"72:14","n":14,"id":5461,"u":"وَأَنَّا مِنَّا ٱلْمُسْلِمُونَ وَمِنَّا ٱلْقَـٰسِطُونَ ۖ فَمَنْ أَسْلَمَ فَأُو۟لَـٰٓئِكَ تَحَرَّوْا۟ رَشَدًا","juz":29,"page":573,"sajdah":false,"w":[{"u":"وَأَنَّا","en":"And that we","ur":"اور بیشک ہم"},{"u":"مِنَّا","en":"among us","ur":"ہم میں سے"},{"u":"ٱلْمُسْلِمُونَ","en":"(are) Muslims","ur":"کچھ مسلمان ہیں"},{"u":"وَمِنَّا","en":"and among us","ur":"اور ہم میں سے کچھ"},{"u":"ٱلْقَـٰسِطُونَ ۖ","en":"(are) unjust","ur":"نافرمان ہیں"},{"u":"فَمَنْ","en":"And whoever","ur":"تو جو کوئی"},{"u":"أَسْلَمَ","en":"submits","ur":"اسلام لائے"},{"u":"فَأُو۟لَـٰٓئِكَ","en":"then those","ur":"تو یہی لوگ"},{"u":"تَحَرَّوْا۟","en":"have sought","ur":"انہوں نے ارادہ کیا"},{"u":"رَشَدًۭا","en":"(the) right path","ur":"بھلائی کا"}]},{"k":"72:15","n":15,"id":5462,"u":"وَأَمَّا ٱلْقَـٰسِطُونَ فَكَانُوا۟ لِجَهَنَّمَ حَطَبًا