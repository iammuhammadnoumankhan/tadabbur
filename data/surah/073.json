_002.mp3"},{"u":"عَلَيْهِ","i":"عَلَيۡهِ","tl":"ʿalayhi","en":"to it","ur":"اس پر","a":"wbw/073_004_003.mp3"},{"u":"وَرَتِّلِ","i":"وَرَتِّلِ","tl":"warattili","en":"and recite","ur":"اور آہستہ آہستہ پڑھو","a":"wbw/073_004_004.mp3"},{"u":"ٱلْقُرْءَانَ","i":"الۡقُرۡاٰنَ","tl":"l-qur'āna","en":"the Quran","ur":"قرآن کو","a":"wbw/073_004_005.mp3"},{"u":"تَرْتِيلًا","i":"تَرۡتِيۡلًا ؕ‏","tl":"tartīlan","en":"(with) measured rhythmic recitation","ur":"آہستہ آہستہ پڑھنا","a":"wbw/073_004_006.mp3"}]},{"k":"73:5","n":5,"id":5480,"u":"إِنَّا سَنُلْقِى عَلَيْكَ قَوْلًا ثَقِيلًا","i":"اِنَّا سَنُلۡقِىۡ عَلَيۡكَ قَوۡلًا ثَقِيۡلًا‏","juz":29,"page":574,"sajdah":false,"w":[{"u":"إِنَّا","i":"اِنَّا","tl":"innā","en":"Indeed, We","ur":"بیشک ہم","a":"wbw/073_005_001.mp3"},{"u":"سَنُلْقِى","i":"سَنُلۡقِىۡ","tl":"sanul'qī","en":"will cast","ur":"عنقریب ہم ڈالیں گے","a":"wbw/073_005_002.mp3"},{"u":"عَلَيْكَ","i":"عَلَيۡكَ","tl":"ʿalayka","en":"upon you","ur":"آپ پر","a":"wbw/073_005_003.mp3"},{"u":"قَوْلًۭا","i":"قَوۡلًا","tl":"qawlan","en":"a Word","ur":"بات۔","a":"wbw/073_005_004.mp3"},{"u":"ثَقِيلًا","i":"ثَقِيۡلًا‏","tl":"thaqīlan","en":"heavy","ur":"بھاری ۔ بوجھل","a":"wbw/073_005_005.mp3"}]},{"k":"73:6","n":6,"id":5481,"u":"إِنَّ نَاشِئَةَ ٱلَّيْلِ هِىَ أَشَدُّ وَطْـًٔا وَأَقْوَمُ قِيلًا","i":"اِنَّ نَاشِئَةَ الَّيۡلِ هِىَ اَشَدُّ وَطۡـاً وَّاَقۡوَمُ قِيۡلًا ؕ‏","juz":29,"page":574,"sajdah":false,"w":[{"u":"إِنَّ","i":"اِنَّ","tl":"inna","en":"Indeed","ur":"بیشک","a":"wbw/073_006_001.mp3"},{"u":"نَاشِئَةَ","i":"نَاشِئَةَ","tl":"nāshi-ata","en":"(the) rising","ur":"اٹھنا","a":"wbw/073_006_002.mp3"},{"u":"ٱلَّيْلِ","i":"الَّيۡلِ","tl":"al-layli","en":"(at) the night","ur":"رات کا","a":"wbw/073_006_003.mp3"},{"u":"هِىَ","i":"هِىَ","tl":"hiya","en":"it","ur":"وہ","a":"wbw/073_006_004.mp3"},{"u":"أَشَدُّ","i":"اَشَدُّ","tl":"ashaddu","en":"(is) very hard","ur":"زیادہ شدید ہے","a":"wbw/073_006_005.mp3"},{"u":"وَطْـًۭٔا","i":"وَطۡـاً","tl":"waṭan","en":"and most potent","ur":"کچلنے میں