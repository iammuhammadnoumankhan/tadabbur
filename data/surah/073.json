","ur":"اس پر"},{"u":"مَا","en":"what","ur":"جو"},{"u":"يَقُولُونَ","en":"they say","ur":"وہ کہتے ہیں"},{"u":"وَٱهْجُرْهُمْ","en":"and avoid them","ur":"اور چھوڑ دو ان کو"},{"u":"هَجْرًۭا","en":"an avoidance","ur":"چھوڑنا"},{"u":"جَمِيلًۭا","en":"gracious","ur":"اچھی طرح۔ خوبصورت طریقے سے"}]},{"k":"73:11","n":11,"id":5486,"u":"وَذَرْنِى وَٱلْمُكَذِّبِينَ أُو۟لِى ٱلنَّعْمَةِ وَمَهِّلْهُمْ قَلِيلًا","juz":29,"page":574,"sajdah":false,"w":[{"u":"وَذَرْنِى","en":"And leave Me","ur":"اور چھوڑو مجھ کو"},{"u":"وَٱلْمُكَذِّبِينَ","en":"and the deniers","ur":"اور جھٹلانے والوں کو"},{"u":"أُو۟لِى","en":"possessors","ur":"والے"},{"u":"ٱلنَّعْمَةِ","en":"(of) the ease","ur":"نعمت"},{"u":"وَمَهِّلْهُمْ","en":"and allow them respite ","ur":"اور ڈھیل دو ان کو"},{"u":"قَلِيلًا","en":"a little","ur":"تھوڑی سی"}]},{"k":"73:12","n":12,"id":5487,"u":"إِنَّ لَدَيْنَآ أَنكَالًا وَجَحِيمًا","juz":29,"page":574,"sajdah":false,"w":[{"u":"إِنَّ","en":"Indeed","ur":"بیشک"},{"u":"لَدَيْنَآ","en":"with Us","ur":"ہمارے پاس"},{"u":"أَنكَالًۭا","en":"(are) shackles","ur":"بھاری بیڑیاں ہیں"},{"u":"وَجَحِيمًۭا","en":"and burning fire","ur":"اور بھڑکتی ہوئی آگ"}]},{"k":"73:13","n":13,"id":5488,"u":"وَطَعَامًا ذَا غُصَّةٍ وَعَذَابًا أَلِيمًا","juz":29,"page":574,"sajdah":false,"w":[{"u":"وَطَعَامًۭا","en":"And food","ur":"اور کھانا"},{"u":"ذَا","en":"that","ur":"والا"},{"u":"غُصَّةٍۢ","en":"chokes","ur":"اٹکنے"},{"u":"وَعَذَابًا","en":"and a punishment","ur":"اور عذاب"},{"u":"أَلِيمًۭا","en":"painful","ur":"دردناک"}]},{"k":"73:14","n":14,"id":5489,"u":"يَوْمَ تَرْجُفُ ٱلْأَرْضُ وَٱلْجِبَالُ وَكَانَتِ ٱلْجِبَالُ كَثِيبًا مَّهِيلًا","juz":29,"page":574,"sajdah":false,"w":[{"u":"يَوْمَ","en":"(On the) Day","ur":"جس دن"},{"u":"تَرْجُفُ","en":"will quake","ur":"کانپے گی"},{"u":"ٱلْأَرْضُ","en":"the earth","ur":"زمین"},{"u":"وَٱلْجِبَالُ","en":"and the mountains","ur":"اور پہاڑ"},{"u":"وَكَانَتِ","en":"and will become","ur":"اور ہوں گے"},{"u":"ٱلْجِبَالُ","en":"the mountains","ur":"پہاڑ"},{"u":"كَثِيبًۭا","en":"a heap of sand","ur":"ٹیلے"},{"u":"مَّهِيلًا","en":"pouring down","ur":"بکھرے ہوئے"}]},{"k":"73:15","n":15,"id":5490,"u":"إِنَّآ أَرْسَلْنَآ إِلَيْكُمْ رَسُولًا شَـٰهِدًا عَلَيْكُمْ كَمَآ أَرْسَلْنَآ إِلَىٰ فِرْعَوْنَ رَسُولًا","juz":29,"page":574,"sajdah":false,"w":[{"u":"إِنَّآ","en":"Indeed, We","ur":"بیشک ہم نے"},{"u":"أَرْسَلْنَآ","en":"[We] have sent","ur":"بھیجا ہم نے"},{"u":"إِلَيْكُمْ","en":"to you","ur":"آپ کی طرف۔ تم سب کی طرف"},{"u":"رَسُولًۭا","en":"a Messenger","ur":"ایک رسول"},{"u":"شَـٰهِدًا","en":"(as) a witness","ur":"گواہ"},{"u":"عَلَيْكُمْ","en":"upon you","ur":"تم پر"},{"u":"كَمَآ","en":"as","ur":"جیسا کہ"},{"u":"أَرْسَلْنَآ","en":"We sent","ur":"بھیجا ہم نے"},{"u":"إِلَىٰ","en":"to","ur":"طرف"},{"u":"فِرْعَوْنَ","en":"Firaun","ur":"فرعون کی"},{"u":"رَسُولًۭا","en":"a Messenger","ur":"ایک رسول"}]},{"k":"73:16","n":16,"id":5491,"u":"فَعَصَىٰ فِرْعَوْنُ ٱلرَّسُولَ فَأَخَذْنَـٰهُ أَخْذًا وَبِيلًا","juz":29,"page":574,"sajdah":false,"w":[{"u":"فَعَصَىٰ","en":"But disobeyed","ur":"تو نافرمانی کی"},{"u":"فِرْعَوْنُ","en":"Firaun","ur":"فرعون نے"},{"u":"ٱلرَّسُولَ","en":"the Messenger","ur":"رسول کی"},{"u":"فَأَخَذْنَـٰهُ","en":"so We seized him","ur":"تو پکڑ لیا ہم نے اس کو"},{"u":"أَخْذًۭا","en":"(with) a seizure","ur":"پکڑنا"},{"u":"وَبِيلًۭا","en":"ruinous","ur":"سخت"}]},{"k":"73:17","n":17,"id":5492,"u":"فَكَيْفَ تَتَّقُونَ إِن كَفَرْتُمْ يَوْمًا يَجْعَلُ ٱلْوِلْدَٰنَ شِيبًا","juz":29,"page":574,"sajdah":false,"w":[{"u":"فَكَيْفَ","en":"Then how","ur":"تو کس طرح"},{"u":"تَتَّقُونَ","en":"will you guard yourselves","ur":"تم بچو گے"},{"u":"إِن","en":"if","ur":"اگر"},{"u":"كَفَرْتُمْ","en":"you disbelieve","ur":"کفر کیا تم نے"},{"u":"يَوْمًۭا","en":"a Day","ur":"اس دن"},{"u":"يَجْعَلُ","en":"(that) will make","ur":"جو کردے گا"},{"u":"ٱلْوِلْدَٰنَ","en":"the children","ur":"بچوں کو"},{"u":"شِيبًا","en":"gray-haired","ur":"بوڑھا"}]},{"k":"73:18","n":18,"id":5493,"u":"ٱلسَّمَآءُ مُنفَطِرٌۢ بِهِۦ ۚ كَانَ وَعْدُهُۥ مَفْعُولًا","juz":29,"pa