فَمَن شَآءَ ٱتَّخَذَ إِلَىٰ رَبِّهِۦ سَبِيلًا","i":"اِنَّ هٰذِهٖ تَذۡكِرَةٌ ​ ۚ فَمَنۡ شَآءَ اتَّخَذَ اِلٰى رَبِّهٖ سَبِيۡلًا‏ ﻿﻿","juz":29,"page":574,"sajdah":false,"w":[{"u":"إِنَّ","i":"اِنَّ","tl":"inna","en":"Indeed","ur":"بیشک","a":"wbw/073_019_001.mp3"},{"u":"هَـٰذِهِۦ","i":"هٰذِهٖ","tl":"hādhihi","en":"this","ur":"یہ","a":"wbw/073_019_002.mp3"},{"u":"تَذْكِرَةٌۭ ۖ","i":"تَذۡكِرَةٌ ​ ۚ","tl":"tadhkiratun","en":"(is) a Reminder","ur":"ایک نصیحت","a":"wbw/073_019_003.mp3"},{"u":"فَمَن","i":"فَمَنۡ","tl":"faman","en":"then whoever","ur":"پس جو کوئی","a":"wbw/073_019_005.mp3"},{"u":"شَآءَ","i":"شَآءَ","tl":"shāa","en":"wills","ur":"چاہے","a":"wbw/073_019_006.mp3"},{"u":"ٱتَّخَذَ","i":"اتَّخَذَ","tl":"ittakhadha","en":"(let him) take","ur":"بنالے","a":"wbw/073_019_007.mp3"},{"u":"إِلَىٰ","i":"اِلٰى","tl":"ilā","en":"to","ur":"طرف","a":"wbw/073_019_008.mp3"},{"u":"رَبِّهِۦ","i":"رَبِّهٖ","tl":"rabbihi","en":"his Lord","ur":"اپنے رب کی","a":"wbw/073_019_009.mp3"},{"u":"سَبِيلًا","i":"سَبِيۡلًا‏ ﻿﻿","tl":"sabīlan","en":"a way","ur":"راستہ","a":"wbw/073_019_010.mp3"}]},{"k":"73:20","n":20,"id":5495,"u":"۞ إِنَّ رَبَّكَ يَعْلَمُ أَنَّكَ تَقُومُ أَدْنَىٰ مِن ثُلُثَىِ ٱلَّيْلِ وَنِصْفَهُۥ وَثُلُثَهُۥ وَطَآئِفَةٌ مِّنَ ٱلَّذِينَ مَعَكَ ۚ وَٱللَّهُ يُقَدِّرُ ٱلَّيْلَ وَٱلنَّهَارَ ۚ عَلِمَ أَن لَّن تُحْصُوهُ فَتَابَ عَلَيْكُمْ ۖ فَٱقْرَءُوا۟ مَا تَيَسَّرَ مِنَ ٱلْقُرْءَانِ ۚ عَلِمَ أَن سَيَكُونُ مِنكُم مَّرْضَىٰ ۙ وَءَاخَرُونَ يَضْرِبُونَ فِى ٱلْأَرْضِ يَبْتَغُونَ مِن فَضْلِ ٱللَّهِ ۙ وَءَاخَرُونَ يُقَـٰتِلُونَ فِى سَبِيلِ ٱللَّهِ ۖ فَٱقْرَءُوا۟ مَا تَيَسَّرَ مِنْهُ ۚ وَأَقِيمُوا۟ ٱلصَّلَوٰةَ وَءَاتُوا۟ ٱلزَّكَوٰةَ وَأَقْرِضُوا۟ ٱللَّهَ قَرْضًا حَسَنًا ۚ وَمَا تُقَدِّمُوا۟ لِأَنفُسِكُم مِّنْ خَيْرٍ تَجِدُوهُ عِندَ ٱللَّهِ هُوَ خَيْرًا وَأَعْظَمَ أَجْرًا ۚ وَٱسْتَغْفِرُوا۟ ٱللَّهَ ۖ إِنَّ ٱللَّهَ غَفُورٌ رَّحِيمٌۢ","i":"اِنَّ رَبَّكَ يَعۡلَمُ اَنَّكَ تَقُوۡمُ اَدۡنىٰ مِنۡ ثُلُثَىِ الَّيۡلِ وَ نِصۡفَهٗ وَثُلُثَهٗ وَطَآٮِٕفَةٌ مِّنَ الَّذِيۡنَ مَعَكَ​ؕ وَاللّٰهُ يُقَدِّرُ الَّيۡلَ وَالنَّهَارَ​ؕ عَلِمَ اَنۡ لَّنۡ تُحۡصُوۡهُ فَتَابَ عَلَيۡكُمۡ​ فَاقۡرَءُوۡا مَا تَيَسَّرَ مِنَ الۡقُرۡاٰنِ​ؕ عَلِمَ اَنۡ سَيَكُوۡنُ مِنۡكُمۡ مَّرۡضٰى​ۙ وَاٰخَرُوۡنَ يَضۡرِبُوۡنَ فِى الۡاَرۡضِ يَبۡتَغُوۡنَ مِنۡ فَضۡلِ اللّٰهِ​ۙ وَاٰخَرُوۡنَ يُقَاتِلُوۡنَ فِىۡ سَبِيۡلِ اللّٰهِ ۖ فَاقۡرَءُوۡا مَا تَيَسَّرَ مِنۡهُ​ ۙ وَاَقِيۡمُوا الصَّلٰوةَ وَاٰتُوا الزَّكٰوةَ وَاَقۡرِضُوا اللّٰهَ قَرۡضًا حَسَنًا​ ؕ وَمَا تُقَدِّمُوۡا لِاَنۡفُسِكُمۡ مِّنۡ خَيۡرٍ تَجِدُوۡهُ عِنۡدَ اللّٰهِ هُوَ خَيۡرًا وَّاَعۡظَمَ اَجۡرًا​ ؕ وَاسۡتَغۡفِرُوا اللّٰهَ ​ؕ اِنَّ اللّٰهَ غَفُوۡرٌ رَّحِيۡمٌ‏","juz":29,"page":575,"sajdah":false,"w":[{"u":"۞ إِنَّ","i":"۞ اِنَّ","tl":"inna","en":"Indeed","ur":"بیشک","a":"wbw/073_020_002.mp3"},{"u":"رَبَّكَ","i":"رَبَّكَ","tl":"rabbaka","en":"your Lord","ur":"تیرا رب","a":"wbw/073_020_003.mp3"},{"u":"يَعْلَمُ","i":"يَعۡلَمُ","tl":"yaʿlamu","en":"knows","ur":"جانتا ہے","a":"wbw/073_020_004.mp3"},{"u":"أَنَّكَ","i":"اَنَّكَ","tl":"annaka","en":"that you","ur":"بیشک آپ","a":"wbw/073_020_005.mp3"},{"u":"تَقُومُ","i":"تَقُوۡمُ","tl":"taqūmu","en":"stand","ur":"کھڑے رہتے ہیں","a":"wbw/073_020_006.mp3"},{"u":"أَدْنَىٰ","i":"اَدۡنىٰ","tl":"adnā","en":"(a little) less","ur":"قریب","a":"wbw/073_020_007.mp3"},{"u":"مِن","i":"مِنۡ","tl":"min","en":"than","ur":"","a":"wbw/073_020_008.mp3"},{"u":"ثُلُثَىِ","i":"ثُلُثَىِ","tl":"thuluthayi","en":"two-thirds","ur":"دو تہارئی","a":"wbw/073_020_009.mp3"},{"u":"ٱلَّيْلِ","i":"الَّيۡلِ","tl":"al-layli","en":"(of) the night","ur":"رات کے","a":"wbw/073_020_010.mp3"},{"u":"وَنِصْفَهُۥ","i":"وَ نِصۡفَهٗ","tl":"waniṣ'fahu","en":"and half of it","ur":"اور آدھے اس کے","a":"wbw/073_020_011.mp3"},{"u":"وَثُلُثَهُۥ","i":"وَثُلُثَهٗ","tl":"wathuluthahu","en":"and a third of it","ur":"اور ایک تہائی اس کے","a":"wbw/073_020_012.mp3"},{"u":"وَطَآئِفَةٌۭ","i":"وَطَآٮِٕفَةٌ","tl":"waṭāifatun","en":"and (so do) a group","ur":"اور ایک گروہ","a":"wbw/073_020_013.mp3"},{"u":"مِّنَ","i":"مِّنَ","tl":"mina","en":"of","ur":"سے","a":"wbw/073_