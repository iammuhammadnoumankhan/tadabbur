40,"id":5535,"u":"فِى جَنَّـٰتٍ يَتَسَآءَلُونَ","juz":29,"page":576,"sajdah":false,"w":[{"u":"فِى","en":"In","ur":"میں"},{"u":"جَنَّـٰتٍۢ","en":"Gardens","ur":"باغوں"},{"u":"يَتَسَآءَلُونَ","en":"asking each other","ur":"سوال کررہے ہوں گے"}]},{"k":"74:41","n":41,"id":5536,"u":"عَنِ ٱلْمُجْرِمِينَ","juz":29,"page":576,"sajdah":false,"w":[{"u":"عَنِ","en":"About","ur":"سے"},{"u":"ٱلْمُجْرِمِينَ","en":"the criminals","ur":"مجرموں (سے)"}]},{"k":"74:42","n":42,"id":5537,"u":"مَا سَلَكَكُمْ فِى سَقَرَ","juz":29,"page":576,"sajdah":false,"w":[{"u":"مَا","en":"What","ur":"کیا"},{"u":"سَلَكَكُمْ","en":"led you","ur":"چیز لے گئی تم کو"},{"u":"فِى","en":"into","ur":"میں"},{"u":"سَقَرَ","en":"Hell","ur":"دوزخ"}]},{"k":"74:43","n":43,"id":5538,"u":"قَالُوا۟ لَمْ نَكُ مِنَ ٱلْمُصَلِّينَ","juz":29,"page":576,"sajdah":false,"w":[{"u":"قَالُوا۟","en":"They will say","ur":"وہ کہیں گے"},{"u":"لَمْ","en":"Not","ur":"نہ"},{"u":"نَكُ","en":"we were","ur":"تھے ہم"},{"u":"مِنَ","en":"of","ur":"میں سے"},{"u":"ٱلْمُصَلِّينَ","en":"those who prayed","ur":"نماز پڑھنے والوں"}]},{"k":"74:44","n":44,"id":5539,"u":"وَلَمْ نَكُ نُطْعِمُ ٱلْمِسْكِينَ","juz":29,"page":576,"sajdah":false,"w":[{"u":"وَلَمْ","en":"And not","ur":"اور نہ تھے ہم"},{"u":"نَكُ","en":"we used to","ur":"ہم"},{"u":"نُطْعِمُ","en":"feed","ur":"کھانا کھلاتے"},{"u":"ٱلْمِسْكِينَ","en":"the poor","ur":"مسکین کو"}]},{"k":"74:45","n":45,"id":5540,"u":"وَكُنَّا نَخُوضُ مَعَ ٱلْخَآئِضِينَ","juz":29,"page":576,"sajdah":false,"w":[{"u":"وَكُنَّا","en":"And we used to","ur":"اور تھے ہم"},{"u":"نَخُوضُ","en":"indulge in vain talk","ur":"ہم بحث کرتے"},{"u":"مَعَ","en":"with","ur":"ساتھ"},{"u":"ٱلْخَآئِضِينَ","en":"the vain talkers","ur":"بحث کرنے والوں کے"}]},{"k":"74:46","n":46,"id":5541,"u":"وَكُنَّا نُكَذِّبُ بِيَوْمِ ٱلدِّينِ","juz":29,"page":576,"sajdah":false,"w":[{"u":"وَكُنَّا","en":"And we used to","ur":"اور تھے ہم"},{"u":"نُكَذِّبُ","en":"deny","ur":"ہم جھٹلاتے"},{"u":"بِيَوْمِ","en":"(the) Day","ur":"روز"},{"u":"ٱلدِّينِ","en