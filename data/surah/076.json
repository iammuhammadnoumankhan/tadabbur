{"n":76,"src":{"text":"qc-text","wbw":"qc-wbw"},"ayahs":[{"k":"76:1","n":1,"id":5592,"u":" هَلْ أَتَىٰ عَلَى ٱلْإِنسَـٰنِ حِينٌ مِّنَ ٱلدَّهْرِ لَمْ يَكُن شَيْـًٔا مَّذْكُورًا","i":"هَلۡ اَتٰى عَلَى الۡاِنۡسَانِ حِيۡنٌ مِّنَ الدَّهۡرِ لَمۡ يَكُنۡ شَيۡـًٔـا مَّذۡكُوۡرًا‏","juz":29,"page":578,"sajdah":false,"w":[{"u":"هَلْ","i":"هَلۡ","tl":"hal","en":"Has","ur":"کیا","a":"wbw/076_001_001.mp3"},{"u":"أَتَىٰ","i":"اَتٰى","tl":"atā","en":"(there) come","ur":"آیا ہے","a":"wbw/076_001_002.mp3"},{"u":"عَلَى","i":"عَلَى","tl":"ʿalā","en":"upon","ur":"پر","a":"wbw/076_001_003.mp3"},{"u":"ٱلْإِنسَـٰنِ","i":"الۡاِنۡسَانِ","tl":"l-insāni","en":"man","ur":"انسان","a":"wbw/076_001_004.mp3"},{"u":"حِينٌۭ","i":"حِيۡنٌ","tl":"ḥīnun","en":"a period","ur":"ایک وقت","a":"wbw/076_001_005.mp3"},{"u":"مِّنَ","i":"مِّنَ","tl":"mina","en":"of","ur":"میں سے","a":"wbw/076_001_006.mp3"},{"u":"ٱلدَّهْرِ","i":"الدَّهۡرِ","tl":"l-dahri","en":"time","ur":"زمانے","a":"wbw/076_001_007.mp3"},{"u":"لَمْ","i":"لَمۡ","tl":"lam","en":"not","ur":"نہ","a":"wbw/076_001_008.mp3"},{"u":"يَكُن","i":"يَكُنۡ","tl":"yakun","en":"he was","ur":"تھا","a":"wbw/076_001_009.mp3"},{"u":"شَيْـًۭٔا","i":"شَيۡـًٔـا","tl":"shayan","en":"a thing","ur":"کوئی چیز","a":"wbw/076_001_010.mp3"},{"u":"مَّذْكُورًا","i":"مَّذۡكُوۡرًا‏","tl":"madhkūran","en":"mentioned","ur":"قابل ذکر","a":"wbw/076_001_011.mp3"}]},{"k":"76:2","n":2,"id":5593,"u":"إِنَّا خَلَقْنَا ٱلْإِنسَـٰنَ مِن نُّطْفَةٍ أَمْشَاجٍ نَّبْتَلِيهِ فَجَعَلْنَـٰهُ سَمِيعًۢا بَصِيرًا","i":"اِنَّا خَلَقۡنَا الۡاِنۡسَانَ مِنۡ نُّطۡفَةٍ اَمۡشَاجٍۖ نَّبۡتَلِيۡهِ فَجَعَلۡنٰهُ سَمِيۡعًۢا بَصِيۡرًا‏","juz":29,"page":578,"sajdah":false,"w":[{"u":"إِنَّا","i":"اِنَّا","tl":"innā","en":"Indeed, We","ur":"بیشک ہم نے","a":"wbw/076_002_001.mp3"},{"u":"خَلَقْنَا","i":"خَلَقۡنَا","tl":"khalaqnā","en":"[We] created","ur":"پیدا کیا ہم نے","a":"wbw/076_002_002.mp3"},{"u":"ٱلْإِنسَـٰنَ","i":"الۡاِنۡسَانَ","tl":"l-insāna","en":"man","ur":"انسان کو","a":"wbw/076_002_003.mp3"},{"u":"مِن","i":"مِنۡ","tl":"min","en":"from","ur":"سے","a":"wbw/076_002_004.mp3"},{"u":"نُّطْفَةٍ","i":"نُّطۡفَةٍ","tl":"nuṭ'fatin","en":"a semen-drop","ur":"ایک نطفے","a":"wbw/076_002_005.mp3"},{"u":"أَمْشَاجٍۢ","i":"اَمۡشَاجٍۖ","tl":"amshājin","en":"a mixture","ur":"ملے ہوئے۔ مخلوط","a":"wbw/076_002_006.mp3"},{"u":"نَّبْتَلِيهِ","i":"نَّبۡتَلِيۡهِ","tl":"nabtalīhi","en":"(that) We test him","ur":"کہ ہم آزمائیں اس کو۔ آزمائش کریں اس کی","a":"wbw/076_002_007.mp3"},{"u":"فَجَعَلْنَـٰهُ","i":"فَجَعَلۡنٰهُ","tl":"fajaʿalnāhu","en":"so We made (for) him","ur":"تو بنایا ہم نے اس کو","a":"wbw/076_002_008.mp3"},{"u":"سَمِيعًۢا","i":"سَمِيۡعًۢا","tl":"samīʿan","en":"hearing","ur":"سننے والا","a":"wbw/076_002_009.mp3"},{"u":"بَصِيرًا","i":"بَصِيۡرًا‏","tl":"baṣīran","en":"and sight","ur":"دیکھنے والا","a":"wbw/076_002_010.mp3"}]},{"k":"76:3","n":3,"id":5594,"u":"إِنَّا هَدَيْنَـٰهُ ٱلسَّبِيلَ إِمَّا شَاكِرًا وَإِمَّا كَفُورًا","i":"اِنَّا هَدَيۡنٰهُ السَّبِيۡلَ اِمَّا شَاكِرًا وَّاِمَّا كَفُوۡرًا‏","juz":29,"page":578,"sajdah":false,"w":[{"u":"إِنَّا","i":"اِنَّا","tl":"innā","en":"Indeed, We","ur":"بیشک ہم نے","a":"wbw/076_003_001.mp3"},{"u":"هَدَيْنَـٰهُ","i":"هَدَيۡنٰهُ","tl":"hadaynāhu","en":"guided him","ur":"راہ دکھائی ہم نے اس کو۔ ہدایت دی ہم نے اس کو","a":"wbw/076_003_002.mp3"},{"u":"ٱلسَّبِيلَ","i":"السَّبِيۡلَ","tl":"l-sabīla","en":"(to) the way","ur":"راستے کی","a":"wbw/076_003_003.mp3"},{"u":"إِمَّا","i":"اِمَّا","tl":"immā","en":"whether","ur":"خواہ","a":"wbw/076_003_004.mp3"},{"u":"شَاكِرًۭا","i":"شَاكِرًا","tl":"shākiran","en":"(he) be grateful","ur":"شکر گزار ہو","a":"wbw/076_003_005.mp3"},{"u":"وَإِمَّا","i":"وَّاِمَّا","tl":"wa-immā","en":"and whether","ur":"اور خواہ","a":"wbw/076_003_006.mp3"},{"u":"كَفُورًا","i":"كَفُوۡرًا‏","tl":"kafūran","en":"(he) be ungrateful","ur":"ناشکرا ہو","a":"wbw/076_003_007.mp3"}]},{"k":"76:4","n":4,"id":5595,"u":"إِنَّآ أَعْتَدْنَا لِلْكَـٰفِرِينَ سَلَـٰسِلَا۟ وَأَغْلَـٰلًا وَسَعِيرًا","i":"اِنَّاۤ اَعۡتَدۡنَا لِلۡكٰفِرِيۡنَ سَلٰسِلَا۟ وَاَ