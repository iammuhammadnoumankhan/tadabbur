{"n":79,"src":{"text":"qc-text","wbw":"qc-wbw"},"ayahs":[{"k":"79:1","n":1,"id":5713,"u":" وَٱلنَّـٰزِعَـٰتِ غَرْقًا","juz":30,"page":583,"sajdah":false,"w":[{"u":"وَٱلنَّـٰزِعَـٰتِ","en":"By those who extract","ur":"قسم ہے ان فرشتوں کی جو کھینچنے والے ہیں"},{"u":"غَرْقًۭا","en":"violently","ur":"غرق ہوکر/ ڈوب کر"}]},{"k":"79:2","n":2,"id":5714,"u":"وَٱلنَّـٰشِطَـٰتِ نَشْطًا","juz":30,"page":583,"sajdah":false,"w":[{"u":"وَٱلنَّـٰشِطَـٰتِ","en":"And those who draw out","ur":"قسم ہے ان فرشتوں کی جو آسانی سے نکالنے والے ہیں"},{"u":"نَشْطًۭا","en":"gently","ur":"نکال لینا"}]},{"k":"79:3","n":3,"id":5715,"u":"وَٱلسَّـٰبِحَـٰتِ سَبْحًا","juz":30,"page":583,"sajdah":false,"w":[{"u":"وَٱلسَّـٰبِحَـٰتِ","en":"And those who glide","ur":"قسم ہے ان فرشتوں کی جو تیرنے والے ہیں"},{"u":"سَبْحًۭا","en":"swimming","ur":"تیرنا"}]},{"k":"79:4","n":4,"id":5716,"u":"فَٱلسَّـٰبِقَـٰتِ سَبْقًا","juz":30,"page":583,"sajdah":false,"w":[{"u":"فَٱلسَّـٰبِقَـٰتِ","en":"And those who race each other","ur":"پھر آگے بڑھنے والوں کی/ سبقت کرنے والوں کی"},{"u":"سَبْقًۭا","en":"(in) a race","ur":"سبقت کرنا/ آگے بڑھنا"}]},{"k":"79:5","n":5,"id":5717,"u":"فَٱلْمُدَبِّرَٰتِ أَمْرًا","juz":30,"page":583,"sajdah":false,"w":[{"u":"فَٱلْمُدَبِّرَٰتِ","en":"And those who arrange","ur":"پھر تدبیر کرنے والوں کی"},{"u":"أَمْرًۭا","en":"(the) matter","ur":"کام میں/ کام کی"}]},{"k":"79:6","n":6,"id":5718,"u":"يَوْمَ تَرْجُفُ ٱلرَّاجِفَةُ","juz":30,"page":583,"sajdah":false,"w":[{"u":"يَوْمَ","en":"(The) Day","ur":"جس دن"},{"u":"تَرْجُفُ","en":"will quake","ur":"کانپے گی"},{"u":"ٱلرَّاجِفَةُ","en":"the quaking one","ur":"کانپنے والی"}]},{"k":"79:7","n":7,"id":5719,"u":"تَتْبَعُهَا ٱلرَّادِفَةُ","juz":30,"page":583,"sajdah":false,"w":[{"u":"تَتْبَعُهَا","en":"Follows it","ur":"پیچھے آئے گی اس کے"},{"u":"ٱلرَّادِفَةُ","en":"the subsequent","ur":"پیچھے آنے والی"}]},{"k":"79:8","n":8,"id":5720,"u":"قُلُوبٌ يَوْمَئِذٍ وَاجِفَةٌ","juz":30,"page":583,"sajdah":false,"w":[{"u":"قُلُوبٌۭ","en":"Hearts","ur":"کچھ دل"},{"u":