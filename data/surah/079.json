rs","ur":"ڈرتا ہو"}]},{"k":"79:27","n":27,"id":5739,"u":"ءَأَنتُمْ أَشَدُّ خَلْقًا أَمِ ٱلسَّمَآءُ ۚ بَنَىٰهَا","juz":30,"page":584,"sajdah":false,"w":[{"u":"ءَأَنتُمْ","en":"Are you","ur":"کیا تم"},{"u":"أَشَدُّ","en":"a more difficult","ur":"زیادہ سخت ہو"},{"u":"خَلْقًا","en":"creation","ur":"تخلیق میں"},{"u":"أَمِ","en":"or","ur":"یا"},{"u":"ٱلسَّمَآءُ ۚ","en":"the heaven","ur":"آسمان"},{"u":"بَنَىٰهَا","en":"He constructed it","ur":"اس نے بنایا اس کو"}]},{"k":"79:28","n":28,"id":5740,"u":"رَفَعَ سَمْكَهَا فَسَوَّىٰهَا","juz":30,"page":584,"sajdah":false,"w":[{"u":"رَفَعَ","en":"He raised","ur":"اٹھایا"},{"u":"سَمْكَهَا","en":"its ceiling","ur":"اس کی بلندی کو"},{"u":"فَسَوَّىٰهَا","en":"and proportioned it","ur":"پھر درست کردیا اس کو"}]},{"k":"79:29","n":29,"id":5741,"u":"وَأَغْطَشَ لَيْلَهَا وَأَخْرَجَ ضُحَىٰهَا","juz":30,"page":584,"sajdah":false,"w":[{"u":"وَأَغْطَشَ","en":"And He darkened","ur":"اور ڈھانک دیا"},{"u":"لَيْلَهَا","en":"its night","ur":"اس کی رات کو"},{"u":"وَأَخْرَجَ","en":"and brought out","ur":"اور نکالا"},{"u":"ضُحَىٰهَا","en":"its brightness","ur":"اس کی دھوپ کو/ اس کے دن کو/ اگلا پہر"}]},{"k":"79:30","n":30,"id":5742,"u":"وَٱلْأَرْضَ بَعْدَ ذَٰلِكَ دَحَىٰهَآ","juz":30,"page":584,"sajdah":false,"w":[{"u":"وَٱلْأَرْضَ","en":"And the earth","ur":"اور زمین کو"},{"u":"بَعْدَ","en":"after","ur":"بعد"},{"u":"ذَٰلِكَ","en":"that","ur":"اس کے"},{"u":"دَحَىٰهَآ","en":"He spread it","ur":"اس نے بچھا دیا"}]},{"k":"79:31","n":31,"id":5743,"u":"أَخْرَجَ مِنْهَا مَآءَهَا وَمَرْعَىٰهَا","juz":30,"page":584,"sajdah":false,"w":[{"u":"أَخْرَجَ","en":"He brought forth","ur":"اس نے نکالا"},{"u":"مِنْهَا","en":"from it","ur":"اس سے"},{"u":"مَآءَهَا","en":"its water","ur":"اس کا پانی"},{"u":"وَمَرْعَىٰهَا","en":"and its pasture","ur":"اور اس کا چارہ"}]},{"k":"79:32","n":32,"id":5744,"u":"وَٱلْجِبَالَ أَرْسَىٰهَا","juz":30,"page":584,"sajdah":false,"w":[{"u":"وَٱلْجِبَالَ","en":"And the mountains","ur":"اور پہاڑوں کو"},{"u":"أَرْسَىٰهَا","en":"He made them