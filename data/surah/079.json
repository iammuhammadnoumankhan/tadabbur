","ur":"طرف"},{"u":"رَبِّكَ","en":"your Lord","ur":"تیرے رب کی"},{"u":"مُنتَهَىٰهَآ","en":"(is) its finality","ur":"اس کی انتہاء ہے"}]},{"k":"79:45","n":45,"id":5757,"u":"إِنَّمَآ أَنتَ مُنذِرُ مَن يَخْشَىٰهَا","juz":30,"page":584,"sajdah":false,"w":[{"u":"إِنَّمَآ","en":"Only","ur":"بیشک"},{"u":"أَنتَ","en":"you","ur":"تو"},{"u":"مُنذِرُ","en":"(are) a warner","ur":"خبردار کرنے والا ہے"},{"u":"مَن","en":"(for him) who","ur":"اس کو جو"},{"u":"يَخْشَىٰهَا","en":"fears it","ur":"ڈرتا ہو اس سے"}]},{"k":"79:46","n":46,"id":5758,"u":"كَأَنَّهُمْ يَوْمَ يَرَوْنَهَا لَمْ يَلْبَثُوٓا۟ إِلَّا عَشِيَّةً أَوْ ضُحَىٰهَا","juz":30,"page":584,"sajdah":false,"w":[{"u":"كَأَنَّهُمْ","en":"As though they","ur":"گویا کہ وہ"},{"u":"يَوْمَ","en":"(the) Day","ur":"جس دن"},{"u":"يَرَوْنَهَا","en":"they see it","ur":"وہ دیکھ لیں گے اس کو ( تو کہیں گے گویا کہ)"},{"u":"لَمْ","en":"not","ur":"نہیں"},{"u":"يَلْبَثُوٓا۟","en":"they had remained","ur":"وہ ٹھہرے"},{"u":"إِلَّا","en":"except","ur":"مگر"},{"u":"عَشِيَّةً","en":"an evening","ur":"شام کا وقت"},{"u":"أَوْ","en":"or","ur":"یا"},{"u":"ضُحَىٰهَا","en":"a morning thereof","ur":"اس کی صبح"}]}]}