}]},{"k":"79:15","n":15,"id":5727,"u":"هَلْ أَتَىٰكَ حَدِيثُ مُوسَىٰٓ","juz":30,"page":583,"sajdah":false,"w":[{"u":"هَلْ","en":"Has","ur":"کیا"},{"u":"أَتَىٰكَ","en":"(there) come to you","ur":"آئی ہے تیرے پاس"},{"u":"حَدِيثُ","en":"(the) story","ur":"بات"},{"u":"مُوسَىٰٓ","en":"(of) Musa","ur":"موسیٰ کی"}]},{"k":"79:16","n":16,"id":5728,"u":"إِذْ نَادَىٰهُ رَبُّهُۥ بِٱلْوَادِ ٱلْمُقَدَّسِ طُوًى","juz":30,"page":583,"sajdah":false,"w":[{"u":"إِذْ","en":"When","ur":"جب"},{"u":"نَادَىٰهُ","en":"called him","ur":"پکارا اس کو"},{"u":"رَبُّهُۥ","en":"his Lord","ur":"اس کے رب نے"},{"u":"بِٱلْوَادِ","en":"in the valley","ur":"وادی میں"},{"u":"ٱلْمُقَدَّسِ","en":"the sacred","ur":"مقدس"},{"u":"طُوًى","en":"(of) Tuwa","ur":"طویٰ کی"}]},{"k":"79:17","n":17,"id":5729,"u":"ٱذْهَبْ إِلَىٰ فِرْعَوْنَ إِنَّهُۥ طَغَىٰ","juz":30,"page":584,"sajdah":false,"w":[{"u":"ٱذْهَبْ","en":"Go","ur":"جاؤ"},{"u":"إِلَىٰ","en":"to","ur":"طرف"},{"u":"فِرْعَوْنَ","en":"Firaun","ur":"فرعون کے"},{"u":"إِنَّهُۥ","en":"Indeed, he","ur":"بیشک وہ"},{"u":"طَغَىٰ","en":"(has) transgressed","ur":"سرکش ہوگیا ہے"}]},{"k":"79:18","n":18,"id":5730,"u":"فَقُلْ هَل لَّكَ إِلَىٰٓ أَن تَزَكَّىٰ","juz":30,"page":584,"sajdah":false,"w":[{"u":"فَقُلْ","en":"And say","ur":"پس کہو"},{"u":"هَل","en":"Would","ur":"کیا"},{"u":"لَّكَ","en":"[for] you","ur":"تیرے لئے ہے"},{"u":"إِلَىٰٓ","en":"[to]","ur":"طرف اس بات کے"},{"u":"أَن","en":"[that]","ur":"کہ"},{"u":"تَزَكَّىٰ","en":"purify yourself","ur":"تو پاکیزگی اختیار کرے"}]},{"k":"79:19","n":19,"id":5731,"u":"وَأَهْدِيَكَ إِلَىٰ رَبِّكَ فَتَخْشَىٰ","juz":30,"page":584,"sajdah":false,"w":[{"u":"وَأَهْدِيَكَ","en":"And I will guide you","ur":"اور میں رہنمائی کروں تیری"},{"u":"إِلَىٰ","en":"to","ur":"طرف"},{"u":"رَبِّكَ","en":"your Lord","ur":"تیرے رب کی"},{"u":"فَتَخْشَىٰ","en":"so you would fear","ur":"تاکہ تو ڈرے"}]},{"k":"79:20","n":20,"id":5732,"u":"فَأَرَىٰهُ ٱلْـَٔايَةَ ٱلْكُبْرَىٰ","juz":30,"page":584,"sajdah":false,"w":[{"u":"فَأَرَىٰهُ","en":"Then he showed him","u