w/079_005_001.mp3"},{"u":"أَمْرًۭا","i":"اَمۡرًا​ ۘ‏","tl":"amran","en":"(the) matter","ur":"کام میں/ کام کی","a":"wbw/079_005_002.mp3"}]},{"k":"79:6","n":6,"id":5718,"u":"يَوْمَ تَرْجُفُ ٱلرَّاجِفَةُ","i":"يَوۡمَ تَرۡجُفُ الرَّاجِفَةُ ۙ‏","juz":30,"page":583,"sajdah":false,"w":[{"u":"يَوْمَ","i":"يَوۡمَ","tl":"yawma","en":"(The) Day","ur":"جس دن","a":"wbw/079_006_001.mp3"},{"u":"تَرْجُفُ","i":"تَرۡجُفُ","tl":"tarjufu","en":"will quake","ur":"کانپے گی","a":"wbw/079_006_002.mp3"},{"u":"ٱلرَّاجِفَةُ","i":"الرَّاجِفَةُ ۙ‏","tl":"l-rājifatu","en":"the quaking one","ur":"کانپنے والی","a":"wbw/079_006_003.mp3"}]},{"k":"79:7","n":7,"id":5719,"u":"تَتْبَعُهَا ٱلرَّادِفَةُ","i":"تَتۡبَعُهَا الرَّادِفَةُ ؕ‏","juz":30,"page":583,"sajdah":false,"w":[{"u":"تَتْبَعُهَا","i":"تَتۡبَعُهَا","tl":"tatbaʿuhā","en":"Follows it","ur":"پیچھے آئے گی اس کے","a":"wbw/079_007_001.mp3"},{"u":"ٱلرَّادِفَةُ","i":"الرَّادِفَةُ ؕ‏","tl":"l-rādifatu","en":"the subsequent","ur":"پیچھے آنے والی","a":"wbw/079_007_002.mp3"}]},{"k":"79:8","n":8,"id":5720,"u":"قُلُوبٌ يَوْمَئِذٍ وَاجِفَةٌ","i":"قُلُوۡبٌ يَّوۡمَٮِٕذٍ وَّاجِفَةٌ ۙ‏","juz":30,"page":583,"sajdah":false,"w":[{"u":"قُلُوبٌۭ","i":"قُلُوۡبٌ","tl":"qulūbun","en":"Hearts","ur":"کچھ دل","a":"wbw/079_008_001.mp3"},{"u":"يَوْمَئِذٍۢ","i":"يَّوۡمَٮِٕذٍ","tl":"yawma-idhin","en":"that Day","ur":"اس دن","a":"wbw/079_008_002.mp3"},{"u":"وَاجِفَةٌ","i":"وَّاجِفَةٌ ۙ‏","tl":"wājifatun","en":"will palpitate","ur":"دھڑکنے والے ہیں/ ہوں گے","a":"wbw/079_008_003.mp3"}]},{"k":"79:9","n":9,"id":5721,"u":"أَبْصَـٰرُهَا خَـٰشِعَةٌ","i":"اَبۡصَارُهَا خَاشِعَةٌ​ ۘ‏","juz":30,"page":583,"sajdah":false,"w":[{"u":"أَبْصَـٰرُهَا","i":"اَبۡصَارُهَا","tl":"abṣāruhā","en":"Their eyes","ur":"نگاہیں ان کی","a":"wbw/079_009_001.mp3"},{"u":"خَـٰشِعَةٌۭ","i":"خَاشِعَةٌ​ ۘ‏","tl":"khāshiʿatun","en":"humbled","ur":"دبی ہوئی ہوں گی/ سہمی ہوئی ہوں گی","a":"wbw/079_009_002.mp3"}]},{"k":"79:10","n":10,"id":5722,"u":"يَقُولُونَ أَءِنَّا لَمَرْدُودُونَ فِى ٱلْحَافِرَةِ","i":"يَقُوۡلُوۡ