{"n":80,"src":{"text":"qc-text","wbw":"qc-wbw"},"ayahs":[{"k":"80:1","n":1,"id":5759,"u":" عَبَسَ وَتَوَلَّىٰٓ","juz":30,"page":585,"sajdah":false,"w":[{"u":"عَبَسَ","en":"He frowned","ur":"ترش رو ہوا"},{"u":"وَتَوَلَّىٰٓ","en":"and turned away","ur":"اور منہ موڑا"}]},{"k":"80:2","n":2,"id":5760,"u":"أَن جَآءَهُ ٱلْأَعْمَىٰ","juz":30,"page":585,"sajdah":false,"w":[{"u":"أَن","en":"Because","ur":"کہ"},{"u":"جَآءَهُ","en":"came to him","ur":"آیا اس کے پاس"},{"u":"ٱلْأَعْمَىٰ","en":"the blind man","ur":"اندھا"}]},{"k":"80:3","n":3,"id":5761,"u":"وَمَا يُدْرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ","juz":30,"page":585,"sajdah":false,"w":[{"u":"وَمَا","en":"But what","ur":"اور کیا چیز"},{"u":"يُدْرِيكَ","en":"would make you know","ur":"بتائے تجھ کو"},{"u":"لَعَلَّهُۥ","en":"that he might","ur":"شاید کہ وہ"},{"u":"يَزَّكَّىٰٓ","en":"purify himself","ur":"وہ سدھر جائے/ تزکیہ پائے"}]},{"k":"80:4","n":4,"id":5762,"u":"أَوْ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكْرَىٰٓ","juz":30,"page":585,"sajdah":false,"w":[{"u":"أَوْ","en":"Or","ur":"یا"},{"u":"يَذَّكَّرُ","en":"be reminded","ur":"نصیحت پکڑے"},{"u":"فَتَنفَعَهُ","en":"so would benefit him","ur":"تو فائدہ دے اس کو"},{"u":"ٱلذِّكْرَىٰٓ","en":"the reminder","ur":"نصیحت"}]},{"k":"80:5","n":5,"id":5763,"u":"أَمَّا مَنِ ٱسْتَغْنَىٰ","juz":30,"page":585,"sajdah":false,"w":[{"u":"أَمَّا","en":"As for","ur":"رہا"},{"u":"مَنِ","en":"(him) who","ur":"وہ جو"},{"u":"ٱسْتَغْنَىٰ","en":"considers himself free from need","ur":"بےپروائی کرتا ہے"}]},{"k":"80:6","n":6,"id":5764,"u":"فَأَنتَ لَهُۥ تَصَدَّىٰ","juz":30,"page":585,"sajdah":false,"w":[{"u":"فَأَنتَ","en":"So you","ur":"تو آپ"},{"u":"لَهُۥ","en":"to him","ur":"اس کی طرف"},{"u":"تَصَدَّىٰ","en":"give attention","ur":"مائل ہوتے ہیں/ فکر کرتے ہیں"}]},{"k":"80:7","n":7,"id":5765,"u":"وَمَا عَلَيْكَ أَلَّا يَزَّكَّىٰ","juz":30,"page":585,"sajdah":false,"w":[{"u":"وَمَا","en":"And not","ur":"اور نہیں"},{"u":"عَلَيْكَ","en":"upon you","ur":"آپ پر ذمہ داری"},{"u":"أَلَّا","en":"that not","ur":"کہ نہ"},{"u":"ي