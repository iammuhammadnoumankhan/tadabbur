:"(of) scribes","ur":"لکھنے والوں کے"}]},{"k":"80:16","n":16,"id":5774,"u":"كِرَامٍۭ بَرَرَةٍ","juz":30,"page":585,"sajdah":false,"w":[{"u":"كِرَامٍۭ","en":"Noble","ur":"معزز ہیں"},{"u":"بَرَرَةٍۢ","en":"dutiful","ur":"جو نیک ہیں"}]},{"k":"80:17","n":17,"id":5775,"u":"قُتِلَ ٱلْإِنسَـٰنُ مَآ أَكْفَرَهُۥ","juz":30,"page":585,"sajdah":false,"w":[{"u":"قُتِلَ","en":"Is destroyed","ur":"مارا جائے"},{"u":"ٱلْإِنسَـٰنُ","en":"[the] man","ur":"انسان"},{"u":"مَآ","en":"how","ur":"کیا"},{"u":"أَكْفَرَهُۥ","en":"ungrateful is he","ur":"سخت منکر ہے"}]},{"k":"80:18","n":18,"id":5776,"u":"مِنْ أَىِّ شَىْءٍ خَلَقَهُۥ","juz":30,"page":585,"sajdah":false,"w":[{"u":"مِنْ","en":"From","ur":"سے"},{"u":"أَىِّ","en":"what","ur":"کس"},{"u":"شَىْءٍ","en":"thing","ur":"چیز"},{"u":"خَلَقَهُۥ","en":"He created him","ur":"اس نے پیدا کیا اس کو"}]},{"k":"80:19","n":19,"id":5777,"u":"مِن نُّطْفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ","juz":30,"page":585,"sajdah":false,"w":[{"u":"مِن","en":"From","ur":"سے"},{"u":"نُّطْفَةٍ","en":"a semen-drop","ur":"ایک نطفے (سے)"},{"u":"خَلَقَهُۥ","en":"He created him","ur":"اس نے پیدا کیا اس کو"},{"u":"فَقَدَّرَهُۥ","en":"then He proportioned him","ur":"پھر تقدیر مقرر کی اس کی"}]},{"k":"80:20","n":20,"id":5778,"u":"ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ","juz":30,"page":585,"sajdah":false,"w":[{"u":"ثُمَّ","en":"Then","ur":"پھر"},{"u":"ٱلسَّبِيلَ","en":"the way","ur":"راستہ"},{"u":"يَسَّرَهُۥ","en":"He made easy for him","ur":"اس نے آسان کیا اس کا"}]},{"k":"80:21","n":21,"id":5779,"u":"ثُمَّ أَمَاتَهُۥ فَأَقْبَرَهُۥ","juz":30,"page":585,"sajdah":false,"w":[{"u":"ثُمَّ","en":"Then","ur":"پھر"},{"u":"أَمَاتَهُۥ","en":"He causes him to die","ur":"موت دی اس کو"},{"u":"فَأَقْبَرَهُۥ","en":"and provides a grave for him","ur":"پھر قبر دی اس کو"}]},{"k":"80:22","n":22,"id":5780,"u":"ثُمَّ إِذَا شَآءَ أَنشَرَهُۥ","juz":30,"page":585,"sajdah":false,"w":[{"u":"ثُمَّ","en":"Then","ur":"پھر"},{"u":"إِذَا","en":"when","ur":"جب"},{"u":"شَآءَ","en":"He wills","ur":"وہ چاہے گا"},{"u":"أَنشَرَهُۥ","en":"He will resurrect him","ur":"اٹھا کھڑا کرے گا اس کو"}]},{"k":"80:23","n":23,"id":5781,"u":"كَلَّا لَمَّا يَقْضِ مَآ أَمَرَهُۥ","juz":30,"page":585,"sajdah":false,"w":[{"u":"كَلَّا","en":"Nay","ur":"ہرگز نہیں"},{"u":"لَمَّا","en":"Not","ur":"نہیں"},{"u":"يَقْضِ","en":"he has accomplished","ur":"پورا کیا"},{"u":"مَآ","en":"what","ur":"جو"},{"u":"أَمَرَهُۥ","en":"He commanded him","ur":"اس نے حکم دیا اس کو"}]},{"k":"80:24","n":24,"id":5782,"u":"فَلْيَنظُرِ ٱلْإِنسَـٰنُ إِلَىٰ طَعَامِهِۦٓ","juz":30,"page":585,"sajdah":false,"w":[{"u":"فَلْيَنظُرِ","en":"Then let look","ur":"پس چاہیے کہ دیکھے"},{"u":"ٱلْإِنسَـٰنُ","en":"the man","ur":"انسان"},{"u":"إِلَىٰ","en":"at","ur":"طرف"},{"u":"طَعَامِهِۦٓ","en":"his food","ur":"اپنے کھانے کی"}]},{"k":"80:25","n":25,"id":5783,"u":"أَنَّا صَبَبْنَا ٱلْمَآءَ صَبًّا","juz":30,"page":585,"sajdah":false,"w":[{"u":"اَنَّا","en":"That [We]","ur":"بیشک ہم نے"},{"u":"صَبَبْنَا","en":"[We] poured","ur":"ڈالا ہم نے/پلٹنا ہم نے/ انڈیلا ہم نے"},{"u":"ٱلْمَآءَ","en":"the water","ur":"پانی"},{"u":"صَبًّۭا","en":"(in) abundance","ur":"ڈالنا/ انڈیلنا"}]},{"k":"80:26","n":26,"id":5784,"u":"ثُمَّ شَقَقْنَا ٱلْأَرْضَ شَقًّا","juz":30,"page":585,"sajdah":false,"w":[{"u":"ثُمَّ","en":"Then","ur":"پھر"},{"u":"شَقَقْنَا","en":"We cleaved","ur":"پھاڑی ہم نے"},{"u":"ٱلْأَرْضَ","en":"the earth","ur":"زمین"},{"u":"شَقًّۭا","en":"splitting","ur":"پھاڑنا"}]},{"k":"80:27","n":27,"id":5785,"u":"فَأَنۢبَتْنَا فِيهَا حَبًّا","juz":30,"page":585,"sajdah":false,"w":[{"u":"فَأَنۢبَتْنَا","en":"Then We caused to grow","ur":"پھر اگایا ہم نے"},{"u":"فِيهَا","en":"therein","ur":"اس میں"},{"u":"حَبًّۭا","en":"grain","ur":"غلہ"}]},{"k":"80:28","n":28,"id":5786,"u":"وَعِنَبًا وَقَضْبًا","juz":30,"page":585,"sajdah":false,"w":[{"u":"وَعِنَبًۭا","en":"And grapes","ur":"اور انگور"},{"u":"وَقَضْبًۭا","en":"and green fodder","ur":"اور ترکاری"}]},{"k":"80:29","n":29,"id":5787,"u":"وَزَيْتُونًا وَنَخْلًا","juz":30,"page":585,"sajdah":false,"w":[{"u":"وَزَيْتُونًۭا","en":"