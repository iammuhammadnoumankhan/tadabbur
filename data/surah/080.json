{"n":80,"src":{"text":"qc-text","wbw":"qc-wbw"},"ayahs":[{"k":"80:1","n":1,"id":5759,"u":" عَبَسَ وَتَوَلَّىٰٓ","i":"عَبَسَ وَتَوَلّٰٓىۙ‏","juz":30,"page":585,"sajdah":false,"w":[{"u":"عَبَسَ","i":"عَبَسَ","tl":"ʿabasa","en":"He frowned","ur":"ترش رو ہوا","a":"wbw/080_001_001.mp3"},{"u":"وَتَوَلَّىٰٓ","i":"وَتَوَلّٰٓىۙ‏","tl":"watawallā","en":"and turned away","ur":"اور منہ موڑا","a":"wbw/080_001_002.mp3"}]},{"k":"80:2","n":2,"id":5760,"u":"أَن جَآءَهُ ٱلْأَعْمَىٰ","i":"اَنۡ جَآءَهُ الۡاَعۡمٰىؕ‏","juz":30,"page":585,"sajdah":false,"w":[{"u":"أَن","i":"اَنۡ","tl":"an","en":"Because","ur":"کہ","a":"wbw/080_002_001.mp3"},{"u":"جَآءَهُ","i":"جَآءَهُ","tl":"jāahu","en":"came to him","ur":"آیا اس کے پاس","a":"wbw/080_002_002.mp3"},{"u":"ٱلْأَعْمَىٰ","i":"الۡاَعۡمٰىؕ‏","tl":"l-aʿmā","en":"the blind man","ur":"اندھا","a":"wbw/080_002_003.mp3"}]},{"k":"80:3","n":3,"id":5761,"u":"وَمَا يُدْرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ","i":"وَمَا يُدۡرِيۡكَ لَعَلَّهٗ يَزَّكّٰٓىۙ‏","juz":30,"page":585,"sajdah":false,"w":[{"u":"وَمَا","i":"وَمَا","tl":"wamā","en":"But what","ur":"اور کیا چیز","a":"wbw/080_003_001.mp3"},{"u":"يُدْرِيكَ","i":"يُدۡرِيۡكَ","tl":"yud'rīka","en":"would make you know","ur":"بتائے تجھ کو","a":"wbw/080_003_002.mp3"},{"u":"لَعَلَّهُۥ","i":"لَعَلَّهٗ","tl":"laʿallahu","en":"that he might","ur":"شاید کہ وہ","a":"wbw/080_003_003.mp3"},{"u":"يَزَّكَّىٰٓ","i":"يَزَّكّٰٓىۙ‏","tl":"yazzakkā","en":"purify himself","ur":"وہ سدھر جائے/ تزکیہ پائے","a":"wbw/080_003_004.mp3"}]},{"k":"80:4","n":4,"id":5762,"u":"أَوْ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكْرَىٰٓ","i":"اَوۡ يَذَّكَّرُ فَتَنۡفَعَهُ الذِّكۡرٰىؕ‏","juz":30,"page":585,"sajdah":false,"w":[{"u":"أَوْ","i":"اَوۡ","tl":"aw","en":"Or","ur":"یا","a":"wbw/080_004_001.mp3"},{"u":"يَذَّكَّرُ","i":"يَذَّكَّرُ","tl":"yadhakkaru","en":"be reminded","ur":"نصیحت پکڑے","a":"wbw/080_004_002.mp3"},{"u":"فَتَنفَعَهُ","i":"فَتَنۡفَعَهُ","tl":"fatanfaʿahu","en":"so would benefit him","ur":"تو فائدہ دے اس کو","a":"wbw/080_004_003.mp3"},{"u":"ٱلذِّكْ