{"n":81,"src":{"text":"qc-text","wbw":"qc-wbw"},"ayahs":[{"k":"81:1","n":1,"id":5801,"u":" إِذَا ٱلشَّمْسُ كُوِّرَتْ","juz":30,"page":586,"sajdah":false,"w":[{"u":"إِذَا","en":"When","ur":"جب"},{"u":"ٱلشَّمْسُ","en":"the sun","ur":"سورج"},{"u":"كُوِّرَتْ","en":"is wrapped up","ur":"لپیٹ دیا جائے گا"}]},{"k":"81:2","n":2,"id":5802,"u":"وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتْ","juz":30,"page":586,"sajdah":false,"w":[{"u":"وَإِذَا","en":"And when","ur":"اور جب"},{"u":"ٱلنُّجُومُ","en":"the stars","ur":"تارے"},{"u":"ٱنكَدَرَتْ","en":"fall, losing their luster","ur":"گدلے ہوجائیں گے"}]},{"k":"81:3","n":3,"id":5803,"u":"وَإِذَا ٱلْجِبَالُ سُيِّرَتْ","juz":30,"page":586,"sajdah":false,"w":[{"u":"وَإِذَا","en":"And when","ur":"اور جب"},{"u":"ٱلْجِبَالُ","en":"the mountains","ur":"پہاڑ"},{"u":"سُيِّرَتْ","en":"are moved away","ur":"چلا دیئے جائیں گے"}]},{"k":"81:4","n":4,"id":5804,"u":"وَإِذَا ٱلْعِشَارُ عُطِّلَتْ","juz":30,"page":586,"sajdah":false,"w":[{"u":"وَإِذَا","en":"And when","ur":"اور جب"},{"u":"ٱلْعِشَارُ","en":"the full-term she-camels","ur":"دس مہینے کی حاملہ اونٹنیاں"},{"u":"عُطِّلَتْ","en":"(are) left untended","ur":"تنہا چھوڑ دی جائیں گی"}]},{"k":"81:5","n":5,"id":5805,"u":"وَإِذَا ٱلْوُحُوشُ حُشِرَتْ","juz":30,"page":586,"sajdah":false,"w":[{"u":"وَإِذَا","en":"And when","ur":"اور جب"},{"u":"ٱلْوُحُوشُ","en":"the wild beasts","ur":"وحشی جانور"},{"u":"حُشِرَتْ","en":"are gathered","ur":"اکٹھے کردیئے جائیں گے"}]},{"k":"81:6","n":6,"id":5806,"u":"وَإِذَا ٱلْبِحَارُ سُجِّرَتْ","juz":30,"page":586,"sajdah":false,"w":[{"u":"وَإِذَا","en":"And when","ur":"اور جب"},{"u":"ٱلْبِحَارُ","en":"the seas","ur":"سمندر"},{"u":"سُجِّرَتْ","en":"are made to overflow","ur":"بھڑکادیئے جائیں گے"}]},{"k":"81:7","n":7,"id":5807,"u":"وَإِذَا ٱلنُّفُوسُ زُوِّجَتْ","juz":30,"page":586,"sajdah":false,"w":[{"u":"وَإِذَا","en":"And when","ur":"اور جب"},{"u":"ٱلنُّفُوسُ","en":"the souls","ur":"جانیں"},{"u":"زُوِّجَتْ","en":"are paired","ur":"جوڑ دی جائیں گے"}]},{"k":"81:8","n":8,"id":5808,"u":"وَإِذَا ٱلْمَوْءُۥدَةُ سُئِلَتْ","juz":30,"page":586,"sajdah":false,"w":[{"u":"وَإِذَا","en":"And when","ur":"اور جب"},{"u":"ٱلْمَوْءُۥدَةُ","en":"the female infant buried alive","ur":"زندہ گاڑی ہوئی لڑکی"},{"u":"سُئِلَتْ","en":"is asked","ur":"پوچھی جائے گی"}]},{"k":"81:9","n":9,"id":5809,"u":"بِأَىِّ ذَنۢبٍ قُتِلَتْ","juz":30,"page":586,"sajdah":false,"w":[{"u":"بِأَىِّ","en":"For what","ur":"کس"},{"u":"ذَنۢبٍۢ","en":"sin","ur":"گناہ میں"},{"u":"قُتِلَتْ","en":"she was killed","ur":"ماری گئی"}]},{"k":"81:10","n":10,"id":5810,"u":"وَإِذَا ٱلصُّحُفُ نُشِرَتْ","juz":30,"page":586,"sajdah":false,"w":[{"u":"وَإِذَا","en":"And when","ur":"اور جب"},{"u":"ٱلصُّحُفُ","en":"the pages","ur":"اعمال نامے"},{"u":"نُشِرَتْ","en":"are laid open","ur":"پھیلادیئے جائیں گے"}]},{"k":"81:11","n":11,"id":5811,"u":"وَإِذَا ٱلسَّمَآءُ كُشِطَتْ","juz":30,"page":586,"sajdah":false,"w":[{"u":"وَإِذَا","en":"And when","ur":"اور جب"},{"u":"ٱلسَّمَآءُ","en":"the sky","ur":"آسمان"},{"u":"كُشِطَتْ","en":"is stripped away","ur":"اس کی کھال اتار دی جائے گی"}]},{"k":"81:12","n":12,"id":5812,"u":"وَإِذَا ٱلْجَحِيمُ سُعِّرَتْ","juz":30,"page":586,"sajdah":false,"w":[{"u":"وَإِذَا","en":"And when","ur":"اور جب"},{"u":"ٱلْجَحِيمُ","en":"the Hellfire","ur":"جہنم"},{"u":"سُعِّرَتْ","en":"is set ablaze","ur":"بھڑکا دی جائے گی"}]},{"k":"81:13","n":13,"id":5813,"u":"وَإِذَا ٱلْجَنَّةُ أُزْلِفَتْ","juz":30,"page":586,"sajdah":false,"w":[{"u":"وَإِذَا","en":"And when","ur":"اور جب"},{"u":"ٱلْجَنَّةُ","en":"Paradise","ur":"جنت"},{"u":"أُزْلِفَتْ","en":"is brought near","ur":"قریب لے آئی جائے گی"}]},{"k":"81:14","n":14,"id":5814,"u":"عَلِمَتْ نَفْسٌ مَّآ أَحْضَرَتْ","juz":30,"page":586,"sajdah":false,"w":[{"u":"عَلِمَتْ","en":"Will know","ur":"جان لے گا"},{"u":"نَفْسٌۭ","en":"a soul","ur":"ہر نفس"},{"u":"مَّآ","en":"what","ur":"کیا"},{"u":"أَحْضَرَتْ","en":"it has brought","ur":"اس نے حاضر کیا/ کیا لے کر آیا"}]},{"k":"81:15","n":15,"id":5815,"u":"فَلَآ أُقْسِمُ بِٱلْخُنَّسِ","juz":30,"page":586,"sajdah":false,"w":[{"u":"فَلَآ","en":"But nay","ur":"پس نہیں"},{"u":"أُقْسِمُ","en":"I swear","ur":"میں قسم کھاتا ہوں"},{"u":"بِٱلْخُنَّسِ","en":"by the retreating planets","ur":"پیچھے ہٹنے والے کی"}]},{"k":"81:16","n":16,"id":5816,"u":"ٱلْجَوَارِ ٱلْكُنَّسِ","juz":30,"page":586,"sajdah":false,"w":[{"u":"ٱلْجَوَارِ","en":"Those that run","ur":"سیدھے چلنے والے"},{"u":"ٱلْكُنَّسِ","en":"(and) disappear","ur":"چھپ جانے والے (ستاروں کی)"}]},{"k":"81:17","n":17,"id":5817,"u":"وَٱلَّيْلِ إِذَا عَسْعَسَ","juz":30,"page":586,"sajdah":false,"w":[{"u":"وَٱلَّيْلِ","en":"And the night","ur":"اور رات کی"},{"u":"إِذَا","en":"when","ur":"جب"},{"u":"عَسْعَسَ","en":"it departs","ur":"وہ رخصت ہوتی ہے"}]},{"k":"81:18","n":18,"id":5818,"u":"وَٱلصُّبْحِ إِذَا تَنَفَّسَ","juz":30,"page":586,"sajdah":false,"w":[{"u":"وَٱلصُّبْحِ","en":"And the dawn","ur":"اور صبح کی"},{"u":"إِذَا","en":"when","ur":"جب"},{"u":"تَنَفَّسَ","en":"it breathes","ur":"وہ سانس لیتی ہے"}]},{"k":"81:19","n":19,"id":5819,"u":"إِنَّهُۥ لَقَوْلُ رَسُولٍ كَرِيمٍ","juz":30,"page":586,"sajdah":false,"w":[{"u":"إِنَّهُۥ","en":"Indeed, it","ur":"بیشک وہ"},{"u":"لَقَوْلُ","en":"(is) surely a word","ur":"البتہ قول ہے/ کہنا ہے"},{"u":"رَسُولٍۢ","en":"(of) a Messenger","ur":"ایک پیام بر کا"},{"u":"كَرِيمٍۢ","en":"noble","ur":"معزز کا"}]},{"k":"81:20","n":20,"id":5820,"u":"ذِى قُوَّةٍ عِندَ ذِى ٱلْعَرْشِ مَكِينٍ","juz":30,"page":586,"sajdah":false,"w":[{"u":"ذِى","en":"Possessor of","ur":"والا ہے"},{"u":"قُوَّةٍ","en":"power","ur":"قوت کا"},{"u":"عِندَ","en":"with","ur":"نزدیک"},{"u":"ذِى","en":"(the) Owner of","ur":"والے کے"},{"u":"ٱلْعَرْشِ","en":"the Throne","ur":"عرش (والے کے )"},{"u":"مَكِينٍۢ","en":"secure","ur":"بلند مرتبے والا"}]},{"k":"81:21","n":21,"id":5821,"u":"مُّطَاعٍ ثَمَّ أَمِينٍ","juz":30,"page":586,"sajdah":false,"w":[{"u":"مُّطَاعٍۢ","en":"One to be obeyed","ur":"کہا مانا گیا"},{"u":"ثَمَّ","en":"and","ur":"اس جگہ"},{"u":"أَمِينٍۢ","en":"trustworthy","ur":"امانت دار ہے"}]},{"k":"81:22","n":22,"id":5822,"u":"وَمَا صَاحِبُكُم بِمَجْنُونٍ","juz":30,"page":586,"sajdah":false,"w":[{"u":"وَمَا","en":"And not","ur":"اور نہیں"},{"u":"صَاحِبُكُم","en":"(is) your companion","ur":"ساتھ تمہارا"},{"u":"بِمَجْنُونٍۢ","en":"mad","ur":"کوئی مجنون"}]},{"k":"81:23","n":23,"id":5823,"u":"وَلَقَدْ رَءَاهُ بِٱلْأُفُقِ ٱلْمُبِينِ","juz":30,"page":586,"sajdah":false,"w":[{"u":"وَلَقَدْ","en":"And certainly","ur":"اور البتہ تحقیق"},{"u":"رَءَاهُ","en":"he saw him","ur":"اس نے دیکھا اس کو"},{"u":"بِٱلْأُفُقِ","en":"in the horizon","ur":"آسمان کے کنارے پر"},{"u":"ٱلْمُبِينِ","en":"the clear","ur":"کھلے"}]},{"k":"81:24","n":24,"id":5824,"u":"وَمَا هُوَ عَلَى ٱلْغَيْبِ بِضَنِينٍ","juz":30,"page":586,"sajdah":false,"w":[{"u":"وَمَا","en":"And not","ur":"اور نہیں"},{"u":"هُوَ","en":"he (is)","ur":"وہ"},{"u":"عَلَى","en":"on","ur":"پر"},{"u":"ٱلْغَيْبِ","en":"the unseen","ur":"غیب"},{"u":"بِضَنِينٍۢ","en":"a withholder","ur":"ہرگز بخیل"}]},{"k":"81:25","n":25,"id":5825,"u":"وَمَا هُوَ بِقَوْلِ شَيْطَـٰنٍ رَّجِيمٍ","juz":30,"page":586,"sajdah":false,"w":[{"u":"وَمَا","en":"And not","ur":"اور نہیں ہے"},{"u":"هُوَ","en":"it","ur":"وہ"},{"u":"بِقَوْلِ","en":"(is the) word","ur":"قول"},{"u":"شَيْطَـٰنٍۢ","en":"(of) Shaitaan","ur":"شیطان"},{"u":"رَّجِيمٍۢ","en":"accursed","ur":"مردود کا"}]},{"k":"81:26","n":26,"id":5826,"u":"فَأَيْنَ تَذْهَبُونَ","juz":30,"page":586,"sajdah":false,"w":[{"u":"فَأَيْنَ","en":"So where","ur":"پھر کدھر"},{"u":"تَذْهَبُونَ","en":"are you going","ur":"تم جارہے ہو"}]},{"k":"81:27","n":27,"id":5827,"u":"إِنْ هُوَ إِلَّا ذِكْرٌ لِّلْعَـٰلَمِينَ","juz":30,"page":586,"sajdah":false,"w":[{"u":"إِنْ","en":"Not","ur":"نہیں"},{"u":"هُوَ","en":"it","ur":"وہ"},{"u":"إِلَّا","en":"(is) except","ur":"مگر"},{"u":"ذِكْرٌۭ","en":"a reminder","ur":"ایک نصیحت ہے"},{"u":"لِّلْعَـٰلَمِينَ","en":"to the worlds","ur":"جہان والوں کے لئے"}]},{"k":"81:28","n":28,"id":5828,"u":"لِمَن شَآءَ مِنكُمْ أَن يَسْتَقِيمَ","juz":30,"page":586,"sajdah":false,"w":[{"u":"لِمَن","en":"For whoever","ur":"واسطے اس کو"},{"u":"شَآءَ","en":"wills","ur":"جو چاہے"},{"u":"مِنكُمْ","en":"among you","ur":"تم میں سے"},{"u":"أَن","en":"to","ur":"کہ"},{"u":"يَسْتَقِيمَ","en":"take a straight way","ur":"راہ راست پر چلے"}]},{"k":"81:29","n":29,"id":5829,"u":"وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلْعَـٰلَمِينَ","juz":30,"page":586,"sajdah":false,"w":[{"u":"وَمَا","en":"And not","ur":"اور نہیں"},{"u":"تَشَآءُونَ","en":"you will","ur":"تم چاہ سکتے"},{"u":"إِلَّآ","en":"except","ur":"مگر"},{"u":"أَن","en":"that","ur":"یہ کہ"},{"u":"يَشَآءَ","en":"wills","ur":"چاہے"},{"u":"ٱللَّهُ","en":"Allah","ur":"اللہ"},{"u":"رَبُّ","en":"Lord","ur":"جو رب ہے"},{"u":"ٱلْعَـٰلَمِينَ","en":"(of) the worlds","ur":"سارے جہان والوں کا"}]}]}