{"n":82,"src":{"text":"qc-text","wbw":"qc-wbw"},"ayahs":[{"k":"82:1","n":1,"id":5830,"u":" إِذَا ٱلسَّمَآءُ ٱنفَطَرَتْ","juz":30,"page":587,"sajdah":false,"w":[{"u":"إِذَا","en":"When","ur":"جب"},{"u":"ٱلسَّمَآءُ","en":"the sky","ur":"آسمان"},{"u":"ٱنفَطَرَتْ","en":"(is) cleft asunder","ur":"پھٹ جائے گا"}]},{"k":"82:2","n":2,"id":5831,"u":"وَإِذَا ٱلْكَوَاكِبُ ٱنتَثَرَتْ","juz":30,"page":587,"sajdah":false,"w":[{"u":"وَإِذَا","en":"And when","ur":"اور جب"},{"u":"ٱلْكَوَاكِبُ","en":"the stars","ur":"تارے"},{"u":"ٱنتَثَرَتْ","en":"scatter","ur":"بکھرجائیں گے"}]},{"k":"82:3","n":3,"id":5832,"u":"وَإِذَا ٱلْبِحَارُ فُجِّرَتْ","juz":30,"page":587,"sajdah":false,"w":[{"u":"وَإِذَا","en":"And when","ur":"اور جب"},{"u":"ٱلْبِحَارُ","en":"the seas","ur":"سمندر"},{"u":"فُجِّرَتْ","en":"are made to gush forth","ur":"پھاڑ دیئے جائیں گے"}]},{"k":"82:4","n":4,"id":5833,"u":"وَإِذَا ٱلْقُبُورُ بُعْثِرَتْ","juz":30,"page":587,"sajdah":false,"w":[{"u":"وَإِذَا","en":"And when","ur":"اور جب"},{"u":"ٱلْقُبُورُ","en":"the graves","ur":"قبریں"},{"u":"بُعْثِرَتْ","en":"are overturned","ur":"کھول دی جائیں گی"}]},{"k":"82:5","n":5,"id":5834,"u":"عَلِمَتْ نَفْسٌ مَّا قَدَّمَتْ وَأَخَّرَتْ","juz":30,"page":587,"sajdah":false,"w":[{"u":"عَلِمَتْ","en":"Will know","ur":"جان لے گا"},{"u":"نَفْسٌۭ","en":"a soul","ur":"ہر شخص"},{"u":"مَّا","en":"what","ur":"جو"},{"u":"قَدَّمَتْ","en":"it has sent forth","ur":"اس نے آگے بھیجا"},{"u":"وَأَخَّرَتْ","en":"and left behind","ur":"اور جو پیچھے رکھا"}]},{"k":"82:6","n":6,"id":5835,"u":"يَـٰٓأَيُّهَا ٱلْإِنسَـٰنُ مَا غَرَّكَ بِرَبِّكَ ٱلْكَرِيمِ","juz":30,"page":587,"sajdah":false,"w":[{"u":"يَـٰٓأَيُّهَا","en":"O","ur":"اے"},{"u":"ٱلْإِنسَـٰنُ","en":"man","ur":"انسان"},{"u":"مَا","en":"What","ur":"کس چیز نے"},{"u":"غَرَّكَ","en":"has deceived you","ur":"دھوکے میں ڈالا تجھ کو"},{"u":"بِرَبِّكَ","en":"concerning your Lord","ur":"تیرے رب"},{"u":"ٱلْكَرِيمِ","en":"the Most Noble","ur":"کریم کے بارے میں"}]},{"k":"82:7","n":7,"id":5836,"u":"ٱلَّذِى خَلَقَكَ ف