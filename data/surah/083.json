{"n":83,"src":{"text":"qc-text","wbw":"qc-wbw"},"ayahs":[{"k":"83:1","n":1,"id":5849,"u":" وَيْلٌ لِّلْمُطَفِّفِينَ","i":"وَيۡلٌ لِّلۡمُطَفِّفِيۡنَۙ‏","juz":30,"page":587,"sajdah":false,"w":[{"u":"وَيْلٌۭ","i":"وَيۡلٌ","tl":"waylun","en":"Woe","ur":"ہلاکت ہے","a":"wbw/083_001_001.mp3"},{"u":"لِّلْمُطَفِّفِينَ","i":"لِّلۡمُطَفِّفِيۡنَۙ‏","tl":"lil'muṭaffifīna","en":"to those who give less","ur":"ڈنڈی مارنے والوں کے لئے","a":"wbw/083_001_002.mp3"}]},{"k":"83:2","n":2,"id":5850,"u":"ٱلَّذِينَ إِذَا ٱكْتَالُوا۟ عَلَى ٱلنَّاسِ يَسْتَوْفُونَ","i":"الَّذِيۡنَ اِذَا اكۡتَالُوۡا عَلَى النَّاسِ يَسۡتَوۡفُوۡنَۖ‏","juz":30,"page":587,"sajdah":false,"w":[{"u":"ٱلَّذِينَ","i":"الَّذِيۡنَ","tl":"alladhīna","en":"Those who","ur":"وہ لوگ","a":"wbw/083_002_001.mp3"},{"u":"إِذَا","i":"اِذَا","tl":"idhā","en":"when","ur":"جب","a":"wbw/083_002_002.mp3"},{"u":"ٱكْتَالُوا۟","i":"اكۡتَالُوۡا","tl":"ik'tālū","en":"they take a measure","ur":"ناپ کرلیتے ہیں","a":"wbw/083_002_003.mp3"},{"u":"عَلَى","i":"عَلَى","tl":"ʿalā","en":"from","ur":"","a":"wbw/083_002_004.mp3"},{"u":"ٱلنَّاسِ","i":"النَّاسِ","tl":"l-nāsi","en":"the people","ur":"لوگوں سے","a":"wbw/083_002_005.mp3"},{"u":"يَسْتَوْفُونَ","i":"يَسۡتَوۡفُوۡنَۖ‏","tl":"yastawfūna","en":"they take in full","ur":"وہ پورا پورا لیتے ہیں","a":"wbw/083_002_006.mp3"}]},{"k":"83:3","n":3,"id":5851,"u":"وَإِذَا كَالُوهُمْ أَو وَّزَنُوهُمْ يُخْسِرُونَ","i":"وَاِذَا كَالُوۡهُمۡ اَوْ وَّزَنُوۡهُمۡ يُخۡسِرُوۡنَؕ‏","juz":30,"page":587,"sajdah":false,"w":[{"u":"وَإِذَا","i":"وَاِذَا","tl":"wa-idhā","en":"But when","ur":"اور جب","a":"wbw/083_003_001.mp3"},{"u":"كَالُوهُمْ","i":"كَالُوۡهُمۡ","tl":"kālūhum","en":"they give by measure (to) them","ur":"ناپ کر ان کو دیتے ہیں","a":"wbw/083_003_002.mp3"},{"u":"أَو","i":"اَوْ","tl":"aw","en":"or","ur":"یا","a":"wbw/083_003_003.mp3"},{"u":"وَّزَنُوهُمْ","i":"وَّزَنُوۡهُمۡ","tl":"wazanūhum","en":"they weigh (for) them","ur":"وزن کرکے دیتے ہیں ان کو","a":"wbw/083_003_004.mp3"},{"u":"يُخْسِرُونَ","i":"يُخۡسِرُوۡنَؕ‏","tl":"yukh'sirūna","en":"they give less","ur":"گھاٹا کرکے دیتے ہیں/ کم کرکے دیتے ہیں","a":"wbw/083_003_005.mp3"}]},{"k":"83:4","n":4,"id":5852,"u":"أَلَا يَظُنُّ أُو۟لَـٰٓئِكَ أَنَّهُم مَّبْعُوثُونَ","i":"اَلَا يَظُنُّ اُولٰٓٮِٕكَ اَنَّهُمۡ مَّبۡعُوۡثُوۡنَۙ‏","juz":30,"page":587,"sajdah":false,"w":[{"u":"أَلَا","i":"اَلَا","tl":"alā","en":"Do not","ur":"کیا وہ نہیں","a":"wbw/083_004_001.mp3"},{"u":"يَظُنُّ","i":"يَظُنُّ","tl":"yaẓunnu","en":"think","ur":"سمجھتے / کیا وہ یقین  (نہیں) رکھتے","a":"wbw/083_004_002.mp3"},{"u":"أُو۟لَـٰٓئِكَ","i":"اُولٰٓٮِٕكَ","tl":"ulāika","en":"those","ur":"یہ لوگ","a":"wbw/083_004_003.mp3"},{"u":"أَنَّهُم","i":"اَنَّهُمۡ","tl":"annahum","en":"that they","ur":"بیشک وہ","a":"wbw/083_004_004.mp3"},{"u":"مَّبْعُوثُونَ","i":"مَّبۡعُوۡثُوۡنَۙ‏","tl":"mabʿūthūna","en":"(will be) resurrected","ur":"اٹھائے جانے والے ہیں","a":"wbw/083_004_005.mp3"}]},{"k":"83:5","n":5,"id":5853,"u":"لِيَوْمٍ عَظِيمٍ","i":"لِيَوۡمٍ عَظِيۡمٍۙ‏","juz":30,"page":588,"sajdah":false,"w":[{"u":"لِيَوْمٍ","i":"لِيَوۡمٍ","tl":"liyawmin","en":"For a Day","ur":"دن کو","a":"wbw/083_005_001.mp3"},{"u":"عَظِيمٍۢ","i":"عَظِيۡمٍۙ‏","tl":"ʿaẓīmin","en":"Great","ur":"بڑے","a":"wbw/083_005_002.mp3"}]},{"k":"83:6","n":6,"id":5854,"u":"يَوْمَ يَقُومُ ٱلنَّاسُ لِرَبِّ ٱلْعَـٰلَمِينَ","i":"يَّوۡمَ يَقُوۡمُ النَّاسُ لِرَبِّ الۡعٰلَمِيۡنَؕ‏","juz":30,"page":588,"sajdah":false,"w":[{"u":"يَوْمَ","i":"يَّوۡمَ","tl":"yawma","en":"(The) Day","ur":"جس دن","a":"wbw/083_006_001.mp3"},{"u":"يَقُومُ","i":"يَقُوۡمُ","tl":"yaqūmu","en":"will stand","ur":"کھڑے ہوں گے","a":"wbw/083_006_002.mp3"},{"u":"ٱلنَّاسُ","i":"النَّاسُ","tl":"l-nāsu","en":"mankind","ur":"لوگ","a":"wbw/083_006_003.mp3"},{"u":"لِرَبِّ","i":"لِرَبِّ","tl":"lirabbi","en":"before (the) Lord","ur":"رب کے لیے","a":"wbw/083_006_004.mp3"},{"u":"ٱلْعَـٰلَمِينَ","i":"الۡعٰلَمِيۡنَؕ‏","tl":"l-ʿālamīna","en":"(of) the worlds","ur":"رب العالمین کے لئے","a":"wbw/083_006_005.mp3"}]},{"k":"83:7","n":7,"id":5855,"u":"كَلَّآ إِنَّ كِتَـٰبَ ٱلْ