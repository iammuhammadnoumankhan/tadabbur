{"n":84,"src":{"text":"qc-text","wbw":"qc-wbw"},"ayahs":[{"k":"84:1","n":1,"id":5885,"u":" إِذَا ٱلسَّمَآءُ ٱنشَقَّتْ","juz":30,"page":589,"sajdah":false,"w":[{"u":"إِذَا","en":"When","ur":"جب"},{"u":"ٱلسَّمَآءُ","en":"the sky","ur":"آسمان"},{"u":"ٱنشَقَّتْ","en":"is split asunder","ur":"پھٹ جائے گا"}]},{"k":"84:2","n":2,"id":5886,"u":"وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ","juz":30,"page":589,"sajdah":false,"w":[{"u":"وَأَذِنَتْ","en":"And has listened","ur":"اور کان لگائے گا"},{"u":"لِرَبِّهَا","en":"to its Lord","ur":"اپنے رب کے لئے"},{"u":"وَحُقَّتْ","en":"and was obligated","ur":"اور حق یہی ہے/ یہی حق دیا گیا ہے"}]},{"k":"84:3","n":3,"id":5887,"u":"وَإِذَا ٱلْأَرْضُ مُدَّتْ","juz":30,"page":589,"sajdah":false,"w":[{"u":"وَإِذَا","en":"And when","ur":"اور جب"},{"u":"ٱلْأَرْضُ","en":"the earth","ur":"زمین"},{"u":"مُدَّتْ","en":"is spread","ur":"پھیلادی جائے گی"}]},{"k":"84:4","n":4,"id":5888,"u":"وَأَلْقَتْ مَا فِيهَا وَتَخَلَّتْ","juz":30,"page":589,"sajdah":false,"w":[{"u":"وَأَلْقَتْ","en":"And has cast out","ur":"اور ڈال دی جائے گی"},{"u":"مَا","en":"what","ur":"جو"},{"u":"فِيهَا","en":"(is) in it","ur":"اس میں ہے"},{"u":"وَتَخَلَّتْ","en":"and becomes empty","ur":"اور خالی ہوجائے گی"}]},{"k":"84:5","n":5,"id":5889,"u":"وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ","juz":30,"page":589,"sajdah":false,"w":[{"u":"وَأَذِنَتْ","en":"And has listened","ur":"اور کان لگائے گی"},{"u":"لِرَبِّهَا","en":"to its Lord","ur":"اپنے رب کے لئے"},{"u":"وَحُقَّتْ","en":"and was obligated","ur":"اور حق یہی ہے/ یہی حق دی گئی ہے"}]},{"k":"84:6","n":6,"id":5890,"u":"يَـٰٓأَيُّهَا ٱلْإِنسَـٰنُ إِنَّكَ كَادِحٌ إِلَىٰ رَبِّكَ كَدْحًا فَمُلَـٰقِيهِ","juz":30,"page":589,"sajdah":false,"w":[{"u":"يَـٰٓأَيُّهَا","en":"O","ur":"اے"},{"u":"ٱلْإِنسَـٰنُ","en":"mankind","ur":"انسان"},{"u":"إِنَّكَ","en":"Indeed, you","ur":"بیشک"},{"u":"كَادِحٌ","en":"(are) laboring","ur":"تو محنت کرنے والا ہے"},{"u":"إِلَىٰ","en":"to","ur":"طرف"},{"u":"رَبِّكَ","en":"your Lord","ur":"اپنے رب کی"},{"u":"كَدْحًۭا","en":"(with) exertion","ur":"خوب محنت"},{"u":"فَمُلَـٰقِيهِ","en":"and you (will) meet Him","ur":"پھر ملنے والا ہے اس سے"}]},{"k":"84:7","n":7,"id":5891,"u":"فَأَمَّا مَنْ أُوتِىَ كِتَـٰبَهُۥ بِيَمِينِهِۦ","juz":30,"page":589,"sajdah":false,"w":[{"u":"فَأَمَّا","en":"Then as for","ur":"تو رہا"},{"u":"مَنْ","en":"(him) who","ur":"وہ جو"},{"u":"أُوتِىَ","en":"is given","ur":"دیا گیا"},{"u":"كِتَـٰبَهُۥ","en":"his record","ur":"کتاب اپنی"},{"u":"بِيَمِينِهِۦ","en":"in his right (hand)","ur":"اپنے دائیں ہاتھ میں"}]},{"k":"84:8","n":8,"id":5892,"u":"فَسَوْفَ يُحَاسَبُ حِسَابًا يَسِيرًا","juz":30,"page":589,"sajdah":false,"w":[{"u":"فَسَوْفَ","en":"Then soon","ur":"تو عنقریب"},{"u":"يُحَاسَبُ","en":"his account will be taken","ur":"حساب کیا جائے گا وہ"},{"u":"حِسَابًۭا","en":"an account","ur":"حساب"},{"u":"يَسِيرًۭا","en":"easy","ur":"آسان"}]},{"k":"84:9","n":9,"id":5893,"u":"وَيَنقَلِبُ إِلَىٰٓ أَهْلِهِۦ مَسْرُورًا","juz":30,"page":589,"sajdah":false,"w":[{"u":"وَيَنقَلِبُ","en":"And he will return","ur":"اور وہ لوٹے گا"},{"u":"إِلَىٰٓ","en":"to","ur":"طرف"},{"u":"أَهْلِهِۦ","en":"his people","ur":"اپنے گھر والوں کی (طرف)"},{"u":"مَسْرُورًۭا","en":"happily","ur":"خوش"}]},{"k":"84:10","n":10,"id":5894,"u":"وَأَمَّا مَنْ أُوتِىَ كِتَـٰبَهُۥ وَرَآءَ ظَهْرِهِۦ","juz":30,"page":589,"sajdah":false,"w":[{"u":"وَأَمَّا","en":"But as for","ur":"اور رہا"},{"u":"مَنْ","en":"(him) who","ur":"وہ جو"},{"u":"أُوتِىَ","en":"is given","ur":"دیا گیا"},{"u":"كِتَـٰبَهُۥ","en":"his record","ur":"اپنی کتاب/ نامہ اعمال"},{"u":"وَرَآءَ","en":"behind","ur":"پیچھے"},{"u":"ظَهْرِهِۦ","en":"his back","ur":"اپنی پیٹھ کے"}]},{"k":"84:11","n":11,"id":5895,"u":"فَسَوْفَ يَدْعُوا۟ ثُبُورًا","juz":30,"page":589,"sajdah":false,"w":[{"u":"فَسَوْفَ","en":"Then soon","ur":"تو عنقریب"},{"u":"يَدْعُوا۟","en":"he will call","ur":"بلائے گا"},{"u":"ثُبُورًۭا","en":"(for) destruction","ur":"ہلاکت کو"}]},{"k":"84:12","n":12,"id":5896,"u":"وَيَصْلَىٰ سَعِيرًا","juz":30,"page":589,"sajdah":false,"w":[{"u":"وَيَصْلَىٰ","en":"And he will burn","ur":"اور داخل ہوگا"},{"u":"سَعِيرًا","en":"(in) a Blaze","ur":"بھڑکتی آگ میں"}]},{"k":"84:13","n":13,"id":5897,"u":"إِنَّهُۥ كَانَ فِىٓ أَهْلِهِۦ مَسْرُورًا","juz":30,"page":589,"sajdah":false,"w":[{"u":"إِنَّهُۥ","en":"Indeed, he","ur":"بیشک وہ"},{"u":"كَانَ","en":"had been","ur":"تھا"},{"u":"فِىٓ","en":"among","ur":"میں"},{"u":"أَهْلِهِۦ","en":"his people","ur":"اپنے گھر والوں (میں )"},{"u":"مَسْرُورًا","en":"happy","ur":"مسرور/ خوش"}]},{"k":"84:14","n":14,"id":5898,"u":"إِنَّهُۥ ظَنَّ أَن لَّن يَحُورَ","juz":30,"page":589,"sajdah":false,"w":[{"u":"إِنَّهُۥ","en":"Indeed, he","ur":"بیشک وہ"},{"u":"ظَنَّ","en":"(had) thought","ur":"سمجھتا تھا"},{"u":"أَن","en":"that","ur":"کہ"},{"u":"لَّن","en":"never","ur":"ہرگز نہیں"},{"u":"يَحُورَ","en":"he would return","ur":"وہ لوٹے گا"}]},{"k":"84:15","n":15,"id":5899,"u":"بَلَىٰٓ إِنَّ رَبَّهُۥ كَانَ بِهِۦ بَصِيرًا","juz":30,"page":589,"sajdah":false,"w":[{"u":"بَلَىٰٓ","en":"Yes","ur":"کیوں نہیں"},{"u":"إِنَّ","en":"Indeed","ur":"بیشک"},{"u":"رَبَّهُۥ","en":"his Lord","ur":"اس کا رب"},{"u":"كَانَ","en":"was","ur":"تھا"},{"u":"بِهِۦ","en":"of him","ur":"اس کو"},{"u":"بَصِيرًۭا","en":"All-Seer","ur":"دیکھنے والا"}]},{"k":"84:16","n":16,"id":5900,"u":"فَلَآ أُقْسِمُ بِٱلشَّفَقِ","juz":30,"page":589,"sajdah":false,"w":[{"u":"فَلَآ","en":"But nay","ur":"پس نہیں"},{"u":"أُقْسِمُ","en":"I swear","ur":"میں قسم کھاتا ہوں"},{"u":"بِٱلشَّفَقِ","en":"by the twilight glow","ur":"شفق کی"}]},{"k":"84:17","n":17,"id":5901,"u":"وَٱلَّيْلِ وَمَا وَسَقَ","juz":30,"page":589,"sajdah":false,"w":[{"u":"وَٱلَّيْلِ","en":"And the night","ur":"اور رات کی"},{"u":"وَمَا","en":"and what","ur":"اور اس کی جو"},{"u":"وَسَقَ","en":"it envelops","ur":"وہ اکٹھا کرے/ سمیٹ لے"}]},{"k":"84:18","n":18,"id":5902,"u":"وَٱلْقَمَرِ إِذَا ٱتَّسَقَ","juz":30,"page":589,"sajdah":false,"w":[{"u":"وَٱلْقَمَرِ","en":"And the moon","ur":"اور چاند کی"},{"u":"إِذَا","en":"when","ur":"جب"},{"u":"ٱتَّسَقَ","en":"it becomes full","ur":"وہ پورا ہو جائے"}]},{"k":"84:19","n":19,"id":5903,"u":"لَتَرْكَبُنَّ طَبَقًا عَن طَبَقٍ","juz":30,"page":589,"sajdah":false,"w":[{"u":"لَتَرْكَبُنَّ","en":"You will surely embark","ur":"البتہ تم ضرور سوار ہوگے"},{"u":"طَبَقًا","en":"(to) stage","ur":"ایک حالت پر"},{"u":"عَن","en":"from","ur":"سے"},{"u":"طَبَقٍۢ","en":"stage","ur":"دوسری حالت(سے)"}]},{"k":"84:20","n":20,"id":5904,"u":"فَمَا لَهُمْ لَا يُؤْمِنُونَ","juz":30,"page":589,"sajdah":false,"w":[{"u":"فَمَا","en":"So what","ur":"پس کیا ہے"},{"u":"لَهُمْ","en":"(is) for them","ur":"ان کو"},{"u":"لَا","en":"not","ur":"نہیں"},{"u":"يُؤْمِنُونَ","en":"they believe","ur":"وہ ایمان لاتے"}]},{"k":"84:21","n":21,"id":5905,"u":"وَإِذَا قُرِئَ عَلَيْهِمُ ٱلْقُرْءَانُ لَا يَسْجُدُونَ ۩","juz":30,"page":589,"sajdah":true,"w":[{"u":"وَإِذَا","en":"And when","ur":"اور جب"},{"u":"قُرِئَ","en":"is recited","ur":"پڑھا جاتا ہے"},{"u":"عَلَيْهِمُ","en":"to them","ur":"ان پر"},{"u":"ٱلْقُرْءَانُ","en":"the Quran","ur":"قرآن"},{"u":"لَا","en":"not","ur":"نہیں"},{"u":"يَسْجُدُونَ ۩","en":"they prostrate","ur":"وہ سجدہ  کرتے"}]},{"k":"84:22","n":22,"id":5906,"u":"بَلِ ٱلَّذِينَ كَفَرُوا۟ يُكَذِّبُونَ","juz":30,"page":589,"sajdah":false,"w":[{"u":"بَلِ","en":"Nay","ur":"بلکہ"},{"u":"ٱلَّذِينَ","en":"Those who","ur":"وہ لوگ"},{"u":"كَفَرُوا۟","en":"disbelieved","ur":"جنہوں نے کفر کیا"},{"u":"يُكَذِّبُونَ","en":"deny","ur":"وہ جھٹلاتے ہیں"}]},{"k":"84:23","n":23,"id":5907,"u":"وَٱللَّهُ أَعْلَمُ بِمَا يُوعُونَ","juz":30,"page":589,"sajdah":false,"w":[{"u":"وَٱللَّهُ","en":"And Allah","ur":"اور اللہ"},{"u":"أَعْلَمُ","en":"(is) most knowing","ur":"خوب جانتا ہے"},{"u":"بِمَا","en":"of what","ur":"ساتھ اس کے جو"},{"u":"يُوعُونَ","en":"they keep within themselves","ur":"وہ سمیٹ رہے ہیں"}]},{"k":"84:24","n":24,"id":5908,"u":"فَبَشِّرْهُم بِعَذَابٍ أَلِيمٍ","juz":30,"page":589,"sajdah":false,"w":[{"u":"فَبَشِّرْهُم","en":"so give them tidings","ur":"پس خوش خبری دے دیجئے  ان کو"},{"u":"بِعَذَابٍ","en":"of a punishment","ur":"عذاب"},{"u":"أَلِيمٍ","en":"painful","ur":"درد ناک کی"}]},{"k":"84:25","n":25,"id":5909,"u":"إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ لَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍۭ","juz":30,"page":590,"sajdah":false,"w":[{"u":"إِلَّا","en":"Except","ur":"سوائے"},{"u":"ٱلَّذِينَ","en":"those who","ur":"ان لوگوں کے"},{"u":"ءَامَنُوا۟","en":"believe","ur":"جو ایمان لائے"},{"u":"وَعَمِلُوا۟","en":"and do","ur":"اور انہوں نے عمل کئے"},{"u":"ٱلصَّـٰلِحَـٰتِ","en":"righteous deeds","ur":"اچھے"},{"u":"لَهُمْ","en":"For them","ur":"ان کے لئے"},{"u":"أَجْرٌ","en":"(is) a reward","ur":"اجر ہے"},{"u":"غَيْرُ","en":"never","ur":"نہ"},{"u":"مَمْنُونٍۭ","en":"ending","ur":"ختم ہونے والا"}]}]}