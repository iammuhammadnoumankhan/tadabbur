w/085_008_001.mp3"},{"u":"نَقَمُوا۟","i":"نَقَمُوۡا","tl":"naqamū","en":"they resented","ur":"وہ ناراض ہوئے","a":"wbw/085_008_002.mp3"},{"u":"مِنْهُمْ","i":"مِنۡهُمۡ","tl":"min'hum","en":"[of] them","ur":"ان سے","a":"wbw/085_008_003.mp3"},{"u":"إِلَّآ","i":"اِلَّاۤ","tl":"illā","en":"except","ur":"مگر","a":"wbw/085_008_004.mp3"},{"u":"أَن","i":"اَنۡ","tl":"an","en":"that","ur":"یہ کہ","a":"wbw/085_008_005.mp3"},{"u":"يُؤْمِنُوا۟","i":"يُّؤۡمِنُوۡا","tl":"yu'minū","en":"they believed","ur":"وہ ایمان لائے","a":"wbw/085_008_006.mp3"},{"u":"بِٱللَّهِ","i":"بِاللّٰهِ","tl":"bil-lahi","en":"in Allah","ur":"اللہ پر","a":"wbw/085_008_007.mp3"},{"u":"ٱلْعَزِيزِ","i":"الۡعَزِيۡزِ","tl":"l-ʿazīzi","en":"the All-Mighty","ur":"جو زبردست ہے","a":"wbw/085_008_008.mp3"},{"u":"ٱلْحَمِيدِ","i":"الۡحَمِيۡدِۙ‏ ﻿﻿","tl":"l-ḥamīdi","en":"the Praiseworthy","ur":"تعریف والا ہے","a":"wbw/085_008_009.mp3"}]},{"k":"85:9","n":9,"id":5918,"u":"ٱلَّذِى لَهُۥ مُلْكُ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۚ وَٱللَّهُ عَلَىٰ كُلِّ شَىْءٍ شَهِيدٌ","i":"الَّذِىۡ لَهٗ مُلۡكُ السَّمٰوٰتِ وَالۡاَرۡضِ​ؕ وَ اللّٰهُ عَلٰى كُلِّ شَىۡءٍ شَهِيۡدٌ ؕ‏","juz":30,"page":590,"sajdah":false,"w":[{"u":"ٱلَّذِى","i":"الَّذِىۡ","tl":"alladhī","en":"The One Who","ur":"وہ ذات","a":"wbw/085_009_001.mp3"},{"u":"لَهُۥ","i":"لَهٗ","tl":"lahu","en":"for Him","ur":"اسی کے لئے","a":"wbw/085_009_002.mp3"},{"u":"مُلْكُ","i":"مُلۡكُ","tl":"mul'ku","en":"(is) the dominion","ur":"بادشاہت","a":"wbw/085_009_003.mp3"},{"u":"ٱلسَّمَـٰوَٰتِ","i":"السَّمٰوٰتِ","tl":"l-samāwāti","en":"(of) the heavens","ur":"آسمانوں کی","a":"wbw/085_009_004.mp3"},{"u":"وَٱلْأَرْضِ ۚ","i":"وَالۡاَرۡضِ​ؕ","tl":"wal-arḍi","en":"and the earth","ur":"اور زمین کی","a":"wbw/085_009_005.mp3"},{"u":"وَٱللَّهُ","i":"وَ اللّٰهُ","tl":"wal-lahu","en":"and Allah","ur":"اور اللہ","a":"wbw/085_009_007.mp3"},{"u":"عَلَىٰ","i":"عَلٰى","tl":"ʿalā","en":"on","ur":"پر","a":"wbw/085_009_008.mp3"},{"u":"كُلِّ","i":"كُلِّ","tl":"kulli","en":"every","ur":"ہر","a":"wbw/085_009_009.mp3"},{"u