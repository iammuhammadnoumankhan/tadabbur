{"n":85,"src":{"text":"qc-text","wbw":"qc-wbw"},"ayahs":[{"k":"85:1","n":1,"id":5910,"u":" وَٱلسَّمَآءِ ذَاتِ ٱلْبُرُوجِ","juz":30,"page":590,"sajdah":false,"w":[{"u":"وَٱلسَّمَآءِ","en":"By the sky","ur":"قسم ہے آسمان کی"},{"u":"ذَاتِ","en":"containing","ur":"والا ہے"},{"u":"ٱلْبُرُوجِ","en":"the constellations","ur":"جو برجوں (والا ہے)"}]},{"k":"85:2","n":2,"id":5911,"u":"وَٱلْيَوْمِ ٱلْمَوْعُودِ","juz":30,"page":590,"sajdah":false,"w":[{"u":"وَٱلْيَوْمِ","en":"And the Day","ur":"اور قسم ہے  دن کی"},{"u":"ٱلْمَوْعُودِ","en":"Promised","ur":"وعدہ کئے گئے"}]},{"k":"85:3","n":3,"id":5912,"u":"وَشَاهِدٍ وَمَشْهُودٍ","juz":30,"page":590,"sajdah":false,"w":[{"u":"وَشَاهِدٍۢ","en":"And (the) witness","ur":"اور حاضر ہونے والی"},{"u":"وَمَشْهُودٍۢ","en":"and what is witnessed","ur":"اور حاضر کیے ہوئے کی"}]},{"k":"85:4","n":4,"id":5913,"u":"قُتِلَ أَصْحَـٰبُ ٱلْأُخْدُودِ","juz":30,"page":590,"sajdah":false,"w":[{"u":"قُتِلَ","en":"Destroyed were","ur":"مارے گئے"},{"u":"أَصْحَـٰبُ","en":"(the) companions","ur":"والے"},{"u":"ٱلْأُخْدُودِ","en":"(of) the pit","ur":"خندقوں (والے)"}]},{"k":"85:5","n":5,"id":5914,"u":"ٱلنَّارِ ذَاتِ ٱلْوَقُودِ","juz":30,"page":590,"sajdah":false,"w":[{"u":"ٱلنَّارِ","en":"(Of) the fire","ur":"جو آگ تھی"},{"u":"ذَاتِ","en":"full","ur":"والی"},{"u":"ٱلْوَقُودِ","en":"(of) the fuel","ur":"ایندھن (والی)"}]},{"k":"85:6","n":6,"id":5915,"u":"إِذْ هُمْ عَلَيْهَا قُعُودٌ","juz":30,"page":590,"sajdah":false,"w":[{"u":"إِذْ","en":"When","ur":"جب"},{"u":"هُمْ","en":"they","ur":"وہ"},{"u":"عَلَيْهَا","en":"by it","ur":"اس پر"},{"u":"قُعُودٌۭ","en":"(were) sitting","ur":"بیٹھے ہوئے تھے"}]},{"k":"85:7","n":7,"id":5916,"u":"وَهُمْ عَلَىٰ مَا يَفْعَلُونَ بِٱلْمُؤْمِنِينَ شُهُودٌ","juz":30,"page":590,"sajdah":false,"w":[{"u":"وَهُمْ","en":"And they","ur":"اور وہ"},{"u":"عَلَىٰ","en":"over","ur":"اوپر"},{"u":"مَا","en":"what","ur":"اس کے جو"},{"u":"يَفْعَلُونَ","en":"they were doing","ur":"وہ کر رہے تھے"},{"u":"بِٱلْمُؤْمِنِينَ","en":"to the believers","ur":"موم