{"n":87,"src":{"text":"qc-text","wbw":"qc-wbw"},"ayahs":[{"k":"87:1","n":1,"id":5949,"u":" سَبِّحِ ٱسْمَ رَبِّكَ ٱلْأَعْلَى","juz":30,"page":591,"sajdah":false,"w":[{"u":"سَبِّحِ","en":"Glorify","ur":"تسبیح کیجئے"},{"u":"ٱسْمَ","en":"(the) name","ur":"نام کی"},{"u":"رَبِّكَ","en":"(of) your Lord","ur":"اپنے رب کے"},{"u":"ٱلْأَعْلَى","en":"the Most High","ur":"جو سب سے بلند ہے"}]},{"k":"87:2","n":2,"id":5950,"u":"ٱلَّذِى خَلَقَ فَسَوَّىٰ","juz":30,"page":591,"sajdah":false,"w":[{"u":"ٱلَّذِى","en":"The One Who","ur":"وہ جس نے"},{"u":"خَلَقَ","en":"created","ur":"پیدا کیا"},{"u":"فَسَوَّىٰ","en":"then proportioned","ur":"پھر درست بنایا"}]},{"k":"87:3","n":3,"id":5951,"u":"وَٱلَّذِى قَدَّرَ فَهَدَىٰ","juz":30,"page":591,"sajdah":false,"w":[{"u":"وَٱلَّذِى","en":"And the One Who","ur":"اور وہ ذات"},{"u":"قَدَّرَ","en":"measured","ur":"جس نے انداز کیا/ تقدیر بنائی"},{"u":"فَهَدَىٰ","en":"then guided","ur":"پھر ہدایت بخشی"}]},{"k":"87:4","n":4,"id":5952,"u":"وَٱلَّذِىٓ أَخْرَجَ ٱلْمَرْعَىٰ","juz":30,"page":591,"sajdah":false,"w":[{"u":"وَٱلَّذِىٓ","en":"And the One Who","ur":"اور وہ ذات"},{"u":"أَخْرَجَ","en":"brings forth","ur":"جس نے نکالا"},{"u":"ٱلْمَرْعَىٰ","en":"the pasture","ur":"چارہ"}]},{"k":"87:5","n":5,"id":5953,"u":"فَجَعَلَهُۥ غُثَآءً أَحْوَىٰ","juz":30,"page":591,"sajdah":false,"w":[{"u":"فَجَعَلَهُۥ","en":"And then makes it","ur":"پھر بنادیا اس کو"},{"u":"غُثَآءً","en":"stubble","ur":"خشک گھاس/ کوڑا"},{"u":"أَحْوَىٰ","en":"dark","ur":"سیاہ کیا"}]},{"k":"87:6","n":6,"id":5954,"u":"سَنُقْرِئُكَ فَلَا تَنسَىٰٓ","juz":30,"page":591,"sajdah":false,"w":[{"u":"سَنُقْرِئُكَ","en":"We will make you recite","ur":"عنقریب ہم پڑھوا دیں گے تجھ کو"},{"u":"فَلَا","en":"so not","ur":"تو نہ"},{"u":"تَنسَىٰٓ","en":"you will forget","ur":"تم بھولو گے"}]},{"k":"87:7","n":7,"id":5955,"u":"إِلَّا مَا شَآءَ ٱللَّهُ ۚ إِنَّهُۥ يَعْلَمُ ٱلْجَهْرَ وَمَا يَخْفَىٰ","juz":30,"page":591,"sajdah":false,"w":[{"u":"إِلَّا","en":"Except","ur":"مگر"},{"u":"مَا","en":"what","ur":"جو"},{"u":