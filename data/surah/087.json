":"therein","ur":"اس میں"},{"u":"وَلَا","en":"and not","ur":"اور نہ"},{"u":"يَحْيَىٰ","en":"will live","ur":"زندہ ہوگا"}]},{"k":"87:14","n":14,"id":5962,"u":"قَدْ أَفْلَحَ مَن تَزَكَّىٰ","juz":30,"page":592,"sajdah":false,"w":[{"u":"قَدْ","en":"Certainly","ur":"یقیناً"},{"u":"أَفْلَحَ","en":"has succeeded","ur":"فلاح پا گیا"},{"u":"مَن","en":"(one) who","ur":"وہ جس نے"},{"u":"تَزَكَّىٰ","en":"purifies (himself)","ur":"پاکیزگی اختیار کی"}]},{"k":"87:15","n":15,"id":5963,"u":"وَذَكَرَ ٱسْمَ رَبِّهِۦ فَصَلَّىٰ","juz":30,"page":592,"sajdah":false,"w":[{"u":"وَذَكَرَ","en":"And remembers","ur":"اور ذکر کیا/ یاد کیا"},{"u":"ٱسْمَ","en":"(the) name","ur":"نام"},{"u":"رَبِّهِۦ","en":"(of) his Lord","ur":"اپنے رب کا"},{"u":"فَصَلَّىٰ","en":"and prays","ur":"پھر اس نے نماز پڑھی"}]},{"k":"87:16","n":16,"id":5964,"u":"بَلْ تُؤْثِرُونَ ٱلْحَيَوٰةَ ٱلدُّنْيَا","juz":30,"page":592,"sajdah":false,"w":[{"u":"بَلْ","en":"Nay","ur":"بلکہ"},{"u":"تُؤْثِرُونَ","en":"You prefer","ur":"تم ترجیح دیتے ہو"},{"u":"ٱلْحَيَوٰةَ","en":"the life","ur":"زندگی کو"},{"u":"ٱلدُّنْيَا","en":"(of) the world","ur":"دنیا کی"}]},{"k":"87:17","n":17,"id":5965,"u":"وَٱلْـَٔاخِرَةُ خَيْرٌ وَأَبْقَىٰٓ","juz":30,"page":592,"sajdah":false,"w":[{"u":"وَٱلْـَٔاخِرَةُ","en":"While the Hereafter","ur":"اور آخرت"},{"u":"خَيْرٌۭ","en":"(is) better","ur":"بہتر ہے"},{"u":"وَأَبْقَىٰٓ","en":"and everlasting","ur":"اور زیادہ باقی رہنے والی"}]},{"k":"87:18","n":18,"id":5966,"u":"إِنَّ هَـٰذَا لَفِى ٱلصُّحُفِ ٱلْأُولَىٰ","juz":30,"page":592,"sajdah":false,"w":[{"u":"إِنَّ","en":"Indeed","ur":"یقیناً"},{"u":"هَـٰذَا","en":"this","ur":"یہ"},{"u":"لَفِى","en":"surely (is) in","ur":"البتہ میں"},{"u":"ٱلصُّحُفِ","en":"the Scriptures","ur":"صحیفوں میں ہے"},{"u":"ٱلْأُولَىٰ","en":"[the] former","ur":"پہلے"}]},{"k":"87:19","n":19,"id":5967,"u":"صُحُفِ إِبْرَٰهِيمَ وَمُوسَىٰ","juz":30,"page":592,"sajdah":false,"w":[{"u":"صُحُفِ","en":"(The) Scriptures","ur":"صحیفوں میں"},{"u":"إِبْرَٰهِيمَ","en":"(of) Ibrahim","ur":"ابراہیم"},{"u":"وَمُوسَىٰ","en":"and Musa","ur":"اور موسیٰ کے"}]}]}