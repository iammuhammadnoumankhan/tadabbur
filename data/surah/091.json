{"n":91,"src":{"text":"qc-text","wbw":"qc-wbw"},"ayahs":[{"k":"91:1","n":1,"id":6044,"u":" وَٱلشَّمْسِ وَضُحَىٰهَا","juz":30,"page":595,"sajdah":false,"w":[{"u":"وَٱلشَّمْسِ","en":"By the sun","ur":"قسم ہے سورج کی"},{"u":"وَضُحَىٰهَا","en":"and its brightness","ur":"اور قسم ہے اس کی دھوپ کی"}]},{"k":"91:2","n":2,"id":6045,"u":"وَٱلْقَمَرِ إِذَا تَلَىٰهَا","juz":30,"page":595,"sajdah":false,"w":[{"u":"وَٱلْقَمَرِ","en":"And the moon","ur":"اور قسم ہے چاند کی"},{"u":"إِذَا","en":"when","ur":"جبکہ"},{"u":"تَلَىٰهَا","en":"it follows it","ur":"وہ اس کے پیچھے آئے"}]},{"k":"91:3","n":3,"id":6046,"u":"وَٱلنَّهَارِ إِذَا جَلَّىٰهَا","juz":30,"page":595,"sajdah":false,"w":[{"u":"وَٱلنَّهَارِ","en":"And the day","ur":"اور قسم ہے دن کی"},{"u":"إِذَا","en":"when","ur":"جبکہ"},{"u":"جَلَّىٰهَا","en":"it displays it","ur":"وہ اس کو ظاہر کرے"}]},{"k":"91:4","n":4,"id":6047,"u":"وَٱلَّيْلِ إِذَا يَغْشَىٰهَا","juz":30,"page":595,"sajdah":false,"w":[{"u":"وَٱلَّيْلِ","en":"And the night","ur":"اور قسم ہے رات کی"},{"u":"إِذَا","en":"when","ur":"جب"},{"u":"يَغْشَىٰهَا","en":"it covers it","ur":"وہ چھا جائے اس پر"}]},{"k":"91:5","n":5,"id":6048,"u":"وَٱلسَّمَآءِ وَمَا بَنَىٰهَا","juz":30,"page":595,"sajdah":false,"w":[{"u":"وَٱلسَّمَآءِ","en":"And the heaven","ur":"اور قسم ہے آسمان کی"},{"u":"وَمَا","en":"and (He) Who","ur":"اور اس کی"},{"u":"بَنَىٰهَا","en":"constructed it","ur":"جس نے بنایا اس کو"}]},{"k":"91:6","n":6,"id":6049,"u":"وَٱلْأَرْضِ وَمَا طَحَىٰهَا","juz":30,"page":595,"sajdah":false,"w":[{"u":"وَٱلْأَرْضِ","en":"And the earth","ur":"اور قسم ہے زمین کی"},{"u":"وَمَا","en":"and by (He) Who","ur":"اور اس کی"},{"u":"طَحَىٰهَا","en":"spread it","ur":"جس نے بچھایا اس کو"}]},{"k":"91:7","n":7,"id":6050,"u":"وَنَفْسٍ وَمَا سَوَّىٰهَا","juz":30,"page":595,"sajdah":false,"w":[{"u":"وَنَفْسٍۢ","en":"And (the) soul","ur":"اور قسم ہے نفس انسانی کی"},{"u":"وَمَا","en":"and (He) Who","ur":"اور اس کی"},{"u":"سَوَّىٰهَا","en":"proportioned it","ur":"جس نے درست کیا اس کو/ ہموار کیا اس کو"}]},{"k":"91:8","n":8,"id":6051,"u":"فَأَلْهَمَهَا فُجُورَهَا وَتَقْوَىٰهَا","juz":30,"page":595,"sajdah":false,"w":[{"u":"فَأَلْهَمَهَا","en":"And He inspired it","ur":"پس اس نے الہام کیا اس کو"},{"u":"فُجُورَهَا","en":"(to distinguish) its wickedness","ur":"اور اس کی بدی کو"},{"u":"وَتَقْوَىٰهَا","en":"and its righteousness","ur":"اور اس کے تقویٰ کو"}]},{"k":"91:9","n":9,"id":6052,"u":"قَدْ أَفْلَحَ مَن زَكَّىٰهَا","juz":30,"page":595,"sajdah":false,"w":[{"u":"قَدْ","en":"Indeed","ur":"یقیناً"},{"u":"أَفْلَحَ","en":"he succeeds","ur":"فلاح پا گیا"},{"u":"مَن","en":"who","ur":"جس نے"},{"u":"زَكَّىٰهَا","en":"purifies it","ur":"پاک کیا اس کو"}]},{"k":"91:10","n":10,"id":6053,"u":"وَقَدْ خَابَ مَن دَسَّىٰهَا","juz":30,"page":595,"sajdah":false,"w":[{"u":"وَقَدْ","en":"And indeed","ur":"اور یقیناً"},{"u":"خَابَ","en":"he fails","ur":"ناکام ہوا"},{"u":"مَن","en":"who","ur":"جس نے"},{"u":"دَسَّىٰهَا","en":"buries it","ur":"دبا دیا اس کو"}]},{"k":"91:11","n":11,"id":6054,"u":"كَذَّبَتْ ثَمُودُ بِطَغْوَىٰهَآ","juz":30,"page":595,"sajdah":false,"w":[{"u":"كَذَّبَتْ","en":"Denied","ur":"جھٹلایا"},{"u":"ثَمُودُ","en":"Thamud","ur":"ثمود نے"},{"u":"بِطَغْوَىٰهَآ","en":"by their transgression","ur":"اپنی سرکشی کے ساتھ"}]},{"k":"91:12","n":12,"id":6055,"u":"إِذِ ٱنۢبَعَثَ أَشْقَىٰهَا","juz":30,"page":595,"sajdah":false,"w":[{"u":"إِذِ","en":"When","ur":"جب"},{"u":"ٱنۢبَعَثَ","en":"(was) sent forth","ur":"اٹھا"},{"u":"أَشْقَىٰهَا","en":"(the) most wicked of them","ur":"سب سے بڑا بدبخت اس کا"}]},{"k":"91:13","n":13,"id":6056,"u":"فَقَالَ لَهُمْ رَسُولُ ٱللَّهِ نَاقَةَ ٱللَّهِ وَسُقْيَـٰهَا","juz":30,"page":595,"sajdah":false,"w":[{"u":"فَقَالَ","en":"But said","ur":"تو کہا"},{"u":"لَهُمْ","en":"to them","ur":"ان کو"},{"u":"رَسُولُ","en":"(the) Messenger","ur":"رسول نے"},{"u":"ٱللَّهِ","en":"(of) Allah","ur":"اللہ کے"},{"u":"نَاقَةَ","en":"(It is the) she-camel","ur":"اونٹنی ہے"},{"u":"ٱللَّهِ","en":"(of) Allah","ur":"اللہ کی"},{"u":"وَسُقْيَـٰهَا","en":"and her drink","ur":"اور پانی پلانا اس کو"}]},{"k":"91:14","n":14,"id":6057,"u":"فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمْدَمَ عَلَيْهِمْ رَبُّهُم بِذَنۢبِهِمْ فَسَوَّىٰهَا","juz":30,"page":595,"sajdah":false,"w":[{"u":"فَكَذَّبُوهُ","en":"But they denied him","ur":"تو انہوں نے جھٹلایا اس کو"},{"u":"فَعَقَرُوهَا","en":"and they hamstrung her","ur":"پھر کاٹ ڈالا اس کو"},{"u":"فَدَمْدَمَ","en":"So destroyed","ur":"تو ہلاکت ڈالی"},{"u":"عَلَيْهِمْ","en":"them","ur":"ان پر"},{"u":"رَبُّهُم","en":"their Lord","ur":"ان کے رب نے"},{"u":"بِذَنۢبِهِمْ","en":"for their sin","ur":"ان کے گناہوں کی وجہ سے"},{"u":"فَسَوَّىٰهَا","en":"and leveled them","ur":"پھر برابر کردیا اس کو"}]},{"k":"91:15","n":15,"id":6058,"u":"وَلَا يَخَافُ عُقْبَـٰهَا","juz":30,"page":595,"sajdah":false,"w":[{"u":"وَلَا","en":"And not","ur":"اور نہیں"},{"u":"يَخَافُ","en":"He fears","ur":"وہ ڈرتا"},{"u":"عُقْبَـٰهَا","en":"its consequences","ur":"اس کے انجام سے"}]}]}