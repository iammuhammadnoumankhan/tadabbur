{"n":91,"src":{"text":"qc-text","wbw":"qc-wbw"},"ayahs":[{"k":"91:1","n":1,"id":6044,"u":" وَٱلشَّمْسِ وَضُحَىٰهَا","i":"وَالشَّمۡسِ وَضُحٰٮهَا  ۙ‏","juz":30,"page":595,"sajdah":false,"w":[{"u":"وَٱلشَّمْسِ","i":"وَالشَّمۡسِ","tl":"wal-shamsi","en":"By the sun","ur":"قسم ہے سورج کی","a":"wbw/091_001_001.mp3"},{"u":"وَضُحَىٰهَا","i":"وَضُحٰٮهَا  ۙ‏","tl":"waḍuḥāhā","en":"and its brightness","ur":"اور قسم ہے اس کی دھوپ کی","a":"wbw/091_001_002.mp3"}]},{"k":"91:2","n":2,"id":6045,"u":"وَٱلْقَمَرِ إِذَا تَلَىٰهَا","i":"وَالۡقَمَرِ اِذَا تَلٰٮهَا  ۙ‏","juz":30,"page":595,"sajdah":false,"w":[{"u":"وَٱلْقَمَرِ","i":"وَالۡقَمَرِ","tl":"wal-qamari","en":"And the moon","ur":"اور قسم ہے چاند کی","a":"wbw/091_002_001.mp3"},{"u":"إِذَا","i":"اِذَا","tl":"idhā","en":"when","ur":"جبکہ","a":"wbw/091_002_002.mp3"},{"u":"تَلَىٰهَا","i":"تَلٰٮهَا  ۙ‏","tl":"talāhā","en":"it follows it","ur":"وہ اس کے پیچھے آئے","a":"wbw/091_002_003.mp3"}]},{"k":"91:3","n":3,"id":6046,"u":"وَٱلنَّهَارِ إِذَا جَلَّىٰهَا","i":"وَالنَّهَارِ اِذَا جَلّٰٮهَا ۙ‏","juz":30,"page":595,"sajdah":false,"w":[{"u":"وَٱلنَّهَارِ","i":"وَالنَّهَارِ","tl":"wal-nahāri","en":"And the day","ur":"اور قسم ہے دن کی","a":"wbw/091_003_001.mp3"},{"u":"إِذَا","i":"اِذَا","tl":"idhā","en":"when","ur":"جبکہ","a":"wbw/091_003_002.mp3"},{"u":"جَلَّىٰهَا","i":"جَلّٰٮهَا ۙ‏","tl":"jallāhā","en":"it displays it","ur":"وہ اس کو ظاہر کرے","a":"wbw/091_003_003.mp3"}]},{"k":"91:4","n":4,"id":6047,"u":"وَٱلَّيْلِ إِذَا يَغْشَىٰهَا","i":"وَالَّيۡلِ اِذَا يَغۡشٰٮهَا ۙ‏","juz":30,"page":595,"sajdah":false,"w":[{"u":"وَٱلَّيْلِ","i":"وَالَّيۡلِ","tl":"wa-al-layli","en":"And the night","ur":"اور قسم ہے رات کی","a":"wbw/091_004_001.mp3"},{"u":"إِذَا","i":"اِذَا","tl":"idhā","en":"when","ur":"جب","a":"wbw/091_004_002.mp3"},{"u":"يَغْشَىٰهَا","i":"يَغۡشٰٮهَا ۙ‏","tl":"yaghshāhā","en":"it covers it","ur":"وہ چھا جائے اس پر","a":"wbw/091_004_003.mp3"}]},{"k":"91:5","n":5,"id":6048,"u":"وَٱلسَّمَآءِ وَمَا بَنَىٰهَا","i":"وَالسَّمَآءِ وَمَا بَنٰٮهَا ۙ‏","juz":30,"page":595,"sajdah":false,"w":[{"u":"وَٱلسَّمَآءِ","i":"وَالسَّمَآءِ","tl":"wal-samāi","en":"And the heaven","ur":"اور قسم ہے آسمان کی","a":"wbw/091_005_001.mp3"},{"u":"وَمَا","i":"وَمَا","tl":"wamā","en":"and (He) Who","ur":"اور اس کی","a":"wbw/091_005_002.mp3"},{"u":"بَنَىٰهَا","i":"بَنٰٮهَا ۙ‏","tl":"banāhā","en":"constructed it","ur":"جس نے بنایا اس کو","a":"wbw/091_005_003.mp3"}]},{"k":"91:6","n":6,"id":6049,"u":"وَٱلْأَرْضِ وَمَا طَحَىٰهَا","i":"وَالۡاَرۡضِ وَمَا طَحٰٮهَا ۙ‏","juz":30,"page":595,"sajdah":false,"w":[{"u":"وَٱلْأَرْضِ","i":"وَالۡاَرۡضِ","tl":"wal-arḍi","en":"And the earth","ur":"اور قسم ہے زمین کی","a":"wbw/091_006_001.mp3"},{"u":"وَمَا","i":"وَمَا","tl":"wamā","en":"and by (He) Who","ur":"اور اس کی","a":"wbw/091_006_002.mp3"},{"u":"طَحَىٰهَا","i":"طَحٰٮهَا ۙ‏","tl":"ṭaḥāhā","en":"spread it","ur":"جس نے بچھایا اس کو","a":"wbw/091_006_003.mp3"}]},{"k":"91:7","n":7,"id":6050,"u":"وَنَفْسٍ وَمَا سَوَّىٰهَا","i":"وَنَفۡسٍ وَّمَا سَوّٰٮهَا ۙ‏","juz":30,"page":595,"sajdah":false,"w":[{"u":"وَنَفْسٍۢ","i":"وَنَفۡسٍ","tl":"wanafsin","en":"And (the) soul","ur":"اور قسم ہے نفس انسانی کی","a":"wbw/091_007_001.mp3"},{"u":"وَمَا","i":"وَّمَا","tl":"wamā","en":"and (He) Who","ur":"اور اس کی","a":"wbw/091_007_002.mp3"},{"u":"سَوَّىٰهَا","i":"سَوّٰٮهَا ۙ‏","tl":"sawwāhā","en":"proportioned it","ur":"جس نے درست کیا اس کو/ ہموار کیا اس کو","a":"wbw/091_007_003.mp3"}]},{"k":"91:8","n":8,"id":6051,"u":"فَأَلْهَمَهَا فُجُورَهَا وَتَقْوَىٰهَا","i":"فَاَلۡهَمَهَا فُجُوۡرَهَا وَتَقۡوٰٮهَا ۙ‏","juz":30,"page":595,"sajdah":false,"w":[{"u":"فَأَلْهَمَهَا","i":"فَاَلۡهَمَهَا","tl":"fa-alhamahā","en":"And He inspired it","ur":"پس اس نے الہام کیا اس کو","a":"wbw/091_008_001.mp3"},{"u":"فُجُورَهَا","i":"فُجُوۡرَهَا","tl":"fujūrahā","en":"(to distinguish) its wickedness","ur":"اور اس کی بدی کو","a":"wbw/091_008_002.mp3"},{"u":"وَتَقْوَىٰهَا","i":"وَتَقۡوٰٮهَا ۙ‏","tl":"wataqwāhā","en":"and its righteousness","ur":"اور اس کے تقویٰ کو","a":"wbw/091_008_003.mp3"}]},{"k":"91:9","n":9,"id":6052,"u":"قَدْ أَفْلَحَ مَن زَكَّىٰهَا","i":"قَدۡ اَفۡلَحَ مَنۡ زَكّٰٮهَا ۙ‏","juz":30,"page":595,"sajdah":false,"w":[{"u":"قَدْ","i":"قَدۡ","tl":"qad","en":"Indeed","ur":"یقیناً","a":"wbw/091_009_001.mp3"},{"u":"أَفْلَحَ","i":"اَفۡلَحَ","tl":"aflaḥa","en":"he succeeds","ur":"فلاح پا گیا","a":"wbw/091_009_002.mp3"},{"u":"مَن","i":"مَنۡ","tl":"man","en":"who","ur":"جس نے","a":"wbw/091_009_003.mp3"},{"u":"زَكَّىٰهَا","i":"زَكّٰٮهَا ۙ‏","tl":"zakkāhā","en":"purifies it","ur":"پاک کیا اس کو","a":"wbw/091_009_004.mp3"}]},{"k":"91:10","n":10,"id":6053,"u":"وَقَدْ خَابَ مَن دَسَّىٰهَا","i":"وَقَدۡ خَابَ مَنۡ دَسّٰٮهَا ؕ‏","juz":30,"page":595,"sajdah":false,"w":[{"u":"وَقَدْ","i":"وَقَدۡ","tl":"waqad","en":"And indeed","ur":"اور یقیناً","a":"wbw/091_010_001.mp3"},{"u":"خَابَ","i":"خَابَ","tl":"khāba","en":"he fails","ur":"ناکام ہوا","a":"wbw/091_010_002.mp3"},{"u":"مَن","i":"مَنۡ","tl":"man","en":"who","ur":"جس نے","a":"wbw/091_010_003.mp3"},{"u":"دَسَّىٰهَا","i":"دَسّٰٮهَا ؕ‏","tl":"dassāhā","en":"buries it","ur":"دبا دیا اس کو","a":"wbw/091_010_004.mp3"}]},{"k":"91:11","n":11,"id":6054,"u":"كَذَّبَتْ ثَمُودُ بِطَغْوَىٰهَآ","i":"كَذَّبَتۡ ثَمُوۡدُ بِطَغۡوٰٮهَآ  ۙ‏","juz":30,"page":595,"sajdah":false,"w":[{"u":"كَذَّبَتْ","i":"كَذَّبَتۡ","tl":"kadhabat","en":"Denied","ur":"جھٹلایا","a":"wbw/091_011_001.mp3"},{"u":"ثَمُودُ","i":"ثَمُوۡدُ","tl":"thamūdu","en":"Thamud","ur":"ثمود نے","a":"wbw/091_011_002.mp3"},{"u":"بِطَغْوَىٰهَآ","i":"بِطَغۡوٰٮهَآ  ۙ‏","tl":"biṭaghwāhā","en":"by their transgression","ur":"اپنی سرکشی کے ساتھ","a":"wbw/091_011_003.mp3"}]},{"k":"91:12","n":12,"id":6055,"u":"إِذِ ٱنۢبَعَثَ أَشْقَىٰهَا","i":"اِذِ انۡۢبَعَثَ اَشۡقٰٮهَا  ۙ‏","juz":30,"page":595,"sajdah":false,"w":[{"u":"إِذِ","i":"اِذِ","tl":"idhi","en":"When","ur":"جب","a":"wbw/091_012_001.mp3"},{"u":"ٱنۢبَعَثَ","i":"انۡۢبَعَثَ","tl":"inbaʿatha","en":"(was) sent forth","ur":"اٹھا","a":"wbw/091_012_002.mp3"},{"u":"أَشْقَىٰهَا","i":"اَشۡقٰٮهَا  ۙ‏","tl":"ashqāhā","en":"(the) most wicked of them","ur":"سب سے بڑا بدبخت اس کا","a":"wbw/091_012_003.mp3"}]},{"k":"91:13","n":13,"id":6056,"u":"فَقَالَ لَهُمْ رَسُولُ ٱللَّهِ نَاقَةَ ٱللَّهِ وَسُقْيَـٰهَا","i":"فَقَالَ لَهُمۡ رَسُوۡلُ اللّٰهِ نَاقَةَ اللّٰهِ وَسُقۡيٰهَا ؕ‏","juz":30,"page":595,"sajdah":false,"w":[{"u":"فَقَالَ","i":"فَقَالَ","tl":"faqāla","en":"But said","ur":"تو کہا","a":"wbw/091_013_001.mp3"},{"u":"لَهُمْ","i":"لَهُمۡ","tl":"lahum","en":"to them","ur":"ان کو","a":"wbw/091_013_002.mp3"},{"u":"رَسُولُ","i":"رَسُوۡلُ","tl":"rasūlu","en":"(the) Messenger","ur":"رسول نے","a":"wbw/091_013_003.mp3"},{"u":"ٱللَّهِ","i":"اللّٰهِ","tl":"l-lahi","en":"(of) Allah","ur":"اللہ کے","a":"wbw/091_013_004.mp3"},{"u":"نَاقَةَ","i":"نَاقَةَ","tl":"nāqata","en":"(It is the) she-camel","ur":"اونٹنی ہے","a":"wbw/091_013_005.mp3"},{"u":"ٱللَّهِ","i":"اللّٰهِ","tl":"l-lahi","en":"(of) Allah","ur":"اللہ کی","a":"wbw/091_013_006.mp3"},{"u":"وَسُقْيَـٰهَا","i":"وَسُقۡيٰهَا ؕ‏","tl":"wasuq'yāhā","en":"and her drink","ur":"اور پانی پلانا اس کو","a":"wbw/091_013_007.mp3"}]},{"k":"91:14","n":14,"id":6057,"u":"فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمْدَمَ عَلَيْهِمْ رَبُّهُم بِذَنۢبِهِمْ فَسَوَّىٰهَا","i":"فَكَذَّبُوۡهُ فَعَقَرُوۡهَا   ۙفَدَمۡدَمَ عَلَيۡهِمۡ رَبُّهُمۡ بِذَنۡۢبِهِمۡ فَسَوّٰٮهَا  ۙ‏","juz":30,"page":595,"sajdah":false,"w":[{"u":"فَكَذَّبُوهُ","i":"فَكَذَّبُوۡهُ","tl":"fakadhabūhu","en":"But they denied him","ur":"تو انہوں نے جھٹلایا اس کو","a":"wbw/091_014_001.mp3"},{"u":"فَعَقَرُوهَا","i":"فَعَقَرُوۡهَا  ","tl":"faʿaqarūhā","en":"and they hamstrung her","ur":"پھر کاٹ ڈالا اس کو","a":"wbw/091_014_002.mp3"},{"u":"فَدَمْدَمَ","i":"ۙفَدَمۡدَمَ","tl":"fadamdama","en":"So destroyed","ur":"تو ہلاکت ڈالی","a":"wbw/091_014_003.mp3"},{"u":"عَلَيْهِمْ","i":"عَلَيۡهِمۡ","tl":"ʿalayhim","en":"them","ur":"ان پر","a":"wbw/091_014_004.mp3"},{"u":"رَبُّهُم","i":"رَبُّهُمۡ","tl":"rabbuhum","en":"their Lord","ur":"ان کے رب نے","a":"wbw/091_014_005.mp3"},{"u":"بِذَنۢبِهِمْ","i":"بِذَنۡۢبِهِمۡ","tl":"bidhanbihim","en":"for their sin","ur":"ان کے گناہوں کی وجہ سے","a":"wbw/091_014_006.mp3"},{"u":"فَسَوَّىٰهَا","i":"فَسَوّٰٮهَا  ۙ‏","tl":"fasawwāhā","en":"and leveled them","ur":"پھر برابر کردیا اس کو","a":"wbw/091_014_007.mp3"}]},{"k":"91:15","n":15,"id":6058,"u":"وَلَا يَخَافُ عُقْبَـٰهَا","i":"وَلَا يَخَافُ عُقۡبٰهَا‏","juz":30,"page":595,"sajdah":false,"w":[{"u":"وَلَا","i":"وَلَا","tl":"walā","en":"And not","ur":"اور نہیں","a":"wbw/091_015_001.mp3"},{"u":"يَخَافُ","i":"يَخَافُ","tl":"yakhāfu","en":"He fears","ur":"وہ ڈرتا","a":"wbw/091_015_002.mp3"},{"u":"عُقْبَـٰهَا","i":"عُقۡبٰهَا‏","tl":"ʿuq'bāhā","en":"its consequences","ur":"اس کے انجام سے","a":"wbw/091_015_003.mp3"}]}]}