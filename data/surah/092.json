{"n":92,"src":{"text":"qc-text","wbw":"qc-wbw"},"ayahs":[{"k":"92:1","n":1,"id":6059,"u":" وَٱلَّيْلِ إِذَا يَغْشَىٰ","juz":30,"page":595,"sajdah":false,"w":[{"u":"وَٱلَّيْلِ","en":"By the night","ur":"قسم ہے رات کی"},{"u":"إِذَا","en":"when","ur":"جب"},{"u":"يَغْشَىٰ","en":"it covers","ur":"وہ چھا جائے"}]},{"k":"92:2","n":2,"id":6060,"u":"وَٱلنَّهَارِ إِذَا تَجَلَّىٰ","juz":30,"page":595,"sajdah":false,"w":[{"u":"وَٱلنَّهَارِ","en":"And the day","ur":"قسم ہے دن کی"},{"u":"إِذَا","en":"when","ur":"جب"},{"u":"تَجَلَّىٰ","en":"it shines in brightness","ur":"وہ روشن ہو"}]},{"k":"92:3","n":3,"id":6061,"u":"وَمَا خَلَقَ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ","juz":30,"page":595,"sajdah":false,"w":[{"u":"وَمَا","en":"And He Who","ur":"اور اس کی جس نے"},{"u":"خَلَقَ","en":"created","ur":"پیدا کیا"},{"u":"ٱلذَّكَرَ","en":"the male","ur":"نر کو"},{"u":"وَٱلْأُنثَىٰٓ","en":"and the female","ur":"اور مادہ کو"}]},{"k":"92:4","n":4,"id":6062,"u":"إِنَّ سَعْيَكُمْ لَشَتَّىٰ","juz":30,"page":595,"sajdah":false,"w":[{"u":"إِنَّ","en":"Indeed","ur":"بیشک"},{"u":"سَعْيَكُمْ","en":"your efforts","ur":"تمہاری کوشش"},{"u":"لَشَتَّىٰ","en":"(are) surely diverse","ur":"البتہ مختلف طرح کی ہے"}]},{"k":"92:5","n":5,"id":6063,"u":"فَأَمَّا مَنْ أَعْطَىٰ وَٱتَّقَىٰ","juz":30,"page":595,"sajdah":false,"w":[{"u":"فَأَمَّا","en":"Then as for","ur":"تو رہا"},{"u":"مَنْ","en":"(him) who","ur":"وہ جس نے"},{"u":"أَعْطَىٰ","en":"gives","ur":"دیا"},{"u":"وَٱتَّقَىٰ","en":"and fears","ur":"اور تقویٰ کیا"}]},{"k":"92:6","n":6,"id":6064,"u":"وَصَدَّقَ بِٱلْحُسْنَىٰ","juz":30,"page":595,"sajdah":false,"w":[{"u":"وَصَدَّقَ","en":"And believes","ur":"اور تصدیق کی"},{"u":"بِٱلْحُسْنَىٰ","en":"in the best","ur":"بھلائی کی"}]},{"k":"92:7","n":7,"id":6065,"u":"فَسَنُيَسِّرُهُۥ لِلْيُسْرَىٰ","juz":30,"page":595,"sajdah":false,"w":[{"u":"فَسَنُيَسِّرُهُۥ","en":"Then We will ease him","ur":"پس عنقریب ہم آسانی دیں گے اس کو"},{"u":"لِلْيُسْرَىٰ","en":"towards [the] ease","ur":"نیکی کے لئے/ آسانی کے لئے"}]},{"k":"92:8","n":8,"id":6066,"u":"وَأَمَّا مَنۢ بَخِلَ وَٱسْتَغْنَىٰ","juz":30,"page":595,"sajdah":false,"w":[{"u":"وَأَمَّا","en":"But as for","ur":"اور رہا وہ"},{"u":"مَنۢ","en":"(him) who","ur":"جس نے"},{"u":"بَخِلَ","en":"withholds","ur":"بخل کیا"},{"u":"وَٱسْتَغْنَىٰ","en":"and considers himself free from need","ur":"اور بےپروائی برتی"}]},{"k":"92:9","n":9,"id":6067,"u":"وَكَذَّبَ بِٱلْحُسْنَىٰ","juz":30,"page":595,"sajdah":false,"w":[{"u":"وَكَذَّبَ","en":"And denies","ur":"اور جھٹلایا"},{"u":"بِٱلْحُسْنَىٰ","en":"the best","ur":"نیکی کو/ بھلائی کو"}]},{"k":"92:10","n":10,"id":6068,"u":"فَسَنُيَسِّرُهُۥ لِلْعُسْرَىٰ","juz":30,"page":596,"sajdah":false,"w":[{"u":"فَسَنُيَسِّرُهُۥ","en":"Then We will ease him","ur":"پس عنقریب ہم آسانی دیں گے اس کو"},{"u":"لِلْعُسْرَىٰ","en":"towards [the] difficulty","ur":"تنگی کے لئے"}]},{"k":"92:11","n":11,"id":6069,"u":"وَمَا يُغْنِى عَنْهُ مَالُهُۥٓ إِذَا تَرَدَّىٰٓ","juz":30,"page":596,"sajdah":false,"w":[{"u":"وَمَا","en":"And not","ur":"اور نہیں"},{"u":"يُغْنِى","en":"will avail","ur":"کس کام آئے گا/  کام آئے گا"},{"u":"عَنْهُ","en":"him","ur":"اس کو"},{"u":"مَالُهُۥٓ","en":"his wealth","ur":"اس کا مال"},{"u":"إِذَا","en":"when","ur":"جب"},{"u":"تَرَدَّىٰٓ","en":"he falls","ur":"وہ ہلاک ہوگیا"}]},{"k":"92:12","n":12,"id":6070,"u":"إِنَّ عَلَيْنَا لَلْهُدَىٰ","juz":30,"page":596,"sajdah":false,"w":[{"u":"إِنَّ","en":"Indeed","ur":"بیشک"},{"u":"عَلَيْنَا","en":"upon Us","ur":"ہمارے ذمہ"},{"u":"لَلْهُدَىٰ","en":"(is) the guidance","ur":"البتہ ہدایت ہے"}]},{"k":"92:13","n":13,"id":6071,"u":"وَإِنَّ لَنَا لَلْـَٔاخِرَةَ وَٱلْأُولَىٰ","juz":30,"page":596,"sajdah":false,"w":[{"u":"وَإِنَّ","en":"And indeed","ur":"اور بیشک"},{"u":"لَنَا","en":"for Us","ur":"ہمارے لئے"},{"u":"لَلْـَٔاخِرَةَ","en":"(is) the Hereafter","ur":"البتہ آخرت ہے"},{"u":"وَٱلْأُولَىٰ","en":"and the first (life)","ur":"اور اولیٰ / دنیا"}]},{"k":"92:14","n":14,"id":6072,"u":"فَأَنذَرْتُكُمْ نَارًا تَلَظَّىٰ","juz":30,"page":596,"sajdah":false,"w":[{"u":"فَأَنذَرْتُكُمْ","en":"So I warn you","ur":"تو خبردار کیا میں نے تم کو"},{"u":"نَارًۭا","en":"(of) a Fire","ur":"ایک آگ سے"},{"u":"تَلَظَّىٰ","en":"blazing","ur":"جو بھٹرکتی ہے"}]},{"k":"92:15","n":15,"id":6073,"u":"لَا يَصْلَىٰهَآ إِلَّا ٱلْأَشْقَى","juz":30,"page":596,"sajdah":false,"w":[{"u":"لَا","en":"Not","ur":"نہ"},{"u":"يَصْلَىٰهَآ","en":"will burn (in) it","ur":"داخل ہوگا اس میں"},{"u":"إِلَّا","en":"except","ur":"مگر"},{"u":"ٱلْأَشْقَى","en":"the most wretched","ur":"بدبخت"}]},{"k":"92:16","n":16,"id":6074,"u":"ٱلَّذِى كَذَّبَ وَتَوَلَّىٰ","juz":30,"page":596,"sajdah":false,"w":[{"u":"ٱلَّذِى","en":"The one who","ur":"جس نے"},{"u":"كَذَّبَ","en":"denied","ur":"جھٹلایا"},{"u":"وَتَوَلَّىٰ","en":"and turned away","ur":"اور منہ موڑ لیا"}]},{"k":"92:17","n":17,"id":6075,"u":"وَسَيُجَنَّبُهَا ٱلْأَتْقَى","juz":30,"page":596,"sajdah":false,"w":[{"u":"وَسَيُجَنَّبُهَا","en":"But will be removed from it","ur":"اور عنقریب بچالیا جائے گا اس سے"},{"u":"ٱلْأَتْقَى","en":"the righteous","ur":"سب سے زیادہ پرہیزگار"}]},{"k":"92:18","n":18,"id":6076,"u":"ٱلَّذِى يُؤْتِى مَالَهُۥ يَتَزَكَّىٰ","juz":30,"page":596,"sajdah":false,"w":[{"u":"ٱلَّذِى","en":"The one who","ur":"وہ جو"},{"u":"يُؤْتِى","en":"gives","ur":"دیتا ہے"},{"u":"مَالَهُۥ","en":"his wealth","ur":"مال اپنا"},{"u":"يَتَزَكَّىٰ","en":"(to) purify himself","ur":"کہ پاکیزگی اختیار کرے"}]},{"k":"92:19","n":19,"id":6077,"u":"وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعْمَةٍ تُجْزَىٰٓ","juz":30,"page":596,"sajdah":false,"w":[{"u":"وَمَا","en":"And not","ur":"اور نہیں"},{"u":"لِأَحَدٍ","en":"for anyone","ur":"کسی ایک کے لئے"},{"u":"عِندَهُۥ","en":"with him","ur":"اس کے پاس"},{"u":"مِن","en":"any","ur":"سے"},{"u":"نِّعْمَةٍۢ","en":"favor","ur":"نعمت میں (سے)"},{"u":"تُجْزَىٰٓ","en":"to be recompensed","ur":"جس کا بدلہ دیا جائے گا/ اسے دینا ہو"}]},{"k":"92:20","n":20,"id":6078,"u":"إِلَّا ٱبْتِغَآءَ وَجْهِ رَبِّهِ ٱلْأَعْلَىٰ","juz":30,"page":596,"sajdah":false,"w":[{"u":"إِلَّا","en":"Except","ur":"سوائے/ مگر"},{"u":"ٱبْتِغَآءَ","en":"seeking","ur":"تلاش کرنے کو"},{"u":"وَجْهِ","en":"(the) Countenance","ur":"ذات/ رضا"},{"u":"رَبِّهِ","en":"(of) his Lord","ur":"اپنے رب"},{"u":"ٱلْأَعْلَىٰ","en":"the Most High","ur":"اعلیٰ کی"}]},{"k":"92:21","n":21,"id":6079,"u":"وَلَسَوْفَ يَرْضَىٰ","juz":30,"page":596,"sajdah":false,"w":[{"u":"وَلَسَوْفَ","en":"And soon, surely","ur":"اور البتہ عنقریب"},{"u":"يَرْضَىٰ","en":"he will be pleased","ur":"وہ راضی ہوجائے گا"}]}]}