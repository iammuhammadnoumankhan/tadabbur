{"n":93,"src":{"text":"qc-text","wbw":"qc-wbw"},"ayahs":[{"k":"93:1","n":1,"id":6080,"u":" وَٱلضُّحَىٰ","i":"وَالضُّحٰىۙ‏","juz":30,"page":596,"sajdah":false,"w":[{"u":"وَٱلضُّحَىٰ","i":"وَالضُّحٰىۙ‏","tl":"wal-ḍuḥā","en":"By the morning brightness","ur":"قسم ہے روز روشن کی","a":"wbw/093_001_001.mp3"}]},{"k":"93:2","n":2,"id":6081,"u":"وَٱلَّيْلِ إِذَا سَجَىٰ","i":"وَالَّيۡلِ اِذَا سَجٰىۙ‏","juz":30,"page":596,"sajdah":false,"w":[{"u":"وَٱلَّيْلِ","i":"وَالَّيۡلِ","tl":"wa-al-layli","en":"And the night","ur":"اور رات کی","a":"wbw/093_002_001.mp3"},{"u":"إِذَا","i":"اِذَا","tl":"idhā","en":"when","ur":"جب","a":"wbw/093_002_002.mp3"},{"u":"سَجَىٰ","i":"سَجٰىۙ‏","tl":"sajā","en":"it covers with darkness","ur":"وہ ڈھانپ لے","a":"wbw/093_002_003.mp3"}]},{"k":"93:3","n":3,"id":6082,"u":"مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ","i":"مَا وَدَّعَكَ رَبُّكَ وَمَا قَلٰىؕ‏","juz":30,"page":596,"sajdah":false,"w":[{"u":"مَا","i":"مَا","tl":"mā","en":"Not","ur":"نہیں","a":"wbw/093_003_001.mp3"},{"u":"وَدَّعَكَ","i":"وَدَّعَكَ","tl":"waddaʿaka","en":"has forsaken you","ur":"چھوڑا تجھ کو","a":"wbw/093_003_002.mp3"},{"u":"رَبُّكَ","i":"رَبُّكَ","tl":"rabbuka","en":"your Lord","ur":"تیرے رب نے","a":"wbw/093_003_003.mp3"},{"u":"وَمَا","i":"وَمَا","tl":"wamā","en":"and not","ur":"اور نہ","a":"wbw/093_003_004.mp3"},{"u":"قَلَىٰ","i":"قَلٰىؕ‏","tl":"qalā","en":"He is displeased","ur":"وہ ناراض ہوا","a":"wbw/093_003_005.mp3"}]},{"k":"93:4","n":4,"id":6083,"u":"وَلَلْـَٔاخِرَةُ خَيْرٌ لَّكَ مِنَ ٱلْأُولَىٰ","i":"وَلَـلۡاٰخِرَةُ خَيۡرٌ لَّكَ مِنَ الۡاُوۡلٰىؕ‏","juz":30,"page":596,"sajdah":false,"w":[{"u":"وَلَلْـَٔاخِرَةُ","i":"وَلَـلۡاٰخِرَةُ","tl":"walalākhiratu","en":"And surely the Hereafter","ur":"اور البتہ آخرت/ انجام","a":"wbw/093_004_001.mp3"},{"u":"خَيْرٌۭ","i":"خَيۡرٌ","tl":"khayrun","en":"(is) better","ur":"بہتر ہے","a":"wbw/093_004_002.mp3"},{"u":"لَّكَ","i":"لَّكَ","tl":"laka","en":"for you","ur":"تیرے لئے","a":"wbw/093_004_003.mp3"},{"u":"مِنَ","i":"مِنَ","tl":"mina","en":"than","u