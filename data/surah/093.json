{"n":93,"src":{"text":"qc-text","wbw":"qc-wbw"},"ayahs":[{"k":"93:1","n":1,"id":6080,"u":" وَٱلضُّحَىٰ","juz":30,"page":596,"sajdah":false,"w":[{"u":"وَٱلضُّحَىٰ","en":"By the morning brightness","ur":"قسم ہے روز روشن کی"}]},{"k":"93:2","n":2,"id":6081,"u":"وَٱلَّيْلِ إِذَا سَجَىٰ","juz":30,"page":596,"sajdah":false,"w":[{"u":"وَٱلَّيْلِ","en":"And the night","ur":"اور رات کی"},{"u":"إِذَا","en":"when","ur":"جب"},{"u":"سَجَىٰ","en":"it covers with darkness","ur":"وہ ڈھانپ لے"}]},{"k":"93:3","n":3,"id":6082,"u":"مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ","juz":30,"page":596,"sajdah":false,"w":[{"u":"مَا","en":"Not","ur":"نہیں"},{"u":"وَدَّعَكَ","en":"has forsaken you","ur":"چھوڑا تجھ کو"},{"u":"رَبُّكَ","en":"your Lord","ur":"تیرے رب نے"},{"u":"وَمَا","en":"and not","ur":"اور نہ"},{"u":"قَلَىٰ","en":"He is displeased","ur":"وہ ناراض ہوا"}]},{"k":"93:4","n":4,"id":6083,"u":"وَلَلْـَٔاخِرَةُ خَيْرٌ لَّكَ مِنَ ٱلْأُولَىٰ","juz":30,"page":596,"sajdah":false,"w":[{"u":"وَلَلْـَٔاخِرَةُ","en":"And surely the Hereafter","ur":"اور البتہ آخرت/ انجام"},{"u":"خَيْرٌۭ","en":"(is) better","ur":"بہتر ہے"},{"u":"لَّكَ","en":"for you","ur":"تیرے لئے"},{"u":"مِنَ","en":"than","ur":"سے"},{"u":"ٱلْأُولَىٰ","en":"the first","ur":"آغاز سے/ ابتداء سے"}]},{"k":"93:5","n":5,"id":6084,"u":"وَلَسَوْفَ يُعْطِيكَ رَبُّكَ فَتَرْضَىٰٓ","juz":30,"page":596,"sajdah":false,"w":[{"u":"وَلَسَوْفَ","en":"And soon","ur":"اور البتہ عنقریب"},{"u":"يُعْطِيكَ","en":"will give you","ur":"عطا کرے گا تجھ کو"},{"u":"رَبُّكَ","en":"your Lord","ur":"تیرا رب"},{"u":"فَتَرْضَىٰٓ","en":"then you will be satisfied","ur":"تو تو راضی ہوجائے گا/ خوش ہوجائے گا"}]},{"k":"93:6","n":6,"id":6085,"u":"أَلَمْ يَجِدْكَ يَتِيمًا فَـَٔاوَىٰ","juz":30,"page":596,"sajdah":false,"w":[{"u":"أَلَمْ","en":"Did not","ur":"کیا نہیں"},{"u":"يَجِدْكَ","en":"He find you","ur":"پایا تجھ کو"},{"u":"يَتِيمًۭا","en":"an orphan","ur":"یتیم"},{"u":"فَـَٔاوَىٰ","en":"and give shelter","ur":"پھر اس نے ٹھکانہ فراہم کیا"}]},{"k":"93:7","n":7,"id":6086,"u":"وَوَجَدَكَ ضَآلًّا فَهَدَىٰ","juz":30,"page":596,"sajdah":false,"w":[{"u":"وَوَجَدَكَ","en":"And He found you","ur":"اور پایا تجھ کو"},{"u":"ضَآلًّۭا","en":"lost","ur":"راہ بھولا"},{"u":"فَهَدَىٰ","en":"so He guided","ur":"تو اس نے ہدایت بخشی/ رہنمائی کی"}]},{"k":"93:8","n":8,"id":6087,"u":"وَوَجَدَكَ عَآئِلًا فَأَغْنَىٰ","juz":30,"page":596,"sajdah":false,"w":[{"u":"وَوَجَدَكَ","en":"And He found you","ur":"اور پایا تجھ کو"},{"u":"عَآئِلًۭا","en":"in need","ur":"مفلس"},{"u":"فَأَغْنَىٰ","en":"so He made self-sufficient","ur":"تو اس نے غنی کردیا"}]},{"k":"93:9","n":9,"id":6088,"u":"فَأَمَّا ٱلْيَتِيمَ فَلَا تَقْهَرْ","juz":30,"page":596,"sajdah":false,"w":[{"u":"فَأَمَّا","en":"So as for","ur":"تو رہا"},{"u":"ٱلْيَتِيمَ","en":"the orphan","ur":"یتیم"},{"u":"فَلَا","en":"then (do) not","ur":"پس نہ"},{"u":"تَقْهَرْ","en":"oppress","ur":"سختی کر"}]},{"k":"93:10","n":10,"id":6089,"u":"وَأَمَّا ٱلسَّآئِلَ فَلَا تَنْهَرْ","juz":30,"page":596,"sajdah":false,"w":[{"u":"وَأَمَّا","en":"And as for","ur":"اور رہا"},{"u":"ٱلسَّآئِلَ","en":"one who asks","ur":"سوالی"},{"u":"فَلَا","en":"then (do) not","ur":"پس نہ"},{"u":"تَنْهَرْ","en":"repel","ur":"جھڑکو"}]},{"k":"93:11","n":11,"id":6090,"u":"وَأَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثْ","juz":30,"page":596,"sajdah":false,"w":[{"u":"وَأَمَّا","en":"But as for","ur":"اور رہی"},{"u":"بِنِعْمَةِ","en":"(the) Favor","ur":"نعمت"},{"u":"رَبِّكَ","en":"(of) your Lord","ur":"اپنے رب کی"},{"u":"فَحَدِّثْ","en":"narrate","ur":"پس بیان کرو"}]}]}