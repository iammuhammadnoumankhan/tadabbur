{"n":98,"src":{"text":"qc-text","wbw":"qc-wbw"},"ayahs":[{"k":"98:1","n":1,"id":6131,"u":" لَمْ يَكُنِ ٱلَّذِينَ كَفَرُوا۟ مِنْ أَهْلِ ٱلْكِتَـٰبِ وَٱلْمُشْرِكِينَ مُنفَكِّينَ حَتَّىٰ تَأْتِيَهُمُ ٱلْبَيِّنَةُ","juz":30,"page":598,"sajdah":false,"w":[{"u":"لَمْ","en":"Not","ur":"نہیں"},{"u":"يَكُنِ","en":"were","ur":"تھے وہ"},{"u":"ٱلَّذِينَ","en":"those who","ur":"لوگ"},{"u":"كَفَرُوا۟","en":"disbelieved","ur":"جنہوں نے کفر کیا"},{"u":"مِنْ","en":"from","ur":"سے"},{"u":"أَهْلِ","en":"(the) People","ur":"اہل"},{"u":"ٱلْكِتَـٰبِ","en":"of the Book","ur":"کتاب میں سے"},{"u":"وَٱلْمُشْرِكِينَ","en":"and the polytheists","ur":"اور مشرکین میں سے"},{"u":"مُنفَكِّينَ","en":"to be abandoned","ur":"باز آنے والے"},{"u":"حَتَّىٰ","en":"until","ur":"یہاں تک کہ"},{"u":"تَأْتِيَهُمُ","en":"(there) comes to them","ur":"آجائے ان کے پاس"},{"u":"ٱلْبَيِّنَةُ","en":"the clear evidence","ur":"واضح دلیل"}]},{"k":"98:2","n":2,"id":6132,"u":"رَسُولٌ مِّنَ ٱللَّهِ يَتْلُوا۟ صُحُفًا مُّطَهَّرَةً","juz":30,"page":598,"sajdah":false,"w":[{"u":"رَسُولٌۭ","en":"A Messenger","ur":"ایک رسول"},{"u":"مِّنَ","en":"from","ur":"سے"},{"u":"ٱللَّهِ","en":"Allah","ur":"اللہ کی طرف (سے)"},{"u":"يَتْلُوا۟","en":"reciting","ur":"جو پڑھتا ہے"},{"u":"صُحُفًۭا","en":"pages","ur":"صحیفے"},{"u":"مُّطَهَّرَةًۭ","en":"purified","ur":"پاکیزہ"}]},{"k":"98:3","n":3,"id":6133,"u":"فِيهَا كُتُبٌ قَيِّمَةٌ","juz":30,"page":598,"sajdah":false,"w":[{"u":"فِيهَا","en":"Wherein","ur":"اس میں"},{"u":"كُتُبٌۭ","en":"(are) writings","ur":"احکام ہیں/ تحریریں ہیں"},{"u":"قَيِّمَةٌۭ","en":"correct","ur":"درست"}]},{"k":"98:4","n":4,"id":6134,"u":"وَمَا تَفَرَّقَ ٱلَّذِينَ أُوتُوا۟ ٱلْكِتَـٰبَ إِلَّا مِنۢ بَعْدِ مَا جَآءَتْهُمُ ٱلْبَيِّنَةُ","juz":30,"page":598,"sajdah":false,"w":[{"u":"وَمَا","en":"And not","ur":"اور نہیں"},{"u":"تَفَرَّقَ","en":"became divided","ur":"تفرقہ کیا"},{"u":"ٱلَّذِينَ","en":"those who","ur":"ان لوگوں نے"},{"u":"أُوتُوا۟","en":"were given","ur":"جو دیئے گئے"},{"u":"ٱلْكِتَـٰبَ","en":"the Book","ur":"کتاب"},{"u":"إِلَّا","en":"until","ur":"مگر"},{"u":"مِنۢ","en":"from","ur":"کے"},{"u":"بَعْدِ","en":"after","ur":"بعد اس کے"},{"u":"مَا","en":"what","ur":"جو"},{"u":"جَآءَتْهُمُ","en":"came (to) them","ur":"آئی ان کے پاس"},{"u":"ٱلْبَيِّنَةُ","en":"(of) the clear evidence","ur":"واضح بیان/واضح نصیحت/ واضح چیز"}]},{"k":"98:5","n":5,"id":6135,"u":"وَمَآ أُمِرُوٓا۟ إِلَّا لِيَعْبُدُوا۟ ٱللَّهَ مُخْلِصِينَ لَهُ ٱلدِّينَ حُنَفَآءَ وَيُقِيمُوا۟ ٱلصَّلَوٰةَ وَيُؤْتُوا۟ ٱلزَّكَوٰةَ ۚ وَذَٰلِكَ دِينُ ٱلْقَيِّمَةِ","juz":30,"page":598,"sajdah":false,"w":[{"u":"وَمَآ","en":"And not","ur":"اور نہیں"},{"u":"أُمِرُوٓا۟","en":"they were commanded","ur":"وہ حکم دیئے گئے تھے"},{"u":"إِلَّا","en":"except","ur":"مگر"},{"u":"لِيَعْبُدُوا۟","en":"to worship","ur":"یہ کہ وہ عبادت کرتے"},{"u":"ٱللَّهَ","en":"Allah","ur":"اللہ کی"},{"u":"مُخْلِصِينَ","en":"(being) sincere","ur":"خالص کرتے ہوئے"},{"u":"لَهُ","en":"to Him","ur":"اس کے لئے"},{"u":"ٱلدِّينَ","en":"(in) the religion","ur":"دین کو"},{"u":"حُنَفَآءَ","en":"upright","ur":"یکسو ہوکر"},{"u":"وَيُقِيمُوا۟","en":"and to establish","ur":"اور وہ قائم کرتے"},{"u":"ٱلصَّلَوٰةَ","en":"the prayer","ur":"نماز"},{"u":"وَيُؤْتُوا۟","en":"and to give","ur":"اور ادا کرتے"},{"u":"ٱلزَّكَوٰةَ ۚ","en":"the zakah","ur":"زکوٰۃ"},{"u":"وَذَٰلِكَ","en":"And that","ur":"اور یہ ہے"},{"u":"دِينُ","en":"(is the) religion","ur":"دین"},{"u":"ٱلْقَيِّمَةِ","en":"the correct","ur":"درست"}]},{"k":"98:6","n":6,"id":6136,"u":"إِنَّ ٱلَّذِينَ كَفَرُوا۟ مِنْ أَهْلِ ٱلْكِتَـٰبِ وَٱلْمُشْرِكِينَ فِى نَارِ جَهَنَّمَ خَـٰلِدِينَ فِيهَآ ۚ أُو۟لَـٰٓئِكَ هُمْ شَرُّ ٱلْبَرِيَّةِ","juz":30,"page":599,"sajdah":false,"w":[{"u":"إِنَّ","en":"Indeed","ur":"بیشک"},{"u":"ٱلَّذِينَ","en":"those who","ur":"وہ لوگ"},{"u":"كَفَرُوا۟","en":"disbelieve","ur":"جنہوں نے کفر کیا"},{"u":"مِنْ","en":"from","ur":"سے"},{"u":"أَهْلِ","en":"(the) People","ur":"اہل"},{"u":"ٱلْكِتَـٰبِ","en":"(of) the Book","ur":"کتاب میں (سے)"},{"u":"وَٱلْمُشْرِكِينَ","en":"and the polytheists","ur":"اور مشرکین میں سے"},{"u":"فِى","en":"(will be) in","ur":"میں"},{"u":"نَارِ","en":"(the) Fire","ur":"آگ میں ہوں گے"},{"u":"جَهَنَّمَ","en":"(of) Hell","ur":"جہنم کی"},{"u":"خَـٰلِدِينَ","en":"abiding eternally","ur":"ہمیشہ رہنے والے"},{"u":"فِيهَآ ۚ","en":"therein","ur":"اس میں"},{"u":"أُو۟لَـٰٓئِكَ","en":"Those ","ur":"یہی لوگ"},{"u":"هُمْ","en":"they","ur":"وہ"},{"u":"شَرُّ","en":"(are the) worst","ur":"بدترین"},{"u":"ٱلْبَرِيَّةِ","en":"(of) the creatures","ur":"مخلوق ہیں"}]},{"k":"98:7","n":7,"id":6137,"u":"إِنَّ ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ أُو۟لَـٰٓئِكَ هُمْ خَيْرُ ٱلْبَرِيَّةِ","juz":30,"page":599,"sajdah":false,"w":[{"u":"إِنَّ","en":"Indeed","ur":"بیشک"},{"u":"ٱلَّذِينَ","en":"those who","ur":"وہ لوگ"},{"u":"ءَامَنُوا۟","en":"believe","ur":"جو ایمان لائے"},{"u":"وَعَمِلُوا۟","en":"and do","ur":"اور انہوں نے عمل کئے"},{"u":"ٱلصَّـٰلِحَـٰتِ","en":"righteous deeds","ur":"اچھے"},{"u":"أُو۟لَـٰٓئِكَ","en":"those ","ur":"یہی لوگ"},{"u":"هُمْ","en":"they","ur":"وہ"},{"u":"خَيْرُ","en":"(are the) best","ur":"بہترین"},{"u":"ٱلْبَرِيَّةِ","en":"(of) the creatures","ur":"مخلوق ہیں"}]},{"k":"98:8","n":8,"id":6138,"u":"جَزَآؤُهُمْ عِندَ رَبِّهِمْ جَنَّـٰتُ عَدْنٍ تَجْرِى مِن تَحْتِهَا ٱلْأَنْهَـٰرُ خَـٰلِدِينَ فِيهَآ أَبَدًا ۖ رَّضِىَ ٱللَّهُ عَنْهُمْ وَرَضُوا۟ عَنْهُ ۚ ذَٰلِكَ لِمَنْ خَشِىَ رَبَّهُۥ","juz":30,"page":599,"sajdah":false,"w":[{"u":"جَزَآؤُهُمْ","en":"Their reward","ur":"ان کی جزا"},{"u":"عِندَ","en":"(is) with","ur":"پاس"},{"u":"رَبِّهِمْ","en":"their Lord ","ur":"ان کے رب کے"},{"u":"جَنَّـٰتُ","en":"Gardens","ur":"باغات"},{"u":"عَدْنٍۢ","en":"(of) Eternity","ur":"ہمیشگی کے"},{"u":"تَجْرِى","en":"flow","ur":"بہتی ہیں"},{"u":"مِن","en":"from","ur":"سے"},{"u":"تَحْتِهَا","en":"underneath them","ur":"ان کے نیچے سے"},{"u":"ٱلْأَنْهَـٰرُ","en":"the rivers","ur":"نہریں"},{"u":"خَـٰلِدِينَ","en":"will abide","ur":"ہمیشہ رہنے والے ہیں"},{"u":"فِيهَآ","en":"therein","ur":"اس میں"},{"u":"أَبَدًۭا ۖ","en":"forever","ur":"ہمیشہ ہمیشہ"},{"u":"رَّضِىَ","en":"(will be) pleased","ur":"راضی ہوگیا"},{"u":"ٱللَّهُ","en":"Allah","ur":"اللہ"},{"u":"عَنْهُمْ","en":"with them","ur":"ان سے"},{"u":"وَرَضُوا۟","en":"and they (will be) pleased","ur":"اور وہ راضی ہوگئے"},{"u":"عَنْهُ ۚ","en":"with Him","ur":"اس سے"},{"u":"ذَٰلِكَ","en":"That","ur":"یہ"},{"u":"لِمَنْ","en":"(is) for whoever","ur":"واسطے اس کے ہے جو"},{"u":"خَشِىَ","en":"feared","ur":"ڈرتا ہو"},{"u":"رَبَّهُۥ","en":"his Lord","ur":"اپنے رب سے"}]}]}