{"n":99,"src":{"text":"qc-text","wbw":"qc-wbw"},"ayahs":[{"k":"99:1","n":1,"id":6139,"u":" إِذَا زُلْزِلَتِ ٱلْأَرْضُ زِلْزَالَهَا","juz":30,"page":599,"sajdah":false,"w":[{"u":"إِذَا","en":"When","ur":"جب"},{"u":"زُلْزِلَتِ","en":"is shaken","ur":"ہلا ماری جائے گی"},{"u":"ٱلْأَرْضُ","en":"the earth","ur":"زمین"},{"u":"زِلْزَالَهَا","en":"(with) its earthquake","ur":"ہلا دیا جانا اس کا"}]},{"k":"99:2","n":2,"id":6140,"u":"وَأَخْرَجَتِ ٱلْأَرْضُ أَثْقَالَهَا","juz":30,"page":599,"sajdah":false,"w":[{"u":"وَأَخْرَجَتِ","en":"And brings forth","ur":"اور نکالے گی"},{"u":"ٱلْأَرْضُ","en":"the earth","ur":"زمین"},{"u":"أَثْقَالَهَا","en":"its burdens","ur":"بوجھ اپنے"}]},{"k":"99:3","n":3,"id":6141,"u":"وَقَالَ ٱلْإِنسَـٰنُ مَا لَهَا","juz":30,"page":599,"sajdah":false,"w":[{"u":"وَقَالَ","en":"And says","ur":"اور کہے گا"},{"u":"ٱلْإِنسَـٰنُ","en":"man","ur":"انسان"},{"u":"مَا","en":"What","ur":"کیا ہے"},{"u":"لَهَا","en":"(is) with it","ur":"اس کو"}]},{"k":"99:4","n":4,"id":6142,"u":"يَوْمَئِذٍ تُحَدِّثُ أَخْبَارَهَا","juz":30,"page":599,"sajdah":false,"w":[{"u":"يَوْمَئِذٍۢ","en":"That Day","ur":"اس دن"},{"u":"تُحَدِّثُ","en":"it will report","ur":"وہ بیان کرے گی"},{"u":"أَخْبَارَهَا","en":"its news","ur":"اپنی خبریں"}]},{"k":"99:5","n":5,"id":6143,"u":"بِأَنَّ رَبَّكَ أَوْحَىٰ لَهَا","juz":30,"page":599,"sajdah":false,"w":[{"u":"بِأَنَّ","en":"Because","ur":"کیونکہ"},{"u":"رَبَّكَ","en":"your Lord","ur":"تیرے رب نے"},{"u":"أَوْحَىٰ","en":"inspired","ur":"وحی کی"},{"u":"لَهَا","en":"[to] it","ur":"اس کے لئے"}]},{"k":"99:6","n":6,"id":6144,"u":"يَوْمَئِذٍ يَصْدُرُ ٱلنَّاسُ أَشْتَاتًا لِّيُرَوْا۟ أَعْمَـٰلَهُمْ","juz":30,"page":599,"sajdah":false,"w":[{"u":"يَوْمَئِذٍۢ","en":"That Day","ur":"اس دن"},{"u":"يَصْدُرُ","en":"will proceed","ur":"نکلیں گے/ پلٹیں گے"},{"u":"ٱلنَّاسُ","en":"the mankind","ur":"لوگ"},{"u":"أَشْتَاتًۭا","en":"(in) scattered groups","ur":"مختلف حالت میں"},{"u":"لِّيُرَوْا۟","en":"to be shown","ur":"تاکہ وہ دکھائے جائیں"},{"u":"أَعْمَـٰلَهُمْ","en":"their deeds","ur":"اپنے اعمال"}]},{"k":"99:7","n":7,"id":6145,"u":"فَمَن يَعْمَلْ مِثْقَالَ ذَرَّةٍ خَيْرًا يَرَهُۥ","juz":30,"page":599,"sajdah":false,"w":[{"u":"فَمَن","en":"So whoever","ur":"تو جو کوئی"},{"u":"يَعْمَلْ","en":"does","ur":"عمل کرے"},{"u":"مِثْقَالَ","en":"(equal to the) weight","ur":"برابر"},{"u":"ذَرَّةٍ","en":"(of) an atom","ur":"ذرے کے"},{"u":"خَيْرًۭا","en":"good","ur":"بھلائی کا"},{"u":"يَرَهُۥ","en":"will see it","ur":"وہ دیکھ لے گا اس کو"}]},{"k":"99:8","n":8,"id":6146,"u":"وَمَن يَعْمَلْ مِثْقَالَ ذَرَّةٍ شَرًّا يَرَهُۥ","juz":30,"page":599,"sajdah":false,"w":[{"u":"وَمَن","en":"And whoever","ur":"اور جو کوئی"},{"u":"يَعْمَلْ","en":"does","ur":"عمل کرے گا"},{"u":"مِثْقَالَ","en":"(equal to the) weight","ur":"برابر"},{"u":"ذَرَّةٍۢ","en":"(of) an atom","ur":"ذرے کے"},{"u":"شَرًّۭا","en":"evil","ur":"برائی کا"},{"u":"يَرَهُۥ","en":"will see it","ur":"وہ دیکھ لے گا اس کو"}]}]}