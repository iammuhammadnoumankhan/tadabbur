/099_007_001.mp3"},{"u":"يَعْمَلْ","i":"يَّعۡمَلۡ","tl":"yaʿmal","en":"does","ur":"عمل کرے","a":"wbw/099_007_002.mp3"},{"u":"مِثْقَالَ","i":"مِثۡقَالَ","tl":"mith'qāla","en":"(equal to the) weight","ur":"برابر","a":"wbw/099_007_003.mp3"},{"u":"ذَرَّةٍ","i":"ذَرَّةٍ","tl":"dharratin","en":"(of) an atom","ur":"ذرے کے","a":"wbw/099_007_004.mp3"},{"u":"خَيْرًۭا","i":"خَيۡرًا","tl":"khayran","en":"good","ur":"بھلائی کا","a":"wbw/099_007_005.mp3"},{"u":"يَرَهُۥ","i":"يَّرَهٗ ؕ‏","tl":"yarahu","en":"will see it","ur":"وہ دیکھ لے گا اس کو","a":"wbw/099_007_006.mp3"}]},{"k":"99:8","n":8,"id":6146,"u":"وَمَن يَعْمَلْ مِثْقَالَ ذَرَّةٍ شَرًّا يَرَهُۥ","i":"وَمَنۡ يَّعۡمَلۡ مِثۡقَالَ ذَرَّةٍ شَرًّا يَّرَهٗ‏","juz":30,"page":599,"sajdah":false,"w":[{"u":"وَمَن","i":"وَمَنۡ","tl":"waman","en":"And whoever","ur":"اور جو کوئی","a":"wbw/099_008_001.mp3"},{"u":"يَعْمَلْ","i":"يَّعۡمَلۡ","tl":"yaʿmal","en":"does","ur":"عمل کرے گا","a":"wbw/099_008_002.mp3"},{"u":"مِثْقَالَ","i":"مِثۡقَالَ","tl":"mith'qāla","en":"(equal to the) weight","ur":"برابر","a":"wbw/099_008_003.mp3"},{"u":"ذَرَّةٍۢ","i":"ذَرَّةٍ","tl":"dharratin","en":"(of) an atom","ur":"ذرے کے","a":"wbw/099_008_004.mp3"},{"u":"شَرًّۭا","i":"شَرًّا","tl":"sharran","en":"evil","ur":"برائی کا","a":"wbw/099_008_005.mp3"},{"u":"يَرَهُۥ","i":"يَّرَهٗ‏","tl":"yarahu","en":"will see it","ur":"وہ دیکھ لے گا اس کو","a":"wbw/099_008_006.mp3"}]}]}