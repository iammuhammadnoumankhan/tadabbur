{"n":104,"src":{"text":"qc-text","wbw":"qc-wbw"},"ayahs":[{"k":"104:1","n":1,"id":6180,"u":" وَيْلٌ لِّكُلِّ هُمَزَةٍ لُّمَزَةٍ","juz":30,"page":601,"sajdah":false,"w":[{"u":"وَيْلٌۭ","en":"Woe","ur":"ہلاکت ہے"},{"u":"لِّكُلِّ","en":"to every","ur":"واسطے ہر اس شخص کے"},{"u":"هُمَزَةٍۢ","en":"slanderer","ur":"جو منہ پر عیب لگاتا ہے"},{"u":"لُّمَزَةٍ","en":"backbiter","ur":"پیٹھ پیچھے برائیاں کرتا ہے"}]},{"k":"104:2","n":2,"id":6181,"u":"ٱلَّذِى جَمَعَ مَالًا وَعَدَّدَهُۥ","juz":30,"page":601,"sajdah":false,"w":[{"u":"ٱلَّذِى","en":"The one who","ur":"وہ جس نے"},{"u":"جَمَعَ","en":"collects","ur":"جمع کیا"},{"u":"مَالًۭا","en":"wealth","ur":"مال"},{"u":"وَعَدَّدَهُۥ","en":"and counts it","ur":"اور گن گن کر رکھا اس کو"}]},{"k":"104:3","n":3,"id":6182,"u":"يَحْسَبُ أَنَّ مَالَهُۥٓ أَخْلَدَهُۥ","juz":30,"page":601,"sajdah":false,"w":[{"u":"يَحْسَبُ","en":"Thinking","ur":"وہ سمجھتا ہے"},{"u":"أَنَّ","en":"that","ur":"کہ بیشک"},{"u":"مَالَهُۥٓ","en":"his wealth","ur":"اس کا مال"},{"u":"أَخْلَدَهُۥ","en":"will make him immortal","ur":"ہمیشہ اس کے پاس رہے گا"}]},{"k":"104:4","n":4,"id":6183,"u":"كَلَّا ۖ لَيُنۢبَذَنَّ فِى ٱلْحُطَمَةِ","juz":30,"page":601,"sajdah":false,"w":[{"u":"كَلَّا ۖ","en":"Nay","ur":"ہرگز نہیں"},{"u":"لَيُنۢبَذَنَّ","en":"Surely he will be thrown","ur":"البتہ ضرور ڈالا جائے گا"},{"u":"فِى","en":"in","ur":"میں"},{"u":"ٱلْحُطَمَةِ","en":"the Crusher","ur":"حطمہ (میں)"}]},{"k":"104:5","n":5,"id":6184,"u":"وَمَآ أَدْرَىٰكَ مَا ٱلْحُطَمَةُ","juz":30,"page":601,"sajdah":false,"w":[{"u":"وَمَآ","en":"And what","ur":"اور کیا چیز"},{"u":"أَدْرَىٰكَ","en":"will make you know","ur":"بتائے تجھ کو"},{"u":"مَا","en":"what","ur":"کیا ہے"},{"u":"ٱلْحُطَمَةُ","en":"the Crusher (is)","ur":"حطمہ"}]},{"k":"104:6","n":6,"id":6185,"u":"نَارُ ٱللَّهِ ٱلْمُوقَدَةُ","juz":30,"page":601,"sajdah":false,"w":[{"u":"نَارُ","en":"A Fire","ur":"آگ"},{"u":"ٱللَّهِ","en":"Allah","ur":"اللہ کی"},{"u":"ٱلْمُوقَدَةُ","en":"kindled","ur":"سلگائی ہوئی"}]},{"k":"104:7","n":7,"id":6186,"u":"ٱلَّتِى تَطَّلِعُ عَلَى ٱلْأَفْـِٔدَةِ","juz":30,"page":601,"sajdah":false,"w":[{"u":"ٱلَّتِى","en":"Which","ur":"وہ جو"},{"u":"تَطَّلِعُ","en":"mounts up","ur":"چڑھ آتی ہے"},{"u":"عَلَى","en":"to","ur":"پر"},{"u":"ٱلْأَفْـِٔدَةِ","en":"the hearts","ur":"دلوں (پر)"}]},{"k":"104:8","n":8,"id":6187,"u":"إِنَّهَا عَلَيْهِم مُّؤْصَدَةٌ","juz":30,"page":601,"sajdah":false,"w":[{"u":"إِنَّهَا","en":"Indeed, it","ur":"بیشک وہ"},{"u":"عَلَيْهِم","en":"(will be) upon them","ur":"ان پر"},{"u":"مُّؤْصَدَةٌۭ","en":"closed over","ur":"بند کی ہوئی ہے"}]},{"k":"104:9","n":9,"id":6188,"u":"فِى عَمَدٍ مُّمَدَّدَةٍۭ","juz":30,"page":601,"sajdah":false,"w":[{"u":"فِى","en":"In","ur":"میں"},{"u":"عَمَدٍۢ","en":"columns","ur":"ستونوں (میں)"},{"u":"مُّمَدَّدَةٍۭ","en":"extended","ur":"لمبے لمبے"}]}]}