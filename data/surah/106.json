_004_001.mp3"},{"u":"أَطْعَمَهُم","i":"اَطۡعَمَهُمۡ","tl":"aṭʿamahum","en":"feeds them","ur":"کھلایا ان کو","a":"wbw/106_004_002.mp3"},{"u":"مِّن","i":"مِّنۡ","tl":"min","en":"[from]","ur":"سے","a":"wbw/106_004_003.mp3"},{"u":"جُوعٍۢ","i":"جُوۡعٍ   ۙ","tl":"jūʿin","en":"(against) hunger","ur":"بھوک (سے)","a":"wbw/106_004_004.mp3"},{"u":"وَءَامَنَهُم","i":"وَّاٰمَنَهُمۡ","tl":"waāmanahum","en":"and gives them security","ur":"اور امن دیا ان کو","a":"wbw/106_004_005.mp3"},{"u":"مِّنْ","i":"مِّنۡ","tl":"min","en":"from","ur":"سے","a":"wbw/106_004_006.mp3"},{"u":"خَوْفٍۭ","i":"خَوۡفٍ‏","tl":"khawfin","en":"fear","ur":"خوف (سے)","a":"wbw/106_004_007.mp3"}]}]}