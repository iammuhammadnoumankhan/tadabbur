{"n":106,"src":{"text":"qc-text","wbw":"qc-wbw"},"ayahs":[{"k":"106:1","n":1,"id":6194,"u":" لِإِيلَـٰفِ قُرَيْشٍ","juz":30,"page":602,"sajdah":false,"w":[{"u":"لِإِيلَـٰفِ","en":"For (the) familiarity","ur":"مانوس کرنے کے لئے"},{"u":"قُرَيْشٍ","en":"(of the) Quraish","ur":"قریش کو"}]},{"k":"106:2","n":2,"id":6195,"u":"إِۦلَـٰفِهِمْ رِحْلَةَ ٱلشِّتَآءِ وَٱلصَّيْفِ","juz":30,"page":602,"sajdah":false,"w":[{"u":"إِۦلَـٰفِهِمْ","en":"Their familiarity","ur":"مانوس کرنا ان کو"},{"u":"رِحْلَةَ","en":"(with the) journey","ur":"سفر میں"},{"u":"ٱلشِّتَآءِ","en":"(of) winter","ur":"سردی کے"},{"u":"وَٱلصَّيْفِ","en":"and summer","ur":"اور گرمی کے"}]},{"k":"106:3","n":3,"id":6196,"u":"فَلْيَعْبُدُوا۟ رَبَّ هَـٰذَا ٱلْبَيْتِ","juz":30,"page":602,"sajdah":false,"w":[{"u":"فَلْيَعْبُدُوا۟","en":"So let them worship","ur":"پس چاہیے کہ وہ عبادت کریں"},{"u":"رَبَّ","en":"(the) Lord","ur":"رب کی"},{"u":"هَـٰذَا","en":"(of) this","ur":"اس"},{"u":"ٱلْبَيْتِ","en":"House","ur":"گھر کے"}]},{"k":"106:4","n":4,"id":6197,"u":"ٱلَّذِىٓ أَطْعَمَهُم مِّن جُوعٍ وَءَامَنَهُم مِّنْ خَوْفٍۭ","juz":30,"page":602,"sajdah":false,"w":[{"u":"ٱلَّذِىٓ","en":"The One Who","ur":"جس نے"},{"u":"أَطْعَمَهُم","en":"feeds them","ur":"کھلایا ان کو"},{"u":"مِّن","en":"[from]","ur":"سے"},{"u":"جُوعٍۢ","en":"(against) hunger","ur":"بھوک (سے)"},{"u":"وَءَامَنَهُم","en":"and gives them security","ur":"اور امن دیا ان کو"},{"u":"مِّنْ","en":"from","ur":"سے"},{"u":"خَوْفٍۭ","en":"fear","ur":"خوف (سے)"}]}]}