{"n":107,"src":{"text":"qc-text","wbw":"qc-wbw"},"ayahs":[{"k":"107:1","n":1,"id":6198,"u":" أَرَءَيْتَ ٱلَّذِى يُكَذِّبُ بِٱلدِّينِ","juz":30,"page":602,"sajdah":false,"w":[{"u":"أَرَءَيْتَ","en":"Have you seen","ur":"کیا دیکھا تم نے"},{"u":"ٱلَّذِى","en":"the one who","ur":"اس شخص کو"},{"u":"يُكَذِّبُ","en":"denies","ur":"جو جھٹلاتا ہے"},{"u":"بِٱلدِّينِ","en":"the Judgment","ur":"جزا و سزا کو"}]},{"k":"107:2","n":2,"id":6199,"u":"فَذَٰلِكَ ٱلَّذِى يَدُعُّ ٱلْيَتِيمَ","juz":30,"page":602,"sajdah":false,"w":[{"u":"فَذَٰلِكَ","en":"Then that","ur":"پس یہ وہ"},{"u":"ٱلَّذِى","en":"(is) the one who","ur":"شخص ہے"},{"u":"يَدُعُّ","en":"repulses","ur":"جو دھکے دیتا ہے"},{"u":"ٱلْيَتِيمَ","en":"the orphan","ur":"یتیم کو"}]},{"k":"107:3","n":3,"id":6200,"u":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ","juz":30,"page":602,"sajdah":false,"w":[{"u":"وَلَا","en":"And (does) not","ur":"اور نہیں"},{"u":"يَحُضُّ","en":"feel the urge","ur":"رغبت دلاتا"},{"u":"عَلَىٰ","en":"to","ur":"پر"},{"u":"طَعَامِ","en":"feed","ur":"کھانے پر/کھانا دینے پر"},{"u":"ٱلْمِسْكِينِ","en":"the poor","ur":"مسکین کے"}]},{"k":"107:4","n":4,"id":6201,"u":"فَوَيْلٌ لِّلْمُصَلِّينَ","juz":30,"page":602,"sajdah":false,"w":[{"u":"فَوَيْلٌۭ","en":"So woe","ur":"پس ہلاکت ہے"},{"u":"لِّلْمُصَلِّينَ","en":"to those who pray","ur":"نمازیوں کے لئے"}]},{"k":"107:5","n":5,"id":6202,"u":"ٱلَّذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ","juz":30,"page":602,"sajdah":false,"w":[{"u":"ٱلَّذِينَ","en":"Those who","ur":"وہ لوگ"},{"u":"هُمْ","en":"[they]","ur":"وہ"},{"u":"عَن","en":"about","ur":"سے"},{"u":"صَلَاتِهِمْ","en":"their prayers","ur":"اپنی نمازوں (سے)"},{"u":"سَاهُونَ","en":"(are) neglectful","ur":"بےخبر ہیں"}]},{"k":"107:6","n":6,"id":6203,"u":"ٱلَّذِينَ هُمْ يُرَآءُونَ","juz":30,"page":602,"sajdah":false,"w":[{"u":"ٱلَّذِينَ","en":"Those who","ur":"وہ لوگ"},{"u":"هُمْ","en":"[they]","ur":"وہ"},{"u":"يُرَآءُونَ","en":"make show","ur":"دکھاوا کرتے ہیں"}]},{"k":"107:7","n":7,"id":6204,"u":"وَيَمْنَعُونَ ٱلْمَاعُونَ","ju