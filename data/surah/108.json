{"n":108,"src":{"text":"qc-text","wbw":"qc-wbw"},"ayahs":[{"k":"108:1","n":1,"id":6205,"u":" إِنَّآ أَعْطَيْنَـٰكَ ٱلْكَوْثَرَ","juz":30,"page":602,"sajdah":false,"w":[{"u":"إِنَّآ","en":"Indeed, We","ur":"بیشک ہم نے"},{"u":"أَعْطَيْنَـٰكَ","en":"We have given you","ur":"عطا کی ہم نے آپ کو"},{"u":"ٱلْكَوْثَرَ","en":"Al-Kauthar","ur":"خیر کثیر"}]},{"k":"108:2","n":2,"id":6206,"u":"فَصَلِّ لِرَبِّكَ وَٱنْحَرْ","juz":30,"page":602,"sajdah":false,"w":[{"u":"فَصَلِّ","en":"So pray","ur":"پس نماز پڑھو"},{"u":"لِرَبِّكَ","en":"to your Lord","ur":"اپنے رب کے لئے"},{"u":"وَٱنْحَرْ","en":"and sacrifice","ur":"اور قربانی کرو"}]},{"k":"108:3","n":3,"id":6207,"u":"إِنَّ شَانِئَكَ هُوَ ٱلْأَبْتَرُ","juz":30,"page":602,"sajdah":false,"w":[{"u":"إِنَّ","en":"Indeed","ur":"بیشک"},{"u":"شَانِئَكَ","en":"your enemy ","ur":"دشمن تیرا"},{"u":"هُوَ","en":"he (is)","ur":"وہی"},{"u":"ٱلْأَبْتَرُ","en":"the one cut off","ur":"جڑ کٹا ہے"}]}]}