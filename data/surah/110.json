{"n":110,"src":{"text":"qc-text","wbw":"qc-wbw"},"ayahs":[{"k":"110:1","n":1,"id":6214,"u":" إِذَا جَآءَ نَصْرُ ٱللَّهِ وَٱلْفَتْحُ","juz":30,"page":603,"sajdah":false,"w":[{"u":"إِذَا","en":"When","ur":"جب"},{"u":"جَآءَ","en":"comes","ur":"آگئی"},{"u":"نَصْرُ","en":"(the) Help","ur":"مدد"},{"u":"ٱللَّهِ","en":"(of) Allah","ur":"اللہ کی"},{"u":"وَٱلْفَتْحُ","en":"and the Victory","ur":"اور فتح"}]},{"k":"110:2","n":2,"id":6215,"u":"وَرَأَيْتَ ٱلنَّاسَ يَدْخُلُونَ فِى دِينِ ٱللَّهِ أَفْوَاجًا","juz":30,"page":603,"sajdah":false,"w":[{"u":"وَرَأَيْتَ","en":"And you see","ur":"اور تم نے دیکھا"},{"u":"ٱلنَّاسَ","en":"the people","ur":"لوگوں کو"},{"u":"يَدْخُلُونَ","en":"entering","ur":"داخل ہو رہے ہیں"},{"u":"فِى","en":"into","ur":"میں"},{"u":"دِينِ","en":"(the) religion","ur":"دین (میں)"},{"u":"ٱللَّهِ","en":"(of) Allah","ur":"اللہ کے"},{"u":"أَفْوَاجًۭا","en":"(in) multitudes","ur":"فوج در فوج"}]},{"k":"110:3","n":3,"id":6216,"u":"فَسَبِّحْ بِحَمْدِ رَبِّكَ وَٱسْتَغْفِرْهُ ۚ إِنَّهُۥ كَانَ تَوَّابًۢا","juz":30,"page":603,"sajdah":false,"w":[{"u":"فَسَبِّحْ","en":"Then glorify","ur":"تو تسبیح کرو"},{"u":"بِحَمْدِ","en":"with (the) praises","ur":"حمد کے ساتھ"},{"u":"رَبِّكَ","en":"(of) your Lord","ur":"اپنے رب کی"},{"u":"وَٱسْتَغْفِرْهُ ۚ","en":"and ask His forgiveness","ur":"اور بخشش مانگو اس سے"},{"u":"إِنَّهُۥ","en":"Indeed, He","ur":"بیشک وہ"},{"u":"كَانَ","en":"is","ur":"ہے"},{"u":"تَوَّابًۢا","en":"Oft-Returning","ur":"توبہ قبول کرنے والا"}]}]}