{"n":111,"src":{"text":"qc-text","wbw":"qc-wbw"},"ayahs":[{"k":"111:1","n":1,"id":6217,"u":" تَبَّتْ يَدَآ أَبِى لَهَبٍ وَتَبَّ","juz":30,"page":603,"sajdah":false,"w":[{"u":"تَبَّتْ","en":"Perish","ur":"ٹوٹ گئے"},{"u":"يَدَآ","en":"(the) hands","ur":"دونوں ہاتھ"},{"u":"أَبِى","en":"(of) Abu","ur":"ابو"},{"u":"لَهَبٍۢ","en":"Lahab","ur":"لہب کے"},{"u":"وَتَبَّ","en":"and perish he","ur":"اور وہ ہلاک ہوا"}]},{"k":"111:2","n":2,"id":6218,"u":"مَآ أَغْنَىٰ عَنْهُ مَالُهُۥ وَمَا كَسَبَ","juz":30,"page":603,"sajdah":false,"w":[{"u":"مَآ","en":"Not","ur":"نہ"},{"u":"أَغْنَىٰ","en":"(will) avail","ur":"کام آیا"},{"u":"عَنْهُ","en":"him","ur":"اس کو"},{"u":"مَالُهُۥ","en":"his wealth","ur":"اس کا مال"},{"u":"وَمَا","en":"and what","ur":"اور جو"},{"u":"كَسَبَ","en":"he earned","ur":"اس نے کمایا"}]},{"k":"111:3","n":3,"id":6219,"u":"سَيَصْلَىٰ نَارًا ذَاتَ لَهَبٍ","juz":30,"page":603,"sajdah":false,"w":[{"u":"سَيَصْلَىٰ","en":"He will be burnt","ur":"عنقریب وہ داخل ہوگا"},{"u":"نَارًۭا","en":"(in) a Fire","ur":"آگ میں"},{"u":"ذَاتَ","en":"of","ur":"والی"},{"u":"لَهَبٍۢ","en":"Blazing Flames","ur":"شعلے (والی)"}]},{"k":"111:4","n":4,"id":6220,"u":"وَٱمْرَأَتُهُۥ حَمَّالَةَ ٱلْحَطَبِ","juz":30,"page":603,"sajdah":false,"w":[{"u":"وَٱمْرَأَتُهُۥ","en":"And his wife","ur":"اور اس کی بیوی"},{"u":"حَمَّالَةَ","en":"(the) carrier","ur":"اٹھانے والی"},{"u":"ٱلْحَطَبِ","en":"(of) firewood","ur":"لکڑی کے گٹھے کو"}]},{"k":"111:5","n":5,"id":6221,"u":"فِى جِيدِهَا حَبْلٌ مِّن مَّسَدٍۭ","juz":30,"page":603,"sajdah":false,"w":[{"u":"فِى","en":"In","ur":"میں"},{"u":"جِيدِهَا","en":"her neck","ur":"اس کی گردن میں ہوگی"},{"u":"حَبْلٌۭ","en":"(will be) a rope","ur":"رسی"},{"u":"مِّن","en":"of","ur":"کی"},{"u":"مَّسَدٍۭ","en":"palm-fiber","ur":"مونجھ کی"}]}]}