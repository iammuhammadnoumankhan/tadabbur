{"n":113,"src":{"text":"qc-text","wbw":"qc-wbw"},"ayahs":[{"k":"113:1","n":1,"id":6226,"u":" قُلْ أَعُوذُ بِرَبِّ ٱلْفَلَقِ","juz":30,"page":604,"sajdah":false,"w":[{"u":"قُلْ","en":"Say","ur":"کہہ دیجئے"},{"u":"أَعُوذُ","en":"I seek refuge","ur":"میں پناہ چاہتا ہوں"},{"u":"بِرَبِّ","en":"in (the) Lord","ur":"رب کی"},{"u":"ٱلْفَلَقِ","en":"(of) the dawn","ur":"صبح کے"}]},{"k":"113:2","n":2,"id":6227,"u":"مِن شَرِّ مَا خَلَقَ","juz":30,"page":604,"sajdah":false,"w":[{"u":"مِن","en":"From","ur":"سے"},{"u":"شَرِّ","en":"(the) evil","ur":"شر"},{"u":"مَا","en":"(of) what","ur":"ہر اس چیز کے  جو"},{"u":"خَلَقَ","en":"He created","ur":"اس نے پیدا کی"}]},{"k":"113:3","n":3,"id":6228,"u":"وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ","juz":30,"page":604,"sajdah":false,"w":[{"u":"وَمِن","en":"And from","ur":"اور سے"},{"u":"شَرِّ","en":"(the) evil","ur":"شر"},{"u":"غَاسِقٍ","en":"(of) darkness","ur":"اندھیرا کرنے والی کے"},{"u":"إِذَا","en":"when","ur":"جب"},{"u":"وَقَبَ","en":"it spreads","ur":"وہ داخل ہوجائے"}]},{"k":"113:4","n":4,"id":6229,"u":"وَمِن شَرِّ ٱلنَّفَّـٰثَـٰتِ فِى ٱلْعُقَدِ","juz":30,"page":604,"sajdah":false,"w":[{"u":"وَمِن","en":"And from","ur":"اور سے"},{"u":"شَرِّ","en":"(the) evil","ur":"شر"},{"u":"ٱلنَّفَّـٰثَـٰتِ","en":"(of) the blowers","ur":"پھونکنے والیوں کے"},{"u":"فِى","en":"in","ur":"میں"},{"u":"ٱلْعُقَدِ","en":"the knots","ur":"گرہوں (میں)"}]},{"k":"113:5","n":5,"id":6230,"u":"وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ","juz":30,"page":604,"sajdah":false,"w":[{"u":"وَمِن","en":"And from","ur":"اور سے"},{"u":"شَرِّ","en":"(the) evil","ur":"شر"},{"u":"حَاسِدٍ","en":"(of) an envier","ur":"حاسد کے"},{"u":"إِذَا","en":"when","ur":"جب"},{"u":"حَسَدَ","en":"he envies","ur":"وہ حسد کرے"}]}]}